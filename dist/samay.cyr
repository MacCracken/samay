# --- uuid.cyr ---

# uuid.cyr — RFC-4122 version-4 UUID generation.
#
# Cyrius port of the Rust `uuid::new_v4().to_string()` used for task ids.
# 122 random bits from the kernel CSPRNG (`random_bytes` → getrandom(2)),
# with the 4-bit version field set to 0100b and the 2-bit variant field
# set to 10b, rendered as the canonical 8-4-4-4-12 lowercase hex form.
#
# Requires (auto-prepended from cyrius.cyml [deps].stdlib): random, str,
# alloc, syscalls.

var _UUID_HEX = "0123456789abcdef";

# Generate a random v4 UUID and return it as a heap `Str`
# ("xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx", y in {8,9,a,b}). samay stores
# all strings as `Str` (ptr+len) so `#derive(Serialize)` can codec them and
# `map_new_str` can key on content; the backing buffer stays NUL-terminated
# so `str_cstr`/syscall-write paths still work.
fn samay_uuid_v4(): Str {
    var b[16];
    random_bytes(&b, 16);
    # version 4: high nibble of byte 6 = 0100b
    store8(&b + 6, (load8(&b + 6) & 0x0F) | 0x40);
    # variant RFC-4122: high bits of byte 8 = 10b
    store8(&b + 8, (load8(&b + 8) & 0x3F) | 0x80);

    var out = alloc(37);
    if (out == 0) { panic("samay: out of memory in samay_uuid_v4 (buffer)"); }
    var op = 0;
    var i = 0;
    while (i < 16) {
        if (i == 4) { store8(out + op, 45); op = op + 1; }   # '-'
        if (i == 6) { store8(out + op, 45); op = op + 1; }
        if (i == 8) { store8(out + op, 45); op = op + 1; }
        if (i == 10) { store8(out + op, 45); op = op + 1; }
        var byte = load8(&b + i);
        store8(out + op, load8(_UUID_HEX + (byte >> 4)));
        store8(out + op + 1, load8(_UUID_HEX + (byte & 0x0F)));
        op = op + 2;
        i = i + 1;
    }
    store8(out + op, 0);
    # str_new returns 0 on OOM (lib/str.cyr). A null Str here becomes
    # ScheduledTask.task_id and then a hashmap key -- and it does NOT fault
    # there, because hash_str_v null-guards in lib/hashmap.cyr. The task
    # inserts under bucket 0 and the SIGSEGV lands on some LATER, unrelated
    # submit that probes into slot 0 and reaches str_eq(0, key). Measured at
    # the 8th/10th/10th subsequent submit across three runs: nondeterministic,
    # cross-frame, unattributable. Abort here instead (ADR-0009).
    var s = str_new(out, 36);
    if (s == 0) { panic("samay: out of memory in samay_uuid_v4 (Str header)"); }
    return s;
}

# --- types.cyr ---

# types.cyr — core scheduler domain types.
#
# Cyrius port of the Rust structs/enums in rust-old/src/lib.rs. Instances
# are heap pointers built by the `*_new` constructors; fields are read/
# written through `#derive(accessors)` getters/setters. All fields are
# 8-byte slots (i64, f64 bit-pattern, or Str pointer). `0` is the None
# sentinel for optional Str / timestamp fields.
#
# Requires (auto-prepended from cyrius.cyml): str, alloc, chrono, fmt,
# string, plus ai-hwaccel (REQ_* accelerator enum) and src/uuid.cyr.
# f64 arithmetic/compare (f64_from/to/add/sub/mul/div/lt/gt/eq) are
# compiler builtins; f64 min/max are local helpers (avoid a math.cyr dep).

fn _f64_max(a, b): i64 { if (f64_gt(a, b) == 1) { return a; } return b; }
fn _f64_min(a, b): i64 { if (f64_lt(a, b) == 1) { return a; } return b; }

# Own a caller-supplied Str: copy its bytes into samay's own allocation.
#
# ⛔ 1.1.3 — every constructor that RETAINS a caller's Str now goes through here.
# Through 1.1.2 they stored the pointer they were given, so samay's records held
# whatever lifetime the CALLER's buffer had. daimon — samay's consumer — hands in
# `jget` results: VIEWS into an HTTP request buffer that its server REUSES for
# the next connection. Measured on the live daimon binary:
#
#   POST /v1/scheduler/tasks {"name":"ORIGINAL_TASK_NAME"}
#   (one unrelated request from another client)
#   GET  /v1/scheduler/tasks/<id>  ->  "name":"ZZZZZZZZZZZZZZZZZZ"
#
# i.e. another client's request body, served back as this task's name. The
# library, not the caller, is the right place for the rule: a constructor that
# keeps a Str must own it, because it cannot know how long the caller's lives.
#
# 0 is samay's None sentinel for optional Str fields (see the header), so a 0
# input is passed through, never cloned. A non-null input that clones to 0 is an
# OOM, and per ADR-0009 a null must never leave the function that created it:
# `who` names the constructor so the panic says where it happened.
fn _samay_own(s, who): i64 {
    if (s == 0) { return 0; }
    var c = str_clone(s);
    if (c == 0) { panic(who); }
    return c;
}

# The same for a field that is never None: a null becomes the empty Str. Kept as 0 it
# placed and counted like any task, then crashed the first writer that met it (1.5.1).
fn _samay_own_req(s, who): i64 {
    if (s == 0) {
        var e = str_from("");
        if (e == 0) { panic(who); }
        return e;
    }
    return _samay_own(s, who);
}

# Add at most `most` bytes of `s` to a log line, a control byte shown as '?'. A name or
# id can be any bytes, and a newline in one started a log line of its own (1.5.1).
fn _samay_log_add(sb, s, most): i64 {
    if (s == 0) { return 0; }
    var n = str_len(s);
    if (n > most) { n = most; }
    var d = str_data(s);
    var i = 0;
    while (i < n) {
        var c = load8(d + i);
        if (c < 32) { c = 63; }
        if (c == 127) { c = 63; }
        str_builder_putc(sb, c);
        i = i + 1;
    }
    return 0;
}

# Nothing to do, and kept because it is public. It existed to fill chrono's month
# table while the caller was single-threaded, against a publish-before-fill race
# (ADR-0008). chrono fixed that in cyrius 6.5.37, and samay stopped reading the table
# in 1.4.1.
fn samay_init(): i64 {
    return 0;
}

# The value in slot i of a map's table, or 0 if the slot holds nothing. For a pass
# that runs again and again: map_values copies everything the map holds into a
# fresh vec and alloc() never frees, so a long-lived scheduler would pay for every
# task it has ever held on every pass, finished or not. Walking the table allocates
# nothing. Slots come in table order, so anything order-sensitive still sorts
# (ADR-0004). lib/hashmap.cyr keeps walking map_entries/map_cap safe: neither a
# delete nor an overwrite moves an entry.
fn _map_slot(m, i): i64 {
    var slot = map_entries(m) + i * 24;
    if (load64(slot + 16) != 1) { return 0; }
    return load64(slot + 8);
}

# Finite-f64 gate. NaN fails the self-equality test; +/-Inf exceeds any
# finite bound. 1e18 is many orders above any real CPU-core count, so a value
# beyond it is a corrupt snapshot either way.
fn _f64_is_finite(x): i64 {
    if (f64_eq(x, x) == 0) { return 0; }
    var huge = f64_from(1000000000000000000);
    if (f64_gt(x, huge) == 1) { return 0; }
    if (f64_lt(x, f64_sub(f64_from(0), huge)) == 1) { return 0; }
    return 1;
}

# Lexicographic (unsigned byte-wise) less-than for two `Str`s. Returns 1 if
# `a` sorts strictly before `b`, else 0. The determinism tie-breaker used
# across the scheduler/cron/json layers: task_id / node_id / entry-name are
# unique keys, so ordering by them turns every "arbitrary among equals"
# choice into a total order independent of hashmap iteration (see ADR-0004).
fn samay_str_lt(a, b): i64 {
    if (_samay_str_cmp(a, b) < 0) { return 1; }
    return 0;
}

# The same order as a vec_sort_by comparator: <0 if a sorts first, 0 if equal, >0
# if after. A proper prefix sorts first.
fn _samay_str_cmp(a, b): i64 {
    var la = str_len(a);
    var lb = str_len(b);
    var da = str_data(a);
    var db = str_data(b);
    var n = la;
    if (lb < n) { n = lb; }
    var i = 0;
    while (i < n) {
        var ca = load8(da + i);
        var cb = load8(db + i);
        if (ca < cb) { return 0 - 1; }
        if (ca > cb) { return 1; }
        i = i + 1;
    }
    return la - lb;
}

# ---------------------------------------------------------------------------
# TaskPriority — ordered classification (Rust enum w/ derived Ord)
# ---------------------------------------------------------------------------

enum TaskPriority {
    PRIO_NORMAL = 0;      # numeric 1-3
    PRIO_HIGH = 1;        # numeric 4-6
    PRIO_CRITICAL = 2;    # numeric 7-9
    PRIO_EMERGENCY = 3;   # numeric 10
}

# Derive a TaskPriority from a numeric priority (1-10).
fn task_priority_from_numeric(p): i64 {
    if (p >= 1) { if (p <= 3) { return PRIO_NORMAL; } }
    if (p >= 4) { if (p <= 6) { return PRIO_HIGH; } }
    if (p >= 7) { if (p <= 9) { return PRIO_CRITICAL; } }
    if (p == 10) { return PRIO_EMERGENCY; }
    return PRIO_NORMAL;
}

# True (1) if `a` can preempt `b` — strictly higher priority class.
fn task_priority_can_preempt(a, b): i64 {
    if (a > b) { return 1; }
    return 0;
}

# ---------------------------------------------------------------------------
# TaskStatus — state machine (Rust enum; Failed(String) → status + fail_reason)
# ---------------------------------------------------------------------------

enum TaskStatus {
    TASK_QUEUED = 0;
    TASK_SCHEDULED = 1;
    TASK_RUNNING = 2;
    TASK_COMPLETED = 3;
    TASK_FAILED = 4;
    TASK_CANCELLED = 5;
    TASK_PREEMPTED = 6;
}

# True (1) if transitioning from `a` to `b` is valid. Mirrors the Rust
# valid_transition matrix exactly.
fn task_status_valid_transition(a, b): i64 {
    if (a == TASK_QUEUED) {
        if (b == TASK_SCHEDULED) { return 1; }
        if (b == TASK_CANCELLED) { return 1; }
        return 0;
    }
    if (a == TASK_SCHEDULED) {
        if (b == TASK_RUNNING) { return 1; }
        if (b == TASK_CANCELLED) { return 1; }
        if (b == TASK_QUEUED) { return 1; }
        return 0;
    }
    if (a == TASK_RUNNING) {
        if (b == TASK_COMPLETED) { return 1; }
        if (b == TASK_FAILED) { return 1; }
        if (b == TASK_CANCELLED) { return 1; }
        if (b == TASK_PREEMPTED) { return 1; }
        return 0;
    }
    if (a == TASK_PREEMPTED) {
        if (b == TASK_QUEUED) { return 1; }
        return 0;
    }
    return 0;
}

fn task_status_name(s): i64 {
    if (s == TASK_QUEUED) { return "queued"; }
    if (s == TASK_SCHEDULED) { return "scheduled"; }
    if (s == TASK_RUNNING) { return "running"; }
    if (s == TASK_COMPLETED) { return "completed"; }
    if (s == TASK_FAILED) { return "failed"; }
    if (s == TASK_CANCELLED) { return "cancelled"; }
    if (s == TASK_PREEMPTED) { return "preempted"; }
    return "unknown";
}

# ---------------------------------------------------------------------------
# ResourceReq
# ---------------------------------------------------------------------------

# Fields: cpu_cores (f64), memory_mb, accel_req (ai-hwaccel REQ_*),
# accel_min_chips (for REQ_TPU; else 0), network (bool 0/1), disk_mb,
# accel_devices (how many devices, default 1) and accel_share (thousandths of one
# device, default SAMAY_ACCEL_WHOLE), both since 1.5.0 (ADR-0016).
# NOTE: no inline `#` comments on field lines — #derive(accessors) parses
# them as field names.
#derive(accessors)
#derive(Serialize)
struct ResourceReq {
    cpu_cores: f64;
    memory_mb: i64;
    accel_req: i64;
    accel_min_chips: i64;
    network: i64;
    disk_mb: i64;
    accel_devices: i64;
    accel_share: i64;
}

# A whole device, in the thousandths a share is counted in (ADR-0016).
var SAMAY_ACCEL_WHOLE = 1000;

# A negative or NaN requirement runs capacity backwards through reserve and release,
# which subtract it, so it reads as none. A value past 1e18 stops there: no node has
# that, so it still never fits, and it stays a number the wire can carry. +Inf would
# write as null, and a task must not get easier to place by going through a snapshot.
fn _req_cpu(x): i64 {
    if (f64_eq(x, x) == 0) { return f64_from(0); }
    if (f64_lt(x, f64_from(0)) == 1) { return f64_from(0); }
    var most = f64_from(1000000000000000000);
    if (f64_gt(x, most) == 1) { return most; }
    return x;
}

fn _req_amount(x): i64 {
    if (x < 0) { return 0; }
    return x;
}

fn resource_req_new(cpu_cores, memory_mb, accel_req, accel_min_chips, network, disk_mb): i64 {
    var p = alloc(64);
    # NOT `return 0`: _rr_from (src/json.cyr) forwards this result, and
    # its callers read 0 as ADR-0005's "required field missing -- reject this
    # record", then drop the record and continue. An
    # OOM-0 would silently delete a WELL-FORMED task from a VALID snapshot
    # while the restore reported success -- contradicting the module's own rule
    # that samay never silently drops. See ADR-0009.
    if (p == 0) { panic("samay: out of memory in resource_req_new"); }
    ResourceReq_set_cpu_cores(p, _req_cpu(cpu_cores));
    ResourceReq_set_memory_mb(p, _req_amount(memory_mb));
    ResourceReq_set_accel_req(p, accel_req);
    ResourceReq_set_accel_min_chips(p, _req_amount(accel_min_chips));
    # A flag, as restore reads it: anything non-zero is 1.
    if (network != 0) { network = 1; }
    ResourceReq_set_network(p, network);
    ResourceReq_set_disk_mb(p, _req_amount(disk_mb));
    # One whole device: exclusive is the default (ADR-0016).
    ResourceReq_set_accel_devices(p, 1);
    ResourceReq_set_accel_share(p, SAMAY_ACCEL_WHOLE);
    return p;
}

# The share a request takes of one device, in thousandths. 0 or less, or a whole device
# or more, is the whole device: setters and the derive's decoder can leave a 0.
fn _req_share(req): i64 {
    var s = ResourceReq_accel_share(req);
    if (s <= 0) { return SAMAY_ACCEL_WHOLE; }
    if (s >= SAMAY_ACCEL_WHOLE) { return SAMAY_ACCEL_WHOLE; }
    return s;
}

# How many devices a request takes: at least one, and one for a share.
fn _req_devices(req): i64 {
    if (_req_share(req) < SAMAY_ACCEL_WHOLE) { return 1; }
    var d = ResourceReq_accel_devices(req);
    if (d < 1) { return 1; }
    return d;
}

# Ask for `n` whole devices on one node; returns `req`. Fewer than one is one, and it
# replaces any share, since several devices are each taken whole (ADR-0016).
fn resource_req_with_devices(req, n): i64 {
    var d = n;
    if (d < 1) { d = 1; }
    ResourceReq_set_accel_devices(req, d);
    ResourceReq_set_accel_share(req, SAMAY_ACCEL_WHOLE);
    return req;
}

# Ask for `thousandths` of one device; returns `req`. 0 or less, or SAMAY_ACCEL_WHOLE or
# more, is the whole device, and it replaces any device count, since a share is of one.
fn resource_req_with_share(req, thousandths): i64 {
    var s = thousandths;
    if (s <= 0) { s = SAMAY_ACCEL_WHOLE; }
    if (s > SAMAY_ACCEL_WHOLE) { s = SAMAY_ACCEL_WHOLE; }
    ResourceReq_set_accel_share(req, s);
    ResourceReq_set_accel_devices(req, 1);
    return req;
}

# Rust Default: 1.0 cpu, 256 MB, no accelerator, no network, 0 disk.
fn resource_req_default(): i64 {
    return resource_req_new(f64_from(1), 256, REQ_NONE, 0, 0, 0);
}

# Deep copy (Rust derives Clone; cron fires clone the template's req). Devices and
# share are copied as placement reads them.
fn resource_req_clone(req): i64 {
    var c = resource_req_new(
      ResourceReq_cpu_cores(req), ResourceReq_memory_mb(req),
      ResourceReq_accel_req(req), ResourceReq_accel_min_chips(req),
      ResourceReq_network(req), ResourceReq_disk_mb(req));
    ResourceReq_set_accel_devices(c, _req_devices(req));
    ResourceReq_set_accel_share(c, _req_share(req));
    return c;
}

# ---------------------------------------------------------------------------
# ScheduledTask
# ---------------------------------------------------------------------------

# Fields: task_id/name/description/agent_id (Str), priority (1-10),
# resource_requirements (ResourceReq pointer), status (TaskStatus),
# fail_reason (Str, 0=none — payload of Failed), created_at (epoch-ns),
# scheduled_at/started_at/completed_at/deadline (epoch-ns, 0=None),
# requested_node/assigned_node/reserved_on (Str, 0=None).
#derive(accessors)
# Three fields name a node, and each has one meaning (ADR-0010):
# `requested_node` is the node the caller asked for, and only the caller writes
# it. `assigned_node` is the node schedule_pending last placed this task on, and
# it stays after the task ends, so a finished task still says where it ran.
# `reserved_on` is the node whose capacity this task is CURRENTLY holding, and is
# 0 when it holds none. That distinction is what makes releasing idempotent —
# see _release_task_node / _reconcile_reservations (ADR-0007).
struct ScheduledTask {
    task_id: Str;
    name: Str;
    description: Str;
    agent_id: Str;
    priority: i64;
    resource_requirements: i64;
    status: i64;
    fail_reason: Str;
    created_at: i64;
    scheduled_at: i64;
    started_at: i64;
    completed_at: i64;
    deadline: i64;
    requested_node: Str;
    reserved_on: Str;
    assigned_node: Str;
}

# The node a task was placed on, or the node it asked for if it was never placed.
# This is what a single `node_preference` field meant through 1.2.x, and it is
# what consumers reading this name and the snapshot's `node_preference` key still
# get (ADR-0010). Use requested_node or assigned_node for just one of the two.
fn ScheduledTask_node_preference(t): Str {
    var assigned = ScheduledTask_assigned_node(t);
    if (assigned != 0) { return assigned; }
    return ScheduledTask_requested_node(t);
}

# Ask for a node. Takes effect at the next schedule_pending, so on a task already
# placed, ScheduledTask_node_preference keeps naming the assignment until then.
fn ScheduledTask_set_node_preference(t, node): i64 {
    ScheduledTask_set_requested_node(t, _samay_own(node, "samay: out of memory in ScheduledTask_set_node_preference"));
    return 0;
}

# Create a new task in Queued status. Priority is clamped to 1-10.
fn scheduled_task_new(name, description, agent_id, priority, req): i64 {
    var p = alloc(128);   # 16 fields * 8
    if (p == 0) { panic("samay: out of memory in scheduled_task_new"); }
    var prio = priority;
    if (prio < 1) { prio = 1; }
    if (prio > 10) { prio = 10; }
    ScheduledTask_set_task_id(p, samay_uuid_v4());
    ScheduledTask_set_name(p, _samay_own_req(name, "samay: out of memory in scheduled_task_new"));
    ScheduledTask_set_description(p, _samay_own_req(description, "samay: out of memory in scheduled_task_new"));
    ScheduledTask_set_agent_id(p, _samay_own_req(agent_id, "samay: out of memory in scheduled_task_new"));
    ScheduledTask_set_priority(p, prio);
    # A copy, so a caller reusing one ResourceReq cannot change what a placed task
    # gives back: release has to return exactly what reserve took (ADR-0007).
    ScheduledTask_set_resource_requirements(p, resource_req_clone(req));
    ScheduledTask_set_status(p, TASK_QUEUED);
    ScheduledTask_set_fail_reason(p, 0);
    ScheduledTask_set_created_at(p, dt_now());
    ScheduledTask_set_scheduled_at(p, 0);
    ScheduledTask_set_started_at(p, 0);
    ScheduledTask_set_completed_at(p, 0);
    ScheduledTask_set_deadline(p, 0);
    ScheduledTask_set_requested_node(p, 0);
    ScheduledTask_set_reserved_on(p, 0);
    ScheduledTask_set_assigned_node(p, 0);
    return p;
}

# Derived priority classification.
fn scheduled_task_priority_class(t): i64 {
    return task_priority_from_numeric(ScheduledTask_priority(t));
}

# Transition to a new status. Returns Ok(0) on success, Err(1) on an
# invalid transition (Rust returns Result<()> with a bail! message).
fn scheduled_task_transition(t, to): i64 {
    if (task_status_valid_transition(ScheduledTask_status(t), to) != 1) {
        return Err(1);
    }
    ScheduledTask_set_status(t, to);
    # Stamped here because a consumer can drive a task with this alone, and stats
    # has nothing to average without them. A requeued task keeps its first start.
    if (to == TASK_RUNNING) {
        if (ScheduledTask_started_at(t) == 0) { ScheduledTask_set_started_at(t, dt_now()); }
    } elif (to == TASK_COMPLETED) {
        ScheduledTask_set_completed_at(t, dt_now());
    } elif (to == TASK_FAILED) {
        ScheduledTask_set_completed_at(t, dt_now());
    } elif (to == TASK_CANCELLED) {
        ScheduledTask_set_completed_at(t, dt_now());
    }
    return Ok(0);
}

# ---------------------------------------------------------------------------
# NodeCapacity
# ---------------------------------------------------------------------------

# M3 (ADR-0002): accelerator availability is a list of real ai-hwaccel
# accelerator profiles (profile_cuda/rocm/tpu/gaudi/neuron), not flat
# gpu/tpu booleans. can_fit delegates to ai-hwaccel's requirement_satisfied().
#derive(accessors)
struct NodeCapacity {
    node_id: Str;
    total_cpu: f64;
    available_cpu: f64;
    total_memory_mb: i64;
    available_memory_mb: i64;
    total_disk_mb: i64;
    available_disk_mb: i64;
    accel_profiles: i64;
    running_tasks: i64;
    accel_used: i64;
    accel_holds: i64;
    accel_order: i64;
}

# The most accelerator profiles one node may have. No host has a thousand devices, and
# without a ceiling a 1 MB snapshot of one node and one task asking for all of them took
# a minute and a half to restore. A var, so a consumer can raise it (1.5.1, ADR-0018).
var SAMAY_MAX_NODE_DEVICES = 1024;

# Empty hold records for a new node. Reservations say who holds what, so a restore
# rebuilds these from the tasks (ADR-0013, ADR-0018). accel_order is the profiles in
# rank order, 0 until a hold first needs it: most nodes in a large fleet have none.
fn _node_init_holds(p): i64 {
    var used = vec_new();
    if (used == 0) { panic("samay: out of memory in _node_init_holds"); }
    var holds = vec_new();
    if (holds == 0) { panic("samay: out of memory in _node_init_holds"); }
    NodeCapacity_set_accel_used(p, used);
    NodeCapacity_set_accel_holds(p, holds);
    NodeCapacity_set_accel_order(p, 0);
    return 0;
}

fn node_capacity_new(node_id, total_cpu, total_memory_mb, total_disk_mb, gpu_available): i64 {
    var p = alloc(96);   # 12 fields * 8 — MUST track node_capacity_from_jsonv
    if (p == 0) { panic("samay: out of memory in node_capacity_new"); }
    NodeCapacity_set_node_id(p, _samay_own_req(node_id, "samay: out of memory in node_capacity_new"));
    # The domain restore reads back, so a node comes back as it was built: NaN or a
    # negative amount is none, and cores stop at 1e18. Through 1.4.4 a node past 1e18
    # restored with no cores at all, and one with negative memory with none.
    var cpu = _req_cpu(total_cpu);
    NodeCapacity_set_total_cpu(p, cpu);
    NodeCapacity_set_available_cpu(p, cpu);
    NodeCapacity_set_total_memory_mb(p, _req_amount(total_memory_mb));
    NodeCapacity_set_available_memory_mb(p, _req_amount(total_memory_mb));
    NodeCapacity_set_total_disk_mb(p, _req_amount(total_disk_mb));
    NodeCapacity_set_available_disk_mb(p, _req_amount(total_disk_mb));
    # vec_new returns 0 on OOM (lib/vec.cyr:35) and this used to store it
    # straight into the struct, which was then returned looking healthy. For a
    # CPU node the gpu_available branch below is skipped, so nothing ever
    # touched the null vec: node_capacity_can_fit returned 1 for a REQ_NONE
    # requirement and schedule_pending PLACED A TASK ON THE CORRUPT NODE --
    # a successful, wrong scheduling decision, dying much later in vec_len(0).
    # That is the class this project's resource-awareness rule exists to
    # forbid, so it aborts at the allocation instead (ADR-0009).
    var profs = vec_new();
    if (profs == 0) { panic("samay: out of memory in node_capacity_new (accel_profiles)"); }
    NodeCapacity_set_accel_profiles(p, profs);
    NodeCapacity_set_running_tasks(p, 0);
    _node_init_holds(p);
    # Convenience: a `gpu_available` node registers one CUDA profile.
    if (gpu_available == 1) {
        vec_push(NodeCapacity_accel_profiles(p), profile_cuda(0, 0));
    }
    return p;
}

fn _log_device_ceiling(node): i64 {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "node '");
    _samay_log_add(sb, NodeCapacity_node_id(node), 128);
    str_builder_add_cstr(sb, "': accelerator profile not added, past ");
    str_builder_add_int(sb, SAMAY_MAX_NODE_DEVICES);
    var msg = str_builder_build(sb);
    sakshi_warn(str_data(msg), str_len(msg));
    return 0;
}

# Attach a real ai-hwaccel accelerator profile (profile_cuda / profile_rocm /
# profile_tpu / profile_gaudi / profile_neuron). Chainable. This is how
# accelerator availability is registered for resource-aware placement. Past
# SAMAY_MAX_NODE_DEVICES the profile is not added, and that is logged.
fn node_capacity_add_accel(node, profile): i64 {
    var profs = NodeCapacity_accel_profiles(node);
    if (vec_len(profs) >= SAMAY_MAX_NODE_DEVICES) {
        _log_device_ceiling(node);
        return node;
    }
    vec_push(profs, profile);
    return node;
}

# Convenience: register a TPU profile with `chip_count` chips (chainable).
fn node_capacity_with_tpu(node, chip_count): i64 {
    if (chip_count > 0) { node_capacity_add_accel(node, profile_tpu(0, chip_count, TPU_V4)); }
    return node;
}

# --- accelerator holds (ADR-0013, ADR-0016) ---
#
# requirement_satisfied says a device exists. Placement also needs it to be free,
# so a node counts what is in use on each profile. accel_used runs parallel to
# accel_profiles. accel_holds is flat pairs of (requirement, profile index), one per
# profile a reservation took, so a release gives back exactly the profiles that
# reservation took: undoing a pick by requirement type alone would free the wrong one
# when two requirements overlap, and leave the other held for good.

# What a profile offers: a TPU pod shares its chips, and anything else is one device
# of SAMAY_ACCEL_WHOLE thousandths.
fn _accel_capacity(p): i64 {
    if (profile_accel_type(p) == ACCEL_TPU) { return profile_tpu_chips(p); }
    return SAMAY_ACCEL_WHOLE;
}

# What a request takes of one profile: its share of a device, or chips of a pod.
# REQ_GPU_OR_TPU and REQ_ANY_ACCELERATOR do not check chips, so one can ask for more
# than a pod has. It then takes the pod.
fn _accel_units(p, req): i64 {
    if (profile_accel_type(p) != ACCEL_TPU) { return _req_share(req); }
    var chips = profile_tpu_chips(p);
    var want = ResourceReq_accel_min_chips(req);
    if (want < 1) { return 1; }
    if (want > chips) { return chips; }
    return want;
}

fn _accel_used_at(node, i): i64 {
    var used = NodeCapacity_accel_used(node);
    if (i >= vec_len(used)) { return 0; }
    return vec_get(used, i);
}

# accel_profiles can grow after a node is built, so this grows to match.
fn _accel_add_used(node, i, delta): i64 {
    var used = NodeCapacity_accel_used(node);
    while (vec_len(used) <= i) { vec_push(used, 0); }
    vec_set(used, i, vec_get(used, i) + delta);
    return 0;
}

# 1 if profile `a` comes before profile `b` when a share is picked: a device already in
# use first, so a share leaves whole devices whole while a shared one has room
# (ADR-0016), then _accel_ranks_before. Only a share is picked; whole devices go by
# _accel_order.
fn _accel_before(node, a, b): i64 {
    var ua = 0;
    var ub = 0;
    if (_accel_used_at(node, a) > 0) { ua = 1; }
    if (_accel_used_at(node, b) > 0) { ub = 1; }
    if (ua > ub) { return 1; }
    if (ua < ub) { return 0; }
    return _accel_ranks_before(NodeCapacity_accel_profiles(node), a, b);
}

# The profile `req` would take next, or -1: the first, by _accel_before, of those that
# satisfy it. `room` 1 looks only at profiles with room left for it, and 0 only at those
# without.
fn _accel_pick(node, req, room): i64 {
    var profs = NodeCapacity_accel_profiles(node);
    var n = vec_len(profs);
    var ar = ResourceReq_accel_req(req);
    var chips = ResourceReq_accel_min_chips(req);
    var best = 0 - 1;
    var i = 0;
    while (i < n) {
        var p = vec_get(profs, i);
        if (requirement_satisfied(ar, chips, p) == 1) {
            var fits = 1;
            if (_accel_used_at(node, i) + _accel_units(p, req) > _accel_capacity(p)) { fits = 0; }
            if (fits == room) {
                if (best < 0) { best = i; }
                elif (_accel_before(node, i, best) == 1) { best = i; }
            }
        }
        i = i + 1;
    }
    return best;
}

# How many profiles have room for `req`, counting no further than `most`. Whether a
# node fits needs only this; which profiles are taken needs the ranking.
fn _accel_free(node, req, most): i64 {
    var profs = NodeCapacity_accel_profiles(node);
    var n = vec_len(profs);
    var ar = ResourceReq_accel_req(req);
    var chips = ResourceReq_accel_min_chips(req);
    var free = 0;
    var i = 0;
    while (i < n) {
        var p = vec_get(profs, i);
        if (requirement_satisfied(ar, chips, p) == 1) {
            if (_accel_used_at(node, i) + _accel_units(p, req) <= _accel_capacity(p)) {
                free = free + 1;
                if (free >= most) { return free; }
            }
        }
        i = i + 1;
    }
    return free;
}

# 1 if profile `a` ranks before profile `b` by ai-hwaccel's order alone: highest
# profile_rank, then most memory, then lowest index. What a whole device is chosen by.
fn _accel_ranks_before(profs, a, b): i64 {
    var pa = vec_get(profs, a);
    var pb = vec_get(profs, b);
    if (profile_rank(pa) > profile_rank(pb)) { return 1; }
    if (profile_rank(pa) < profile_rank(pb)) { return 0; }
    if (profile_memory_bytes(pa) > profile_memory_bytes(pb)) { return 1; }
    if (profile_memory_bytes(pa) < profile_memory_bytes(pb)) { return 0; }
    if (a < b) { return 1; }
    return 0;
}

# Sift the heap order[0..n) down from `at`, the root last in rank order.
fn _accel_sift(profs, order, at, n): i64 {
    var root = at;
    var child = root * 2 + 1;
    while (child < n) {
        if (child + 1 < n) {
            if (_accel_ranks_before(profs, vec_get(order, child), vec_get(order, child + 1)) == 1) {
                child = child + 1;
            }
        }
        if (_accel_ranks_before(profs, vec_get(order, root), vec_get(order, child)) == 0) { return 0; }
        var swap = vec_get(order, root);
        vec_set(order, root, vec_get(order, child));
        vec_set(order, child, swap);
        root = child;
        child = root * 2 + 1;
    }
    return 0;
}

# The node's profiles in rank order, sorted again only when the profiles changed. A
# heap sort: it needs the profiles to compare, which vec_sort_by cannot pass, and it
# allocates nothing.
fn _accel_order(node): i64 {
    var profs = NodeCapacity_accel_profiles(node);
    var order = NodeCapacity_accel_order(node);
    if (order == 0) {
        order = vec_new();
        if (order == 0) { panic("samay: out of memory in _accel_order"); }
        NodeCapacity_set_accel_order(node, order);
    }
    var n = vec_len(profs);
    if (vec_len(order) == n) { return order; }
    vec_truncate(order, 0);
    var i = 0;
    while (i < n) {
        vec_push(order, i);
        i = i + 1;
    }
    i = n / 2 - 1;
    while (i >= 0) {
        _accel_sift(profs, order, i, n);
        i = i - 1;
    }
    var end = n - 1;
    while (end > 0) {
        var top = vec_get(order, 0);
        vec_set(order, 0, vec_get(order, end));
        vec_set(order, end, top);
        _accel_sift(profs, order, 0, end);
        end = end - 1;
    }
    return order;
}

fn _accel_take(node, req, at): i64 {
    _accel_add_used(node, at, _accel_units(vec_get(NodeCapacity_accel_profiles(node), at), req));
    var holds = NodeCapacity_accel_holds(node);
    vec_push(holds, req);
    vec_push(holds, at);
    return 0;
}

# Record a reservation's use of devices: the free profiles it needs, first by rank.
# With too few free it takes ones with no room as well, counted past capacity: an old
# snapshot can hold four tasks on one GPU, and losing track of three would offer the
# device again while they run (ADR-0013). Those are taken first, so a free profile
# filled here is not taken twice. A requirement nothing here can serve holds nothing.
#
# Several devices are each whole, so their order is the rank order alone, and one walk
# of it takes them all: picking them one by one cost a walk per device, which made a
# restore quadratic in the devices a task held.
fn _accel_hold(node, req): i64 {
    if (ResourceReq_accel_req(req) == REQ_NONE) { return 0; }
    var want = _req_devices(req);
    var free = _accel_free(node, req, want);
    # A whole device goes by rank alone; only a share also asks what is in use.
    if (_req_share(req) == SAMAY_ACCEL_WHOLE) { return _accel_hold_ranked(node, req, want, free); }
    if (free == 0) {
        var full = _accel_pick(node, req, 0);
        if (full >= 0) { _accel_take(node, req, full); }
        return 0;
    }
    _accel_take(node, req, _accel_pick(node, req, 1));
    return 0;
}

# _accel_hold for whole devices: in rank order, those with no room first, then the free
# ones, as many of each as it needs.
fn _accel_hold_ranked(node, req, want, free): i64 {
    var profs = NodeCapacity_accel_profiles(node);
    var order = _accel_order(node);
    var n = vec_len(order);
    var ar = ResourceReq_accel_req(req);
    var chips = ResourceReq_accel_min_chips(req);
    var room = 0;
    while (room < 2) {
        var left = free;
        if (room == 0) { left = want - free; }
        var k = 0;
        while (k < n) {
            if (left == 0) { break; }
            var i = vec_get(order, k);
            var p = vec_get(profs, i);
            if (requirement_satisfied(ar, chips, p) == 1) {
                var fits = 1;
                if (_accel_used_at(node, i) + _accel_units(p, req) > _accel_capacity(p)) { fits = 0; }
                if (fits == room) {
                    _accel_take(node, req, i);
                    left = left - 1;
                }
            }
            k = k + 1;
        }
        room = room + 1;
    }
    return 0;
}

# Take exactly the profiles in `list` for `req`, as a snapshot recorded them: 1 if
# taken, or 0 with nothing taken if the list does not fit this node. It fits when each
# index is a profile here that satisfies the request, none twice, and there are no more
# than the request takes. Room is not asked: the record is what was held, past capacity
# or not (ADR-0018).
fn _accel_take_listed(node, req, list): i64 {
    var profs = NodeCapacity_accel_profiles(node);
    var n = vec_len(profs);
    var k = vec_len(list);
    # Nothing on record is no record: the devices are chosen as a reservation would.
    if (k == 0) { return 0; }
    if (k > _req_devices(req)) { return 0; }
    var ar = ResourceReq_accel_req(req);
    var chips = ResourceReq_accel_min_chips(req);
    var i = 0;
    while (i < k) {
        var at = vec_get(list, i);
        if (at < 0) { return 0; }
        if (at >= n) { return 0; }
        if (requirement_satisfied(ar, chips, vec_get(profs, at)) == 0) { return 0; }
        var j = 0;
        while (j < i) {
            if (vec_get(list, j) == at) { return 0; }
            j = j + 1;
        }
        i = i + 1;
    }
    i = 0;
    while (i < k) {
        _accel_take(node, req, vec_get(list, i));
        i = i + 1;
    }
    return 1;
}

# Fill `list` with the profile indices this very ResourceReq holds here, lowest first,
# so a snapshot writes them the same way whatever order the holds were made in.
fn _accel_held_list(node, req, list): i64 {
    vec_truncate(list, 0);
    var holds = NodeCapacity_accel_holds(node);
    var n = vec_len(holds);
    var i = 0;
    while (i < n) {
        if (vec_get(holds, i) == req) {
            var at = vec_get(holds, i + 1);
            vec_push(list, at);
            var j = vec_len(list) - 1;
            while (j > 0) {
                if (vec_get(list, j - 1) <= at) { break; }
                vec_set(list, j, vec_get(list, j - 1));
                j = j - 1;
            }
            vec_set(list, j, at);
        }
        i = i + 2;
    }
    return vec_len(list);
}

# 1 if a hold made for `h` would serve `req` alike: same devices, chips and share.
fn _accel_same(h, req): i64 {
    if (ResourceReq_accel_req(h) != ResourceReq_accel_req(req)) { return 0; }
    if (ResourceReq_accel_min_chips(h) != ResourceReq_accel_min_chips(req)) { return 0; }
    if (_req_devices(h) != _req_devices(req)) { return 0; }
    if (_req_share(h) != _req_share(req)) { return 0; }
    return 1;
}

# 1 if this very ResourceReq holds a device here.
fn _accel_owns(node, req): i64 {
    var holds = NodeCapacity_accel_holds(node);
    var n = vec_len(holds);
    var i = 0;
    while (i < n) {
        if (vec_get(holds, i) == req) { return 1; }
        i = i + 2;
    }
    return 0;
}

# The next hold at or after `from` that a release of `req` gives back, or -1. With
# `mine` 1 those are its own holds; with 0, equal ones, for a caller releasing with its
# own copy.
fn _accel_hold_from(node, req, mine, from): i64 {
    var holds = NodeCapacity_accel_holds(node);
    var n = vec_len(holds);
    var i = from;
    while (i < n) {
        var h = vec_get(holds, i);
        if (mine == 1) {
            if (h == req) { return i; }
        } elif (_accel_same(h, req) == 1) { return i; }
        i = i + 2;
    }
    return 0 - 1;
}

# Units a hold has on its profile.
fn _accel_hold_units(node, at): i64 {
    var holds = NodeCapacity_accel_holds(node);
    var p = vec_get(NodeCapacity_accel_profiles(node), vec_get(holds, at + 1));
    return _accel_units(p, vec_get(holds, at));
}

# Give back every hold of `req` here; or, if it has none, as many equal ones as it
# would have taken, for a caller releasing with its own copy.
fn _accel_drop(node, req): i64 {
    if (ResourceReq_accel_req(req) == REQ_NONE) { return 0; }
    var mine = _accel_owns(node, req);
    var left = _req_devices(req);
    var holds = NodeCapacity_accel_holds(node);
    var at = _accel_hold_from(node, req, mine, 0);
    while (at >= 0) {
        if (mine == 0) {
            if (left == 0) { return 0; }
            left = left - 1;
        }
        _accel_add_used(node, vec_get(holds, at + 1), 0 - _accel_hold_units(node, at));
        # Holds have no order, so the last pair fills the gap.
        var n = vec_len(holds);
        vec_set(holds, at, vec_get(holds, n - 2));
        vec_set(holds, at + 1, vec_get(holds, n - 1));
        vec_truncate(holds, n - 2);
        at = _accel_hold_from(node, req, mine, 0);
    }
    return 0;
}

# Add `sign` times what each of `held`'s own holds takes to what its profile has in
# use, and keep the holds. -1 then 1 asks a question and leaves the node as it was.
fn _accel_lend(node, held, sign): i64 {
    var holds = NodeCapacity_accel_holds(node);
    var n = vec_len(holds);
    var i = 0;
    while (i < n) {
        if (vec_get(holds, i) == held) {
            _accel_add_used(node, vec_get(holds, i + 1), sign * _accel_hold_units(node, i));
        }
        i = i + 2;
    }
    return 0;
}

# Accelerator availability check (M3, ADR-0002): delegates to ai-hwaccel's
# requirement_satisfied() over this node's real profiles, and each profile taken must
# also have room. REQ_NONE always fits; any other requirement needs as many profiles
# as it asks for devices, so REQ_GAUDI / REQ_AWS_NEURON / REQ_ANY_ACCELERATOR require
# an actual matching accelerator (vs the Rust port's always-true stub).
fn _accel_ok(req, node): i64 {
    if (ResourceReq_accel_req(req) == REQ_NONE) { return 1; }
    var want = _req_devices(req);
    if (_accel_free(node, req, want) < want) { return 0; }
    return 1;
}

# 1 if `required` cores fit in `available`. The margin is 1e-9 of a core: f64 sums
# are inexact, and 0.3 + 0.3 + 0.3 + 0.1 of one core must not leave the last 0.1
# short by a rounding error.
var _CPU_MARGIN = 0x3E112E0BE826D695;

fn _cpu_short(available, required): i64 {
    return f64_lt(f64_add(available, _CPU_MARGIN), required);
}

# True (1) if this node can fit the given resource requirements.
fn node_capacity_can_fit(node, req): i64 {
    if (_cpu_short(NodeCapacity_available_cpu(node), ResourceReq_cpu_cores(req)) == 1) { return 0; }
    if (NodeCapacity_available_memory_mb(node) < ResourceReq_memory_mb(req)) { return 0; }
    if (_accel_ok(req, node) != 1) { return 0; }
    if (NodeCapacity_available_disk_mb(node) < ResourceReq_disk_mb(req)) { return 0; }
    return 1;
}

# Utilization ratio 0.0-1.0 (average of CPU and memory) as an f64.
fn node_capacity_utilization(node): i64 {
    var total_cpu = NodeCapacity_total_cpu(node);
    var total_mem = NodeCapacity_total_memory_mb(node);
    if (f64_eq(total_cpu, f64_from(0)) == 1) {
        if (total_mem == 0) { return f64_from(0); }
    }
    var cpu_util = f64_from(0);
    if (f64_gt(total_cpu, f64_from(0)) == 1) {
        cpu_util = f64_sub(f64_from(1), f64_div(NodeCapacity_available_cpu(node), total_cpu));
    }
    var mem_util = f64_from(0);
    if (total_mem > 0) {
        mem_util = f64_sub(f64_from(1), f64_div(f64_from(NodeCapacity_available_memory_mb(node)), f64_from(total_mem)));
    }
    return f64_div(f64_add(cpu_util, mem_util), f64_from(2));
}

# The lowest an amount goes: far below anything real, and far enough above i64's floor
# that adding to it or taking from it cannot wrap.
var _CAPACITY_FLOOR = 0 - 4611686018427387904;

# What is left once `held` is taken, below zero if the node is over-committed: a
# replayed reservation takes what its task holds whether or not it fits. Through 1.5.0
# this stopped at zero, so the next release gave back more than was there and the node
# was sold twice (ADR-0007).
fn _capacity_taken(available, held): i64 {
    if (available >= 0) {
        var left = available - held;
        if (left < _CAPACITY_FLOOR) { return _CAPACITY_FLOOR; }
        return left;
    }
    if (held > available - _CAPACITY_FLOOR) { return _CAPACITY_FLOOR; }
    return available - held;
}

# The cores left once `held` is taken. A reservation that fits, as can_fit counts it,
# leaves no less than zero, as through 1.5.0: f64 rounding can put it a hair below.
# One that does not fit is a replayed over-commitment, and goes below zero. NaN is none.
fn _cpu_taken(available, held): i64 {
    var c = f64_sub(available, held);
    if (f64_eq(c, c) == 0) { return f64_from(0); }
    if (_cpu_short(available, held) == 0) {
        if (f64_lt(c, f64_from(0)) == 1) { return f64_from(0); }
    }
    return c;
}

# Reserve a task's cores, memory and disk, and count it.
fn _reserve_amounts(node, req): i64 {
    NodeCapacity_set_available_cpu(node, _cpu_taken(NodeCapacity_available_cpu(node), ResourceReq_cpu_cores(req)));
    var mem = _capacity_taken(NodeCapacity_available_memory_mb(node), ResourceReq_memory_mb(req));
    NodeCapacity_set_available_memory_mb(node, mem);
    var disk = _capacity_taken(NodeCapacity_available_disk_mb(node), ResourceReq_disk_mb(req));
    NodeCapacity_set_available_disk_mb(node, disk);
    var rt = NodeCapacity_running_tasks(node);
    if (rt < 9223372036854775807) { NodeCapacity_set_running_tasks(node, rt + 1); }
    return 0;
}

# Reserve resources for a task.
fn node_capacity_reserve(node, req): i64 {
    _reserve_amounts(node, req);
    _accel_hold(node, req);
    return 0;
}

# Reserve as a record says: the devices `list` names if they fit this node, else as
# node_capacity_reserve picks them. 1 if the record was used (ADR-0018).
fn _reserve_listed(node, req, list): i64 {
    _reserve_amounts(node, req);
    if (ResourceReq_accel_req(req) == REQ_NONE) { return 1; }
    if (_accel_take_listed(node, req, list) == 1) { return 1; }
    _accel_hold(node, req);
    return 0;
}

# What is available once `held` comes back, capped at total. The cap is tested
# before adding: a restored reservation can be any size up to i64 max, and the
# plain sum wraps negative, which no `> total` check can catch. Below zero, the sum
# cannot wrap (_capacity_taken keeps it above _CAPACITY_FLOOR).
fn _capacity_returned(available, held, total): i64 {
    if (available < 0) {
        var back = available + held;
        if (back > total) { return total; }
        return back;
    }
    if (held >= total - available) { return total; }
    return available + held;
}

# Release resources after a task completes.
fn node_capacity_release(node, req): i64 {
    var rel_cpu = f64_add(NodeCapacity_available_cpu(node), ResourceReq_cpu_cores(req));
    NodeCapacity_set_available_cpu(node, _f64_min(rel_cpu, NodeCapacity_total_cpu(node)));
    NodeCapacity_set_available_memory_mb(node, _capacity_returned(NodeCapacity_available_memory_mb(node),
        ResourceReq_memory_mb(req), NodeCapacity_total_memory_mb(node)));
    NodeCapacity_set_available_disk_mb(node, _capacity_returned(NodeCapacity_available_disk_mb(node),
        ResourceReq_disk_mb(req), NodeCapacity_total_disk_mb(node)));
    var rt = NodeCapacity_running_tasks(node) - 1;
    if (rt < 0) { rt = 0; }
    NodeCapacity_set_running_tasks(node, rt);
    _accel_drop(node, req);
    # An idle node is a full node (ADR-0007). f64 sums round, so giving back 0.1 and
    # 0.2 can stop one bit short of the total, and that bit would refuse a whole-node
    # task on an idle node forever.
    if (rt == 0) { NodeCapacity_set_available_cpu(node, NodeCapacity_total_cpu(node)); }
    return 0;
}

# Would `req` fit on this node once `held`, a reservation here, was gone? Changes
# nothing, which is why it is not a release and a reserve: those would round cpu.
fn _fits_without(node, held, req): i64 {
    var cpu = f64_add(NodeCapacity_available_cpu(node), ResourceReq_cpu_cores(held));
    cpu = _f64_min(cpu, NodeCapacity_total_cpu(node));
    if (_cpu_short(cpu, ResourceReq_cpu_cores(req)) == 1) { return 0; }
    var mem = _capacity_returned(NodeCapacity_available_memory_mb(node),
      ResourceReq_memory_mb(held), NodeCapacity_total_memory_mb(node));
    if (mem < ResourceReq_memory_mb(req)) { return 0; }
    var disk = _capacity_returned(NodeCapacity_available_disk_mb(node),
      ResourceReq_disk_mb(held), NodeCapacity_total_disk_mb(node));
    if (disk < ResourceReq_disk_mb(req)) { return 0; }
    if (ResourceReq_accel_req(req) == REQ_NONE) { return 1; }
    _accel_lend(node, held, 0 - 1);
    var ok = _accel_ok(req, node);
    _accel_lend(node, held, 1);
    return ok;
}

# ---------------------------------------------------------------------------
# SchedulingDecision / PreemptionAction / SchedulerStats
# ---------------------------------------------------------------------------

#derive(accessors)
#derive(Serialize)
struct SchedulingDecision {
    task_id: Str;
    assigned_node: Str;
    reason: Str;
    score: f64;
}

fn scheduling_decision_new(task_id, assigned_node, reason, score): i64 {
    var p = alloc(32);
    if (p == 0) { panic("samay: out of memory in scheduling_decision_new"); }
    SchedulingDecision_set_task_id(p, _samay_own_req(task_id, "samay: out of memory in scheduling_decision_new"));
    SchedulingDecision_set_assigned_node(p,
      _samay_own_req(assigned_node, "samay: out of memory in scheduling_decision_new"));
    SchedulingDecision_set_reason(p, _samay_own_req(reason, "samay: out of memory in scheduling_decision_new"));
    SchedulingDecision_set_score(p, score);
    return p;
}

#derive(accessors)
#derive(Serialize)
struct PreemptionAction {
    preempted_task_id: Str;
    preempting_task_id: Str;
    reason: Str;
}

fn preemption_action_new(preempted_task_id, preempting_task_id, reason): i64 {
    var p = alloc(24);
    # NOT `return 0`: 0 is already a live value one frame up with an
    # incompatible meaning -- task_scheduler_preempt_if_needed returns 0 for
    # "no candidate needs preempting" and forwards this
    # pointer as the affirmative answer. An OOM-0 would be indistinguishable
    # from "nothing to preempt", and the tests assert exactly
    # that equality -- so they would PASS on an OOM. See ADR-0009.
    if (p == 0) { panic("samay: out of memory in preemption_action_new"); }
    PreemptionAction_set_preempted_task_id(p,
      _samay_own_req(preempted_task_id, "samay: out of memory in preemption_action_new"));
    PreemptionAction_set_preempting_task_id(p,
      _samay_own_req(preempting_task_id, "samay: out of memory in preemption_action_new"));
    PreemptionAction_set_reason(p, _samay_own_req(reason, "samay: out of memory in preemption_action_new"));
    return p;
}

#derive(accessors)
#derive(Serialize)
struct SchedulerStats {
    total_tasks: i64;
    queued: i64;
    running: i64;
    completed: i64;
    failed: i64;
    average_wait_time_ms: i64;
    average_run_time_ms: i64;
}

fn scheduler_stats_new(): i64 {
    var p = alloc(56);
    if (p == 0) { panic("samay: out of memory in scheduler_stats_new"); }
    SchedulerStats_set_total_tasks(p, 0);
    SchedulerStats_set_queued(p, 0);
    SchedulerStats_set_running(p, 0);
    SchedulerStats_set_completed(p, 0);
    SchedulerStats_set_failed(p, 0);
    SchedulerStats_set_average_wait_time_ms(p, 0);
    SchedulerStats_set_average_run_time_ms(p, 0);
    return p;
}

# --- scheduler.cyr ---

# scheduler.cyr — the core distributed task scheduler (Rust TaskScheduler).
#
# THREAD SAFETY: none. One TaskScheduler is owned by one thread at a time.
# Every mutating call is an unsynchronised read-modify-write, and the query
# functions hand out raw pointers into scheduler-owned structs, so an internal
# lock could not make this safe (ADR-0008). Serialise externally if you need
# concurrent access. Measured under 8 concurrent threads: 73% of node
# reservations lost, and the tasks hashmap's own size field left disagreeing
# with its contents.
#
# tasks/nodes are Str-keyed hashmaps (map_new_str) of heap struct pointers.
# Str keys hash by content (hash_str_v) and compare via str_eq, so a lookup
# by an equal-but-distinct Str works.
# Anything that runs on every pass walks the table with _map_slot rather than
# calling map_values, which copies. Pending tasks are sorted by priority desc,
# then created_at asc, matching Rust's sort_by.
# Requires: hashmap, vec, str, string, chrono, result + types.cyr.

# orphans: restored tasks holding a node the snapshot did not have, which that node is
# charged for when it registers (1.5.1).
#derive(accessors)
struct TaskScheduler {
    tasks: i64;
    nodes: i64;
    pending_scratch: i64;
    orphans: i64;
}

fn task_scheduler_new(): i64 {
    var s = alloc(32);
    if (s == 0) { panic("samay: out of memory in task_scheduler_new"); }
    # map_new_str returns 0 on OOM (lib/hashmap.cyr) WITHOUT aborting --
    # unlike map_set/_map_grow, which abort via _hm_die. The stdlib is
    # inconsistent here and samay inherits the quiet half: a scheduler with
    # both fields null survives construction and dies later inside map_set.
    var tasks = map_new_str();
    if (tasks == 0) { panic("samay: out of memory in task_scheduler_new (tasks map)"); }
    var nodes = map_new_str();
    if (nodes == 0) { panic("samay: out of memory in task_scheduler_new (nodes map)"); }
    TaskScheduler_set_tasks(s, tasks);
    TaskScheduler_set_nodes(s, nodes);
    # Reused by every schedule_pending, so an idle pass allocates no list of its own.
    var scratch = vec_new();
    if (scratch == 0) { panic("samay: out of memory in task_scheduler_new (scratch)"); }
    TaskScheduler_set_pending_scratch(s, scratch);
    TaskScheduler_set_orphans(s, 0);
    return s;
}

# --- ordering ---
#
# Every sort here is lib/vec.cyr's vec_sort_by with one of these comparators. It
# allocates nothing, which matters because alloc() never frees and these run on
# every pass. It is not stable, and need not be: each comparator ends on a unique
# key, so each is a total order with exactly one sorted result (ADR-0004, ADR-0011).

# Scheduling order: higher priority first, then earlier created_at (Rust sort_by),
# then — the determinism tie-break the Rust HashMap left to iteration order —
# smaller task_id.
fn _task_cmp(a, b): i64 {
    var pa = ScheduledTask_priority(a);
    var pb = ScheduledTask_priority(b);
    if (pa > pb) { return 0 - 1; }
    if (pa < pb) { return 1; }
    var ca = ScheduledTask_created_at(a);
    var cb = ScheduledTask_created_at(b);
    if (ca < cb) { return 0 - 1; }
    if (ca > cb) { return 1; }
    return _samay_str_cmp(ScheduledTask_task_id(a), ScheduledTask_task_id(b));
}

# By task_id: gives `tasks_for_node` a deterministic order (Rust returned raw
# HashMap iteration order).
fn _task_id_cmp(a, b): i64 {
    return _samay_str_cmp(ScheduledTask_task_id(a), ScheduledTask_task_id(b));
}

fn _node_id_cmp(a, b): i64 {
    return _samay_str_cmp(NodeCapacity_node_id(a), NodeCapacity_node_id(b));
}

# The order tasks were placed in: scheduled_at, then the unique task_id.
fn _placement_cmp(a, b): i64 {
    var sa = ScheduledTask_scheduled_at(a);
    var sb = ScheduledTask_scheduled_at(b);
    if (sa < sb) { return 0 - 1; }
    if (sa > sb) { return 1; }
    return _task_id_cmp(a, b);
}

# Every task holding a reservation, in the order they were placed. That includes a
# finished task the next pass has not reconciled yet: until then it is still charged.
fn _holding_tasks(s): i64 {
    var tasks = TaskScheduler_tasks(s);
    var cap = map_cap(tasks);
    var out = vec_new();
    if (out == 0) { panic("samay: out of memory in _holding_tasks"); }
    var i = 0;
    while (i < cap) {
        var t = _map_slot(tasks, i);
        if (t != 0) {
            if (ScheduledTask_reserved_on(t) != 0) { vec_push(out, t); }
        }
        i = i + 1;
    }
    vec_sort_by(out, &_placement_cmp);
    return out;
}

# --- registration / submission / lookup ---

fn _log_empty_node_id(): i64 {
    var msg = str_from("node refused: an empty id, which no snapshot could restore");
    sakshi_warn(str_data(msg), str_len(msg));
    return 0;
}

# Register a node: 0, or 1 if its id is empty, which restore drops and so must be
# refused here too (1.4.5). An id already known replaces its description, which is
# what a node agent reconnecting does, so what its tasks hold is carried onto the new
# one. Through 1.4.2 the replacement came up empty, and the same capacity was sold twice.
# Each task keeps the devices it held, by index, where the new description still has
# them; picking them again could put two tasks on one device (1.5.1, ADR-0018). A node
# that restored tasks already hold, missing from their snapshot, is charged for them.
fn task_scheduler_register_node(s, node): i64 {
    var nodes = TaskScheduler_nodes(s);
    var id = NodeCapacity_node_id(node);
    if (id == 0) {
        _log_empty_node_id();
        return 1;
    }
    if (str_len(id) == 0) {
        _log_empty_node_id();
        return 1;
    }
    var was = map_get(nodes, id);
    map_set(nodes, id, node);
    if (was == node) { return 0; }
    if (was == 0) {
        if (TaskScheduler_orphans(s) == 0) { return 0; }
    }
    var held = _holding_tasks(s);
    var n = vec_len(held);
    var list = vec_new();
    if (list == 0) { panic("samay: out of memory in task_scheduler_register_node"); }
    var found = 0;
    var i = 0;
    while (i < n) {
        var t = vec_get(held, i);
        if (str_eq(ScheduledTask_reserved_on(t), id) == 1) {
            var req = ScheduledTask_resource_requirements(t);
            if (was != 0) {
                _accel_held_list(was, req, list);
                _reserve_listed(node, req, list);
            } else {
                node_capacity_reserve(node, req);
                found = found + 1;
            }
        }
        i = i + 1;
    }
    if (was == 0) { TaskScheduler_set_orphans(s, TaskScheduler_orphans(s) - found); }
    return 0;
}

# Submit a task; returns Ok(task_id), or Err(1) if that id is already here. Replacing
# a task would orphan whatever it holds, past anything that could release it.
fn task_scheduler_submit_task(s, task): i64 {
    var id = ScheduledTask_task_id(task);
    if (map_has(TaskScheduler_tasks(s), id) == 1) { return Err(1); }
    map_set(TaskScheduler_tasks(s), id, task);
    return Ok(id);
}

# Get a task pointer by id, or 0 if absent.
fn task_scheduler_get_task(s, id): i64 {
    return map_get(TaskScheduler_tasks(s), id);
}

# Return the node capacity a task is currently holding, if any. Keyed on
# `reserved_on` (not `assigned_node`, which outlives the reservation), and
# clears it afterwards — so calling this twice is a no-op rather than a double
# release.
fn _release_task_node(s, task): i64 {
    var ron = ScheduledTask_reserved_on(task);
    if (ron != 0) {
        var node = map_get(TaskScheduler_nodes(s), ron);
        if (node != 0) {
            node_capacity_release(node, ScheduledTask_resource_requirements(task));
        }
        ScheduledTask_set_reserved_on(task, 0);
    }
    return 0;
}

# A reservation is held only while a task is SCHEDULED or RUNNING. Return the
# capacity of every task that has left that set without releasing.
#
# Before v1.0.3 the only release was in cancel_task, so an ordinary COMPLETED
# task held its node's capacity forever: two successful completions retired an
# 8-core node permanently, while stats reported 0 running (ADR-0007).
#
# This reconciles rather than hooking the transition because
# scheduled_task_transition is public — a consumer can drive a task terminal
# without calling any scheduler API, so a hook would leave the hole open.
#
# Releases run in task_id order, not map order. Capacity is f64, and once a sum
# crosses a power of two the order of the adds changes the result. Map order changes
# with the per-process hash seed, so through 1.3.0 the same schedule left different
# low bits in available_cpu from run to run (ADR-0004, ADR-0011). The vec is made only
# when something needs releasing, so a normal pass allocates nothing here.
fn _reconcile_reservations(s): i64 {
    var tasks = TaskScheduler_tasks(s);
    var cap = map_cap(tasks);
    var stale = 0;
    var i = 0;
    while (i < cap) {
        var t = _map_slot(tasks, i);
        if (t != 0) {
            if (ScheduledTask_reserved_on(t) != 0) {
                var st = ScheduledTask_status(t);
                if (st != TASK_SCHEDULED) {
                    if (st != TASK_RUNNING) {
                        if (stale == 0) {
                            stale = vec_new();
                            if (stale == 0) { panic("samay: out of memory in _reconcile_reservations"); }
                        }
                        vec_push(stale, t);
                    }
                }
            }
        }
        i = i + 1;
    }
    if (stale == 0) { return 0; }
    vec_sort_by(stale, &_task_id_cmp);
    var n = vec_len(stale);
    i = 0;
    while (i < n) {
        _release_task_node(s, vec_get(stale, i));
        i = i + 1;
    }
    return 0;
}

# Cancel a task. Ok(0) on success, Err(1) if not found or bad transition.
fn task_scheduler_cancel_task(s, id): i64 {
    var task = map_get(TaskScheduler_tasks(s), id);
    if (task == 0) { return Err(1); }
    var r_t, r_v = scheduled_task_transition(task, TASK_CANCELLED);
    if (is_err_result(r_t) == 1) { return Err(r_v); }
    # Release only once the transition is accepted, so a rejected cancel
    # cannot hand back capacity the task is still using.
    _release_task_node(s, task);
    return Ok(0);
}

# Finish a task and return its node reservation immediately. `final_status`
# must be TASK_COMPLETED or TASK_FAILED. Ok(0) on success; Err(1) unknown id;
# Err(2) non-terminal final_status; otherwise the transition's own Err.
#
# Added in v1.0.3 — there was previously no scheduler-level completion path at
# all, so consumers called scheduled_task_transition directly and the capacity
# was never returned. _reconcile_reservations still covers that route; this
# releases at the moment of completion instead of at the next
# schedule_pending, and makes the intended path the obvious one.
fn task_scheduler_complete_task(s, id, final_status): i64 {
    var task = map_get(TaskScheduler_tasks(s), id);
    if (task == 0) { return Err(1); }
    if (final_status != TASK_COMPLETED) {
        if (final_status != TASK_FAILED) { return Err(2); }
    }
    var r_t, r_v = scheduled_task_transition(task, final_status);
    if (is_err_result(r_t) == 1) { return Err(r_v); }
    _release_task_node(s, task);
    return Ok(0);
}

# --- restore ---
#
# A snapshot states each node's capacity and each task's reservation, and nothing
# makes the two agree. The tasks are the record of who holds what, so restore checks
# the nodes against them. Through 1.4.2 it trusted the nodes, and capacity leaked by
# a 1.0.2 build stayed lost for good (ADR-0007).

fn _log_capacity_rebuilt(id): i64 {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "node '");
    _samay_log_add(sb, id, 128);
    str_builder_add_cstr(sb, "': snapshot capacity disagrees with its tasks; rebuilt from them");
    var msg = str_builder_build(sb);
    sakshi_warn(str_data(msg), str_len(msg));
    return 0;
}

# By node, then in placement order.
fn _held_cmp(a, b): i64 {
    var c = _samay_str_cmp(ScheduledTask_reserved_on(a), ScheduledTask_reserved_on(b));
    if (c != 0) { return c; }
    return _placement_cmp(a, b);
}

fn _log_devices_rechosen(id): i64 {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "node '");
    _samay_log_add(sb, id, 128);
    str_builder_add_cstr(sb, "': a task's recorded devices do not fit it; chosen again");
    var msg = str_builder_build(sb);
    sakshi_warn(str_data(msg), str_len(msg));
    return 0;
}

# Replay held[from..to), all this node's, through reserve, which rebuilds its device
# holds too: as `recorded` lists them where a task's are on record (a map of task id to
# profile indices, or 0), else picked in placement order (ADR-0018). A node that agrees
# keeps the bits it came with, so a good snapshot writes back byte for byte: f64 sums
# depend on order, and this is not the order they ran in.
fn _settle_node(node, held, from, to, recorded): i64 {
    var cpu = NodeCapacity_available_cpu(node);
    var mem = NodeCapacity_available_memory_mb(node);
    var disk = NodeCapacity_available_disk_mb(node);
    var rt = NodeCapacity_running_tasks(node);
    NodeCapacity_set_available_cpu(node, NodeCapacity_total_cpu(node));
    NodeCapacity_set_available_memory_mb(node, NodeCapacity_total_memory_mb(node));
    NodeCapacity_set_available_disk_mb(node, NodeCapacity_total_disk_mb(node));
    NodeCapacity_set_running_tasks(node, 0);
    var i = from;
    while (i < to) {
        var t = vec_get(held, i);
        var req = ScheduledTask_resource_requirements(t);
        var list = 0;
        if (recorded != 0) { list = map_get(recorded, ScheduledTask_task_id(t)); }
        if (list == 0) {
            node_capacity_reserve(node, req);
        } elif (_reserve_listed(node, req, list) == 0) {
            _log_devices_rechosen(NodeCapacity_node_id(node));
        }
        i = i + 1;
    }
    var agree = 1;
    if (NodeCapacity_available_memory_mb(node) != mem) { agree = 0; }
    if (NodeCapacity_available_disk_mb(node) != disk) { agree = 0; }
    if (NodeCapacity_running_tasks(node) != rt) { agree = 0; }
    var gap = f64_sub(NodeCapacity_available_cpu(node), cpu);
    if (f64_gt(gap, _CPU_SETTLE) == 1) { agree = 0; }
    if (f64_lt(gap, f64_sub(f64_from(0), _CPU_SETTLE)) == 1) { agree = 0; }
    if (agree == 1) {
        NodeCapacity_set_available_cpu(node, cpu);
    } else {
        _log_capacity_rebuilt(NodeCapacity_node_id(node));
    }
    return 0;
}

# 1e-6 of a core: well past any rounding a real snapshot's sums can carry.
var _CPU_SETTLE = 0x3EB0C6F7A0B5ED8D;

# Bring every node into line with the tasks. A task placed and running that lost its
# reservation still occupies its node, so it gets it back first. `recorded` maps task
# ids to the devices a snapshot says they hold, or is 0.
fn _settle_capacity(s, recorded): i64 {
    var tasks = TaskScheduler_tasks(s);
    var cap = map_cap(tasks);
    var t = 0;
    while (t < cap) {
        var task = _map_slot(tasks, t);
        if (task != 0) {
            if (ScheduledTask_reserved_on(task) == 0) {
                var st = ScheduledTask_status(task);
                if (st == TASK_SCHEDULED) { ScheduledTask_set_reserved_on(task, ScheduledTask_assigned_node(task)); }
                elif (st == TASK_RUNNING) { ScheduledTask_set_reserved_on(task, ScheduledTask_assigned_node(task)); }
            }
        }
        t = t + 1;
    }
    var held = _holding_tasks(s);
    vec_sort_by(held, &_held_cmp);
    var hn = vec_len(held);
    var nodes = map_values(TaskScheduler_nodes(s));
    vec_sort_by(nodes, &_node_id_cmp);
    var h = 0;
    var matched = 0;
    var orphans = 0;
    var i = 0;
    while (i < vec_len(nodes)) {
        var node = vec_get(nodes, i);
        var id = NodeCapacity_node_id(node);
        # Both are sorted by node id, so this walks them together. A reservation on a
        # node the snapshot does not have matches nothing and is passed over.
        while (h < hn) {
            if (_samay_str_cmp(ScheduledTask_reserved_on(vec_get(held, h)), id) >= 0) { break; }
            h = h + 1;
        }
        orphans = orphans + h - matched;
        var from = h;
        while (h < hn) {
            if (_samay_str_cmp(ScheduledTask_reserved_on(vec_get(held, h)), id) != 0) { break; }
            h = h + 1;
        }
        matched = h;
        _settle_node(node, held, from, h, recorded);
        i = i + 1;
    }
    # What is left holds a node the snapshot does not have; registering it charges them.
    TaskScheduler_set_orphans(s, orphans + hn - matched);
    return 0;
}

# --- removal ---

# 1 once a task cannot run again. PREEMPTED is not finished: it goes back to QUEUED.
fn _task_is_finished(t): i64 {
    var st = ScheduledTask_status(t);
    if (st == TASK_COMPLETED) { return 1; }
    if (st == TASK_FAILED) { return 1; }
    if (st == TASK_CANCELLED) { return 1; }
    return 0;
}

# Forget a finished task. Ok(0) on success; Err(1) unknown id; Err(2) not finished.
#
# An unfinished task is refused, so cancel it first: a running task is still using
# its node, and removing it would hand that capacity to something else. A finished
# task can still hold a reservation if a consumer drove it there through
# scheduled_task_transition, so this returns it.
#
# Removal takes a task off every later pass and out of snapshots. Its memory stays
# allocated, because alloc() never frees.
fn task_scheduler_remove_task(s, id): i64 {
    var task = map_get(TaskScheduler_tasks(s), id);
    if (task == 0) { return Err(1); }
    if (_task_is_finished(task) == 0) { return Err(2); }
    _release_task_node(s, task);
    map_delete(TaskScheduler_tasks(s), id);
    return Ok(0);
}

# Forget every finished task that completed before `before_ns`, and return how many
# went. Only the caller decides this: samay never prunes on its own, and takes the
# time as an argument, as cron_scheduler_check_due_at does, so the same schedule at
# the same time prunes the same tasks. A task with no completed_at, which only an old
# snapshot can hold, counts as the oldest.
#
# task_scheduler_stats counts the tasks it can see, so its totals drop by what goes.
fn task_scheduler_prune_terminal(s, before_ns): i64 {
    var all = map_values(TaskScheduler_tasks(s));
    # task_id order, for the reason _reconcile_reservations gives.
    vec_sort_by(all, &_task_id_cmp);
    var removed = 0;
    var n = vec_len(all);
    var i = 0;
    while (i < n) {
        var t = vec_get(all, i);
        if (_task_is_finished(t) == 1) {
            if (ScheduledTask_completed_at(t) < before_ns) {
                _release_task_node(s, t);
                map_delete(TaskScheduler_tasks(s), ScheduledTask_task_id(t));
                removed = removed + 1;
            }
        }
        i = i + 1;
    }
    return removed;
}

# --- queries ---

# Fill `out` with the pending tasks, sorted.
fn _collect_pending(s, out): i64 {
    var tasks = TaskScheduler_tasks(s);
    var cap = map_cap(tasks);
    var i = 0;
    while (i < cap) {
        var t = _map_slot(tasks, i);
        if (t != 0) {
            if (ScheduledTask_status(t) == TASK_QUEUED) { vec_push(out, t); }
        }
        i = i + 1;
    }
    vec_sort_by(out, &_task_cmp);
    return 0;
}

# Pending (Queued) tasks, sorted by priority desc then created_at asc.
fn task_scheduler_pending_tasks(s): i64 {
    var out = vec_new();
    if (out == 0) { panic("samay: out of memory in task_scheduler_pending_tasks"); }
    _collect_pending(s, out);
    return out;
}

# Tasks on a node (Scheduled|Running with matching node_preference). That name
# rather than assigned_node, so a task a consumer drove to Scheduled itself,
# without schedule_pending, is still listed on the node it asked for.
fn task_scheduler_tasks_for_node(s, node_id): i64 {
    var tasks = TaskScheduler_tasks(s);
    var cap = map_cap(tasks);
    var out = vec_new();
    if (out == 0) { panic("samay: out of memory in task_scheduler_tasks_for_node"); }
    var i = 0;
    while (i < cap) {
        var t = _map_slot(tasks, i);
        if (t != 0) {
            var np = ScheduledTask_node_preference(t);
            if (np != 0) {
                if (str_eq(np, node_id) == 1) {
                    var st = ScheduledTask_status(t);
                    if (st == TASK_SCHEDULED) { vec_push(out, t); }
                    elif (st == TASK_RUNNING) { vec_push(out, t); }
                }
            }
        }
        i = i + 1;
    }
    vec_sort_by(out, &_task_id_cmp);
    return out;
}

# 1 if a node has any profile that is not a CPU, in use or not (ADR-0017).
fn _node_has_accel(node): i64 {
    var profs = NodeCapacity_accel_profiles(node);
    var n = vec_len(profs);
    var i = 0;
    while (i < n) {
        if (profile_accel_type(vec_get(profs, i)) != ACCEL_CPU) { return 1; }
        i = i + 1;
    }
    return 0;
}

# Node with the most available capacity (lowest utilization) that fits req;
# returns its node_id Str, or 0 if none fits. This runs once per pending task, so
# it walks the table: at 500 nodes x 2000 pending tasks, a map_values here was
# 16.4 MB of unreclaimable bump-allocator traffic per schedule_pending.
#
# Work that needs no accelerator goes to a node without one first, so it does not
# take the cores and memory accelerator work needs there (ADR-0017).
fn _best_fit_node(nodes, req): i64 {
    var cpu_work = 0;
    if (ResourceReq_accel_req(req) == REQ_NONE) { cpu_work = 1; }
    var cap = map_cap(nodes);
    var best = 0;
    var best_util = f64_from(0);
    var best_kind = 0;
    var i = 0;
    while (i < cap) {
        var node = _map_slot(nodes, i);
        if (node != 0) {
            if (node_capacity_can_fit(node, req) == 1) {
                var u = node_capacity_utilization(node);
                # Every IEEE comparison against NaN is false, so a NaN utilization
                # would fail both f64_lt and f64_eq and skip the ADR-0004
                # tie-break entirely, letting table order pick the winner. Treat
                # NaN as fully-utilised (worst) so it never wins.
                if (_f64_is_finite(u) == 0) { u = f64_from(1); }
                var take = 0;
                if (best == 0) { take = 1; }
                elif (f64_lt(u, best_util) == 1) { take = 1; }
                elif (f64_eq(u, best_util) == 1) {
                    if (samay_str_lt(NodeCapacity_node_id(node), NodeCapacity_node_id(best)) == 1) { take = 1; }
                }
                # A node's kind is looked up only where it can change the answer: a node
                # with an accelerator never beats one without, whatever its use.
                var kind = best_kind;
                if (cpu_work == 1) {
                    if (best == 0) { kind = _node_has_accel(node); }
                    elif (best_kind == 0) {
                        if (take == 1) {
                            if (vec_len(NodeCapacity_accel_profiles(node)) > 0) {
                                if (_node_has_accel(node) == 1) { take = 0; }
                            }
                        }
                    } else {
                        kind = _node_has_accel(node);
                        if (kind == 0) { take = 1; }
                    }
                }
                if (take == 1) {
                    best = node;
                    best_util = u;
                    best_kind = kind;
                }
            }
        }
        i = i + 1;
    }
    if (best == 0) { return 0; }
    return NodeCapacity_node_id(best);
}

# --- scheduling ---

# Schedule all pending tasks onto available nodes; returns a vec of
# SchedulingDecision pointers.
# No node could satisfy a pending task's requirements. Mirrors the oracle's
# warn!("no node with sufficient capacity").
#
# A stuck task logs on every pass, so the line is built on the stack: a builder
# here cost 313 bytes per stuck task per pass, never freed. A task_id that is not
# one of samay's own UUIDs can be any length after a restore, so it is cut at 128.
fn _log_no_capacity(task_id): i64 {
    var msg[176];
    var n = str_len(task_id);
    if (n > 128) { n = 128; }
    memcpy(&msg, "task '", 6);
    memcpy(&msg + 6, str_data(task_id), n);
    # A control byte, a newline above all, is shown as '?' so it cannot start a line.
    var i = 0;
    while (i < n) {
        var c = load8(&msg + 6 + i);
        if (c < 32) { store8(&msg + 6 + i, 63); }
        if (c == 127) { store8(&msg + 6 + i, 63); }
        i = i + 1;
    }
    memcpy(&msg + 6 + n, "': no node with sufficient capacity", 35);
    sakshi_warn(&msg, n + 41);
    return 0;
}

# --- what a pass already knows fits nowhere (ADR-0015) ---
#
# A pass only fills nodes: each placement takes capacity and devices, and nothing
# comes back until the next pass reconciles. So a requirement that fit no node earlier
# in the pass fits none later, and neither does one asking for the same. The pass
# records each requirement that fit nowhere, and refuses the next one like it without
# walking the nodes, because most queues repeat a few shapes. It also takes the most
# cpu, memory and disk free on any one node, and refuses outright what asks for more.
# Both skip only a walk that would have found nothing, so every decision is the one
# a full walk makes.
#
# The record lives on the pass's own stack: 1,024 slots of requirement pointers,
# probed linearly and filled to half at most, then its count and the three limits. A
# shape past the 512th is walked for every task, as before.

var _KNOWN_SLOTS = 1024;
var _KNOWN_MOST = 512;
var _KNOWN_COUNT = 8192;
var _KNOWN_CPU = 8200;
var _KNOWN_MEM = 8208;
var _KNOWN_DISK = 8216;

# +Inf: no cpu limit. A NaN available cpu fails every comparison, so can_fit lets any
# requirement past it, and the limit has to do the same.
var _CPU_UNBOUNDED = 0x7FF0000000000000;

# Equal in everything can_fit reads, so equal in what it answers on every node.
# f64_eq makes 0 and -0 one shape, which can_fit cannot tell apart either, and a
# NaN no shape at all, which only costs a walk.
fn _same_shape(a, b): i64 {
    if (f64_eq(ResourceReq_cpu_cores(a), ResourceReq_cpu_cores(b)) == 0) { return 0; }
    if (ResourceReq_memory_mb(a) != ResourceReq_memory_mb(b)) { return 0; }
    if (ResourceReq_accel_req(a) != ResourceReq_accel_req(b)) { return 0; }
    if (ResourceReq_accel_min_chips(a) != ResourceReq_accel_min_chips(b)) { return 0; }
    if (ResourceReq_disk_mb(a) != ResourceReq_disk_mb(b)) { return 0; }
    if (ResourceReq_accel_devices(a) != ResourceReq_accel_devices(b)) { return 0; }
    if (ResourceReq_accel_share(a) != ResourceReq_accel_share(b)) { return 0; }
    return 1;
}

# Where a shape's probe starts. Equal shapes start in the same place, since f64_to
# gives 0 and -0 the same integer.
fn _shape_slot(req): i64 {
    var h = f64_to(f64_mul(ResourceReq_cpu_cores(req), f64_from(1024)));
    h = h * 31 + ResourceReq_memory_mb(req);
    h = h * 31 + ResourceReq_accel_req(req);
    h = h * 31 + ResourceReq_accel_min_chips(req);
    h = h * 31 + ResourceReq_disk_mb(req);
    h = h * 31 + ResourceReq_accel_devices(req);
    h = h * 31 + ResourceReq_accel_share(req);
    # Multiply, fold the high bits down and multiply again, so neighbouring shapes
    # spread like random ones. The mask makes the shift the same signed or not.
    h = h * 6364136223846793005;
    h = h ^ ((h >> 29) & 34359738367);
    h = h * 6364136223846793005;
    return (h >> 54) & (_KNOWN_SLOTS - 1);
}

# Forget every shape, and take the limits from the nodes as they are now.
fn _known_reset(known, nodes): i64 {
    memset(known, 0, _KNOWN_CPU);
    var cpu = _CPU_UNBOUNDED;
    var mem = 9223372036854775807;
    var disk = 9223372036854775807;
    var first = 1;
    var cap = map_cap(nodes);
    var i = 0;
    while (i < cap) {
        var node = _map_slot(nodes, i);
        if (node != 0) {
            var c = NodeCapacity_available_cpu(node);
            if (f64_eq(c, c) == 0) { c = _CPU_UNBOUNDED; }
            var m = NodeCapacity_available_memory_mb(node);
            var d = NodeCapacity_available_disk_mb(node);
            if (first == 1) {
                cpu = c;
                mem = m;
                disk = d;
                first = 0;
            } else {
                if (f64_gt(c, cpu) == 1) { cpu = c; }
                if (m > mem) { mem = m; }
                if (d > disk) { disk = d; }
            }
        }
        i = i + 1;
    }
    store64(known + _KNOWN_CPU, cpu);
    store64(known + _KNOWN_MEM, mem);
    store64(known + _KNOWN_DISK, disk);
    return 0;
}

# 1 if no node can fit `req`, as far as this pass already knows.
fn _known_unfit(known, req): i64 {
    if (_cpu_short(load64(known + _KNOWN_CPU), ResourceReq_cpu_cores(req)) == 1) { return 1; }
    if (load64(known + _KNOWN_MEM) < ResourceReq_memory_mb(req)) { return 1; }
    if (load64(known + _KNOWN_DISK) < ResourceReq_disk_mb(req)) { return 1; }
    var i = _shape_slot(req);
    var k = load64(known + i * 8);
    while (k != 0) {
        if (_same_shape(k, req) == 1) { return 1; }
        i = (i + 1) & (_KNOWN_SLOTS - 1);
        k = load64(known + i * 8);
    }
    return 0;
}

# Record that `req` fit no node.
fn _known_add(known, req): i64 {
    var count = load64(known + _KNOWN_COUNT);
    if (count >= _KNOWN_MOST) { return 0; }
    var i = _shape_slot(req);
    while (load64(known + i * 8) != 0) { i = (i + 1) & (_KNOWN_SLOTS - 1); }
    store64(known + i * 8, req);
    store64(known + _KNOWN_COUNT, count + 1);
    return 0;
}

# Devices in use on a node, summed over its profiles.
fn _accel_in_use(node): i64 {
    var used = NodeCapacity_accel_used(node);
    var n = vec_len(used);
    var sum = 0;
    var i = 0;
    while (i < n) {
        sum = sum + vec_get(used, i);
        i = i + 1;
    }
    return sum;
}

# Reserve, and answer 1 if the node came out with more of anything free than it had.
# Constructors cannot build a requirement or node that does this, but setters can: a
# negative amount, or a node already below zero. What the pass knows is then wrong.
fn _reserve_grew(node, req): i64 {
    var cpu = NodeCapacity_available_cpu(node);
    var mem = NodeCapacity_available_memory_mb(node);
    var disk = NodeCapacity_available_disk_mb(node);
    var devices = _accel_in_use(node);
    node_capacity_reserve(node, req);
    if (f64_gt(NodeCapacity_available_cpu(node), cpu) == 1) { return 1; }
    if (NodeCapacity_available_memory_mb(node) > mem) { return 1; }
    if (NodeCapacity_available_disk_mb(node) > disk) { return 1; }
    if (_accel_in_use(node) < devices) { return 1; }
    return 0;
}

fn task_scheduler_schedule_pending(s): i64 {
    # Returned, and the caller's vec_len on a 0 faults a frame away (ADR-0009).
    var decisions = vec_new();
    if (decisions == 0) { panic("samay: out of memory in task_scheduler_schedule_pending"); }
    _reconcile_reservations(s);
    var nodes = TaskScheduler_nodes(s);
    var pending = TaskScheduler_pending_scratch(s);
    vec_truncate(pending, 0);
    _collect_pending(s, pending);
    # _KNOWN_DISK + 8 bytes, filled in when the first task looks past its preferred node.
    var known[8224];
    var knowing = 0;
    var n = vec_len(pending);
    var i = 0;
    while (i < n) {
        var task = vec_get(pending, i);
        var req = ScheduledTask_resource_requirements(task);
        var pref = ScheduledTask_requested_node(task);

        var chosen = 0;
        if (pref != 0) {
            var pnode = map_get(nodes, pref);
            if (pnode != 0) {
                # The node's own id, not the task's copy: this becomes reserved_on,
                # which has to keep naming this node.
                if (node_capacity_can_fit(pnode, req) == 1) { chosen = NodeCapacity_node_id(pnode); }
            }
        }
        if (chosen == 0) {
            if (knowing == 0) {
                _known_reset(&known, nodes);
                knowing = 1;
            }
            if (_known_unfit(&known, req) == 0) {
                chosen = _best_fit_node(nodes, req);
                if (chosen == 0) { _known_add(&known, req); }
            }
        }

        if (chosen != 0) {
            var node = map_get(nodes, chosen);
            var score = f64_sub(f64_from(1), node_capacity_utilization(node));
            if (_reserve_grew(node, req) == 1) { knowing = 0; }
            scheduled_task_transition(task, TASK_SCHEDULED);
            ScheduledTask_set_scheduled_at(task, dt_now());
            var reason = str_from("best-fit selection");
            if (pref != 0) { if (str_eq(pref, chosen) == 1) { reason = str_from("preferred node"); } }
            if (reason == 0) { panic("samay: out of memory in task_scheduler_schedule_pending (reason)"); }
            ScheduledTask_set_assigned_node(task, chosen);
            ScheduledTask_set_reserved_on(task, chosen);
            vec_push(decisions, scheduling_decision_new(ScheduledTask_task_id(task), chosen, reason, score));
        } else {
            # The Rust oracle warned here (rust-old/src/lib.rs:483) and the
            # port dropped it. An unplaceable task is the single most
            # operationally interesting event this loop produces.
            _log_no_capacity(ScheduledTask_task_id(task));
        }
        i = i + 1;
    }
    return decisions;
}

# --- preemption ---

fn _preempt_reason(hi, lo): Str {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "priority ");
    str_builder_add_int(sb, hi);
    str_builder_add_cstr(sb, " preempts priority ");
    str_builder_add_int(sb, lo);
    str_builder_add_cstr(sb, " task");
    var out = str_builder_build(sb);
    if (out == 0) { panic("samay: out of memory in _preempt_reason"); }
    return out;
}

# Would stopping `victim` let `req` fit where it is running?
fn _preempt_helps(s, victim, req): i64 {
    var ron = ScheduledTask_reserved_on(victim);
    if (ron == 0) { return 0; }
    var node = map_get(TaskScheduler_nodes(s), ron);
    if (node == 0) { return 0; }
    return _fits_without(node, ScheduledTask_resource_requirements(victim), req);
}

# If a queued `task` needs a running task's place, return a PreemptionAction; else 0.
# Of the running tasks it may preempt and whose node would then fit it, picks the
# lowest priority; ties go to the newest (later created_at).
#
# Priority alone used to decide (ADR-0013). That stopped tasks for a task that
# already fitted, that could never run, or that had finished, and it could stop a job
# on one node while the device needed was held on another. One victim must be enough:
# stopping several for one task is a plan, and samay does not make those.
fn task_scheduler_preempt_if_needed(s, task): i64 {
    if (ScheduledTask_status(task) != TASK_QUEUED) { return 0; }
    # What a pass would release first, so a victim already stopped, or a task already
    # finished through its transition, is not counted as holding anything (1.5.1).
    _reconcile_reservations(s);
    var req = ScheduledTask_resource_requirements(task);
    if (_best_fit_node(TaskScheduler_nodes(s), req) != 0) { return 0; }
    var new_prio = scheduled_task_priority_class(task);
    var tasks = TaskScheduler_tasks(s);
    var cap = map_cap(tasks);
    var cand = 0;
    var i = 0;
    while (i < cap) {
        var t = _map_slot(tasks, i);
        if (t != 0) {
            if (ScheduledTask_status(t) == TASK_RUNNING) {
                if (task_priority_can_preempt(new_prio, scheduled_task_priority_class(t)) == 1) {
                    if (_preempt_helps(s, t, req) == 1) {
                        if (cand == 0) { cand = t; }
                        elif (ScheduledTask_priority(t) < ScheduledTask_priority(cand)) { cand = t; }
                        elif (ScheduledTask_priority(t) == ScheduledTask_priority(cand)) {
                            var ct = ScheduledTask_created_at(t);
                            var cc = ScheduledTask_created_at(cand);
                            if (ct > cc) { cand = t; }
                            elif (ct == cc) {
                                var lower = samay_str_lt(ScheduledTask_task_id(t), ScheduledTask_task_id(cand));
                                if (lower == 1) { cand = t; }
                            }
                        }
                    }
                }
            }
        }
        i = i + 1;
    }
    if (cand == 0) { return 0; }
    var reason = _preempt_reason(ScheduledTask_priority(task), ScheduledTask_priority(cand));
    return preemption_action_new(ScheduledTask_task_id(cand), ScheduledTask_task_id(task), reason);
}

# --- stats ---

fn task_scheduler_stats(s): i64 {
    var st = scheduler_stats_new();
    var tasks = TaskScheduler_tasks(s);
    var cap = map_cap(tasks);
    SchedulerStats_set_total_tasks(st, map_size(tasks));

    var wait_sum = 0;
    var wait_cnt = 0;
    var run_sum = 0;
    var run_cnt = 0;

    var i = 0;
    while (i < cap) {
        var t = _map_slot(tasks, i);
        if (t != 0) {
            var status = ScheduledTask_status(t);
            if (status == TASK_QUEUED) { SchedulerStats_set_queued(st, SchedulerStats_queued(st) + 1); }
            elif (status == TASK_SCHEDULED) { SchedulerStats_set_queued(st, SchedulerStats_queued(st) + 1); }
            elif (status == TASK_RUNNING) { SchedulerStats_set_running(st, SchedulerStats_running(st) + 1); }
            elif (status == TASK_COMPLETED) {
                SchedulerStats_set_completed(st, SchedulerStats_completed(st) + 1);
                var started = ScheduledTask_started_at(t);
                var completed = ScheduledTask_completed_at(t);
                if (started != 0) {
                    if (completed != 0) {
                        var ms = (completed - started) / 1000000;
                        if (ms < 0) { ms = 0; }
                        run_sum = run_sum + ms;
                        run_cnt = run_cnt + 1;
                    }
                }
            }
            elif (status == TASK_FAILED) { SchedulerStats_set_failed(st, SchedulerStats_failed(st) + 1); }
            elif (status == TASK_CANCELLED) { SchedulerStats_set_completed(st, SchedulerStats_completed(st) + 1); }
            elif (status == TASK_PREEMPTED) { SchedulerStats_set_queued(st, SchedulerStats_queued(st) + 1); }

            var started2 = ScheduledTask_started_at(t);
            if (started2 != 0) {
                var wms = (started2 - ScheduledTask_created_at(t)) / 1000000;
                if (wms < 0) { wms = 0; }
                wait_sum = wait_sum + wms;
                wait_cnt = wait_cnt + 1;
            }
        }
        i = i + 1;
    }

    if (wait_cnt > 0) { SchedulerStats_set_average_wait_time_ms(st, wait_sum / wait_cnt); }
    if (run_cnt > 0) { SchedulerStats_set_average_run_time_ms(st, run_sum / run_cnt); }
    return st;
}

# --- cronexpr.cyr ---

# cronexpr.cyr — standard 5-field cron expression parsing and matching.
#
# Fields:  minute(0-59) hour(0-23) day-of-month(1-31) month(1-12) day-of-week(0-6)
# Per field: `*`, `N`, `N-M`, `A,B,C` lists, `*/S` and `N-M/S` steps, plus
# 3-letter month/day names (JAN.. / SUN..) and `@hourly`/`@daily`/... shortcuts.
# `N/S` is also accepted, running from N to the field's end: cronie's reading, which
# Vixie refuses. `@reboot` is refused: samay has no boot to run at. A number is at
# most 9 digits. day-of-week accepts 0 or 7 for Sunday. Expressions are validated at PARSE
# time (Err on any malformed field), never at execution time.
#
# Each field is stored as an i64 bitmask of allowed values. The DOM/DOW
# "star" flags implement the Vixie/crontab(5) rule (cron.c): when NEITHER
# field starts with `*`, a day matches if EITHER mask matches (OR); when
# either field starts with `*`, BOTH masks must match (AND). A bare `*`
# expands to an all-ones mask, so AND-ing it is the identity — which is why
# the starred field's mask must still be applied, not discarded: `*/N` also
# sets the star flag and its mask is NOT all-ones.
#
# Requires: str, string, alloc, result.

var _CRON_MONTHS = "JANFEBMARAPRMAYJUNJULAUGSEPOCTNOVDEC";
var _CRON_DAYS = "SUNMONTUEWEDTHUFRISAT";

# Missed-schedule policy (used by cron.cyr).
enum CronMissedPolicy {
    CRON_CATCHUP = 0;   # fire one task per missed occurrence
    CRON_SKIP = 1;      # fire once, skip the rest (logged)
}

#derive(accessors)
#derive(Serialize)
struct CronExpr {
    minute_mask: i64;
    hour_mask: i64;
    dom_mask: i64;
    month_mask: i64;
    dow_mask: i64;
    dom_star: i64;
    dow_star: i64;
}

fn _cron_upper(c): i64 {
    if (c >= 97) { if (c <= 122) { return c - 32; } }
    return c;
}

# Index of byte `ch` in buf[start,end), or -1.
fn _cron_find(buf, start, end, ch): i64 {
    var i = start;
    while (i < end) {
        if (load8(buf + i) == ch) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

# Parse decimal buf[start,end) → value, or -1 if empty / non-digit.
fn _cron_atoi(buf, start, end): i64 {
    if (start >= end) { return 0 - 1; }
    if (end - start > 9) { return 0 - 1; }   # reject overlong fields (overflow guard)
    var v = 0;
    var i = start;
    while (i < end) {
        var c = load8(buf + i);
        if (c < 48) { return 0 - 1; }
        if (c > 57) { return 0 - 1; }
        v = v * 10 + (c - 48);
        i = i + 1;
    }
    return v;
}

# 3-letter name → number. is_month=1 → JAN=1..DEC=12; else SUN=0..SAT=6.
fn _cron_name_lookup(buf, start, end, is_month): i64 {
    if (end - start != 3) { return 0 - 1; }
    var tbl = _CRON_DAYS;
    var count = 7;
    var base = 0;
    if (is_month == 1) { tbl = _CRON_MONTHS; count = 12; base = 1; }
    var k = 0;
    while (k < count) {
        var hit = 1;
        var j = 0;
        while (j < 3) {
            if (_cron_upper(load8(buf + start + j)) != load8(tbl + k * 3 + j)) { hit = 0; }
            j = j + 1;
        }
        if (hit == 1) { return base + k; }
        k = k + 1;
    }
    return 0 - 1;
}

# A single value token → number. names: 0 none, 1 month, 2 dow.
fn _cron_val(buf, start, end, names): i64 {
    var n = _cron_atoi(buf, start, end);
    if (n >= 0) { return n; }
    if (names == 1) { return _cron_name_lookup(buf, start, end, 1); }
    if (names == 2) { return _cron_name_lookup(buf, start, end, 0); }
    return 0 - 1;
}

# Parse one term (between commas) → bitmask, or -1 on error.
fn _cron_parse_term(buf, start, end, lo, hi, names): i64 {
    if (end <= start) { return 0 - 1; }

    var step = 1;
    var rend = end;
    var slash = _cron_find(buf, start, end, 47);
    if (slash >= 0) {
        step = _cron_atoi(buf, slash + 1, end);
        if (step <= 0) { return 0 - 1; }
        rend = slash;
    }

    var rlo = lo;
    var rhi = hi;
    if (rend - start == 1 && load8(buf + start) == 42) {
        # `*` or `*/S`: full range, optionally stepped.
        rlo = lo;
        rhi = hi;
    } else {
        var dash = _cron_find(buf, start, rend, 45);
        if (dash >= 0) {
            rlo = _cron_val(buf, start, dash, names);
            rhi = _cron_val(buf, dash + 1, rend, names);
        } else {
            var n = _cron_val(buf, start, rend, names);
            rlo = n;
            if (slash >= 0) { rhi = hi; } else { rhi = n; }
        }
        if (rlo < lo) { return 0 - 1; }
        if (rhi > hi) { return 0 - 1; }
        if (rlo > rhi) { return 0 - 1; }
    }

    var mask = 0;
    var v = rlo;
    while (v <= rhi) {
        mask = mask | (1 << v);
        v = v + step;
    }
    return mask;
}

# Parse a whole field (comma-separated terms) → bitmask, or -1 on error.
fn _cron_parse_field(buf, start, end, lo, hi, names, star_out): i64 {
    store64(star_out, 0);
    if (end <= start) { return 0 - 1; }
    # Vixie/crontab(5) rule: the field is a "star" iff it BEGINS with '*'
    # (covers both `*` and `*/step`) — NOT merely if some list term is `*`.
    if (load8(buf + start) == 42) { store64(star_out, 1); }
    # Reject a trailing comma / empty final term (malformed → parse-time error).
    if (load8(buf + end - 1) == 44) { return 0 - 1; }
    var mask = 0;
    var i = start;
    while (i < end) {
        var tend = _cron_find(buf, i, end, 44);
        if (tend < 0) { tend = end; }
        var tmask = _cron_parse_term(buf, i, tend, lo, hi, names);
        if (tmask == 0 - 1) { return 0 - 1; }
        mask = mask | tmask;
        i = tend + 1;
    }
    return mask;
}

# Parse a cron expression string → Ok(CronExpr*) or Err(1). @shortcuts and
# 5-field forms accepted.
fn cron_expr_parse(s): i64 {
    # `s` is a Str; work over its raw bytes. @shortcuts rebind the working
    # buffer to a 5-field literal (every expansion is exactly 9 bytes).
    var expr_str = str_data(s);
    var len = str_len(s);
    # Trim surrounding space/tab up front. The 5-field path already tolerates
    # it via _cron_skip_ws, but the @shortcut dispatch below compares the
    # whole string, so "@daily " used to be an Err while "0 0 * * * " was Ok.
    # Vixie accepts both.
    while (len > 0) {
        var c0 = load8(expr_str);
        if (c0 != 32) { if (c0 != 9) { break; } }
        expr_str = expr_str + 1;
        len = len - 1;
    }
    while (len > 0) {
        var cl = load8(expr_str + len - 1);
        if (cl != 32) { if (cl != 9) { break; } }
        len = len - 1;
    }
    if (len > 0) {
        if (load8(expr_str) == 64) {
            var sh = str_from_buf(expr_str, len);
            if (str_eq_cstr(sh, "@yearly") == 1) { expr_str = "0 0 1 1 *"; len = 9; }
            elif (str_eq_cstr(sh, "@annually") == 1) { expr_str = "0 0 1 1 *"; len = 9; }
            elif (str_eq_cstr(sh, "@monthly") == 1) { expr_str = "0 0 1 * *"; len = 9; }
            elif (str_eq_cstr(sh, "@weekly") == 1) { expr_str = "0 0 * * 0"; len = 9; }
            elif (str_eq_cstr(sh, "@daily") == 1) { expr_str = "0 0 * * *"; len = 9; }
            elif (str_eq_cstr(sh, "@midnight") == 1) { expr_str = "0 0 * * *"; len = 9; }
            elif (str_eq_cstr(sh, "@hourly") == 1) { expr_str = "0 * * * *"; len = 9; }
            else { return Err(1); }
        }
    }

    var fstart: i64[5];
    var fend: i64[5];
    var nf = 0;
    var i = 0;
    while (i < len) {
        i = _cron_skip_ws(expr_str, i, len);
        if (i >= len) { break; }
        if (nf >= 5) { return Err(1); }
        var fs = i;
        i = _cron_skip_nonws(expr_str, i, len);
        store64(&fstart + nf * 8, fs);
        store64(&fend + nf * 8, i);
        nf = nf + 1;
    }
    if (nf != 5) { return Err(1); }

    var sc = 0;
    var mmask = _cron_parse_field(expr_str, load64(&fstart + 0), load64(&fend + 0), 0, 59, 0, &sc);
    if (mmask == 0 - 1) { return Err(1); }
    var hmask = _cron_parse_field(expr_str, load64(&fstart + 8), load64(&fend + 8), 0, 23, 0, &sc);
    if (hmask == 0 - 1) { return Err(1); }
    var dom_star = 0;
    var dommask = _cron_parse_field(expr_str, load64(&fstart + 16), load64(&fend + 16), 1, 31, 0, &dom_star);
    if (dommask == 0 - 1) { return Err(1); }
    var momask = _cron_parse_field(expr_str, load64(&fstart + 24), load64(&fend + 24), 1, 12, 1, &sc);
    if (momask == 0 - 1) { return Err(1); }
    var dow_star = 0;
    var dowmask = _cron_parse_field(expr_str, load64(&fstart + 32), load64(&fend + 32), 0, 7, 2, &dow_star);
    if (dowmask == 0 - 1) { return Err(1); }
    # Fold Sunday=7 into 0.
    if ((dowmask & (1 << 7)) != 0) {
        dowmask = dowmask | 1;
        dowmask = dowmask & (0 - 1 - (1 << 7));
    }

    var expr = alloc(56);
    # Cannot be an Err: this function's Err already means a malformed expression,
    # so a caller would report an out-of-memory host as a bad schedule (ADR-0009).
    if (expr == 0) { panic("samay: out of memory in cron_expr_parse"); }
    CronExpr_set_minute_mask(expr, mmask);
    CronExpr_set_hour_mask(expr, hmask);
    CronExpr_set_dom_mask(expr, dommask);
    CronExpr_set_month_mask(expr, momask);
    CronExpr_set_dow_mask(expr, dowmask);
    CronExpr_set_dom_star(expr, dom_star);
    CronExpr_set_dow_star(expr, dow_star);
    return Ok(expr);
}

fn _cron_skip_ws(buf, i, len): i64 {
    while (i < len) {
        var c = load8(buf + i);
        if (c != 32) { if (c != 9) { return i; } }
        i = i + 1;
    }
    return i;
}
fn _cron_skip_nonws(buf, i, len): i64 {
    while (i < len) {
        var c = load8(buf + i);
        if (c == 32) { return i; }
        if (c == 9) { return i; }
        i = i + 1;
    }
    return i;
}

# Day of week for an epoch-seconds instant (0=Sunday). 1970-01-01 = Thursday.
fn _cron_dow(epoch_secs): i64 {
    var days = epoch_secs / 86400;
    var d = (days + 4) % 7;
    if (d < 0) { d = d + 7; }
    return d;
}

# Month (1-12) and day of month for a day count since 1970-01-01 (days >= 0),
# packed as month * 32 + day. epoch_to_date gives the same answer, but it
# allocates 48 bytes that are never freed and walks the years from 1970, and
# cron evaluation runs for every entry on every check. This is the Gregorian
# civil-from-days conversion: O(1), no allocation, and no month table. Counting
# the year from March puts the leap day last, so no month length is needed.
fn _cron_month_day(days): i64 {
    var doe = (days + 719468) % 146097;     # day of the 400-year cycle
    var yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
    var doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
    var mp = (5 * doy + 2) / 153;           # months since March
    var day = doy - (153 * mp + 2) / 5 + 1;
    var month = mp + 3;
    if (month > 12) { month = month - 12; }
    return month * 32 + day;
}

# True (1) if the time of day of `epoch_secs` (>= 0) passes the minute and hour
# fields. Exact for UTC, which has no leap seconds here.
fn _cron_time_matches(expr, epoch_secs): i64 {
    var minute = (epoch_secs / 60) % 60;
    if ((CronExpr_minute_mask(expr) & (1 << minute)) == 0) { return 0; }
    var hour = (epoch_secs / 3600) % 24;
    if ((CronExpr_hour_mask(expr) & (1 << hour)) == 0) { return 0; }
    return 1;
}

# True (1) if the UTC day holding `epoch_secs` (>= 0) passes the month and
# day fields. The whole calendar half of a match, and the unit _cron_count_due
# steps by, so a count cannot disagree with cron_expr_matches.
fn _cron_day_matches(expr, epoch_secs): i64 {
    # Under the Vixie AND branch a DOW miss settles the result; under the OR
    # branch it does NOT (DOM may still match), so this early exit is guarded
    # on either_star.
    var dow = _cron_dow(epoch_secs);
    var dow_ok = 0;
    if ((CronExpr_dow_mask(expr) & (1 << dow)) != 0) { dow_ok = 1; }
    var either_star = 0;
    if (CronExpr_dom_star(expr) == 1) { either_star = 1; }
    if (CronExpr_dow_star(expr) == 1) { either_star = 1; }
    if (either_star == 1) { if (dow_ok == 0) { return 0; } }

    var md = _cron_month_day(epoch_secs / 86400);
    var day = md % 32;
    var month = md / 32;
    if ((CronExpr_month_mask(expr) & (1 << month)) == 0) { return 0; }

    var dom_ok = 0;
    if ((CronExpr_dom_mask(expr) & (1 << day)) != 0) { dom_ok = 1; }

    # Vixie combination rule — see the module header. Star => AND, else OR.
    # Both masks are always applied; a starred field is never discarded. In
    # the AND branch dow_ok is already known to be 1 (guarded above).
    if (either_star == 1) { return dom_ok; }
    if (dom_ok == 1) { return 1; }
    return dow_ok;
}

# True (1) if the given epoch-seconds instant matches the expression.
# Pre-1970 (negative) instants are not schedulable and never match. Neither half
# allocates, on a hit or a miss.
fn cron_expr_matches(expr, epoch_secs): i64 {
    if (epoch_secs < 0) { return 0; }
    if (_cron_time_matches(expr, epoch_secs) == 0) { return 0; }
    return _cron_day_matches(expr, epoch_secs);
}

# Bits set in x.
fn _cron_bits(x): i64 {
    var n = 0;
    while (x != 0) {
        x = x & (x - 1);
        n = n + 1;
    }
    return n;
}

# Matching minutes in a whole UTC day that passes the day fields. A snapshot's
# masks are not range-checked on restore, so only bits a real minute or hour can
# test are counted: cron_expr_matches can never reach the others.
fn _cron_day_total(expr): i64 {
    var minutes = _cron_bits(CronExpr_minute_mask(expr) & ((1 << 60) - 1));
    var hours = _cron_bits(CronExpr_hour_mask(expr) & ((1 << 24) - 1));
    return minutes * hours;
}

# Next matching epoch-seconds strictly after `epoch_secs` (minute-aligned), or -1 if
# the expression can never match. The calendar repeats every 400 years, day of week
# included, so a day pattern that has not matched in that span never will, and -1
# means never rather than "not soon". It steps by day, so that span costs about as
# much as ten years did minute by minute.
#
# Near the top of i64 the minute after, or the end of the span, would not fit: those
# wrapped negative through 1.5.0. The search stops a day short of the top instead, and
# an instant past that has no next minute to give.
var _CRON_LAST_SECS = 9223372036854689407;

fn cron_expr_next_after(expr, epoch_secs): i64 {
    if (_cron_day_total(expr) == 0) { return 0 - 1; }
    if (epoch_secs >= _CRON_LAST_SECS) { return 0 - 1; }
    var t = 0;
    if (epoch_secs >= 0) { t = (epoch_secs / 60) * 60 + 60; }
    var limit = _CRON_LAST_SECS;
    if (t < _CRON_LAST_SECS - 146097 * 86400) { limit = t + 146097 * 86400; }
    while (t < limit) {
        var next_day = t - t % 86400 + 86400;
        if (_cron_day_matches(expr, t) == 1) {
            while (t < next_day) {
                if (_cron_time_matches(expr, t) == 1) { return t; }
                t = t + 60;
            }
        }
        t = next_day;
    }
    return 0 - 1;
}

# --- cron.cyr ---

# cron.cyr — cron-like recurring task triggers (cron-expression driven).
#
# THREAD SAFETY: none — one CronScheduler per thread (ADR-0008). check_due_at
# is a read-modify-write on each entry's last_fired watermark, so two threads
# sharing a scheduler will duplicate fired tasks.
#
# v0.3.0 replaces the interval+hour/minute model with real cron expressions
# (src/cronexpr.cyr) and an explicit missed-schedule policy: when the
# scheduler was down across one or more fire times, an entry either fires
# once per missed occurrence (CRON_CATCHUP, capped) or fires once and logs
# the drop (CRON_SKIP). Missed occurrences are NEVER silently discarded: a
# burst past CRON_BURST_BUDGET is held for a later check, not dropped.
#
# check_due_at(now_ns) is deterministic (injected clock) for testing;
# check_due() wraps it with dt_now(). Requires: hashmap, vec, str, string,
# chrono, result, sakshi + types.cyr + cronexpr.cyr.

var CRON_CATCHUP_CAP = 1000;         # max tasks fired per entry per check
var CRON_BURST_BUDGET = 10000;       # max tasks fired by bursts per check (ADR-0012)
var CRON_SCAN_WINDOW_SECS = 31622400; # 366 days — the catch-up look-back window
var CRON_CLOCK_RESET_SECS = 10800;   # a backward step past this re-anchors (ADR-0006)

#derive(accessors)
struct CronTaskTemplate {
    name: Str;
    description: Str;
    agent_id: Str;
    priority: i64;
    resource_requirements: i64;
}

fn cron_task_template_new(name, description, agent_id, priority, req): i64 {
    var p = alloc(40);
    if (p == 0) { panic("samay: out of memory in cron_task_template_new"); }
    CronTaskTemplate_set_name(p, _samay_own_req(name, "samay: out of memory in cron_task_template_new"));
    CronTaskTemplate_set_description(p, _samay_own_req(description, "samay: out of memory in cron_task_template_new"));
    CronTaskTemplate_set_agent_id(p, _samay_own_req(agent_id, "samay: out of memory in cron_task_template_new"));
    if (priority < 1) { priority = 1; }
    if (priority > 10) { priority = 10; }
    CronTaskTemplate_set_priority(p, priority);
    CronTaskTemplate_set_resource_requirements(p, req);
    return p;
}

# expr: a parsed CronExpr pointer. last_fired: epoch-ns, 0 = never.
# missed_policy: CRON_CATCHUP | CRON_SKIP. disabled_seen: 1 once a disabled entry has
# said what it gave up. clock_behind: 1 while a clock step back is being waited out and
# has been logged. reset_from: the watermark before a clock reset, 0 if none (ADR-0006).
#derive(accessors)
struct CronEntry {
    name: Str;
    expr: i64;
    task_template: i64;
    enabled: i64;
    last_fired: i64;
    missed_policy: i64;
    disabled_seen: i64;
    clock_behind: i64;
    reset_from: i64;
}

fn cron_entry_new(name, expr, task_template, enabled, missed_policy): i64 {
    var p = alloc(72);
    if (p == 0) { panic("samay: out of memory in cron_entry_new"); }
    CronEntry_set_name(p, _samay_own_req(name, "samay: out of memory in cron_entry_new"));
    CronEntry_set_expr(p, expr);
    CronEntry_set_task_template(p, task_template);
    # Only 0 is disabled, as restore reads it, so anything else is stored as 1.
    if (enabled != 0) { enabled = 1; }
    CronEntry_set_enabled(p, enabled);
    CronEntry_set_last_fired(p, 0);
    # Anything but CRON_SKIP catches up, and restore reads it back as CRON_CATCHUP.
    if (missed_policy != CRON_SKIP) { missed_policy = CRON_CATCHUP; }
    CronEntry_set_missed_policy(p, missed_policy);
    return p;
}

#derive(accessors)
struct CronScheduler {
    entries: i64;
    check_scratch: i64;
}

fn cron_scheduler_new(): i64 {
    var c = alloc(16);
    if (c == 0) { panic("samay: out of memory in cron_scheduler_new"); }
    # map_new_str returns 0 on OOM without aborting; a null entries map
    # survives construction and dies later inside map_set.
    var entries = map_new_str();
    if (entries == 0) { panic("samay: out of memory in cron_scheduler_new (entries map)"); }
    CronScheduler_set_entries(c, entries);
    # Reused by every check, so a quiet check allocates no list of its own.
    var scratch = vec_new();
    if (scratch == 0) { panic("samay: out of memory in cron_scheduler_new (scratch)"); }
    CronScheduler_set_check_scratch(c, scratch);
    return c;
}

# 1 if two expressions match exactly the same instants.
fn _cron_same_expr(a, b): i64 {
    if (CronExpr_minute_mask(a) != CronExpr_minute_mask(b)) { return 0; }
    if (CronExpr_hour_mask(a) != CronExpr_hour_mask(b)) { return 0; }
    if (CronExpr_dom_mask(a) != CronExpr_dom_mask(b)) { return 0; }
    if (CronExpr_month_mask(a) != CronExpr_month_mask(b)) { return 0; }
    if (CronExpr_dow_mask(a) != CronExpr_dow_mask(b)) { return 0; }
    if (CronExpr_dom_star(a) != CronExpr_dom_star(b)) { return 0; }
    if (CronExpr_dow_star(a) != CronExpr_dow_star(b)) { return 0; }
    return 1;
}

fn _cron_log_replaced(name): i64 {
    var sb = _cron_log_head(name);
    str_builder_add_cstr(sb, "': schedule changed; what the old one owed since its last check is given up");
    var msg = str_builder_build(sb);
    sakshi_warn(str_data(msg), str_len(msg));
    return 0;
}

# Put an entry in the table, keyed on its own name: the caller's Str may be a reused
# buffer. An entry replaced under the same name, with the same schedule, keeps its
# place in time unless the new one brings its own: a fresh 0 would fire the current
# minute a second time, and forget everything owed since the last check with no log
# line. A changed schedule starts fresh instead. Kept, its watermark fired the new
# schedule for time before it existed, and gave up what the old one owed in silence;
# now what the old one owed is given up with a log line (ADR-0006).
fn _cron_put(c, entry): i64 {
    var table = CronScheduler_entries(c);
    var old = map_get(table, CronEntry_name(entry));
    if (old != 0) {
        if (CronEntry_last_fired(entry) == 0) {
            if (_cron_same_expr(CronEntry_expr(old), CronEntry_expr(entry)) == 1) {
                CronEntry_set_last_fired(entry, CronEntry_last_fired(old));
                CronEntry_set_reset_from(entry, CronEntry_reset_from(old));
                CronEntry_set_disabled_seen(entry, CronEntry_disabled_seen(old));
            } elif (CronEntry_enabled(old) != 0) {
                if (CronEntry_last_fired(old) != 0) { _cron_log_replaced(CronEntry_name(entry)); }
            }
        }
    }
    map_set(table, CronEntry_name(entry), entry);
    return 0;
}

# Parse + validate a cron expression, then register the entry. Ok(0) on
# success; Err(1) if the name is empty or the expression is malformed
# (validation happens here, at add time — not at execution).
fn cron_scheduler_add(c, name, expr_str, task_template, enabled, missed_policy): i64 {
    if (name == 0) { return Err(1); }
    if (str_len(name) == 0) { return Err(1); }
    var r_t, r_v = cron_expr_parse(expr_str);
    if (is_err_result(r_t) == 1) { return Err(1); }
    _cron_put(c, cron_entry_new(name, result_unwrap(r_t, r_v), task_template, enabled, missed_policy));
    return Ok(0);
}

# Register a pre-built entry. Err(1) if the name is empty.
fn cron_scheduler_add_entry(c, entry): i64 {
    if (CronEntry_name(entry) == 0) { return Err(1); }
    if (str_len(CronEntry_name(entry)) == 0) { return Err(1); }
    _cron_put(c, entry);
    return Ok(0);
}

# Remove an entry by name; Err(1) if not found.
fn cron_scheduler_remove_entry(c, name): i64 {
    if (map_has(CronScheduler_entries(c), name) == 0) { return Err(1); }
    map_delete(CronScheduler_entries(c), name);
    return Ok(0);
}

# vec_sort_by order for CronEntry pointers: by name. Entry names are unique map
# keys, so this makes list_entries deterministic independent of hashmap
# iteration order (ADR-0004).
fn _entry_name_cmp(a, b): i64 {
    return _samay_str_cmp(CronEntry_name(a), CronEntry_name(b));
}

# vec_sort_by order for one check: oldest watermark first, then by name. A held
# entry keeps its old watermark, so this order alone puts it first on the next
# check, with no queue and nothing new on the wire. On an ordinary check every
# watermark ties, which leaves name order (ADR-0012).
fn _entry_due_cmp(a, b): i64 {
    var la = CronEntry_last_fired(a);
    var lb = CronEntry_last_fired(b);
    if (la < lb) { return 0 - 1; }
    if (la > lb) { return 1; }
    return _entry_name_cmp(a, b);
}

fn cron_scheduler_list_entries(c): i64 {
    var v = map_values(CronScheduler_entries(c));
    vec_sort_by(v, &_entry_name_cmp);
    return v;
}

# "<base> (cron)" as a fresh Str.
fn _cron_task_name(base): Str {
    var sb = str_builder_new();
    str_builder_add(sb, base);
    str_builder_add_cstr(sb, " (cron)");
    # This becomes the task NAME handed to scheduled_task_new, and consumers
    # read it back through str_cstr -- str_cstr(0) faults across the repo
    # boundary, far from here.
    var out = str_builder_build(sb);
    if (out == 0) { panic("samay: out of memory in _cron_task_name"); }
    return out;
}

# Build a fresh ScheduledTask from an entry's template.
fn _cron_fire(e): i64 {
    var tmpl = CronEntry_task_template(e);
    return scheduled_task_new(
        _cron_task_name(CronTaskTemplate_name(tmpl)),
        CronTaskTemplate_description(tmpl),
        CronTaskTemplate_agent_id(tmpl),
        CronTaskTemplate_priority(tmpl),
        CronTaskTemplate_resource_requirements(tmpl));
}

# Matching times of day in [from, to], both minute-aligned and in one UTC day.
fn _cron_part_day(expr, from, to): i64 {
    var n = 0;
    var t = from;
    while (t <= to) {
        n = n + _cron_time_matches(expr, t);
        t = t + 60;
    }
    return n;
}

# Count matching minutes in (lf_secs, now_secs]. The scan is bounded to the
# ~366-day catch-up window; if last_fired predates that window, *clamped_out is
# set to 1 (occurrences older than the window are dropped and MUST be logged by
# the caller — never silently).
#
# It steps by UTC day, not by minute. The time of day and the calendar day are
# independent fields, so a whole day that matches holds exactly _cron_day_total
# minutes, and only the two partial days at the ends are walked. A full window
# is therefore about 366 day checks, on a hit or a miss, with no allocation and
# no need to stop early: the result is always exact. Through 1.4.0 this called
# cron_expr_matches once per minute, 26 ms and 4.8 MB for one stale `* * * * *`
# entry, and stopped at 100,000 matches (ADR-0012).
fn _cron_count_due(expr, lf_secs, now_secs, clamped_out): i64 {
    store64(clamped_out, 0);
    var start = (lf_secs / 60) * 60 + 60;
    var end = (now_secs / 60) * 60;
    var min_start = end - CRON_SCAN_WINDOW_SECS;
    if (start < min_start) {
        start = min_start;
        store64(clamped_out, 1);
    }
    var count = 0;
    var per_day = 0 - 1;    # worked out once, and only if a whole day is in range
    var t = start;
    while (t <= end) {
        var last = t - t % 86400 + 86340;   # the last minute of t's day
        if (last > end) { last = end; }
        var n = 0;
        if (last - t == 86340) {
            if (per_day < 0) { per_day = _cron_day_total(expr); }
            n = per_day;
        } else {
            n = _cron_part_day(expr, t, last);
        }
        if (n > 0) {
            if (_cron_day_matches(expr, t) == 1) { count = count + n; }
        }
        t = last + 60;
    }
    return count;
}

# A log line's opening. sakshi's line buffer holds 256 bytes and a name can be any
# length, so the name stops at 64 and the count after it always survives.
fn _cron_log_head(name): i64 {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "cron '");
    _samay_log_add(sb, name, 64);
    return sb;
}

# The count only ever covers the window, so a clamped one says so.
fn _cron_log_window(sb, clamped): i64 {
    if (clamped == 1) { str_builder_add_cstr(sb, " in the catch-up window"); }
    return 0;
}

fn _cron_log_skip(name, skipped, clamped): i64 {
    var sb = _cron_log_head(name);
    str_builder_add_cstr(sb, "': skip policy dropped ");
    str_builder_add_int(sb, skipped);
    str_builder_add_cstr(sb, " missed occurrence(s)");
    _cron_log_window(sb, clamped);
    var msg = str_builder_build(sb);
    sakshi_warn(str_data(msg), str_len(msg));
    return 0;
}

fn _cron_log_catchup_cap(name, due, clamped): i64 {
    var sb = _cron_log_head(name);
    str_builder_add_cstr(sb, "': catch-up capped — fired ");
    str_builder_add_int(sb, CRON_CATCHUP_CAP);
    str_builder_add_cstr(sb, " of ");
    str_builder_add_int(sb, due);
    str_builder_add_cstr(sb, " due occurrence(s)");
    _cron_log_window(sb, clamped);
    var msg = str_builder_build(sb);
    sakshi_warn(str_data(msg), str_len(msg));
    return 0;
}

# Every late fire is logged, not only the capped ones. The domain principle is
# that the missed-schedule policy is ALWAYS visible: before v1.0.3 a sub-cap burst
# (720 tasks after a 30-day gap) fired silently, and until 1.4.3 so did a single
# late fire, which is all a daily entry ever does. `missed` leaves out an occurrence
# that is on time.
fn _cron_log_missed(name, skip, missed): i64 {
    var sb = _cron_log_head(name);
    if (skip == 1) {
        str_builder_add_cstr(sb, "': skip policy fired ");
    } else {
        str_builder_add_cstr(sb, "': catch-up policy fired ");
    }
    str_builder_add_int(sb, missed);
    str_builder_add_cstr(sb, " missed occurrence(s)");
    var msg = str_builder_build(sb);
    sakshi_warn(str_data(msg), str_len(msg));
    return 0;
}

# The clock moved backwards (NTP correction, VM restore, or a caller of the
# injected-clock API passing a stale instant). Logged, never silent.
fn _cron_log_clock_regression(name): i64 {
    var sb = _cron_log_head(name);
    str_builder_add_cstr(sb, "': clock moved backwards; watermark held, no re-fire");
    var msg = str_builder_build(sb);
    sakshi_warn(str_data(msg), str_len(msg));
    return 0;
}

# Advance the watermark monotonically. Never rewind: before v1.0.3 this was an
# unconditional store, so a backward clock step moved last_fired into the past
# and the next forward call re-fired the whole intervening interval.
fn _cron_advance(e, now_ns): i64 {
    if (now_ns > CronEntry_last_fired(e)) { CronEntry_set_last_fired(e, now_ns); }
    return 0;
}

fn _cron_fire_n(tasks, e, n): i64 {
    var k = 0;
    while (k < n) { vec_push(tasks, _cron_fire(e)); k = k + 1; }
    return 0;
}

# The clock moved back too far to wait for. A watermark from the future, such as one
# bad reading at boot, would otherwise stop the entry until real time caught up
# (ADR-0006).
fn _cron_log_clock_reset(name): i64 {
    var sb = _cron_log_head(name);
    str_builder_add_cstr(sb, "': clock moved backwards past the reset limit; watermark re-anchored");
    var msg = str_builder_build(sb);
    sakshi_warn(str_data(msg), str_len(msg));
    return 0;
}

# Disabling an entry gives up what it owed. A choice, but not a silent one.
fn _cron_log_disabled(name, owed, clamped): i64 {
    var sb = _cron_log_head(name);
    str_builder_add_cstr(sb, "': disabled, giving up ");
    str_builder_add_int(sb, owed);
    str_builder_add_cstr(sb, " missed occurrence(s)");
    _cron_log_window(sb, clamped);
    var msg = str_builder_build(sb);
    sakshi_warn(str_data(msg), str_len(msg));
    return 0;
}

# Anything older than the window is out of reach — logged, not silent. Whether any
# such occurrence exists is unknown, so this does not claim one was dropped.
fn _cron_log_clamp(name): i64 {
    var sb = _cron_log_head(name);
    str_builder_add_cstr(sb, "': last_fired predates the ~366-day catch-up window; anything older is not counted");
    var msg = str_builder_build(sb);
    sakshi_warn(str_data(msg), str_len(msg));
    return 0;
}

# Held back by the budget: nothing was dropped, and these fire on a later check.
fn _cron_log_held(held, spent): i64 {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "cron: burst budget reached at ");
    str_builder_add_int(sb, spent);
    str_builder_add_cstr(sb, " task(s); ");
    str_builder_add_int(sb, held);
    str_builder_add_cstr(sb, " entry(ies) held with their watermarks for the next check");
    var msg = str_builder_build(sb);
    sakshi_warn(str_data(msg), str_len(msg));
    return 0;
}

# Would firing fire_n tasks hold this entry back? `spent` is what this check's
# bursts have fired so far. A single fire is never held: it is what an entry
# does on an ordinary minute, and a caller that writes its own watermarks back
# would lose it. The first burst of a check always runs, so every check moves
# the oldest held entry on, whatever the budget is set to (ADR-0012).
fn _cron_over_budget(fire_n, spent): i64 {
    if (fire_n < 2) { return 0; }
    if (spent == 0) { return 0; }
    if (spent + fire_n > CRON_BURST_BUDGET) { return 1; }
    return 0;
}

# Say what a check did about `due` occurrences, unless it was just the one on time.
fn _cron_log_outcome(e, due, skip, clamped, now_secs): i64 {
    var name = CronEntry_name(e);
    if (skip == 1) {
        if (due > 1) { return _cron_log_skip(name, due - 1, clamped); }
    } elif (due > CRON_CATCHUP_CAP) {
        return _cron_log_catchup_cap(name, due, clamped);
    }
    var missed = due - cron_expr_matches(CronEntry_expr(e), (now_secs / 60) * 60);
    if (missed > 0) { _cron_log_missed(name, skip, missed); }
    return 0;
}

# Evaluate one entry: fire per the missed-schedule policy and advance the
# watermark. Returns the tasks a burst fired, which count against
# CRON_BURST_BUDGET, or -1 if the entry was held: no task, no log and no
# watermark move, so the whole debt is still there for the next check.
# Extracted from cron_scheduler_check_due_at in v1.0.3.
fn _cron_check_entry(tasks, e, now_ns, now_secs, spent): i64 {
    # A disabled entry TRACKS the clock rather than freezing. Freezing made
    # the whole disabled interval count as "missed", so re-enabling fired a
    # burst for time the operator had deliberately turned the schedule off
    # (720 tasks for a 30-day disable of `0 * * * *`). See ADR-0006.
    var expr = CronEntry_expr(e);
    if (CronEntry_enabled(e) == 0) {
        # What it owed from before it was disabled goes, and says so once.
        if (CronEntry_disabled_seen(e) == 0) {
            CronEntry_set_disabled_seen(e, 1);
            var was = CronEntry_last_fired(e);
            if (was != 0) {
                var cut = 0;
                var owed = _cron_count_due(expr, was / 1000000000, now_secs, &cut);
                if (owed > 0) { _cron_log_disabled(CronEntry_name(e), owed, cut); }
            }
        }
        _cron_advance(e, now_ns);
        return 0;
    }
    CronEntry_set_disabled_seen(e, 0);
    var lf = CronEntry_last_fired(e);
    # Time is back past where it had got before a reset, so the reset was a bad reading
    # or is over: what had already fired does not fire again.
    var rf = CronEntry_reset_from(e);
    if (rf != 0) {
        if (now_ns >= rf) {
            if (rf > lf) {
                lf = rf;
                CronEntry_set_last_fired(e, rf);
            }
            CronEntry_set_reset_from(e, 0);
        }
    }
    if (now_ns < lf) {
        if (lf - now_ns <= CRON_CLOCK_RESET_SECS * 1000000000) {
            # Said once while it lasts: every check used to say it again, per entry.
            if (CronEntry_clock_behind(e) == 0) {
                _cron_log_clock_regression(CronEntry_name(e));
                CronEntry_set_clock_behind(e, 1);
            }
            return 0;
        }
        # Vixie's rule: a small step back waits, a large one starts again from now. How
        # far it had got is kept, so a reading that comes back past it fires nothing twice.
        _cron_log_clock_reset(CronEntry_name(e));
        if (lf > CronEntry_reset_from(e)) { CronEntry_set_reset_from(e, lf); }
        CronEntry_set_last_fired(e, 0);
        lf = 0;
    }
    CronEntry_set_clock_behind(e, 0);
    if (lf == 0) {
        # First evaluation: fire only if the current minute matches;
        # anchor last_fired at now (no retroactive firing).
        if (cron_expr_matches(expr, now_secs) == 1) { vec_push(tasks, _cron_fire(e)); }
        _cron_advance(e, now_ns);
        # 0 means never, so an instant at or before the epoch cannot anchor one.
        if (CronEntry_last_fired(e) == 0) { CronEntry_set_last_fired(e, 1); }
        return 0;
    }
    var clamped = 0;
    var due = _cron_count_due(expr, lf / 1000000000, now_secs, &clamped);
    var skip = 0;
    if (CronEntry_missed_policy(e) == CRON_SKIP) { skip = 1; }
    var fire_n = due;
    if (skip == 1) {
        if (fire_n > 1) { fire_n = 1; }
    } elif (fire_n > CRON_CATCHUP_CAP) {
        fire_n = CRON_CATCHUP_CAP;
    }
    if (_cron_over_budget(fire_n, spent) == 1) { return 0 - 1; }
    if (clamped == 1) { _cron_log_clamp(CronEntry_name(e)); }
    _cron_fire_n(tasks, e, fire_n);
    if (due > 0) { _cron_log_outcome(e, due, skip, clamped, now_secs); }
    _cron_advance(e, now_ns);
    if (fire_n > 1) { return fire_n; }
    return 0;
}

# Deterministic check: which entries are due at `now_ns` (epoch-ns)? Fires
# them per the missed-schedule policy, advances last_fired, and returns a vec
# of freshly-created ScheduledTask pointers.
#
# Bursts stop at CRON_BURST_BUDGET: an entry that would pass it is held, keeps
# its watermark, and fires first on a later check. To clear a backlog sooner,
# call again with the same now_ns until a check returns nothing. A caller that
# stores watermarks itself must read them back from the entries: writing now_ns
# over a held entry deletes what it owed (ADR-0012).
fn cron_scheduler_check_due_at(c, now_ns): i64 {
    var now_secs = now_ns / 1000000000;
    # Returned to the caller, which does vec_len on it -- guard rather than
    # hand back a 0 that faults a frame up (ADR-0009).
    var tasks = vec_new();
    if (tasks == 0) { panic("samay: out of memory in cron_scheduler_check_due_at"); }
    var table = CronScheduler_entries(c);
    var cap = map_cap(table);
    var entries = CronScheduler_check_scratch(c);
    vec_truncate(entries, 0);
    var slot = 0;
    while (slot < cap) {
        var entry = _map_slot(table, slot);
        if (entry != 0) { vec_push(entries, entry); }
        slot = slot + 1;
    }
    vec_sort_by(entries, &_entry_due_cmp);
    var n = vec_len(entries);
    var spent = 0;
    var held = 0;
    var i = 0;
    while (i < n) {
        var fired = _cron_check_entry(tasks, vec_get(entries, i), now_ns, now_secs, spent);
        if (fired < 0) { held = held + 1; } else { spent = spent + fired; }
        i = i + 1;
    }
    if (held > 0) { _cron_log_held(held, spent); }
    return tasks;
}

# check_due at the current wall-clock time.
fn cron_scheduler_check_due(c): i64 {
    return cron_scheduler_check_due_at(c, dt_now());
}

# --- training.cyr ---

# training.cyr — training-job scheduling templates (Synapse integration).
#
# Training jobs become High-priority (6) tasks with GPU/accelerator
# requirements. Requires: str, string, chrono + types.cyr.

enum SamayTrainMethod {
    TM_LORA = 0;
    TM_QLORA = 1;
    TM_FULL = 2;
    TM_DPO = 3;
    TM_RLHF = 4;
    TM_DISTILL = 5;
}

# Display name (Rust Display impl).
fn samay_training_method_name(m): i64 {
    if (m == TM_LORA) { return "lora"; }
    if (m == TM_QLORA) { return "qlora"; }
    if (m == TM_FULL) { return "full"; }
    if (m == TM_DPO) { return "dpo"; }
    if (m == TM_RLHF) { return "rlhf"; }
    if (m == TM_DISTILL) { return "distillation"; }
    return "unknown";
}

# Preferred accelerator (ai-hwaccel REQ_*): LoRA/QLoRA → GPU; else GPU-or-TPU.
fn training_method_preferred_accel(m): i64 {
    if (m == TM_LORA) { return REQ_GPU; }
    if (m == TM_QLORA) { return REQ_GPU; }
    return REQ_GPU_OR_TPU;
}

# target_node: Str, or 0 for None.
#derive(accessors)
struct TrainingJobTemplate {
    model_id: Str;
    method: i64;
    dataset: Str;
    target_node: i64;
    max_duration_secs: i64;
    checkpoint_interval_secs: i64;
}

fn training_job_template_new(model_id, method, dataset, target_node, max_duration_secs, checkpoint_interval_secs): i64 {
    var p = alloc(48);
    if (p == 0) { panic("samay: out of memory in training_job_template_new"); }
    TrainingJobTemplate_set_model_id(p, _samay_own_req(model_id, "samay: out of memory in training_job_template_new"));
    TrainingJobTemplate_set_method(p, method);
    TrainingJobTemplate_set_dataset(p, _samay_own_req(dataset, "samay: out of memory in training_job_template_new"));
    var target = _samay_own(target_node, "samay: out of memory in training_job_template_new");
    TrainingJobTemplate_set_target_node(p, target);
    TrainingJobTemplate_set_max_duration_secs(p, _req_amount(max_duration_secs));
    TrainingJobTemplate_set_checkpoint_interval_secs(p, _req_amount(checkpoint_interval_secs));
    return p;
}

# "train-<method>-<model_id>"
fn _train_name(method, model): Str {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "train-");
    str_builder_add_cstr(sb, samay_training_method_name(method));
    str_builder_add_cstr(sb, "-");
    str_builder_add(sb, model);
    # Stored into the ScheduledTask built below, so a null would escape the
    # function rather than trap here.
    var out = str_builder_build(sb);
    if (out == 0) { panic("samay: out of memory in _train_name"); }
    return out;
}

# "Training job: <method> on <model_id>"
fn _train_desc(method, model): Str {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "Training job: ");
    str_builder_add_cstr(sb, samay_training_method_name(method));
    str_builder_add_cstr(sb, " on ");
    str_builder_add(sb, model);
    # Stored into the ScheduledTask built below, so a null would escape the
    # function rather than trap here.
    var out = str_builder_build(sb);
    if (out == 0) { panic("samay: out of memory in _train_desc"); }
    return out;
}

# Build a High-priority (6) ScheduledTask from this template.
# An absurd max_duration_secs was reduced rather than allowed to wrap.
fn _log_deadline_clamp(model, requested): i64 {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "training '");
    _samay_log_add(sb, model, 128);
    str_builder_add_cstr(sb, "': max_duration_secs ");
    str_builder_add_int(sb, requested);
    str_builder_add_cstr(sb, " would overflow the deadline; clamped");
    var msg = str_builder_build(sb);
    sakshi_warn(str_data(msg), str_len(msg));
    return 0;
}

fn training_job_to_scheduled_task(job, agent_id): i64 {
    var method = TrainingJobTemplate_method(job);
    var model = TrainingJobTemplate_model_id(job);
    var req = resource_req_new(f64_from(2), 4096, training_method_preferred_accel(method), 0, 0, 10000);
    var task = scheduled_task_new(_train_name(method, model), _train_desc(method, model), agent_id, 6, req);
    var max = TrainingJobTemplate_max_duration_secs(job);
    if (max > 0) {
        # dur_seconds() multiplies by 1e9, so above ~9.2e9 seconds the product
        # overflows i64 and the deadline lands in the PAST while still passing
        # the `max > 0` guard. Clamp to the headroom actually available.
        var now = dt_now();
        var headroom = (9223372036854775807 - now) / 1000000000;
        if (max > headroom) {
            _log_deadline_clamp(TrainingJobTemplate_model_id(job), max);
            max = headroom;
        }
        ScheduledTask_set_deadline(task, dt_add(now, dur_seconds(max)));
    } else {
        ScheduledTask_set_deadline(task, 0);
    }
    ScheduledTask_set_requested_node(task, TrainingJobTemplate_target_node(job));
    return task;
}

# --- json.cyr ---

# json.cyr — JSON Serialize/Deserialize for the container types (M4).
#
# The five all-scalar/all-Str "leaf" types (ResourceReq, SchedulingDecision,
# PreemptionAction, SchedulerStats, CronExpr) carry their codec via
# #derive(Serialize). This module covers the types the derive can't:
# structs with pointer / vec / map fields, or a nullable Str field.
#
# These compose over bayan's json_v value-tree API — bayan_json_v_obj_set /
# bayan_json_v_arr_push to build, bayan_json_v_parse / bayan_json_v_obj_get
# to read — which handles string escaping, nesting and arrays natively
# (unlike the derive's flat-parser from_json, which does not unescape).
# The two leaves nested in those types, ResourceReq and CronExpr, are built and
# read field by field here rather than through their derive; see _rr_node and
# _rr_from.
#
# Convention per type:
#   <type>_to_jsonv(p)        -> json_v node   (composable build)
#   <type>_from_jsonv(v)      -> struct ptr    (composable read; 0 on non-object)
#   <type>_to_json_str(p)     -> Str           (bayan_json_v_build wrapper)
#   <type>_from_json_str(s)   -> struct ptr    (bayan_json_v_parse wrapper)
#
# None sentinels (ADR-0001): a nullable Str field is 0; it serializes as JSON
# null and reads back as 0. epoch-ns timestamp fields use 0 for None and are
# plain ints on the wire (0 stays 0). Requires: bayan-json, str + the samay
# modules. Calls are the fully-qualified `bayan_json_v_*` spelling: the short
# `json_v_*` aliases exist only in bayan's monolith, not the focused sublib
# samay vendors (bayan 1.5.2 — see [deps.bayan] in cyrius.cyml).

# ---------------------------------------------------------------------------
# helpers over bayan json_v
# ---------------------------------------------------------------------------

# --- what a document may cost (ADR-0014) ---
#
# Through 1.4.4 only SAMAY_JSON_MAX_ITEMS limited a restore, and it is checked after
# the parse. bayan's tree costs up to 88 times the text it came from, so 10 MB of
# `[[[...]]]` took 877 MB before anything was refused, and an unknown key was not
# limited at all.

# The longest document a reader accepts and a writer produces. Both item limits at
# once fit: 100,000 tasks write 52 MB and 100,000 nodes 21 MB, and a GPU profile adds
# 117 bytes. A writer refuses past it too, so anything samay writes reads back.
var SAMAY_JSON_MAX_BYTES = 134217728;

# How many times its own size a parse may take. What samay writes takes at most 7.2
# (cron entries with one-letter names and zeroed numbers), so this leaves room for
# bayan to change. The smallest documents get 4 KiB on top: `{}` alone takes 176.
var SAMAY_JSON_MAX_EXPANSION = 10;

# 1 if `n` bytes is past the limit, and says so.
fn _over_byte_limit(n): i64 {
    if (n <= SAMAY_JSON_MAX_BYTES) { return 0; }
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "snapshot refused: ");
    str_builder_add_int(sb, n);
    str_builder_add_cstr(sb, " bytes, past the limit of ");
    str_builder_add_int(sb, SAMAY_JSON_MAX_BYTES);
    var msg = str_builder_build(sb);
    sakshi_error(str_data(msg), str_len(msg));
    return 1;
}

# An allocator that hands out memory until `budget` bytes are spent, then answers 0,
# which fails bayan's whole parse or build. State: { used, budget, refused, base, size }.
# It counts each request as alloc() takes it, rounded up to 8, which is what ADR-0014's
# ratios measured. A request past ALLOC_MAX is refused the same way: plain alloc()
# answers 0 there too, and bayan_json_v_build exits the process on it.
#
# With a mapping (base not 0) it hands out the mapping in order, 8-aligned as alloc()
# is; the budget fits inside it, so it never runs past the end. Without one it forwards
# to alloc(), and any 0 from that is the host out of memory, so it panics rather than
# pass for a refused document (ADR-0009).
fn _budget_alloc(st, size): i64 {
    var need = (size + 7) & (0 - 8);
    var used = load64(st) + need;
    if (size > ALLOC_MAX || used > load64(st + 8)) {
        store64(st + 16, 1);
        return 0;
    }
    var base = load64(st + 24);
    var at = load64(st);
    store64(st, used);
    if (base != 0) { return base + at; }
    var p = alloc(size);
    if (p == 0) { panic("samay: out of memory in _budget_alloc"); }
    return p;
}

# bayan neither reallocates, frees nor resets through an allocator. A realloc is
# refused rather than copied, so a bayan that starts using one fails loudly in tests.
fn _budget_realloc(st, old_ptr, old_size, new_size): i64 { return 0; }
fn _budget_free(st, ptr): i64 { return 0; }
fn _budget_reset(st): i64 { return 0; }

# An allocator for `budget` bytes on the heap, and its state.
fn _budget(budget): i64 {
    var st = alloc(40);
    if (st == 0) { panic("samay: out of memory in _budget"); }
    store64(st, 0);
    store64(st + 8, budget);
    store64(st + 16, 0);
    store64(st + 24, 0);
    store64(st + 32, 0);
    var al = allocator_new(&_budget_alloc, &_budget_realloc, &_budget_free, &_budget_reset, st);
    if (al == 0) { panic("samay: out of memory in _budget"); }
    return al;
}

fn _budget_refused(al): i64 { return load64(allocator_state(al) + 16); }

# 1 to give a restore's tree a mapping of its own; tests set 0 to take the heap path.
var _RESTORE_MAPPED = 1;

# Mappings _budget_mapped has made, less those _budget_unmap has given back: 0 between
# restores. Kept so a test can see that every restore lets its tree go.
var _MAPS_HELD = 0;

# An allocator for `budget` bytes in a mapping of its own, which _budget_unmap gives
# back. The mapping is only an address range until the tree touches it. Where none can
# be had (agnos and cx have no mmap), the allocator uses the heap, as through 1.5.0.
fn _budget_mapped(budget): i64 {
    var al = _budget(budget);
    if (_RESTORE_MAPPED == 0) { return al; }
    var size = (budget + 4095) & (0 - 4096);
    var base = mmap_anon(size);
    if (base != 0) {
        var st = allocator_state(al);
        store64(st + 24, base);
        store64(st + 32, size);
        _MAPS_HELD = _MAPS_HELD + 1;
    }
    return al;
}

fn _budget_unmap(al): i64 {
    var st = allocator_state(al);
    var base = load64(st + 24);
    if (base == 0) { return 0; }
    cyr_munmap(base, load64(st + 32));
    store64(st + 24, 0);
    _MAPS_HELD = _MAPS_HELD - 1;
    return 0;
}

fn _log_build_refused(): i64 {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "snapshot refused: its text runs past the limit of ");
    str_builder_add_int(sb, SAMAY_JSON_MAX_BYTES);
    str_builder_add_cstr(sb, " bytes");
    var msg = str_builder_build(sb);
    sakshi_error(str_data(msg), str_len(msg));
    return 0;
}

fn _log_parse_refused(n): i64 {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "snapshot refused: parsing its ");
    str_builder_add_int(sb, n);
    str_builder_add_cstr(sb, " bytes takes more than ");
    str_builder_add_int(sb, SAMAY_JSON_MAX_EXPANSION);
    str_builder_add_cstr(sb, " times that");
    var msg = str_builder_build(sb);
    sakshi_error(str_data(msg), str_len(msg));
    return 0;
}

# Parse a Str of JSON into a value tree on the heap, or 0 if it is malformed or past a
# limit. Only a writer uses it now, for a tree that becomes part of the document it is
# building; a reader goes through _restore. Calls the explicit buf+len entry
# (bayan_json_v_parse_buf_a): `_str` is a Cyrius dispatch suffix, and the 1-arg
# bayan_json_v_parse form trips a spurious linter arity warning.
fn _parse(s): i64 {
    # A writer past a limit answers 0, and a caller may hand that straight here.
    if (s == 0) { return 0; }
    var n = str_len(s);
    if (_over_byte_limit(n) == 1) { return 0; }
    var al = _budget(n * SAMAY_JSON_MAX_EXPANSION + 4096);
    var v = bayan_json_v_parse_buf_a(al, str_data(s), n);
    # bayan answers 0 when an allocation fails, but whatever it answers, a parse that
    # ran out of budget is refused: a partial tree must not pass for the document.
    if (_budget_refused(al) == 1) {
        _log_parse_refused(n);
        return 0;
    }
    return v;
}

# --- a restore's tree is let go (1.5.1) ---
#
# Once a reader has built its objects the tree is garbage, and alloc() never frees, so
# through 1.5.0 every restore left about six times its document on the heap for good.
# Now the tree goes in a mapping of its own and the mapping goes back when the reader
# returns. That is safe because no reader keeps a pointer into the tree: constructors
# own every Str they keep (1.1.3), the task and node readers copy theirs, and
# ai-hwaccel's profile reader copies its own (2.5.5).

# Parse `s`, give the tree to `reader`, and let the tree go. Malformed, past a limit or
# refused, the answer is 0, as the reader gives for no tree.
fn _restore(s, reader): i64 {
    if (s == 0) { return 0; }
    var n = str_len(s);
    if (_over_byte_limit(n) == 1) { return 0; }
    var al = _budget_mapped(n * SAMAY_JSON_MAX_EXPANSION + 4096);
    var v = bayan_json_v_parse_buf_a(al, str_data(s), n);
    # A parse that ran out of budget is refused whatever bayan answered: a partial tree
    # must not pass for the document.
    if (_budget_refused(al) == 1) {
        _log_parse_refused(n);
        v = 0;
    }
    var out = 0;
    if (v != 0) { out = fncall1(reader, v); }
    _budget_unmap(al);
    return out;
}

# Nullable Str -> json value (null if 0, else string).
fn _jv_opt_str(s): i64 {
    if (s == 0) { return bayan_json_v_null(); }
    return bayan_json_v_str_new(s);
}

# Read a required Str field, or 0 if absent / not a string.
fn _jv_str(obj, key): i64 {
    var el = bayan_json_v_obj_get_by_cstr(obj, key);
    if (el == 0) { return 0; }
    if (bayan_json_v_is_str(el) == 0) { return 0; }
    return bayan_json_v_str(el);
}

# Read a nullable Str field: absent or JSON null -> 0, else the Str.
fn _jv_opt_str_get(obj, key): i64 {
    var el = bayan_json_v_obj_get_by_cstr(obj, key);
    if (el == 0) { return 0; }
    if (bayan_json_v_is_null(el) == 1) { return 0; }
    if (bayan_json_v_is_str(el) == 0) { return 0; }
    return bayan_json_v_str(el);
}

# Read an int field with a default.
fn _jv_int(obj, key, dflt): i64 {
    var el = bayan_json_v_obj_get_by_cstr(obj, key);
    if (el == 0) { return dflt; }
    return bayan_json_v_int(el);
}

# Read an f64 (bit pattern) field with a default.
fn _jv_f64(obj, key, dflt): i64 {
    var el = bayan_json_v_obj_get_by_cstr(obj, key);
    if (el == 0) { return dflt; }
    return bayan_json_v_float(el);
}

# --- restore-side input validation (security hardening, ADR-0005) ---
#
# Snapshots may be untrusted (read from disk/network). The from_jsonv
# deserializers below REJECT a record (return 0) when a required Str field,
# or a required nested struct, is missing OR THE WRONG TYPE — matching Rust
# serde's required-field semantics — so a malformed snapshot fails closed
# instead of producing a poisoned struct that SIGSEGVs later (a null Str
# deref) or corrupts a map (null key). Container loops already skip null
# records, so a bad record is dropped, not fatal.
#
# Numeric fields are CLAMPED to their valid domain rather than rejected, and that
# domain is the constructor's, so a value comes back as it was built (1.4.5). bayan
# maps an overflowing exponent such as 1e400 to +Inf, and cores stop at 1e18 like any
# other value past it.
#
# v1.0.3 closed the "or the wrong type" half for the two nested leaves: they
# used to bridge through their #derive codec, which cannot fail, so every
# wrong-typed value produced a non-zero all-zero struct and the guards here
# were dead code. See _rr_from / _ce_from.

# Ceiling on how many items a restored collection may hold, so a hostile
# snapshot cannot force unbounded allocation. Far above any realistic
# scheduler; caps the anti-catastrophe bound (OOM / minutes-long work).
var SAMAY_JSON_MAX_ITEMS = 100000;

# 1 if a collection is too large to write. Restore refuses a collection past the
# ceiling outright, so a snapshot holding one could never be read back. The writers
# refuse it here instead, while the caller can still prune, and answer 0. They never
# truncate: a partial snapshot would drop records silently (ADR-0011).
fn _over_item_limit(n, what): i64 {
    if (n <= SAMAY_JSON_MAX_ITEMS) { return 0; }
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "snapshot refused: ");
    str_builder_add_int(sb, n);
    str_builder_add_cstr(sb, " ");
    str_builder_add_cstr(sb, what);
    str_builder_add_cstr(sb, ", past the restore limit of ");
    str_builder_add_int(sb, SAMAY_JSON_MAX_ITEMS);
    var msg = str_builder_build(sb);
    sakshi_error(str_data(msg), str_len(msg));
    return 1;
}

# Serialize a tree, or answer 0: for a refused one, and for text past the byte limit,
# which no reader would take. bayan_json_v_build exits the process past ALLOC_MAX
# (2 GiB), so this builds through a budget instead. The builder doubles its buffer, so
# its buffers sum to under 4 times the text, and the text is copied once more: 6 times
# the limit always finishes a document within it.
fn _build_or_0(v): i64 {
    if (v == 0) { return 0; }
    var al = _budget(SAMAY_JSON_MAX_BYTES * 6 + 4096);
    var out = bayan_json_v_build_a(al, v);
    if (_budget_refused(al) == 1) {
        _log_build_refused();
        return 0;
    }
    if (_over_byte_limit(str_len(out)) == 1) { return 0; }
    return out;
}

# Clamp an i64 into [lo, hi].
fn _clamp_i64(x, lo, hi): i64 {
    if (x < lo) { return lo; }
    if (x > hi) { return hi; }
    return x;
}

# Read a flag field normalised to exactly 0 or 1. Anything non-zero is 1, so
# a truthy-but-not-1 value cannot land in a field compared with `== 1`. A JSON
# true is 1: bayan_json_v_int answers 0 for it, which read `"enabled":true` as off.
fn _jv_bool01(obj, key, dflt): i64 {
    var el = bayan_json_v_obj_get_by_cstr(obj, key);
    if (el == 0) { return dflt; }
    if (bayan_json_v_is_bool(el) == 1) { return bayan_json_v_bool(el); }
    if (bayan_json_v_int(el) == 0) { return 0; }
    return 1;
}

# Each of these is 1 if `key` is present and holds the wrong kind of thing. The readers
# above answer 0 for a wrong type, so without them "status":"running" restores as
# QUEUED, "cpu_cores":"8" as no cores at all, and a wrong-typed requirement fits any
# node. A record that fails one is rejected (ADR-0005). An absent key stays the
# reader's business: older snapshots lack some.
fn _jv_not_num(obj, key): i64 {
    var el = bayan_json_v_obj_get_by_cstr(obj, key);
    if (el == 0) { return 0; }
    if (bayan_json_v_is_int(el) == 1) { return 0; }
    if (bayan_json_v_is_float(el) == 1) { return 0; }
    return 1;
}

fn _jv_not_flag(obj, key): i64 {
    var el = bayan_json_v_obj_get_by_cstr(obj, key);
    if (el == 0) { return 0; }
    if (bayan_json_v_is_bool(el) == 1) { return 0; }
    return _jv_not_num(obj, key);
}

# 1 unless `key` is absent, or an array within the ceiling. A collection of the wrong
# type read as empty, so a snapshot with its tasks keyed by id restored as an empty
# scheduler and reported success.
fn _jv_list_ok(obj, key): i64 {
    var el = bayan_json_v_obj_get_by_cstr(obj, key);
    if (el == 0) { return 1; }
    if (bayan_json_v_is_arr(el) == 0) { return 0; }
    if (bayan_json_v_arr_len(el) > SAMAY_JSON_MAX_ITEMS) { return 0; }
    return 1;
}

# Records a restore could not use. A reader drops a bad record and carries on
# (ADR-0005), but samay does not drop anything without saying so.
fn _log_records_dropped(n, what): i64 {
    if (n == 0) { return 0; }
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "restore dropped ");
    str_builder_add_int(sb, n);
    str_builder_add_cstr(sb, " unreadable ");
    str_builder_add_cstr(sb, what);
    var msg = str_builder_build(sb);
    sakshi_warn(str_data(msg), str_len(msg));
    return 0;
}

# An honest writer cannot produce two records under one key. Keeping either would
# strand what the other held, so the whole snapshot is refused.
fn _log_duplicate_key(what, key): i64 {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "snapshot refused: two ");
    str_builder_add_cstr(sb, what);
    str_builder_add_cstr(sb, " named '");
    _samay_log_add(sb, key, 128);
    str_builder_add_cstr(sb, "'");
    var msg = str_builder_build(sb);
    sakshi_error(str_data(msg), str_len(msg));
    return 0;
}

# Read an int field, coerced to its non-negative (u64-like) domain; a
# negative value clamps to 0. Default if absent.
fn _jv_uint(obj, key, dflt): i64 {
    var el = bayan_json_v_obj_get_by_cstr(obj, key);
    if (el == 0) { return dflt; }
    var x = bayan_json_v_int(el);
    if (x < 0) { return 0; }
    return x;
}

# An accelerator profile could not be serialized into the snapshot. Logged,
# never silent — see node_capacity_to_jsonv.
fn _log_profile_skip(node_id): i64 {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "node '");
    _samay_log_add(sb, node_id, 128);
    str_builder_add_cstr(sb, "': accelerator profile omitted from snapshot (unserializable field)");
    var msg = str_builder_build(sb);
    sakshi_warn(str_data(msg), str_len(msg));
    return 0;
}

# 1 if a node record has more profiles than SAMAY_MAX_NODE_DEVICES, and says so. The
# node is refused, as node_capacity_add_accel refuses the profile past it (ADR-0018).
fn _over_device_ceiling(v, nid): i64 {
    var arr = bayan_json_v_obj_get_by_cstr(v, "accel_profiles");
    if (arr == 0) { return 0; }
    if (bayan_json_v_arr_len(arr) <= SAMAY_MAX_NODE_DEVICES) { return 0; }
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "node '");
    _samay_log_add(sb, nid, 128);
    str_builder_add_cstr(sb, "' refused: more accelerator profiles than ");
    str_builder_add_int(sb, SAMAY_MAX_NODE_DEVICES);
    var msg = str_builder_build(sb);
    sakshi_error(str_data(msg), str_len(msg));
    return 1;
}

# A profile samay could not have written: ai-hwaccel's writer always gives its type,
# device and memory, and has since before 1.0.2. Without them a `{}` restored into a
# 184-byte profile, so 3 bytes of text bought 60 of heap, past anything ADR-0014 counted.
fn _profile_shaped(el): i64 {
    if (bayan_json_v_is_obj(el) == 0) { return 0; }
    if (bayan_json_v_obj_get_by_cstr(el, "accel_type_id") == 0) { return 0; }
    if (bayan_json_v_obj_get_by_cstr(el, "device_id") == 0) { return 0; }
    if (bayan_json_v_obj_get_by_cstr(el, "memory_bytes") == 0) { return 0; }
    var bad = _jv_not_num(el, "accel_type_id") + _jv_not_num(el, "device_id") + _jv_not_num(el, "memory_bytes");
    if (bad != 0) { return 0; }
    return 1;
}

fn _log_profile_unshaped(node_id): i64 {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "node '");
    _samay_log_add(sb, node_id, 128);
    str_builder_add_cstr(sb, "': accelerator profile refused on restore (no type, device or memory); capacity lost");
    var msg = str_builder_build(sb);
    sakshi_warn(str_data(msg), str_len(msg));
    return 0;
}

# ai-hwaccel refused an accelerator profile on restore, so the node comes back
# without it. Logged, never silent — see node_capacity_from_jsonv.
fn _log_profile_refused(node_id): i64 {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "node '");
    _samay_log_add(sb, node_id, 128);
    str_builder_add_cstr(sb, "': accelerator profile refused on restore (out of range); capacity lost");
    var msg = str_builder_build(sb);
    sakshi_warn(str_data(msg), str_len(msg));
    return 0;
}

# --- nested leaves ---

# ResourceReq -> json node, built directly. Through 1.4.1 this printed the struct
# with its #derive codec and parsed the text back, which was 72% of the cost of
# serializing a task. The derive is public and stays, so there are two writers of
# this shape: keep these keys and their order the same as the struct's. A field
# added to the struct reaches the derive by itself and has to reach here by hand;
# test_wire_corpus_resource_req fails until it does (1.4.2).
#
# cpu_cores stores the f64 as it is. bayan prints a non-finite one as `null`, the
# same bytes the derive writes. _f64_is_finite is no use for mapping it by hand:
# that gate stops at 1e18, and a larger value is legal on the wire.
fn _rr_node(req): i64 {
    var o = bayan_json_v_obj_new();
    bayan_json_v_obj_set(o, str_from("cpu_cores"), bayan_json_v_float_new(ResourceReq_cpu_cores(req)));
    bayan_json_v_obj_set(o, str_from("memory_mb"), bayan_json_v_int_new(ResourceReq_memory_mb(req)));
    bayan_json_v_obj_set(o, str_from("accel_req"), bayan_json_v_int_new(ResourceReq_accel_req(req)));
    bayan_json_v_obj_set(o, str_from("accel_min_chips"), bayan_json_v_int_new(ResourceReq_accel_min_chips(req)));
    bayan_json_v_obj_set(o, str_from("network"), bayan_json_v_int_new(ResourceReq_network(req)));
    bayan_json_v_obj_set(o, str_from("disk_mb"), bayan_json_v_int_new(ResourceReq_disk_mb(req)));
    # Only a request that is not one whole device writes these, so a snapshot that
    # uses neither is what 1.4.6 wrote (ADR-0016). They go as placement reads them: a 0
    # left by a setter or the derive's decoder is one whole device, and wrote its keys
    # through 1.5.0, which the next restore then dropped. The derive writes them always.
    var devices = _req_devices(req);
    var share = _req_share(req);
    var whole_one = 0;
    if (devices == 1) {
        if (share == SAMAY_ACCEL_WHOLE) { whole_one = 1; }
    }
    if (whole_one == 0) {
        bayan_json_v_obj_set(o, str_from("accel_devices"), bayan_json_v_int_new(devices));
        bayan_json_v_obj_set(o, str_from("accel_share"), bayan_json_v_int_new(share));
    }
    return o;
}

# json node (at key) -> ResourceReq, or 0 if absent / not an object / not
# shaped like a ResourceReq.
#
# Read explicitly rather than through the #derive codec. The derive cannot
# fail: it allocs and returns a pointer whatever it is handed, and alloc is a
# bump allocator over kernel-zeroed pages, so a string / int / array / null /
# {} all yielded a NON-ZERO, all-zero ResourceReq. That made every `req == 0`
# guard downstream dead code, and an all-zero requirement fits any node.
# Reading the fields here also lets the numeric domain be clamped -- negative
# requirements previously ran backwards through node_capacity_reserve, which
# computes `available - required` and so ADDED capacity.
fn _rr_from(obj, key): i64 {
    return _rr_read(bayan_json_v_obj_get_by_cstr(obj, key));
}

fn _rr_read(el): i64 {
    if (el == 0) { return 0; }
    if (bayan_json_v_is_obj(el) == 0) { return 0; }
    # Every field the derive writes, each of which every release since 1.0.2 has written,
    # so a wrong-shaped object is refused too (ADR-0005). Through 1.5.0 only cpu_cores
    # was required, and `{"cpu_cores":1}` read as a request for nothing else.
    if (bayan_json_v_obj_get_by_cstr(el, "cpu_cores") == 0) { return 0; }
    if (bayan_json_v_obj_get_by_cstr(el, "memory_mb") == 0) { return 0; }
    if (bayan_json_v_obj_get_by_cstr(el, "accel_req") == 0) { return 0; }
    if (bayan_json_v_obj_get_by_cstr(el, "accel_min_chips") == 0) { return 0; }
    if (bayan_json_v_obj_get_by_cstr(el, "network") == 0) { return 0; }
    if (bayan_json_v_obj_get_by_cstr(el, "disk_mb") == 0) { return 0; }
    var bad = _jv_not_num(el, "cpu_cores") + _jv_not_num(el, "memory_mb") + _jv_not_num(el, "accel_req")
    + _jv_not_num(el, "accel_min_chips") + _jv_not_flag(el, "network") + _jv_not_num(el, "disk_mb")
    + _jv_not_num(el, "accel_devices") + _jv_not_num(el, "accel_share");
    if (bad != 0) { return 0; }
    # resource_req_new settles the domain, so a huge requirement stays one.
    var req = resource_req_new(
      _jv_f64(el, "cpu_cores", f64_from(0)),
      _jv_uint(el, "memory_mb", 0),
      _jv_int(el, "accel_req", REQ_NONE),
      _jv_uint(el, "accel_min_chips", 0),
      _jv_bool01(el, "network", 0),
      _jv_uint(el, "disk_mb", 0));
    # Absent before 1.5.0, and absent since for one whole device. Settled as the
    # constructors settle them: a share is of one device (ADR-0016).
    var share = _jv_int(el, "accel_share", SAMAY_ACCEL_WHOLE);
    if (share > 0) {
        if (share < SAMAY_ACCEL_WHOLE) { return resource_req_with_share(req, share); }
    }
    return resource_req_with_devices(req, _jv_int(el, "accel_devices", 1));
}

# CronExpr -> json node, built directly. Same reasoning and the same rule as
# _rr_node; test_wire_corpus_cron_expr holds it to the derive.
fn _ce_node(expr): i64 {
    var o = bayan_json_v_obj_new();
    bayan_json_v_obj_set(o, str_from("minute_mask"), bayan_json_v_int_new(CronExpr_minute_mask(expr)));
    bayan_json_v_obj_set(o, str_from("hour_mask"), bayan_json_v_int_new(CronExpr_hour_mask(expr)));
    bayan_json_v_obj_set(o, str_from("dom_mask"), bayan_json_v_int_new(CronExpr_dom_mask(expr)));
    bayan_json_v_obj_set(o, str_from("month_mask"), bayan_json_v_int_new(CronExpr_month_mask(expr)));
    bayan_json_v_obj_set(o, str_from("dow_mask"), bayan_json_v_int_new(CronExpr_dow_mask(expr)));
    bayan_json_v_obj_set(o, str_from("dom_star"), bayan_json_v_int_new(CronExpr_dom_star(expr)));
    bayan_json_v_obj_set(o, str_from("dow_star"), bayan_json_v_int_new(CronExpr_dow_star(expr)));
    return o;
}

# 1 if `key` is a number with at least one bit set and none outside `valid`: the
# values its field can take. An empty mask, or one with only bits no expression sets
# (Sunday as 7, minute 60), restored into an entry that never fired, with no log line.
fn _ce_mask_ok(el, key, valid): i64 {
    if (bayan_json_v_obj_get_by_cstr(el, key) == 0) { return 0; }
    if (_jv_not_num(el, key) == 1) { return 0; }
    var m = _jv_int(el, key, 0);
    if (m == 0) { return 0; }
    if ((m & valid) != m) { return 0; }
    return 1;
}

# A star flag, or, absent, what the mask says: a whole field is a star. 1.0.2 wrote no
# flags, and reading one as 0 put an expression such as `0 0 1 * *` under the OR rule,
# firing daily instead of monthly.
fn _ce_star(el, key, mask, whole): i64 {
    if (bayan_json_v_obj_get_by_cstr(el, key) != 0) { return _jv_bool01(el, key, 0); }
    if (mask == whole) { return 1; }
    return 0;
}

# json node (at key) -> CronExpr, or 0 if absent / not an object / not
# shaped like a CronExpr. Same reasoning as _rr_from: the derive bridge could
# not fail, so a wrong-typed `expr` produced an all-zero CronExpr whose masks
# match nothing -- an entry that silently never fires.
fn _ce_from(obj, key): i64 {
    return _ce_read(bayan_json_v_obj_get_by_cstr(obj, key));
}

fn _ce_read(el): i64 {
    if (el == 0) { return 0; }
    if (bayan_json_v_is_obj(el) == 0) { return 0; }
    # Every mask, a number, and one an expression could produce: a missing one reads as
    # 0, which matches nothing. Minutes 0-59, hours 0-23, days 1-31, months 1-12, days of
    # the week 0-6 (the parser folds 7 to 0).
    if (_ce_mask_ok(el, "minute_mask", (1 << 60) - 1) == 0) { return 0; }
    if (_ce_mask_ok(el, "hour_mask", (1 << 24) - 1) == 0) { return 0; }
    if (_ce_mask_ok(el, "dom_mask", (1 << 32) - 2) == 0) { return 0; }
    if (_ce_mask_ok(el, "month_mask", (1 << 13) - 2) == 0) { return 0; }
    if (_ce_mask_ok(el, "dow_mask", (1 << 7) - 1) == 0) { return 0; }
    if (_jv_not_flag(el, "dom_star") + _jv_not_flag(el, "dow_star") != 0) { return 0; }
    var p = alloc(56);   # 7 fields * 8 — mirrors cron_expr_parse
    # NOT `return 0`: this function already returns 0 for ADR-0005's "absent or
    # wrong type -> reject this record", and the container readers act on that
    # by dropping the record and continuing. An OOM-0 would delete a
    # well-formed record from a valid snapshot while reporting success.
    if (p == 0) { panic("samay: out of memory in _ce_from"); }
    CronExpr_set_minute_mask(p, _jv_int(el, "minute_mask", 0));
    CronExpr_set_hour_mask(p, _jv_int(el, "hour_mask", 0));
    CronExpr_set_dom_mask(p, _jv_int(el, "dom_mask", 0));
    CronExpr_set_month_mask(p, _jv_int(el, "month_mask", 0));
    CronExpr_set_dow_mask(p, _jv_int(el, "dow_mask", 0));
    # The star flags drive the Vixie AND/OR branch and are compared with
    # `== 1`, so they must be exactly 0 or 1.
    CronExpr_set_dom_star(p, _ce_star(el, "dom_star", CronExpr_dom_mask(p), (1 << 32) - 2));
    CronExpr_set_dow_star(p, _ce_star(el, "dow_star", CronExpr_dow_mask(p), (1 << 7) - 1));
    return p;
}

# --- the derived leaves, read with checks (1.4.5) ---
#
# #derive(Serialize) emits T_from_json and T_from_json_str too, and neither can refuse
# anything: `{}` gives a SchedulingDecision of null Strs, which crashes the first
# writer it meets. samay never calls them. These read the same text, take every field
# the derive writes, and answer 0 for one missing or of the wrong type (ADR-0005). A
# ResourceReq and a CronExpr read as they do nested in a snapshot.

fn resource_req_from_json_str(s): i64 { return _restore(s, &_rr_read); }

fn cron_expr_from_json_str(s): i64 { return _restore(s, &_ce_read); }

# 1 if `key` is present and a number.
fn _jv_has_num(v, key): i64 {
    if (bayan_json_v_obj_get_by_cstr(v, key) == 0) { return 0; }
    return 1 - _jv_not_num(v, key);
}

fn scheduling_decision_from_json_str(s): i64 { return _restore(s, &_sd_read); }

fn _sd_read(v): i64 {
    if (bayan_json_v_is_obj(v) == 0) { return 0; }
    var tid = _jv_str(v, "task_id");
    var node = _jv_str(v, "assigned_node");
    var reason = _jv_str(v, "reason");
    if (tid == 0) { return 0; }
    if (node == 0) { return 0; }
    if (reason == 0) { return 0; }
    if (_jv_has_num(v, "score") == 0) { return 0; }
    # A score past what a writer can carry (1e400 reads as +Inf) wrote back as null, and
    # did not read back (1.5.1).
    var score = _jv_f64(v, "score", f64_from(0));
    if (_f64_is_finite(score) == 0) { return 0; }
    return scheduling_decision_new(tid, node, reason, score);
}

fn preemption_action_from_json_str(s): i64 { return _restore(s, &_pa_read); }

fn _pa_read(v): i64 {
    if (bayan_json_v_is_obj(v) == 0) { return 0; }
    var victim = _jv_str(v, "preempted_task_id");
    var by = _jv_str(v, "preempting_task_id");
    var reason = _jv_str(v, "reason");
    if (victim == 0) { return 0; }
    if (by == 0) { return 0; }
    if (reason == 0) { return 0; }
    return preemption_action_new(victim, by, reason);
}

fn scheduler_stats_from_json_str(s): i64 { return _restore(s, &_ss_read); }

fn _ss_read(v): i64 {
    if (bayan_json_v_is_obj(v) == 0) { return 0; }
    var have = _jv_has_num(v, "total_tasks") + _jv_has_num(v, "queued") + _jv_has_num(v, "running")
    + _jv_has_num(v, "completed") + _jv_has_num(v, "failed") + _jv_has_num(v, "average_wait_time_ms")
    + _jv_has_num(v, "average_run_time_ms");
    if (have != 7) { return 0; }
    var st = scheduler_stats_new();
    SchedulerStats_set_total_tasks(st, _jv_int(v, "total_tasks", 0));
    SchedulerStats_set_queued(st, _jv_int(v, "queued", 0));
    SchedulerStats_set_running(st, _jv_int(v, "running", 0));
    SchedulerStats_set_completed(st, _jv_int(v, "completed", 0));
    SchedulerStats_set_failed(st, _jv_int(v, "failed", 0));
    SchedulerStats_set_average_wait_time_ms(st, _jv_int(v, "average_wait_time_ms", 0));
    SchedulerStats_set_average_run_time_ms(st, _jv_int(v, "average_run_time_ms", 0));
    return st;
}

# ---------------------------------------------------------------------------
# TrainingJobTemplate — scalar/Str + nullable target_node (no nesting)
# ---------------------------------------------------------------------------

fn training_job_template_to_jsonv(t): i64 {
    var o = bayan_json_v_obj_new();
    bayan_json_v_obj_set(o, str_from("model_id"), bayan_json_v_str_new(TrainingJobTemplate_model_id(t)));
    bayan_json_v_obj_set(o, str_from("method"), bayan_json_v_int_new(TrainingJobTemplate_method(t)));
    bayan_json_v_obj_set(o, str_from("dataset"), bayan_json_v_str_new(TrainingJobTemplate_dataset(t)));
    bayan_json_v_obj_set(o, str_from("target_node"), _jv_opt_str(TrainingJobTemplate_target_node(t)));
    var md = bayan_json_v_int_new(TrainingJobTemplate_max_duration_secs(t));
    bayan_json_v_obj_set(o, str_from("max_duration_secs"), md);
    var ck = bayan_json_v_int_new(TrainingJobTemplate_checkpoint_interval_secs(t));
    bayan_json_v_obj_set(o, str_from("checkpoint_interval_secs"), ck);
    return o;
}

fn training_job_template_from_jsonv(v): i64 {
    if (v == 0) { return 0; }
    if (bayan_json_v_is_obj(v) == 0) { return 0; }
    var model = _jv_str(v, "model_id");
    var dataset = _jv_str(v, "dataset");
    if (model == 0) { return 0; }
    if (dataset == 0) { return 0; }
    var bad = _jv_not_num(v, "method") + _jv_not_num(v, "max_duration_secs")
    + _jv_not_num(v, "checkpoint_interval_secs");
    if (bad != 0) { return 0; }
    # A method samay does not know is kept, as the constructor keeps it: it is named
    # "unknown" and asks for a GPU or a TPU. Through 1.4.4 it read back as LoRA.
    return training_job_template_new(
      model,
      _jv_int(v, "method", TM_LORA),
      dataset,
      _jv_opt_str_get(v, "target_node"),
      _jv_uint(v, "max_duration_secs", 0),
      _jv_uint(v, "checkpoint_interval_secs", 0));
}

fn training_job_template_to_json_str(t): i64 { return _build_or_0(training_job_template_to_jsonv(t)); }
fn training_job_template_from_json_str(s): i64 { return _restore(s, &training_job_template_from_jsonv); }

# ---------------------------------------------------------------------------
# CronTaskTemplate — scalar/Str + nested ResourceReq
# ---------------------------------------------------------------------------

fn cron_task_template_to_jsonv(t): i64 {
    var o = bayan_json_v_obj_new();
    bayan_json_v_obj_set(o, str_from("name"), bayan_json_v_str_new(CronTaskTemplate_name(t)));
    bayan_json_v_obj_set(o, str_from("description"), bayan_json_v_str_new(CronTaskTemplate_description(t)));
    bayan_json_v_obj_set(o, str_from("agent_id"), bayan_json_v_str_new(CronTaskTemplate_agent_id(t)));
    bayan_json_v_obj_set(o, str_from("priority"), bayan_json_v_int_new(CronTaskTemplate_priority(t)));
    bayan_json_v_obj_set(o, str_from("resource_requirements"), _rr_node(CronTaskTemplate_resource_requirements(t)));
    return o;
}

fn cron_task_template_from_jsonv(v): i64 {
    if (v == 0) { return 0; }
    if (bayan_json_v_is_obj(v) == 0) { return 0; }
    var name = _jv_str(v, "name");
    var desc = _jv_str(v, "description");
    var agent = _jv_str(v, "agent_id");
    var req = _rr_from(v, "resource_requirements");
    if (name == 0) { return 0; }
    if (desc == 0) { return 0; }
    if (agent == 0) { return 0; }
    if (req == 0) { return 0; }
    if (_jv_not_num(v, "priority") == 1) { return 0; }
    return cron_task_template_new(
      name, desc, agent,
      _clamp_i64(_jv_int(v, "priority", 5), 1, 10),
      req);
}

fn cron_task_template_to_json_str(t): i64 { return _build_or_0(cron_task_template_to_jsonv(t)); }
fn cron_task_template_from_json_str(s): i64 { return _restore(s, &cron_task_template_from_jsonv); }

# ---------------------------------------------------------------------------
# ScheduledTask — nested ResourceReq + nullable fail_reason and node fields
# ---------------------------------------------------------------------------

# A nullable Str the task keeps, so it must own it: the tree may be arena-allocated
# and reset the moment this returns.
fn _own_opt(v, key): i64 {
    return _samay_own(_jv_opt_str_get(v, key), "samay: out of memory in scheduled_task_from_jsonv");
}

# Rebuild a ScheduledTask from its raw stored state. scheduled_task_new
# generates a fresh uuid and stamps created_at via dt_now(), so it can't be
# used for restore; this sets every field from the document directly.
fn scheduled_task_from_jsonv(v): i64 {
    if (v == 0) { return 0; }
    if (bayan_json_v_is_obj(v) == 0) { return 0; }
    var tid = _jv_str(v, "task_id");
    var name = _jv_str(v, "name");
    var desc = _jv_str(v, "description");
    var agent = _jv_str(v, "agent_id");
    var req = _rr_from(v, "resource_requirements");
    if (tid == 0) { return 0; }
    if (name == 0) { return 0; }
    if (desc == 0) { return 0; }
    if (agent == 0) { return 0; }
    if (req == 0) { return 0; }
    # task_id is a map key; an empty one collides with any other empty one.
    if (str_len(tid) == 0) { return 0; }
    var bad = _jv_not_num(v, "priority") + _jv_not_num(v, "status") + _jv_not_num(v, "created_at")
    + _jv_not_num(v, "scheduled_at") + _jv_not_num(v, "started_at") + _jv_not_num(v, "completed_at")
    + _jv_not_num(v, "deadline");
    if (bad != 0) { return 0; }
    var st = _jv_int(v, "status", TASK_QUEUED);
    if (st < TASK_QUEUED) { st = TASK_QUEUED; }
    if (st > TASK_PREEMPTED) { st = TASK_QUEUED; }
    var p = alloc(128);   # 16 fields * 8 — MUST track scheduled_task_new
    if (p == 0) { panic("samay: out of memory in scheduled_task_from_jsonv"); }
    ScheduledTask_set_task_id(p, _samay_own(tid, "samay: out of memory in scheduled_task_from_jsonv"));
    ScheduledTask_set_name(p, _samay_own(name, "samay: out of memory in scheduled_task_from_jsonv"));
    ScheduledTask_set_description(p, _samay_own(desc, "samay: out of memory in scheduled_task_from_jsonv"));
    ScheduledTask_set_agent_id(p, _samay_own(agent, "samay: out of memory in scheduled_task_from_jsonv"));
    ScheduledTask_set_priority(p, _clamp_i64(_jv_int(v, "priority", 1), 1, 10));
    ScheduledTask_set_resource_requirements(p, req);
    ScheduledTask_set_status(p, st);
    ScheduledTask_set_fail_reason(p, _own_opt(v, "fail_reason"));
    ScheduledTask_set_created_at(p, _jv_int(v, "created_at", 0));
    ScheduledTask_set_scheduled_at(p, _jv_int(v, "scheduled_at", 0));
    ScheduledTask_set_started_at(p, _jv_int(v, "started_at", 0));
    ScheduledTask_set_completed_at(p, _jv_int(v, "completed_at", 0));
    ScheduledTask_set_deadline(p, _jv_int(v, "deadline", 0));
    # The wire's `node_preference` is the one-field view: the assigned node once
    # placed, else the request (ADR-0010). Snapshots since v1.3.0 also carry each
    # on its own. An older one has only the view. Placing a task overwrote its
    # request, so a placed task's view is its assignment and its request is gone.
    # That view stays as the request: it may be real, and it is how 1.2.x read it.
    var npref = _own_opt(v, "node_preference");
    if (bayan_json_v_obj_get_by_cstr(v, "requested_node") == 0) {
        ScheduledTask_set_requested_node(p, npref);
    } else {
        ScheduledTask_set_requested_node(p, _own_opt(v, "requested_node"));
    }
    if (bayan_json_v_obj_get_by_cstr(v, "assigned_node") == 0) {
        var placed = npref;
        if (ScheduledTask_scheduled_at(p) == 0) {
            if (st != TASK_SCHEDULED) {
                if (st != TASK_RUNNING) { placed = 0; }
            }
        }
        ScheduledTask_set_assigned_node(p, placed);
    } else {
        ScheduledTask_set_assigned_node(p, _own_opt(v, "assigned_node"));
    }
    # Back-compat: snapshots written before v1.0.3 carry no `reserved_on`.
    # A task that was SCHEDULED or RUNNING did hold a reservation, and
    # schedule_pending had written the assigned node into node_preference, so
    # the held-reservation state is reconstructable. Absent key vs explicit
    # null matters here, so test the key rather than the decoded value.
    if (bayan_json_v_obj_get_by_cstr(v, "reserved_on") == 0) {
        var ron = 0;
        if (st == TASK_SCHEDULED) { ron = npref; }
        if (st == TASK_RUNNING) { ron = npref; }
        ScheduledTask_set_reserved_on(p, ron);
    } else {
        ScheduledTask_set_reserved_on(p, _own_opt(v, "reserved_on"));
    }
    return p;
}

fn scheduled_task_to_jsonv(t): i64 {
    var o = bayan_json_v_obj_new();
    bayan_json_v_obj_set(o, str_from("task_id"), bayan_json_v_str_new(ScheduledTask_task_id(t)));
    bayan_json_v_obj_set(o, str_from("name"), bayan_json_v_str_new(ScheduledTask_name(t)));
    bayan_json_v_obj_set(o, str_from("description"), bayan_json_v_str_new(ScheduledTask_description(t)));
    bayan_json_v_obj_set(o, str_from("agent_id"), bayan_json_v_str_new(ScheduledTask_agent_id(t)));
    bayan_json_v_obj_set(o, str_from("priority"), bayan_json_v_int_new(ScheduledTask_priority(t)));
    bayan_json_v_obj_set(o, str_from("resource_requirements"), _rr_node(ScheduledTask_resource_requirements(t)));
    bayan_json_v_obj_set(o, str_from("status"), bayan_json_v_int_new(ScheduledTask_status(t)));
    bayan_json_v_obj_set(o, str_from("fail_reason"), _jv_opt_str(ScheduledTask_fail_reason(t)));
    bayan_json_v_obj_set(o, str_from("created_at"), bayan_json_v_int_new(ScheduledTask_created_at(t)));
    bayan_json_v_obj_set(o, str_from("scheduled_at"), bayan_json_v_int_new(ScheduledTask_scheduled_at(t)));
    bayan_json_v_obj_set(o, str_from("started_at"), bayan_json_v_int_new(ScheduledTask_started_at(t)));
    bayan_json_v_obj_set(o, str_from("completed_at"), bayan_json_v_int_new(ScheduledTask_completed_at(t)));
    bayan_json_v_obj_set(o, str_from("deadline"), bayan_json_v_int_new(ScheduledTask_deadline(t)));
    bayan_json_v_obj_set(o, str_from("node_preference"), _jv_opt_str(ScheduledTask_node_preference(t)));
    bayan_json_v_obj_set(o, str_from("reserved_on"), _jv_opt_str(ScheduledTask_reserved_on(t)));
    bayan_json_v_obj_set(o, str_from("requested_node"), _jv_opt_str(ScheduledTask_requested_node(t)));
    bayan_json_v_obj_set(o, str_from("assigned_node"), _jv_opt_str(ScheduledTask_assigned_node(t)));
    return o;
}

fn scheduled_task_to_json_str(t): i64 { return _build_or_0(scheduled_task_to_jsonv(t)); }
fn scheduled_task_from_json_str(s): i64 { return _restore(s, &scheduled_task_from_jsonv); }

# ---------------------------------------------------------------------------
# NodeCapacity — f64 fields + a vec of ai-hwaccel accelerator profiles
# ---------------------------------------------------------------------------

fn node_capacity_to_jsonv(node): i64 {
    if (_over_item_limit(vec_len(NodeCapacity_accel_profiles(node)), "accelerator profiles") == 1) { return 0; }
    var o = bayan_json_v_obj_new();
    bayan_json_v_obj_set(o, str_from("node_id"), bayan_json_v_str_new(NodeCapacity_node_id(node)));
    bayan_json_v_obj_set(o, str_from("total_cpu"), bayan_json_v_float_new(NodeCapacity_total_cpu(node)));
    bayan_json_v_obj_set(o, str_from("available_cpu"), bayan_json_v_float_new(NodeCapacity_available_cpu(node)));
    bayan_json_v_obj_set(o, str_from("total_memory_mb"), bayan_json_v_int_new(NodeCapacity_total_memory_mb(node)));
    var amem = bayan_json_v_int_new(NodeCapacity_available_memory_mb(node));
    bayan_json_v_obj_set(o, str_from("available_memory_mb"), amem);
    bayan_json_v_obj_set(o, str_from("total_disk_mb"), bayan_json_v_int_new(NodeCapacity_total_disk_mb(node)));
    bayan_json_v_obj_set(o, str_from("available_disk_mb"), bayan_json_v_int_new(NodeCapacity_available_disk_mb(node)));
    bayan_json_v_obj_set(o, str_from("running_tasks"), bayan_json_v_int_new(NodeCapacity_running_tasks(node)));
    # accelerator profiles -> array; each profile via ai-hwaccel's codec.
    var arr = bayan_json_v_arr_new();
    var profs = NodeCapacity_accel_profiles(node);
    var n = vec_len(profs);
    var i = 0;
    while (i < n) {
        var psb = str_builder_new();
        profile_to_json(psb, vec_get(profs, i));
        # Through ai-hwaccel 2.5.4 the serializer wrote string values without
        # JSON escaping, so a device_name/driver_version with a quote or a
        # backslash produced text _parse could not read. 2.5.5 escapes them.
        # This guard stays for any other text _parse refuses: pushing the
        # resulting 0 makes bayan render the child as the literal `null`, and
        # restore then drops the accelerator — a node that could fit a GPU
        # task stops being able to, purely by round-tripping. Skip and log
        # instead: a logged omission beats data-losing output, and the rest
        # of the snapshot stays intact (samay never silently drops).
        var pv = _parse(str_builder_build(psb));
        if (pv == 0) {
            _log_profile_skip(NodeCapacity_node_id(node));
        } else {
            bayan_json_v_arr_push(arr, pv);
        }
        i = i + 1;
    }
    bayan_json_v_obj_set(o, str_from("accel_profiles"), arr);
    return o;
}

fn node_capacity_from_jsonv(v): i64 {
    if (v == 0) { return 0; }
    if (bayan_json_v_is_obj(v) == 0) { return 0; }
    var nid = _jv_str(v, "node_id");
    if (nid == 0) { return 0; }
    if (str_len(nid) == 0) { return 0; }
    var bad = _jv_not_num(v, "total_cpu") + _jv_not_num(v, "available_cpu") + _jv_not_num(v, "total_memory_mb")
    + _jv_not_num(v, "available_memory_mb") + _jv_not_num(v, "total_disk_mb")
    + _jv_not_num(v, "available_disk_mb") + _jv_not_num(v, "running_tasks");
    if (bad != 0) { return 0; }
    if (_jv_list_ok(v, "accel_profiles") == 0) { return 0; }
    if (_over_device_ceiling(v, nid) == 1) { return 0; }
    var p = alloc(96);   # 12 fields * 8 — MUST track node_capacity_new
    if (p == 0) { panic("samay: out of memory in node_capacity_from_jsonv"); }
    NodeCapacity_set_node_id(p, _samay_own(nid, "samay: out of memory in node_capacity_from_jsonv"));
    _node_init_holds(p);
    # Enforce `available <= total` on all three axes. Without it a
    # snapshot carrying available_cpu=1e18 against total_cpu=1.0 gives a
    # hugely negative utilization, and that node then wins every
    # _best_fit_node argmin forever. Cores take node_capacity_new's domain.
    # Available can be below zero: an over-committed node writes that, and the
    # tasks settle every node anyway (1.5.1, ADR-0007).
    var tcpu = _req_cpu(_jv_f64(v, "total_cpu", f64_from(0)));
    var acpu = _jv_f64(v, "available_cpu", f64_from(0));
    if (f64_eq(acpu, acpu) == 0) { acpu = f64_from(0); }
    if (f64_lt(acpu, f64_sub(f64_from(0), f64_from(1000000000000000000))) == 1) {
        acpu = f64_sub(f64_from(0), f64_from(1000000000000000000));
    }
    if (f64_gt(acpu, tcpu) == 1) { acpu = tcpu; }
    NodeCapacity_set_total_cpu(p, tcpu);
    NodeCapacity_set_available_cpu(p, acpu);
    var tmem = _jv_uint(v, "total_memory_mb", 0);
    var amem = _jv_int(v, "available_memory_mb", 0);
    if (amem < _CAPACITY_FLOOR) { amem = _CAPACITY_FLOOR; }
    if (amem > tmem) { amem = tmem; }
    NodeCapacity_set_total_memory_mb(p, tmem);
    NodeCapacity_set_available_memory_mb(p, amem);
    var tdisk = _jv_uint(v, "total_disk_mb", 0);
    var adisk = _jv_int(v, "available_disk_mb", 0);
    if (adisk < _CAPACITY_FLOOR) { adisk = _CAPACITY_FLOOR; }
    if (adisk > tdisk) { adisk = tdisk; }
    NodeCapacity_set_total_disk_mb(p, tdisk);
    NodeCapacity_set_available_disk_mb(p, adisk);
    NodeCapacity_set_running_tasks(p, _jv_uint(v, "running_tasks", 0));
    # Same shape as node_capacity_new's accel_profiles bug, on the restore
    # path: a null vec stored here returns a struct that looks healthy.
    var profs = vec_new();
    if (profs == 0) { panic("samay: out of memory in node_capacity_from_jsonv (accel_profiles)"); }
    var arr = bayan_json_v_obj_get_by_cstr(v, "accel_profiles");
    if (arr != 0) {
        var n = bayan_json_v_arr_len(arr);
        var i = 0;
        while (i < n) {
            # ai-hwaccel's profile_from_json takes a json_v node directly. Since
            # 2.5.5 it refuses out-of-range values, and that can reach a profile
            # samay wrote itself: past 16,384 TPU chips (2.5.6's bound), or past
            # 16 TiB of device memory. The node stays, without that profile, so
            # this is a real capacity loss and it is logged (samay never
            # silently drops).
            var el = bayan_json_v_arr_get(arr, i);
            if (_profile_shaped(el) == 0) {
                _log_profile_unshaped(nid);
            } else {
                var prof = profile_from_json(el);
                if (prof != 0) {
                    vec_push(profs, prof);
                } else {
                    _log_profile_refused(nid);
                }
            }
            i = i + 1;
        }
    }
    NodeCapacity_set_accel_profiles(p, profs);
    return p;
}

fn node_capacity_to_json_str(node): i64 { return _build_or_0(node_capacity_to_jsonv(node)); }
fn node_capacity_from_json_str(s): i64 { return _restore(s, &node_capacity_from_jsonv); }

# ---------------------------------------------------------------------------
# CronEntry — nested CronExpr + nested CronTaskTemplate
# ---------------------------------------------------------------------------

fn cron_entry_to_jsonv(e): i64 {
    var o = bayan_json_v_obj_new();
    bayan_json_v_obj_set(o, str_from("name"), bayan_json_v_str_new(CronEntry_name(e)));
    bayan_json_v_obj_set(o, str_from("expr"), _ce_node(CronEntry_expr(e)));
    bayan_json_v_obj_set(o, str_from("task_template"), cron_task_template_to_jsonv(CronEntry_task_template(e)));
    bayan_json_v_obj_set(o, str_from("enabled"), bayan_json_v_int_new(CronEntry_enabled(e)));
    bayan_json_v_obj_set(o, str_from("last_fired"), bayan_json_v_int_new(CronEntry_last_fired(e)));
    bayan_json_v_obj_set(o, str_from("missed_policy"), bayan_json_v_int_new(CronEntry_missed_policy(e)));
    # Written only when set, so an entry that needs neither keeps 1.5.0's bytes. Without
    # the first, a restored disabled entry said again that it gave up time it never owed;
    # without the second, a clock reset could not be undone across a restore (ADR-0006).
    if (CronEntry_enabled(e) == 0) {
        if (CronEntry_disabled_seen(e) == 1) {
            bayan_json_v_obj_set(o, str_from("disabled_seen"), bayan_json_v_int_new(1));
        }
    }
    if (CronEntry_reset_from(e) != 0) {
        bayan_json_v_obj_set(o, str_from("reset_from"), bayan_json_v_int_new(CronEntry_reset_from(e)));
    }
    return o;
}

fn cron_entry_from_jsonv(v): i64 {
    if (v == 0) { return 0; }
    if (bayan_json_v_is_obj(v) == 0) { return 0; }
    var name = _jv_str(v, "name");
    var expr = _ce_from(v, "expr");
    var tmpl = cron_task_template_from_jsonv(bayan_json_v_obj_get_by_cstr(v, "task_template"));
    if (name == 0) { return 0; }
    if (expr == 0) { return 0; }
    if (tmpl == 0) { return 0; }
    # Both public add paths reject an empty name (src/cron.cyr); restore
    # writes the map directly, so it has to enforce the same invariant.
    if (str_len(name) == 0) { return 0; }
    var bad = _jv_not_flag(v, "enabled") + _jv_not_num(v, "last_fired") + _jv_not_num(v, "missed_policy")
    + _jv_not_flag(v, "disabled_seen") + _jv_not_num(v, "reset_from");
    if (bad != 0) { return 0; }
    var mp = _jv_int(v, "missed_policy", CRON_CATCHUP);
    if (mp != CRON_SKIP) { mp = CRON_CATCHUP; }
    # `enabled` is compared with `== 1`, so a truthy-but-not-1 value would
    # leave the entry permanently dormant while reporting as enabled.
    var e = cron_entry_new(name, expr, tmpl, _jv_bool01(v, "enabled", 1), mp);
    CronEntry_set_last_fired(e, _jv_uint(v, "last_fired", 0));
    if (CronEntry_enabled(e) == 0) { CronEntry_set_disabled_seen(e, _jv_bool01(v, "disabled_seen", 0)); }
    CronEntry_set_reset_from(e, _jv_uint(v, "reset_from", 0));
    return e;
}

fn cron_entry_to_json_str(e): i64 { return _build_or_0(cron_entry_to_jsonv(e)); }
fn cron_entry_from_json_str(s): i64 { return _restore(s, &cron_entry_from_jsonv); }

# ---------------------------------------------------------------------------
# CronScheduler — map of CronEntry keyed by name
#
# Maps serialize as arrays sorted by key, so output is deterministic regardless
# of hashmap iteration order (domain principle).
# ---------------------------------------------------------------------------

fn cron_scheduler_to_jsonv(c): i64 {
    var vals = map_values(CronScheduler_entries(c));
    if (_over_item_limit(vec_len(vals), "cron entries") == 1) { return 0; }
    var o = bayan_json_v_obj_new();
    var arr = bayan_json_v_arr_new();
    vec_sort_by(vals, &_entry_name_cmp);
    var n = vec_len(vals);
    var i = 0;
    while (i < n) {
        bayan_json_v_arr_push(arr, cron_entry_to_jsonv(vec_get(vals, i)));
        i = i + 1;
    }
    bayan_json_v_obj_set(o, str_from("entries"), arr);
    return o;
}

fn cron_scheduler_from_jsonv(v): i64 {
    if (v == 0) { return 0; }
    if (bayan_json_v_is_obj(v) == 0) { return 0; }
    if (_jv_list_ok(v, "entries") == 0) { return 0; }
    var c = cron_scheduler_new();
    var arr = bayan_json_v_obj_get_by_cstr(v, "entries");
    if (arr != 0) {
        var n = bayan_json_v_arr_len(arr);
        var dropped = 0;
        var i = 0;
        while (i < n) {
            var e = cron_entry_from_jsonv(bayan_json_v_arr_get(arr, i));
            if (e == 0) {
                dropped = dropped + 1;
            } else {
                if (map_has(CronScheduler_entries(c), CronEntry_name(e)) == 1) {
                    _log_duplicate_key("cron entries", CronEntry_name(e));
                    return 0;
                }
                map_set(CronScheduler_entries(c), CronEntry_name(e), e);
            }
            i = i + 1;
        }
        _log_records_dropped(dropped, "cron entries");
    }
    return c;
}

fn cron_scheduler_to_json_str(c): i64 { return _build_or_0(cron_scheduler_to_jsonv(c)); }
fn cron_scheduler_from_json_str(s): i64 { return _restore(s, &cron_scheduler_from_jsonv); }

# ---------------------------------------------------------------------------
# TaskScheduler — tasks map + nodes map (the top-level snapshot)
# ---------------------------------------------------------------------------

fn task_scheduler_to_jsonv(s): i64 {
    var tvals = map_values(TaskScheduler_tasks(s));
    var nvals = map_values(TaskScheduler_nodes(s));
    if (_over_item_limit(vec_len(tvals), "tasks") == 1) { return 0; }
    if (_over_item_limit(vec_len(nvals), "nodes") == 1) { return 0; }
    var o = bayan_json_v_obj_new();
    var tarr = bayan_json_v_arr_new();
    vec_sort_by(tvals, &_task_id_cmp);
    var tn = vec_len(tvals);
    var list = vec_new();
    if (list == 0) { panic("samay: out of memory in task_scheduler_to_jsonv"); }
    var ti = 0;
    while (ti < tn) {
        var t = vec_get(tvals, ti);
        var tj = scheduled_task_to_jsonv(t);
        _held_profiles_node(s, t, tj, list);
        bayan_json_v_arr_push(tarr, tj);
        ti = ti + 1;
    }
    bayan_json_v_obj_set(o, str_from("tasks"), tarr);
    var narr = bayan_json_v_arr_new();
    vec_sort_by(nvals, &_node_id_cmp);
    var nn = vec_len(nvals);
    var ni = 0;
    while (ni < nn) {
        var nj = node_capacity_to_jsonv(vec_get(nvals, ni));
        if (nj == 0) { return 0; }
        bayan_json_v_arr_push(narr, nj);
        ni = ni + 1;
    }
    bayan_json_v_obj_set(o, str_from("nodes"), narr);
    return o;
}

# A task holding devices records which, as profile indices on its node, so a restore
# takes exactly those. Rebuilt by replay in placement order, they double-booked a device
# once a task between them had finished (1.5.1, ADR-0018). Written only for a task that
# holds a device, so a snapshot without any is what 1.5.0 wrote.
fn _held_profiles_node(s, t, tj, list): i64 {
    var ron = ScheduledTask_reserved_on(t);
    if (ron == 0) { return 0; }
    var node = map_get(TaskScheduler_nodes(s), ron);
    if (node == 0) { return 0; }
    if (_accel_held_list(node, ScheduledTask_resource_requirements(t), list) == 0) { return 0; }
    var arr = bayan_json_v_arr_new();
    var n = vec_len(list);
    var i = 0;
    while (i < n) {
        bayan_json_v_arr_push(arr, bayan_json_v_int_new(vec_get(list, i)));
        i = i + 1;
    }
    bayan_json_v_obj_set(tj, str_from("held_profiles"), arr);
    return 0;
}

# A task's recorded profile indices as a vec, 0 if it has none, or -1 if the key is not a
# list of whole numbers no longer than SAMAY_MAX_NODE_DEVICES, which refuses the task.
fn _held_profiles_read(el): i64 {
    var arr = bayan_json_v_obj_get_by_cstr(el, "held_profiles");
    if (arr == 0) { return 0; }
    if (bayan_json_v_is_arr(arr) == 0) { return 0 - 1; }
    var n = bayan_json_v_arr_len(arr);
    if (n > SAMAY_MAX_NODE_DEVICES) { return 0 - 1; }
    var list = vec_new();
    if (list == 0) { panic("samay: out of memory in _held_profiles_read"); }
    var i = 0;
    while (i < n) {
        var x = bayan_json_v_arr_get(arr, i);
        if (bayan_json_v_is_int(x) == 0) { return 0 - 1; }
        vec_push(list, bayan_json_v_int(x));
        i = i + 1;
    }
    return list;
}

fn task_scheduler_from_jsonv(v): i64 {
    if (v == 0) { return 0; }
    if (bayan_json_v_is_obj(v) == 0) { return 0; }
    if (_jv_list_ok(v, "tasks") == 0) { return 0; }
    if (_jv_list_ok(v, "nodes") == 0) { return 0; }
    var s = task_scheduler_new();
    var recorded = map_new_str();
    if (recorded == 0) { panic("samay: out of memory in task_scheduler_from_jsonv"); }
    var dropped = 0;
    var tarr = bayan_json_v_obj_get_by_cstr(v, "tasks");
    if (tarr != 0) {
        var tn = bayan_json_v_arr_len(tarr);
        var ti = 0;
        while (ti < tn) {
            var tel = bayan_json_v_arr_get(tarr, ti);
            var t = scheduled_task_from_jsonv(tel);
            var held = 0;
            if (t != 0) { held = _held_profiles_read(tel); }
            if (held < 0) { t = 0; }
            if (t == 0) {
                dropped = dropped + 1;
            } else {
                if (held != 0) { map_set(recorded, ScheduledTask_task_id(t), held); }
                if (map_has(TaskScheduler_tasks(s), ScheduledTask_task_id(t)) == 1) {
                    _log_duplicate_key("tasks", ScheduledTask_task_id(t));
                    return 0;
                }
                map_set(TaskScheduler_tasks(s), ScheduledTask_task_id(t), t);
            }
            ti = ti + 1;
        }
    }
    _log_records_dropped(dropped, "tasks");
    dropped = 0;
    var narr = bayan_json_v_obj_get_by_cstr(v, "nodes");
    if (narr != 0) {
        var nn = bayan_json_v_arr_len(narr);
        var ni = 0;
        while (ni < nn) {
            var el = bayan_json_v_arr_get(narr, ni);
            # A node past the profile limit refuses its scheduler, as it does on the
            # write side. Skipping it would lose a whole node and report success.
            if (bayan_json_v_is_obj(el) == 1) {
                if (_jv_list_ok(el, "accel_profiles") == 0) { return 0; }
                if (_over_device_ceiling(el, _jv_str(el, "node_id")) == 1) { return 0; }
            }
            var node = node_capacity_from_jsonv(el);
            if (node == 0) {
                dropped = dropped + 1;
            } else {
                if (map_has(TaskScheduler_nodes(s), NodeCapacity_node_id(node)) == 1) {
                    _log_duplicate_key("nodes", NodeCapacity_node_id(node));
                    return 0;
                }
                map_set(TaskScheduler_nodes(s), NodeCapacity_node_id(node), node);
            }
            ni = ni + 1;
        }
    }
    _log_records_dropped(dropped, "nodes");
    _settle_capacity(s, recorded);
    return s;
}

fn task_scheduler_to_json_str(s): i64 { return _build_or_0(task_scheduler_to_jsonv(s)); }
fn task_scheduler_from_json_str(s): i64 { return _restore(s, &task_scheduler_from_jsonv); }
