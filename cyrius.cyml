[package]
name = "samay"
version = "${file:VERSION}"
description = "Samay — task scheduler for AGNOS (cron, resource-aware scheduling). Cyrius port of the Rust v0.1.x library."
license = "GPL-3.0-only"
repository = "https://github.com/MacCracken/samay"
language = "cyrius"
cyrius = "6.7.18"
# The oldest toolchain this builds and passes on at the deps pinned below: the
# bayan and ai-hwaccel pins need 6.7.10. CI checks it (scripts/check-floor.sh).
cyrius_floor = "6.7.10"

[build]
entry = "src/main.cyr"
output = "build/samay"

# ── Library surface ──────────────────────────────────────────────
# samay is consumable at the source level as a single-file bundle,
# `dist/samay.cyr` (committed), regenerated by `cyrius distlib`.
# `modules` lists the domain src/*.cyr files, in dependency order, that
# distlib concatenates. src/main.cyr (in-tree demo entry) and
# src/lib.cyr (include-only aggregation header) are intentionally
# excluded — same convention as kavach / ai-hwaccel.
[lib]
modules = [
    "src/uuid.cyr",
    "src/types.cyr",
    "src/scheduler.cyr",
    "src/cronexpr.cyr",
    "src/cron.cyr",
    "src/training.cyr",
    "src/json.cyr",
]

# ── Dependencies ─────────────────────────────────────────────────
# Cyrius stdlib modules, vendored into lib/ by `cyrius deps` along with the
# [deps.NAME] git deps. It works from an empty lib/, and lib/ is
# committed, not gitignored. The set is the union of what samay's own src
# needs (chrono/random/result/hashmap/bayan/…) and what the ai-hwaccel
# dist bundle forward-references (sakshi/thread/process/fs/… — its own
# [deps].stdlib).
# NOTE: math and slice are NOT in this list. samay calls nothing in them.
# `cyrius deps` vendors both from bayan-json's sidecar (dist/bayan-json.deps).
# NOTE: bayan is NOT in this list. As of bayan 1.5.2 it ships focused
# sublibs, and samay consumes `dist/bayan-json.cyr` via [deps.bayan]
# below — see that block for why.
[deps]
stdlib = [
    "syscalls",
    "string",
    "alloc",
    "str",
    "fmt",
    "vec",
    "hashmap",
    "io",
    "fs",
    "chrono",
    "random",
    "result",
    "tagged",
    "fnptr",
    "freelist",
    "atomic",
    "sakshi",
    "process",
    "args",
    "thread",
    "assert",
    "bench",
]

# JSON value-tree API (`bayan_json_v_*`) behind src/json.cyr, plus
# `bayan_f64_to_json` for lib/fmt.cyr. bayan 1.5.2 split the 641 KB monolith
# into focused sublibs; samay uses only the JSON surface, so it takes
# `dist/bayan-json.cyr` — the same module ai-hwaccel pulls. Taking the
# monolith here instead would vendor BOTH files and collide on 27 JSON
# symbols under last-def-wins (the hazard samay's own symbol-hygiene
# principle forbids). The sublib omits the short `json_v_*` aliases, so
# samay calls the fully-qualified `bayan_json_v_*` spelling, which resolves
# under either bayan packaging.
[deps.bayan]
git = "https://github.com/MacCracken/bayan.git"
tag = "1.11.1"
modules = ["dist/bayan-json.cyr"]

# AcceleratorRequirement (REQ_* enum) + resource-aware placement API.
# The Rust crate did `use ai_hwaccel::AcceleratorRequirement;` — the Cyrius
# port consumes the same type from ai-hwaccel's committed dist bundle.
[deps.ai-hwaccel]
git = "https://github.com/MacCracken/ai-hwaccel.git"
tag = "2.5.6"
modules = ["dist/ai-hwaccel.cyr"]
