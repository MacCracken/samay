# json.cyr — JSON Serialize/Deserialize for the container types (M4).
#
# The five all-scalar/all-Str "leaf" types (ResourceReq, SchedulingDecision,
# PreemptionAction, SchedulerStats, CronExpr) carry their codec via
# #derive(Serialize). This module covers the types the derive can't:
# structs with pointer / vec / map fields, or a nullable Str field.
#
# These compose over bayan's json_v value-tree API — bayan_json_v_obj_set /
# bayan_json_v_arr_push to build, bayan_json_v_parse / bayan_json_v_obj_get
# to read — which handles string escaping, nesting and arrays natively
# (unlike the derive's flat-parser from_json, which does not unescape).
# The two leaves nested in those types, ResourceReq and CronExpr, are built and
# read field by field here rather than through their derive; see _rr_node and
# _rr_from.
#
# Convention per type:
#   <type>_to_jsonv(p)        -> json_v node   (composable build)
#   <type>_from_jsonv(v)      -> struct ptr    (composable read; 0 on non-object)
#   <type>_to_json_str(p)     -> Str           (bayan_json_v_build wrapper)
#   <type>_from_json_str(s)   -> struct ptr    (bayan_json_v_parse wrapper)
#
# None sentinels (ADR-0001): a nullable Str field is 0; it serializes as JSON
# null and reads back as 0. epoch-ns timestamp fields use 0 for None and are
# plain ints on the wire (0 stays 0). Requires: bayan-json, str + the samay
# modules. Calls are the fully-qualified `bayan_json_v_*` spelling: the short
# `json_v_*` aliases exist only in bayan's monolith, not the focused sublib
# samay vendors (bayan 1.5.2 — see [deps.bayan] in cyrius.cyml).

# ---------------------------------------------------------------------------
# helpers over bayan json_v
# ---------------------------------------------------------------------------

# --- what a document may cost (ADR-0014) ---
#
# Through 1.4.4 only SAMAY_JSON_MAX_ITEMS limited a restore, and it is checked after
# the parse. bayan's tree costs up to 88 times the text it came from, so 10 MB of
# `[[[...]]]` took 877 MB before anything was refused, and an unknown key was not
# limited at all.

# The longest document a reader accepts and a writer produces. Both item limits at
# once fit: 100,000 tasks write 52 MB and 100,000 nodes 21 MB, and a GPU profile adds
# 117 bytes. A writer refuses past it too, so anything samay writes reads back.
var SAMAY_JSON_MAX_BYTES = 134217728;

# How many times its own size a parse may take. What samay writes takes at most 7.2
# (cron entries with one-letter names and zeroed numbers), so this leaves room for
# bayan to change. The smallest documents get 4 KiB on top: `{}` alone takes 176.
var SAMAY_JSON_MAX_EXPANSION = 10;

# 1 if `n` bytes is past the limit, and says so.
fn _over_byte_limit(n): i64 {
    if (n <= SAMAY_JSON_MAX_BYTES) { return 0; }
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "snapshot refused: ");
    str_builder_add_int(sb, n);
    str_builder_add_cstr(sb, " bytes, past the limit of ");
    str_builder_add_int(sb, SAMAY_JSON_MAX_BYTES);
    var msg = str_builder_build(sb);
    sakshi_error(str_data(msg), str_len(msg));
    return 1;
}

# An allocator that hands out memory until `budget` bytes are spent, then answers 0,
# which fails bayan's whole parse or build. State: { used, budget, refused, base, size }.
# It counts each request as alloc() takes it, rounded up to 8, which is what ADR-0014's
# ratios measured. A request past ALLOC_MAX is refused the same way: plain alloc()
# answers 0 there too, and bayan_json_v_build exits the process on it.
#
# With a mapping (base not 0) it hands out the mapping in order, 8-aligned as alloc()
# is; the budget fits inside it, so it never runs past the end. Without one it forwards
# to alloc(), and any 0 from that is the host out of memory, so it panics rather than
# pass for a refused document (ADR-0009).
fn _budget_alloc(st, size): i64 {
    var need = (size + 7) & (0 - 8);
    var used = load64(st) + need;
    if (size > ALLOC_MAX || used > load64(st + 8)) {
        store64(st + 16, 1);
        return 0;
    }
    var base = load64(st + 24);
    var at = load64(st);
    store64(st, used);
    if (base != 0) { return base + at; }
    var p = alloc(size);
    if (p == 0) { panic("samay: out of memory in _budget_alloc"); }
    return p;
}

# bayan neither reallocates, frees nor resets through an allocator. A realloc is
# refused rather than copied, so a bayan that starts using one fails loudly in tests.
fn _budget_realloc(st, old_ptr, old_size, new_size): i64 { return 0; }
fn _budget_free(st, ptr): i64 { return 0; }
fn _budget_reset(st): i64 { return 0; }

# An allocator for `budget` bytes on the heap, and its state.
fn _budget(budget): i64 {
    var st = alloc(40);
    if (st == 0) { panic("samay: out of memory in _budget"); }
    store64(st, 0);
    store64(st + 8, budget);
    store64(st + 16, 0);
    store64(st + 24, 0);
    store64(st + 32, 0);
    var al = allocator_new(&_budget_alloc, &_budget_realloc, &_budget_free, &_budget_reset, st);
    if (al == 0) { panic("samay: out of memory in _budget"); }
    return al;
}

fn _budget_refused(al): i64 { return load64(allocator_state(al) + 16); }

# 1 to give a restore's tree a mapping of its own; tests set 0 to take the heap path.
var _RESTORE_MAPPED = 1;

# Mappings _budget_mapped has made and _budget_unmap not yet given back: 0 between
# restores. Kept so a test can see that every restore lets its tree go.
var _MAPS_HELD = 0;

# An allocator for `budget` bytes in a mapping of its own, which _budget_unmap gives
# back. The mapping is only an address range until the tree touches it. Where none can
# be had (agnos and cx have no mmap), the allocator uses the heap, as through 1.5.0.
fn _budget_mapped(budget): i64 {
    var al = _budget(budget);
    if (_RESTORE_MAPPED == 0) { return al; }
    var size = (budget + 4095) & (0 - 4096);
    var base = mmap_anon(size);
    if (base != 0) {
        var st = allocator_state(al);
        store64(st + 24, base);
        store64(st + 32, size);
        _MAPS_HELD = _MAPS_HELD + 1;
    }
    return al;
}

fn _budget_unmap(al): i64 {
    var st = allocator_state(al);
    var base = load64(st + 24);
    if (base == 0) { return 0; }
    cyr_munmap(base, load64(st + 32));
    store64(st + 24, 0);
    _MAPS_HELD = _MAPS_HELD - 1;
    return 0;
}

fn _log_build_refused(): i64 {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "snapshot refused: its text runs past the limit of ");
    str_builder_add_int(sb, SAMAY_JSON_MAX_BYTES);
    str_builder_add_cstr(sb, " bytes");
    var msg = str_builder_build(sb);
    sakshi_error(str_data(msg), str_len(msg));
    return 0;
}

fn _log_parse_refused(n): i64 {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "snapshot refused: parsing its ");
    str_builder_add_int(sb, n);
    str_builder_add_cstr(sb, " bytes takes more than ");
    str_builder_add_int(sb, SAMAY_JSON_MAX_EXPANSION);
    str_builder_add_cstr(sb, " times that");
    var msg = str_builder_build(sb);
    sakshi_error(str_data(msg), str_len(msg));
    return 0;
}

# Parse a Str of JSON into a value tree on the heap, or 0 if it is malformed or past a
# limit. Only a writer uses it now, for a tree that becomes part of the document it is
# building; a reader goes through _restore. Calls the explicit buf+len entry
# (bayan_json_v_parse_buf_a): `_str` is a Cyrius dispatch suffix, and the 1-arg
# bayan_json_v_parse form trips a spurious linter arity warning.
fn _parse(s): i64 {
    # A writer past a limit answers 0, and a caller may hand that straight here.
    if (s == 0) { return 0; }
    var n = str_len(s);
    if (_over_byte_limit(n) == 1) { return 0; }
    var al = _budget(n * SAMAY_JSON_MAX_EXPANSION + 4096);
    var v = bayan_json_v_parse_buf_a(al, str_data(s), n);
    # bayan answers 0 when an allocation fails, but whatever it answers, a parse that
    # ran out of budget is refused: a partial tree must not pass for the document.
    if (_budget_refused(al) == 1) {
        _log_parse_refused(n);
        return 0;
    }
    return v;
}

# --- a restore's tree is let go (1.5.1) ---
#
# Once a reader has built its objects the tree is garbage, and alloc() never frees, so
# through 1.5.0 every restore left about six times its document on the heap for good.
# Now the tree goes in a mapping of its own and the mapping goes back when the reader
# returns. That is safe because no reader keeps a pointer into the tree: constructors
# own every Str they keep (1.1.3), the task and node readers copy theirs, and
# ai-hwaccel's profile reader copies its own (2.5.5).

# Parse `s`, give the tree to `reader`, and let the tree go. Malformed, past a limit or
# refused, the answer is 0, as the reader gives for no tree.
fn _restore(s, reader): i64 {
    if (s == 0) { return 0; }
    var n = str_len(s);
    if (_over_byte_limit(n) == 1) { return 0; }
    var al = _budget_mapped(n * SAMAY_JSON_MAX_EXPANSION + 4096);
    var v = bayan_json_v_parse_buf_a(al, str_data(s), n);
    # A parse that ran out of budget is refused whatever bayan answered: a partial tree
    # must not pass for the document.
    if (_budget_refused(al) == 1) {
        _log_parse_refused(n);
        v = 0;
    }
    var out = 0;
    if (v != 0) { out = fncall1(reader, v); }
    _budget_unmap(al);
    return out;
}

# Nullable Str -> json value (null if 0, else string).
fn _jv_opt_str(s): i64 {
    if (s == 0) { return bayan_json_v_null(); }
    return bayan_json_v_str_new(s);
}

# Read a required Str field, or 0 if absent / not a string.
fn _jv_str(obj, key): i64 {
    var el = bayan_json_v_obj_get_by_cstr(obj, key);
    if (el == 0) { return 0; }
    if (bayan_json_v_is_str(el) == 0) { return 0; }
    return bayan_json_v_str(el);
}

# Read a nullable Str field: absent or JSON null -> 0, else the Str.
fn _jv_opt_str_get(obj, key): i64 {
    var el = bayan_json_v_obj_get_by_cstr(obj, key);
    if (el == 0) { return 0; }
    if (bayan_json_v_is_null(el) == 1) { return 0; }
    if (bayan_json_v_is_str(el) == 0) { return 0; }
    return bayan_json_v_str(el);
}

# Read an int field with a default.
fn _jv_int(obj, key, dflt): i64 {
    var el = bayan_json_v_obj_get_by_cstr(obj, key);
    if (el == 0) { return dflt; }
    return bayan_json_v_int(el);
}

# Read an f64 (bit pattern) field with a default.
fn _jv_f64(obj, key, dflt): i64 {
    var el = bayan_json_v_obj_get_by_cstr(obj, key);
    if (el == 0) { return dflt; }
    return bayan_json_v_float(el);
}

# --- restore-side input validation (security hardening, ADR-0005) ---
#
# Snapshots may be untrusted (read from disk/network). The from_jsonv
# deserializers below REJECT a record (return 0) when a required Str field,
# or a required nested struct, is missing OR THE WRONG TYPE — matching Rust
# serde's required-field semantics — so a malformed snapshot fails closed
# instead of producing a poisoned struct that SIGSEGVs later (a null Str
# deref) or corrupts a map (null key). Container loops already skip null
# records, so a bad record is dropped, not fatal.
#
# Numeric fields are CLAMPED to their valid domain rather than rejected, and that
# domain is the constructor's, so a value comes back as it was built (1.4.5). bayan
# maps an overflowing exponent such as 1e400 to +Inf, and cores stop at 1e18 like any
# other value past it.
#
# v1.0.3 closed the "or the wrong type" half for the two nested leaves: they
# used to bridge through their #derive codec, which cannot fail, so every
# wrong-typed value produced a non-zero all-zero struct and the guards here
# were dead code. See _rr_from / _ce_from.

# Ceiling on how many items a restored collection may hold, so a hostile
# snapshot cannot force unbounded allocation. Far above any realistic
# scheduler; caps the anti-catastrophe bound (OOM / minutes-long work).
var SAMAY_JSON_MAX_ITEMS = 100000;

# 1 if a collection is too large to write. Restore refuses a collection past the
# ceiling outright, so a snapshot holding one could never be read back. The writers
# refuse it here instead, while the caller can still prune, and answer 0. They never
# truncate: a partial snapshot would drop records silently (ADR-0011).
fn _over_item_limit(n, what): i64 {
    if (n <= SAMAY_JSON_MAX_ITEMS) { return 0; }
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "snapshot refused: ");
    str_builder_add_int(sb, n);
    str_builder_add_cstr(sb, " ");
    str_builder_add_cstr(sb, what);
    str_builder_add_cstr(sb, ", past the restore limit of ");
    str_builder_add_int(sb, SAMAY_JSON_MAX_ITEMS);
    var msg = str_builder_build(sb);
    sakshi_error(str_data(msg), str_len(msg));
    return 1;
}

# Serialize a tree, or answer 0: for a refused one, and for text past the byte limit,
# which no reader would take. bayan_json_v_build exits the process past ALLOC_MAX
# (2 GiB), so this builds through a budget instead. The builder doubles its buffer, so
# its buffers sum to under 4 times the text, and the text is copied once more: 6 times
# the limit always finishes a document within it.
fn _build_or_0(v): i64 {
    if (v == 0) { return 0; }
    var al = _budget(SAMAY_JSON_MAX_BYTES * 6 + 4096);
    var out = bayan_json_v_build_a(al, v);
    if (_budget_refused(al) == 1) {
        _log_build_refused();
        return 0;
    }
    if (_over_byte_limit(str_len(out)) == 1) { return 0; }
    return out;
}

# Clamp an i64 into [lo, hi].
fn _clamp_i64(x, lo, hi): i64 {
    if (x < lo) { return lo; }
    if (x > hi) { return hi; }
    return x;
}

# Read a flag field normalised to exactly 0 or 1. Anything non-zero is 1, so
# a truthy-but-not-1 value cannot land in a field compared with `== 1`. A JSON
# true is 1: bayan_json_v_int answers 0 for it, which read `"enabled":true` as off.
fn _jv_bool01(obj, key, dflt): i64 {
    var el = bayan_json_v_obj_get_by_cstr(obj, key);
    if (el == 0) { return dflt; }
    if (bayan_json_v_is_bool(el) == 1) { return bayan_json_v_bool(el); }
    if (bayan_json_v_int(el) == 0) { return 0; }
    return 1;
}

# Each of these is 1 if `key` is present and holds the wrong kind of thing. The readers
# above answer 0 for a wrong type, so without them "status":"running" restores as
# QUEUED, "cpu_cores":"8" as no cores at all, and a wrong-typed requirement fits any
# node. A record that fails one is rejected (ADR-0005). An absent key stays the
# reader's business: older snapshots lack some.
fn _jv_not_num(obj, key): i64 {
    var el = bayan_json_v_obj_get_by_cstr(obj, key);
    if (el == 0) { return 0; }
    if (bayan_json_v_is_int(el) == 1) { return 0; }
    if (bayan_json_v_is_float(el) == 1) { return 0; }
    return 1;
}

fn _jv_not_flag(obj, key): i64 {
    var el = bayan_json_v_obj_get_by_cstr(obj, key);
    if (el == 0) { return 0; }
    if (bayan_json_v_is_bool(el) == 1) { return 0; }
    return _jv_not_num(obj, key);
}

# 1 unless `key` is absent, or an array within the ceiling. A collection of the wrong
# type read as empty, so a snapshot with its tasks keyed by id restored as an empty
# scheduler and reported success.
fn _jv_list_ok(obj, key): i64 {
    var el = bayan_json_v_obj_get_by_cstr(obj, key);
    if (el == 0) { return 1; }
    if (bayan_json_v_is_arr(el) == 0) { return 0; }
    if (bayan_json_v_arr_len(el) > SAMAY_JSON_MAX_ITEMS) { return 0; }
    return 1;
}

# Records a restore could not use. A reader drops a bad record and carries on
# (ADR-0005), but samay does not drop anything without saying so.
fn _log_records_dropped(n, what): i64 {
    if (n == 0) { return 0; }
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "restore dropped ");
    str_builder_add_int(sb, n);
    str_builder_add_cstr(sb, " unreadable ");
    str_builder_add_cstr(sb, what);
    var msg = str_builder_build(sb);
    sakshi_warn(str_data(msg), str_len(msg));
    return 0;
}

# An honest writer cannot produce two records under one key. Keeping either would
# strand what the other held, so the whole snapshot is refused.
fn _log_duplicate_key(what, key): i64 {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "snapshot refused: two ");
    str_builder_add_cstr(sb, what);
    str_builder_add_cstr(sb, " named '");
    _samay_log_add(sb, key, 128);
    str_builder_add_cstr(sb, "'");
    var msg = str_builder_build(sb);
    sakshi_error(str_data(msg), str_len(msg));
    return 0;
}

# Read an int field, coerced to its non-negative (u64-like) domain; a
# negative value clamps to 0. Default if absent.
fn _jv_uint(obj, key, dflt): i64 {
    var el = bayan_json_v_obj_get_by_cstr(obj, key);
    if (el == 0) { return dflt; }
    var x = bayan_json_v_int(el);
    if (x < 0) { return 0; }
    return x;
}

# An accelerator profile could not be serialized into the snapshot. Logged,
# never silent — see node_capacity_to_jsonv.
fn _log_profile_skip(node_id): i64 {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "node '");
    _samay_log_add(sb, node_id, 128);
    str_builder_add_cstr(sb, "': accelerator profile omitted from snapshot (unserializable field)");
    var msg = str_builder_build(sb);
    sakshi_warn(str_data(msg), str_len(msg));
    return 0;
}

# 1 if a node record has more profiles than SAMAY_MAX_NODE_DEVICES, and says so. The
# node is refused, as node_capacity_add_accel refuses the profile past it (ADR-0018).
fn _over_device_ceiling(v, nid): i64 {
    var arr = bayan_json_v_obj_get_by_cstr(v, "accel_profiles");
    if (arr == 0) { return 0; }
    if (bayan_json_v_arr_len(arr) <= SAMAY_MAX_NODE_DEVICES) { return 0; }
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "node '");
    _samay_log_add(sb, nid, 128);
    str_builder_add_cstr(sb, "' refused: more accelerator profiles than ");
    str_builder_add_int(sb, SAMAY_MAX_NODE_DEVICES);
    var msg = str_builder_build(sb);
    sakshi_error(str_data(msg), str_len(msg));
    return 1;
}

# A profile samay could not have written: ai-hwaccel's writer always gives its type,
# device and memory, and has since before 1.0.2. Without them a `{}` restored into a
# 184-byte profile, so 3 bytes of text bought 60 of heap, past anything ADR-0014 counted.
fn _profile_shaped(el): i64 {
    if (bayan_json_v_is_obj(el) == 0) { return 0; }
    if (bayan_json_v_obj_get_by_cstr(el, "accel_type_id") == 0) { return 0; }
    if (bayan_json_v_obj_get_by_cstr(el, "device_id") == 0) { return 0; }
    if (bayan_json_v_obj_get_by_cstr(el, "memory_bytes") == 0) { return 0; }
    var bad = _jv_not_num(el, "accel_type_id") + _jv_not_num(el, "device_id") + _jv_not_num(el, "memory_bytes");
    if (bad != 0) { return 0; }
    return 1;
}

fn _log_profile_unshaped(node_id): i64 {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "node '");
    _samay_log_add(sb, node_id, 128);
    str_builder_add_cstr(sb, "': accelerator profile refused on restore (no type, device or memory); capacity lost");
    var msg = str_builder_build(sb);
    sakshi_warn(str_data(msg), str_len(msg));
    return 0;
}

# ai-hwaccel refused an accelerator profile on restore, so the node comes back
# without it. Logged, never silent — see node_capacity_from_jsonv.
fn _log_profile_refused(node_id): i64 {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "node '");
    _samay_log_add(sb, node_id, 128);
    str_builder_add_cstr(sb, "': accelerator profile refused on restore (out of range); capacity lost");
    var msg = str_builder_build(sb);
    sakshi_warn(str_data(msg), str_len(msg));
    return 0;
}

# --- nested leaves ---

# ResourceReq -> json node, built directly. Through 1.4.1 this printed the struct
# with its #derive codec and parsed the text back, which was 72% of the cost of
# serializing a task. The derive is public and stays, so there are two writers of
# this shape: keep these keys and their order the same as the struct's. A field
# added to the struct reaches the derive by itself and has to reach here by hand;
# test_wire_corpus_resource_req fails until it does (1.4.2).
#
# cpu_cores stores the f64 as it is. bayan prints a non-finite one as `null`, the
# same bytes the derive writes. _f64_is_finite is no use for mapping it by hand:
# that gate stops at 1e18, and a larger value is legal on the wire.
fn _rr_node(req): i64 {
    var o = bayan_json_v_obj_new();
    bayan_json_v_obj_set(o, str_from("cpu_cores"), bayan_json_v_float_new(ResourceReq_cpu_cores(req)));
    bayan_json_v_obj_set(o, str_from("memory_mb"), bayan_json_v_int_new(ResourceReq_memory_mb(req)));
    bayan_json_v_obj_set(o, str_from("accel_req"), bayan_json_v_int_new(ResourceReq_accel_req(req)));
    bayan_json_v_obj_set(o, str_from("accel_min_chips"), bayan_json_v_int_new(ResourceReq_accel_min_chips(req)));
    bayan_json_v_obj_set(o, str_from("network"), bayan_json_v_int_new(ResourceReq_network(req)));
    bayan_json_v_obj_set(o, str_from("disk_mb"), bayan_json_v_int_new(ResourceReq_disk_mb(req)));
    # Only a request that is not one whole device writes these, so a snapshot that
    # uses neither is what 1.4.6 wrote (ADR-0016). They go as placement reads them: a 0
    # left by a setter or the derive's decoder is one whole device, and wrote its keys
    # through 1.5.0, which the next restore then dropped. The derive writes them always.
    var devices = _req_devices(req);
    var share = _req_share(req);
    var whole_one = 0;
    if (devices == 1) {
        if (share == SAMAY_ACCEL_WHOLE) { whole_one = 1; }
    }
    if (whole_one == 0) {
        bayan_json_v_obj_set(o, str_from("accel_devices"), bayan_json_v_int_new(devices));
        bayan_json_v_obj_set(o, str_from("accel_share"), bayan_json_v_int_new(share));
    }
    return o;
}

# json node (at key) -> ResourceReq, or 0 if absent / not an object / not
# shaped like a ResourceReq.
#
# Read explicitly rather than through the #derive codec. The derive cannot
# fail: it allocs and returns a pointer whatever it is handed, and alloc is a
# bump allocator over kernel-zeroed pages, so a string / int / array / null /
# {} all yielded a NON-ZERO, all-zero ResourceReq. That made every `req == 0`
# guard downstream dead code, and an all-zero requirement fits any node.
# Reading the fields here also lets the numeric domain be clamped -- negative
# requirements previously ran backwards through node_capacity_reserve, which
# computes `available - required` and so ADDED capacity.
fn _rr_from(obj, key): i64 {
    return _rr_read(bayan_json_v_obj_get_by_cstr(obj, key));
}

fn _rr_read(el): i64 {
    if (el == 0) { return 0; }
    if (bayan_json_v_is_obj(el) == 0) { return 0; }
    # Every field the derive writes, each of which every release since 1.0.2 has written,
    # so a wrong-shaped object is refused too (ADR-0005). Through 1.5.0 only cpu_cores
    # was required, and `{"cpu_cores":1}` read as a request for nothing else.
    if (bayan_json_v_obj_get_by_cstr(el, "cpu_cores") == 0) { return 0; }
    if (bayan_json_v_obj_get_by_cstr(el, "memory_mb") == 0) { return 0; }
    if (bayan_json_v_obj_get_by_cstr(el, "accel_req") == 0) { return 0; }
    if (bayan_json_v_obj_get_by_cstr(el, "accel_min_chips") == 0) { return 0; }
    if (bayan_json_v_obj_get_by_cstr(el, "network") == 0) { return 0; }
    if (bayan_json_v_obj_get_by_cstr(el, "disk_mb") == 0) { return 0; }
    var bad = _jv_not_num(el, "cpu_cores") + _jv_not_num(el, "memory_mb") + _jv_not_num(el, "accel_req")
    + _jv_not_num(el, "accel_min_chips") + _jv_not_flag(el, "network") + _jv_not_num(el, "disk_mb")
    + _jv_not_num(el, "accel_devices") + _jv_not_num(el, "accel_share");
    if (bad != 0) { return 0; }
    # resource_req_new settles the domain, so a huge requirement stays one.
    var req = resource_req_new(
      _jv_f64(el, "cpu_cores", f64_from(0)),
      _jv_uint(el, "memory_mb", 0),
      _jv_int(el, "accel_req", REQ_NONE),
      _jv_uint(el, "accel_min_chips", 0),
      _jv_bool01(el, "network", 0),
      _jv_uint(el, "disk_mb", 0));
    # Absent before 1.5.0, and absent since for one whole device. Settled as the
    # constructors settle them: a share is of one device (ADR-0016).
    var share = _jv_int(el, "accel_share", SAMAY_ACCEL_WHOLE);
    if (share > 0) {
        if (share < SAMAY_ACCEL_WHOLE) { return resource_req_with_share(req, share); }
    }
    return resource_req_with_devices(req, _jv_int(el, "accel_devices", 1));
}

# CronExpr -> json node, built directly. Same reasoning and the same rule as
# _rr_node; test_wire_corpus_cron_expr holds it to the derive.
fn _ce_node(expr): i64 {
    var o = bayan_json_v_obj_new();
    bayan_json_v_obj_set(o, str_from("minute_mask"), bayan_json_v_int_new(CronExpr_minute_mask(expr)));
    bayan_json_v_obj_set(o, str_from("hour_mask"), bayan_json_v_int_new(CronExpr_hour_mask(expr)));
    bayan_json_v_obj_set(o, str_from("dom_mask"), bayan_json_v_int_new(CronExpr_dom_mask(expr)));
    bayan_json_v_obj_set(o, str_from("month_mask"), bayan_json_v_int_new(CronExpr_month_mask(expr)));
    bayan_json_v_obj_set(o, str_from("dow_mask"), bayan_json_v_int_new(CronExpr_dow_mask(expr)));
    bayan_json_v_obj_set(o, str_from("dom_star"), bayan_json_v_int_new(CronExpr_dom_star(expr)));
    bayan_json_v_obj_set(o, str_from("dow_star"), bayan_json_v_int_new(CronExpr_dow_star(expr)));
    return o;
}

# 1 if `key` is a number with at least one bit set and none outside `valid`: the
# values its field can take. An empty mask, or one with only bits no expression sets
# (Sunday as 7, minute 60), restored into an entry that never fired, with no log line.
fn _ce_mask_ok(el, key, valid): i64 {
    if (bayan_json_v_obj_get_by_cstr(el, key) == 0) { return 0; }
    if (_jv_not_num(el, key) == 1) { return 0; }
    var m = _jv_int(el, key, 0);
    if (m == 0) { return 0; }
    if ((m & valid) != m) { return 0; }
    return 1;
}

# A star flag, or, absent, what the mask says: a whole field is a star. 1.0.2 wrote no
# flags, and reading one as 0 put an expression such as `0 0 1 * *` under the OR rule,
# firing daily instead of monthly.
fn _ce_star(el, key, mask, whole): i64 {
    if (bayan_json_v_obj_get_by_cstr(el, key) != 0) { return _jv_bool01(el, key, 0); }
    if (mask == whole) { return 1; }
    return 0;
}

# json node (at key) -> CronExpr, or 0 if absent / not an object / not
# shaped like a CronExpr. Same reasoning as _rr_from: the derive bridge could
# not fail, so a wrong-typed `expr` produced an all-zero CronExpr whose masks
# match nothing -- an entry that silently never fires.
fn _ce_from(obj, key): i64 {
    return _ce_read(bayan_json_v_obj_get_by_cstr(obj, key));
}

fn _ce_read(el): i64 {
    if (el == 0) { return 0; }
    if (bayan_json_v_is_obj(el) == 0) { return 0; }
    # Every mask, a number, and one an expression could produce: a missing one reads as
    # 0, which matches nothing. Minutes 0-59, hours 0-23, days 1-31, months 1-12, days of
    # the week 0-6 (the parser folds 7 to 0).
    if (_ce_mask_ok(el, "minute_mask", (1 << 60) - 1) == 0) { return 0; }
    if (_ce_mask_ok(el, "hour_mask", (1 << 24) - 1) == 0) { return 0; }
    if (_ce_mask_ok(el, "dom_mask", (1 << 32) - 2) == 0) { return 0; }
    if (_ce_mask_ok(el, "month_mask", (1 << 13) - 2) == 0) { return 0; }
    if (_ce_mask_ok(el, "dow_mask", (1 << 7) - 1) == 0) { return 0; }
    if (_jv_not_flag(el, "dom_star") + _jv_not_flag(el, "dow_star") != 0) { return 0; }
    var p = alloc(56);   # 7 fields * 8 — mirrors cron_expr_parse
    # NOT `return 0`: this function already returns 0 for ADR-0005's "absent or
    # wrong type -> reject this record", and the container readers act on that
    # by dropping the record and continuing. An OOM-0 would delete a
    # well-formed record from a valid snapshot while reporting success.
    if (p == 0) { panic("samay: out of memory in _ce_from"); }
    CronExpr_set_minute_mask(p, _jv_int(el, "minute_mask", 0));
    CronExpr_set_hour_mask(p, _jv_int(el, "hour_mask", 0));
    CronExpr_set_dom_mask(p, _jv_int(el, "dom_mask", 0));
    CronExpr_set_month_mask(p, _jv_int(el, "month_mask", 0));
    CronExpr_set_dow_mask(p, _jv_int(el, "dow_mask", 0));
    # The star flags drive the Vixie AND/OR branch and are compared with
    # `== 1`, so they must be exactly 0 or 1.
    CronExpr_set_dom_star(p, _ce_star(el, "dom_star", CronExpr_dom_mask(p), (1 << 32) - 2));
    CronExpr_set_dow_star(p, _ce_star(el, "dow_star", CronExpr_dow_mask(p), (1 << 7) - 1));
    return p;
}

# --- the derived leaves, read with checks (1.4.5) ---
#
# #derive(Serialize) emits T_from_json and T_from_json_str too, and neither can refuse
# anything: `{}` gives a SchedulingDecision of null Strs, which crashes the first
# writer it meets. samay never calls them. These read the same text, take every field
# the derive writes, and answer 0 for one missing or of the wrong type (ADR-0005). A
# ResourceReq and a CronExpr read as they do nested in a snapshot.

fn resource_req_from_json_str(s): i64 { return _restore(s, &_rr_read); }

fn cron_expr_from_json_str(s): i64 { return _restore(s, &_ce_read); }

# 1 if `key` is present and a number.
fn _jv_has_num(v, key): i64 {
    if (bayan_json_v_obj_get_by_cstr(v, key) == 0) { return 0; }
    return 1 - _jv_not_num(v, key);
}

fn scheduling_decision_from_json_str(s): i64 { return _restore(s, &_sd_read); }

fn _sd_read(v): i64 {
    if (bayan_json_v_is_obj(v) == 0) { return 0; }
    var tid = _jv_str(v, "task_id");
    var node = _jv_str(v, "assigned_node");
    var reason = _jv_str(v, "reason");
    if (tid == 0) { return 0; }
    if (node == 0) { return 0; }
    if (reason == 0) { return 0; }
    if (_jv_has_num(v, "score") == 0) { return 0; }
    # A score past what a writer can carry (1e400 reads as +Inf) wrote back as null, and
    # did not read back (1.5.1).
    var score = _jv_f64(v, "score", f64_from(0));
    if (_f64_is_finite(score) == 0) { return 0; }
    return scheduling_decision_new(tid, node, reason, score);
}

fn preemption_action_from_json_str(s): i64 { return _restore(s, &_pa_read); }

fn _pa_read(v): i64 {
    if (bayan_json_v_is_obj(v) == 0) { return 0; }
    var victim = _jv_str(v, "preempted_task_id");
    var by = _jv_str(v, "preempting_task_id");
    var reason = _jv_str(v, "reason");
    if (victim == 0) { return 0; }
    if (by == 0) { return 0; }
    if (reason == 0) { return 0; }
    return preemption_action_new(victim, by, reason);
}

fn scheduler_stats_from_json_str(s): i64 { return _restore(s, &_ss_read); }

fn _ss_read(v): i64 {
    if (bayan_json_v_is_obj(v) == 0) { return 0; }
    var have = _jv_has_num(v, "total_tasks") + _jv_has_num(v, "queued") + _jv_has_num(v, "running")
    + _jv_has_num(v, "completed") + _jv_has_num(v, "failed") + _jv_has_num(v, "average_wait_time_ms")
    + _jv_has_num(v, "average_run_time_ms");
    if (have != 7) { return 0; }
    var st = scheduler_stats_new();
    SchedulerStats_set_total_tasks(st, _jv_int(v, "total_tasks", 0));
    SchedulerStats_set_queued(st, _jv_int(v, "queued", 0));
    SchedulerStats_set_running(st, _jv_int(v, "running", 0));
    SchedulerStats_set_completed(st, _jv_int(v, "completed", 0));
    SchedulerStats_set_failed(st, _jv_int(v, "failed", 0));
    SchedulerStats_set_average_wait_time_ms(st, _jv_int(v, "average_wait_time_ms", 0));
    SchedulerStats_set_average_run_time_ms(st, _jv_int(v, "average_run_time_ms", 0));
    return st;
}

# ---------------------------------------------------------------------------
# TrainingJobTemplate — scalar/Str + nullable target_node (no nesting)
# ---------------------------------------------------------------------------

fn training_job_template_to_jsonv(t): i64 {
    var o = bayan_json_v_obj_new();
    bayan_json_v_obj_set(o, str_from("model_id"), bayan_json_v_str_new(TrainingJobTemplate_model_id(t)));
    bayan_json_v_obj_set(o, str_from("method"), bayan_json_v_int_new(TrainingJobTemplate_method(t)));
    bayan_json_v_obj_set(o, str_from("dataset"), bayan_json_v_str_new(TrainingJobTemplate_dataset(t)));
    bayan_json_v_obj_set(o, str_from("target_node"), _jv_opt_str(TrainingJobTemplate_target_node(t)));
    var md = bayan_json_v_int_new(TrainingJobTemplate_max_duration_secs(t));
    bayan_json_v_obj_set(o, str_from("max_duration_secs"), md);
    var ck = bayan_json_v_int_new(TrainingJobTemplate_checkpoint_interval_secs(t));
    bayan_json_v_obj_set(o, str_from("checkpoint_interval_secs"), ck);
    return o;
}

fn training_job_template_from_jsonv(v): i64 {
    if (v == 0) { return 0; }
    if (bayan_json_v_is_obj(v) == 0) { return 0; }
    var model = _jv_str(v, "model_id");
    var dataset = _jv_str(v, "dataset");
    if (model == 0) { return 0; }
    if (dataset == 0) { return 0; }
    var bad = _jv_not_num(v, "method") + _jv_not_num(v, "max_duration_secs")
    + _jv_not_num(v, "checkpoint_interval_secs");
    if (bad != 0) { return 0; }
    # A method samay does not know is kept, as the constructor keeps it: it is named
    # "unknown" and asks for a GPU or a TPU. Through 1.4.4 it read back as LoRA.
    return training_job_template_new(
      model,
      _jv_int(v, "method", TM_LORA),
      dataset,
      _jv_opt_str_get(v, "target_node"),
      _jv_uint(v, "max_duration_secs", 0),
      _jv_uint(v, "checkpoint_interval_secs", 0));
}

fn training_job_template_to_json_str(t): i64 { return _build_or_0(training_job_template_to_jsonv(t)); }
fn training_job_template_from_json_str(s): i64 { return _restore(s, &training_job_template_from_jsonv); }

# ---------------------------------------------------------------------------
# CronTaskTemplate — scalar/Str + nested ResourceReq
# ---------------------------------------------------------------------------

fn cron_task_template_to_jsonv(t): i64 {
    var o = bayan_json_v_obj_new();
    bayan_json_v_obj_set(o, str_from("name"), bayan_json_v_str_new(CronTaskTemplate_name(t)));
    bayan_json_v_obj_set(o, str_from("description"), bayan_json_v_str_new(CronTaskTemplate_description(t)));
    bayan_json_v_obj_set(o, str_from("agent_id"), bayan_json_v_str_new(CronTaskTemplate_agent_id(t)));
    bayan_json_v_obj_set(o, str_from("priority"), bayan_json_v_int_new(CronTaskTemplate_priority(t)));
    bayan_json_v_obj_set(o, str_from("resource_requirements"), _rr_node(CronTaskTemplate_resource_requirements(t)));
    return o;
}

fn cron_task_template_from_jsonv(v): i64 {
    if (v == 0) { return 0; }
    if (bayan_json_v_is_obj(v) == 0) { return 0; }
    var name = _jv_str(v, "name");
    var desc = _jv_str(v, "description");
    var agent = _jv_str(v, "agent_id");
    var req = _rr_from(v, "resource_requirements");
    if (name == 0) { return 0; }
    if (desc == 0) { return 0; }
    if (agent == 0) { return 0; }
    if (req == 0) { return 0; }
    if (_jv_not_num(v, "priority") == 1) { return 0; }
    return cron_task_template_new(
      name, desc, agent,
      _clamp_i64(_jv_int(v, "priority", 5), 1, 10),
      req);
}

fn cron_task_template_to_json_str(t): i64 { return _build_or_0(cron_task_template_to_jsonv(t)); }
fn cron_task_template_from_json_str(s): i64 { return _restore(s, &cron_task_template_from_jsonv); }

# ---------------------------------------------------------------------------
# ScheduledTask — nested ResourceReq + nullable fail_reason and node fields
# ---------------------------------------------------------------------------

# A nullable Str the task keeps, so it must own it: the tree may be arena-allocated
# and reset the moment this returns.
fn _own_opt(v, key): i64 {
    return _samay_own(_jv_opt_str_get(v, key), "samay: out of memory in scheduled_task_from_jsonv");
}

# Rebuild a ScheduledTask from its raw stored state. scheduled_task_new
# generates a fresh uuid and stamps created_at via dt_now(), so it can't be
# used for restore; this sets every field from the document directly.
fn scheduled_task_from_jsonv(v): i64 {
    if (v == 0) { return 0; }
    if (bayan_json_v_is_obj(v) == 0) { return 0; }
    var tid = _jv_str(v, "task_id");
    var name = _jv_str(v, "name");
    var desc = _jv_str(v, "description");
    var agent = _jv_str(v, "agent_id");
    var req = _rr_from(v, "resource_requirements");
    if (tid == 0) { return 0; }
    if (name == 0) { return 0; }
    if (desc == 0) { return 0; }
    if (agent == 0) { return 0; }
    if (req == 0) { return 0; }
    # task_id is a map key; an empty one collides with any other empty one.
    if (str_len(tid) == 0) { return 0; }
    var bad = _jv_not_num(v, "priority") + _jv_not_num(v, "status") + _jv_not_num(v, "created_at")
    + _jv_not_num(v, "scheduled_at") + _jv_not_num(v, "started_at") + _jv_not_num(v, "completed_at")
    + _jv_not_num(v, "deadline");
    if (bad != 0) { return 0; }
    var st = _jv_int(v, "status", TASK_QUEUED);
    if (st < TASK_QUEUED) { st = TASK_QUEUED; }
    if (st > TASK_PREEMPTED) { st = TASK_QUEUED; }
    var p = alloc(128);   # 16 fields * 8 — MUST track scheduled_task_new
    if (p == 0) { panic("samay: out of memory in scheduled_task_from_jsonv"); }
    ScheduledTask_set_task_id(p, _samay_own(tid, "samay: out of memory in scheduled_task_from_jsonv"));
    ScheduledTask_set_name(p, _samay_own(name, "samay: out of memory in scheduled_task_from_jsonv"));
    ScheduledTask_set_description(p, _samay_own(desc, "samay: out of memory in scheduled_task_from_jsonv"));
    ScheduledTask_set_agent_id(p, _samay_own(agent, "samay: out of memory in scheduled_task_from_jsonv"));
    ScheduledTask_set_priority(p, _clamp_i64(_jv_int(v, "priority", 1), 1, 10));
    ScheduledTask_set_resource_requirements(p, req);
    ScheduledTask_set_status(p, st);
    ScheduledTask_set_fail_reason(p, _own_opt(v, "fail_reason"));
    ScheduledTask_set_created_at(p, _jv_int(v, "created_at", 0));
    ScheduledTask_set_scheduled_at(p, _jv_int(v, "scheduled_at", 0));
    ScheduledTask_set_started_at(p, _jv_int(v, "started_at", 0));
    ScheduledTask_set_completed_at(p, _jv_int(v, "completed_at", 0));
    ScheduledTask_set_deadline(p, _jv_int(v, "deadline", 0));
    # The wire's `node_preference` is the one-field view: the assigned node once
    # placed, else the request (ADR-0010). Snapshots since v1.3.0 also carry each
    # on its own. An older one has only the view. Placing a task overwrote its
    # request, so a placed task's view is its assignment and its request is gone.
    # That view stays as the request: it may be real, and it is how 1.2.x read it.
    var npref = _own_opt(v, "node_preference");
    if (bayan_json_v_obj_get_by_cstr(v, "requested_node") == 0) {
        ScheduledTask_set_requested_node(p, npref);
    } else {
        ScheduledTask_set_requested_node(p, _own_opt(v, "requested_node"));
    }
    if (bayan_json_v_obj_get_by_cstr(v, "assigned_node") == 0) {
        var placed = npref;
        if (ScheduledTask_scheduled_at(p) == 0) {
            if (st != TASK_SCHEDULED) {
                if (st != TASK_RUNNING) { placed = 0; }
            }
        }
        ScheduledTask_set_assigned_node(p, placed);
    } else {
        ScheduledTask_set_assigned_node(p, _own_opt(v, "assigned_node"));
    }
    # Back-compat: snapshots written before v1.0.3 carry no `reserved_on`.
    # A task that was SCHEDULED or RUNNING did hold a reservation, and
    # schedule_pending had written the assigned node into node_preference, so
    # the held-reservation state is reconstructable. Absent key vs explicit
    # null matters here, so test the key rather than the decoded value.
    if (bayan_json_v_obj_get_by_cstr(v, "reserved_on") == 0) {
        var ron = 0;
        if (st == TASK_SCHEDULED) { ron = npref; }
        if (st == TASK_RUNNING) { ron = npref; }
        ScheduledTask_set_reserved_on(p, ron);
    } else {
        ScheduledTask_set_reserved_on(p, _own_opt(v, "reserved_on"));
    }
    return p;
}

fn scheduled_task_to_jsonv(t): i64 {
    var o = bayan_json_v_obj_new();
    bayan_json_v_obj_set(o, str_from("task_id"), bayan_json_v_str_new(ScheduledTask_task_id(t)));
    bayan_json_v_obj_set(o, str_from("name"), bayan_json_v_str_new(ScheduledTask_name(t)));
    bayan_json_v_obj_set(o, str_from("description"), bayan_json_v_str_new(ScheduledTask_description(t)));
    bayan_json_v_obj_set(o, str_from("agent_id"), bayan_json_v_str_new(ScheduledTask_agent_id(t)));
    bayan_json_v_obj_set(o, str_from("priority"), bayan_json_v_int_new(ScheduledTask_priority(t)));
    bayan_json_v_obj_set(o, str_from("resource_requirements"), _rr_node(ScheduledTask_resource_requirements(t)));
    bayan_json_v_obj_set(o, str_from("status"), bayan_json_v_int_new(ScheduledTask_status(t)));
    bayan_json_v_obj_set(o, str_from("fail_reason"), _jv_opt_str(ScheduledTask_fail_reason(t)));
    bayan_json_v_obj_set(o, str_from("created_at"), bayan_json_v_int_new(ScheduledTask_created_at(t)));
    bayan_json_v_obj_set(o, str_from("scheduled_at"), bayan_json_v_int_new(ScheduledTask_scheduled_at(t)));
    bayan_json_v_obj_set(o, str_from("started_at"), bayan_json_v_int_new(ScheduledTask_started_at(t)));
    bayan_json_v_obj_set(o, str_from("completed_at"), bayan_json_v_int_new(ScheduledTask_completed_at(t)));
    bayan_json_v_obj_set(o, str_from("deadline"), bayan_json_v_int_new(ScheduledTask_deadline(t)));
    bayan_json_v_obj_set(o, str_from("node_preference"), _jv_opt_str(ScheduledTask_node_preference(t)));
    bayan_json_v_obj_set(o, str_from("reserved_on"), _jv_opt_str(ScheduledTask_reserved_on(t)));
    bayan_json_v_obj_set(o, str_from("requested_node"), _jv_opt_str(ScheduledTask_requested_node(t)));
    bayan_json_v_obj_set(o, str_from("assigned_node"), _jv_opt_str(ScheduledTask_assigned_node(t)));
    return o;
}

fn scheduled_task_to_json_str(t): i64 { return _build_or_0(scheduled_task_to_jsonv(t)); }
fn scheduled_task_from_json_str(s): i64 { return _restore(s, &scheduled_task_from_jsonv); }

# ---------------------------------------------------------------------------
# NodeCapacity — f64 fields + a vec of ai-hwaccel accelerator profiles
# ---------------------------------------------------------------------------

fn node_capacity_to_jsonv(node): i64 {
    if (_over_item_limit(vec_len(NodeCapacity_accel_profiles(node)), "accelerator profiles") == 1) { return 0; }
    var o = bayan_json_v_obj_new();
    bayan_json_v_obj_set(o, str_from("node_id"), bayan_json_v_str_new(NodeCapacity_node_id(node)));
    bayan_json_v_obj_set(o, str_from("total_cpu"), bayan_json_v_float_new(NodeCapacity_total_cpu(node)));
    bayan_json_v_obj_set(o, str_from("available_cpu"), bayan_json_v_float_new(NodeCapacity_available_cpu(node)));
    bayan_json_v_obj_set(o, str_from("total_memory_mb"), bayan_json_v_int_new(NodeCapacity_total_memory_mb(node)));
    var amem = bayan_json_v_int_new(NodeCapacity_available_memory_mb(node));
    bayan_json_v_obj_set(o, str_from("available_memory_mb"), amem);
    bayan_json_v_obj_set(o, str_from("total_disk_mb"), bayan_json_v_int_new(NodeCapacity_total_disk_mb(node)));
    bayan_json_v_obj_set(o, str_from("available_disk_mb"), bayan_json_v_int_new(NodeCapacity_available_disk_mb(node)));
    bayan_json_v_obj_set(o, str_from("running_tasks"), bayan_json_v_int_new(NodeCapacity_running_tasks(node)));
    # accelerator profiles -> array; each profile via ai-hwaccel's codec.
    var arr = bayan_json_v_arr_new();
    var profs = NodeCapacity_accel_profiles(node);
    var n = vec_len(profs);
    var i = 0;
    while (i < n) {
        var psb = str_builder_new();
        profile_to_json(psb, vec_get(profs, i));
        # Through ai-hwaccel 2.5.4 the serializer wrote string values without
        # JSON escaping, so a device_name/driver_version with a quote or a
        # backslash produced text _parse could not read. 2.5.5 escapes them.
        # This guard stays for any other text _parse refuses: pushing the
        # resulting 0 makes bayan render the child as the literal `null`, and
        # restore then drops the accelerator — a node that could fit a GPU
        # task stops being able to, purely by round-tripping. Skip and log
        # instead: a logged omission beats data-losing output, and the rest
        # of the snapshot stays intact (samay never silently drops).
        var pv = _parse(str_builder_build(psb));
        if (pv == 0) {
            _log_profile_skip(NodeCapacity_node_id(node));
        } else {
            bayan_json_v_arr_push(arr, pv);
        }
        i = i + 1;
    }
    bayan_json_v_obj_set(o, str_from("accel_profiles"), arr);
    return o;
}

fn node_capacity_from_jsonv(v): i64 {
    if (v == 0) { return 0; }
    if (bayan_json_v_is_obj(v) == 0) { return 0; }
    var nid = _jv_str(v, "node_id");
    if (nid == 0) { return 0; }
    if (str_len(nid) == 0) { return 0; }
    var bad = _jv_not_num(v, "total_cpu") + _jv_not_num(v, "available_cpu") + _jv_not_num(v, "total_memory_mb")
    + _jv_not_num(v, "available_memory_mb") + _jv_not_num(v, "total_disk_mb")
    + _jv_not_num(v, "available_disk_mb") + _jv_not_num(v, "running_tasks");
    if (bad != 0) { return 0; }
    if (_jv_list_ok(v, "accel_profiles") == 0) { return 0; }
    if (_over_device_ceiling(v, nid) == 1) { return 0; }
    var p = alloc(96);   # 12 fields * 8 — MUST track node_capacity_new
    if (p == 0) { panic("samay: out of memory in node_capacity_from_jsonv"); }
    NodeCapacity_set_node_id(p, _samay_own(nid, "samay: out of memory in node_capacity_from_jsonv"));
    _node_init_holds(p);
    # Enforce `available <= total` on all three axes. Without it a
    # snapshot carrying available_cpu=1e18 against total_cpu=1.0 gives a
    # hugely negative utilization, and that node then wins every
    # _best_fit_node argmin forever. Cores take node_capacity_new's domain.
    # Available can be below zero: an over-committed node writes that, and the
    # tasks settle every node anyway (1.5.1, ADR-0007).
    var tcpu = _req_cpu(_jv_f64(v, "total_cpu", f64_from(0)));
    var acpu = _jv_f64(v, "available_cpu", f64_from(0));
    if (f64_eq(acpu, acpu) == 0) { acpu = f64_from(0); }
    if (f64_lt(acpu, f64_sub(f64_from(0), f64_from(1000000000000000000))) == 1) {
        acpu = f64_sub(f64_from(0), f64_from(1000000000000000000));
    }
    if (f64_gt(acpu, tcpu) == 1) { acpu = tcpu; }
    NodeCapacity_set_total_cpu(p, tcpu);
    NodeCapacity_set_available_cpu(p, acpu);
    var tmem = _jv_uint(v, "total_memory_mb", 0);
    var amem = _jv_int(v, "available_memory_mb", 0);
    if (amem < _CAPACITY_FLOOR) { amem = _CAPACITY_FLOOR; }
    if (amem > tmem) { amem = tmem; }
    NodeCapacity_set_total_memory_mb(p, tmem);
    NodeCapacity_set_available_memory_mb(p, amem);
    var tdisk = _jv_uint(v, "total_disk_mb", 0);
    var adisk = _jv_int(v, "available_disk_mb", 0);
    if (adisk < _CAPACITY_FLOOR) { adisk = _CAPACITY_FLOOR; }
    if (adisk > tdisk) { adisk = tdisk; }
    NodeCapacity_set_total_disk_mb(p, tdisk);
    NodeCapacity_set_available_disk_mb(p, adisk);
    NodeCapacity_set_running_tasks(p, _jv_uint(v, "running_tasks", 0));
    # Same shape as node_capacity_new's accel_profiles bug, on the restore
    # path: a null vec stored here returns a struct that looks healthy.
    var profs = vec_new();
    if (profs == 0) { panic("samay: out of memory in node_capacity_from_jsonv (accel_profiles)"); }
    var arr = bayan_json_v_obj_get_by_cstr(v, "accel_profiles");
    if (arr != 0) {
        var n = bayan_json_v_arr_len(arr);
        var i = 0;
        while (i < n) {
            # ai-hwaccel's profile_from_json takes a json_v node directly. Since
            # 2.5.5 it refuses out-of-range values, and that can reach a profile
            # samay wrote itself: past 16,384 TPU chips (2.5.6's bound), or past
            # 16 TiB of device memory. The node stays, without that profile, so
            # this is a real capacity loss and it is logged (samay never
            # silently drops).
            var el = bayan_json_v_arr_get(arr, i);
            if (_profile_shaped(el) == 0) {
                _log_profile_unshaped(nid);
            } else {
                var prof = profile_from_json(el);
                if (prof != 0) {
                    vec_push(profs, prof);
                } else {
                    _log_profile_refused(nid);
                }
            }
            i = i + 1;
        }
    }
    NodeCapacity_set_accel_profiles(p, profs);
    return p;
}

fn node_capacity_to_json_str(node): i64 { return _build_or_0(node_capacity_to_jsonv(node)); }
fn node_capacity_from_json_str(s): i64 { return _restore(s, &node_capacity_from_jsonv); }

# ---------------------------------------------------------------------------
# CronEntry — nested CronExpr + nested CronTaskTemplate
# ---------------------------------------------------------------------------

fn cron_entry_to_jsonv(e): i64 {
    var o = bayan_json_v_obj_new();
    bayan_json_v_obj_set(o, str_from("name"), bayan_json_v_str_new(CronEntry_name(e)));
    bayan_json_v_obj_set(o, str_from("expr"), _ce_node(CronEntry_expr(e)));
    bayan_json_v_obj_set(o, str_from("task_template"), cron_task_template_to_jsonv(CronEntry_task_template(e)));
    bayan_json_v_obj_set(o, str_from("enabled"), bayan_json_v_int_new(CronEntry_enabled(e)));
    bayan_json_v_obj_set(o, str_from("last_fired"), bayan_json_v_int_new(CronEntry_last_fired(e)));
    bayan_json_v_obj_set(o, str_from("missed_policy"), bayan_json_v_int_new(CronEntry_missed_policy(e)));
    # Written only when set, so an entry that needs neither keeps 1.5.0's bytes. Without
    # the first, a restored disabled entry said again that it gave up time it never owed;
    # without the second, a clock reset could not be undone across a restore (ADR-0006).
    if (CronEntry_enabled(e) == 0) {
        if (CronEntry_disabled_seen(e) == 1) {
            bayan_json_v_obj_set(o, str_from("disabled_seen"), bayan_json_v_int_new(1));
        }
    }
    if (CronEntry_reset_from(e) != 0) {
        bayan_json_v_obj_set(o, str_from("reset_from"), bayan_json_v_int_new(CronEntry_reset_from(e)));
    }
    return o;
}

fn cron_entry_from_jsonv(v): i64 {
    if (v == 0) { return 0; }
    if (bayan_json_v_is_obj(v) == 0) { return 0; }
    var name = _jv_str(v, "name");
    var expr = _ce_from(v, "expr");
    var tmpl = cron_task_template_from_jsonv(bayan_json_v_obj_get_by_cstr(v, "task_template"));
    if (name == 0) { return 0; }
    if (expr == 0) { return 0; }
    if (tmpl == 0) { return 0; }
    # Both public add paths reject an empty name (src/cron.cyr); restore
    # writes the map directly, so it has to enforce the same invariant.
    if (str_len(name) == 0) { return 0; }
    var bad = _jv_not_flag(v, "enabled") + _jv_not_num(v, "last_fired") + _jv_not_num(v, "missed_policy")
    + _jv_not_flag(v, "disabled_seen") + _jv_not_num(v, "reset_from");
    if (bad != 0) { return 0; }
    var mp = _jv_int(v, "missed_policy", CRON_CATCHUP);
    if (mp != CRON_SKIP) { mp = CRON_CATCHUP; }
    # `enabled` is compared with `== 1`, so a truthy-but-not-1 value would
    # leave the entry permanently dormant while reporting as enabled.
    var e = cron_entry_new(name, expr, tmpl, _jv_bool01(v, "enabled", 1), mp);
    CronEntry_set_last_fired(e, _jv_uint(v, "last_fired", 0));
    if (CronEntry_enabled(e) == 0) { CronEntry_set_disabled_seen(e, _jv_bool01(v, "disabled_seen", 0)); }
    CronEntry_set_reset_from(e, _jv_uint(v, "reset_from", 0));
    return e;
}

fn cron_entry_to_json_str(e): i64 { return _build_or_0(cron_entry_to_jsonv(e)); }
fn cron_entry_from_json_str(s): i64 { return _restore(s, &cron_entry_from_jsonv); }

# ---------------------------------------------------------------------------
# CronScheduler — map of CronEntry keyed by name
#
# Maps serialize as arrays sorted by key, so output is deterministic regardless
# of hashmap iteration order (domain principle).
# ---------------------------------------------------------------------------

fn cron_scheduler_to_jsonv(c): i64 {
    var vals = map_values(CronScheduler_entries(c));
    if (_over_item_limit(vec_len(vals), "cron entries") == 1) { return 0; }
    var o = bayan_json_v_obj_new();
    var arr = bayan_json_v_arr_new();
    vec_sort_by(vals, &_entry_name_cmp);
    var n = vec_len(vals);
    var i = 0;
    while (i < n) {
        bayan_json_v_arr_push(arr, cron_entry_to_jsonv(vec_get(vals, i)));
        i = i + 1;
    }
    bayan_json_v_obj_set(o, str_from("entries"), arr);
    return o;
}

fn cron_scheduler_from_jsonv(v): i64 {
    if (v == 0) { return 0; }
    if (bayan_json_v_is_obj(v) == 0) { return 0; }
    if (_jv_list_ok(v, "entries") == 0) { return 0; }
    var c = cron_scheduler_new();
    var arr = bayan_json_v_obj_get_by_cstr(v, "entries");
    if (arr != 0) {
        var n = bayan_json_v_arr_len(arr);
        var dropped = 0;
        var i = 0;
        while (i < n) {
            var e = cron_entry_from_jsonv(bayan_json_v_arr_get(arr, i));
            if (e == 0) {
                dropped = dropped + 1;
            } else {
                if (map_has(CronScheduler_entries(c), CronEntry_name(e)) == 1) {
                    _log_duplicate_key("cron entries", CronEntry_name(e));
                    return 0;
                }
                map_set(CronScheduler_entries(c), CronEntry_name(e), e);
            }
            i = i + 1;
        }
        _log_records_dropped(dropped, "cron entries");
    }
    return c;
}

fn cron_scheduler_to_json_str(c): i64 { return _build_or_0(cron_scheduler_to_jsonv(c)); }
fn cron_scheduler_from_json_str(s): i64 { return _restore(s, &cron_scheduler_from_jsonv); }

# ---------------------------------------------------------------------------
# TaskScheduler — tasks map + nodes map (the top-level snapshot)
# ---------------------------------------------------------------------------

fn task_scheduler_to_jsonv(s): i64 {
    var tvals = map_values(TaskScheduler_tasks(s));
    var nvals = map_values(TaskScheduler_nodes(s));
    if (_over_item_limit(vec_len(tvals), "tasks") == 1) { return 0; }
    if (_over_item_limit(vec_len(nvals), "nodes") == 1) { return 0; }
    var o = bayan_json_v_obj_new();
    var tarr = bayan_json_v_arr_new();
    vec_sort_by(tvals, &_task_id_cmp);
    var tn = vec_len(tvals);
    var list = vec_new();
    if (list == 0) { panic("samay: out of memory in task_scheduler_to_jsonv"); }
    var ti = 0;
    while (ti < tn) {
        var t = vec_get(tvals, ti);
        var tj = scheduled_task_to_jsonv(t);
        _held_profiles_node(s, t, tj, list);
        bayan_json_v_arr_push(tarr, tj);
        ti = ti + 1;
    }
    bayan_json_v_obj_set(o, str_from("tasks"), tarr);
    var narr = bayan_json_v_arr_new();
    vec_sort_by(nvals, &_node_id_cmp);
    var nn = vec_len(nvals);
    var ni = 0;
    while (ni < nn) {
        var nj = node_capacity_to_jsonv(vec_get(nvals, ni));
        if (nj == 0) { return 0; }
        bayan_json_v_arr_push(narr, nj);
        ni = ni + 1;
    }
    bayan_json_v_obj_set(o, str_from("nodes"), narr);
    return o;
}

# A task holding devices records which, as profile indices on its node, so a restore
# takes exactly those. Rebuilt by replay in placement order, they double-booked a device
# once a task between them had finished (1.5.1, ADR-0018). Written only for a task that
# holds a device, so a snapshot without any is what 1.5.0 wrote.
fn _held_profiles_node(s, t, tj, list): i64 {
    var ron = ScheduledTask_reserved_on(t);
    if (ron == 0) { return 0; }
    var node = map_get(TaskScheduler_nodes(s), ron);
    if (node == 0) { return 0; }
    if (_accel_held_list(node, ScheduledTask_resource_requirements(t), list) == 0) { return 0; }
    var arr = bayan_json_v_arr_new();
    var n = vec_len(list);
    var i = 0;
    while (i < n) {
        bayan_json_v_arr_push(arr, bayan_json_v_int_new(vec_get(list, i)));
        i = i + 1;
    }
    bayan_json_v_obj_set(tj, str_from("held_profiles"), arr);
    return 0;
}

# A task's recorded profile indices as a vec, 0 if it has none, or -1 if the key is not a
# list of whole numbers no longer than SAMAY_MAX_NODE_DEVICES, which refuses the task.
fn _held_profiles_read(el): i64 {
    var arr = bayan_json_v_obj_get_by_cstr(el, "held_profiles");
    if (arr == 0) { return 0; }
    if (bayan_json_v_is_arr(arr) == 0) { return 0 - 1; }
    var n = bayan_json_v_arr_len(arr);
    if (n > SAMAY_MAX_NODE_DEVICES) { return 0 - 1; }
    var list = vec_new();
    if (list == 0) { panic("samay: out of memory in _held_profiles_read"); }
    var i = 0;
    while (i < n) {
        var x = bayan_json_v_arr_get(arr, i);
        if (bayan_json_v_is_int(x) == 0) { return 0 - 1; }
        vec_push(list, bayan_json_v_int(x));
        i = i + 1;
    }
    return list;
}

fn task_scheduler_from_jsonv(v): i64 {
    if (v == 0) { return 0; }
    if (bayan_json_v_is_obj(v) == 0) { return 0; }
    if (_jv_list_ok(v, "tasks") == 0) { return 0; }
    if (_jv_list_ok(v, "nodes") == 0) { return 0; }
    var s = task_scheduler_new();
    var recorded = map_new_str();
    if (recorded == 0) { panic("samay: out of memory in task_scheduler_from_jsonv"); }
    var dropped = 0;
    var tarr = bayan_json_v_obj_get_by_cstr(v, "tasks");
    if (tarr != 0) {
        var tn = bayan_json_v_arr_len(tarr);
        var ti = 0;
        while (ti < tn) {
            var tel = bayan_json_v_arr_get(tarr, ti);
            var t = scheduled_task_from_jsonv(tel);
            var held = 0;
            if (t != 0) { held = _held_profiles_read(tel); }
            if (held < 0) { t = 0; }
            if (t == 0) {
                dropped = dropped + 1;
            } else {
                if (held != 0) { map_set(recorded, ScheduledTask_task_id(t), held); }
                if (map_has(TaskScheduler_tasks(s), ScheduledTask_task_id(t)) == 1) {
                    _log_duplicate_key("tasks", ScheduledTask_task_id(t));
                    return 0;
                }
                map_set(TaskScheduler_tasks(s), ScheduledTask_task_id(t), t);
            }
            ti = ti + 1;
        }
    }
    _log_records_dropped(dropped, "tasks");
    dropped = 0;
    var narr = bayan_json_v_obj_get_by_cstr(v, "nodes");
    if (narr != 0) {
        var nn = bayan_json_v_arr_len(narr);
        var ni = 0;
        while (ni < nn) {
            var el = bayan_json_v_arr_get(narr, ni);
            # A node past the profile limit refuses its scheduler, as it does on the
            # write side. Skipping it would lose a whole node and report success.
            if (bayan_json_v_is_obj(el) == 1) {
                if (_jv_list_ok(el, "accel_profiles") == 0) { return 0; }
                if (_over_device_ceiling(el, _jv_str(el, "node_id")) == 1) { return 0; }
            }
            var node = node_capacity_from_jsonv(el);
            if (node == 0) {
                dropped = dropped + 1;
            } else {
                if (map_has(TaskScheduler_nodes(s), NodeCapacity_node_id(node)) == 1) {
                    _log_duplicate_key("nodes", NodeCapacity_node_id(node));
                    return 0;
                }
                map_set(TaskScheduler_nodes(s), NodeCapacity_node_id(node), node);
            }
            ni = ni + 1;
        }
    }
    _log_records_dropped(dropped, "nodes");
    _settle_capacity(s, recorded);
    return s;
}

fn task_scheduler_to_json_str(s): i64 { return _build_or_0(task_scheduler_to_jsonv(s)); }
fn task_scheduler_from_json_str(s): i64 { return _restore(s, &task_scheduler_from_jsonv); }
