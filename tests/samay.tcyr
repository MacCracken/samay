    NodeCapacity_set_available_cpu(n, f64_from(3));
    NodeCapacity_set_available_memory_mb(n, 1111);
    NodeCapacity_set_available_disk_mb(n, 222);
    NodeCapacity_set_running_tasks(n, 4);
    var b = node_capacity_from_json_str(node_capacity_to_json_str(n));
    assert_eq(str_eq(NodeCapacity_node_id(b), str_from("n")), 1, "node_id");
    assert_eq(f64_eq(NodeCapacity_total_cpu(b), f64_from(16)), 1, "total_cpu");
    assert_eq(f64_eq(NodeCapacity_available_cpu(b), f64_from(3)), 1, "available_cpu");
    assert_eq(NodeCapacity_total_memory_mb(b), 8192, "total_memory_mb");
    assert_eq(NodeCapacity_available_memory_mb(b), 1111, "available_memory_mb");
    assert_eq(NodeCapacity_total_disk_mb(b), 2048, "total_disk_mb");
    assert_eq(NodeCapacity_available_disk_mb(b), 222, "available_disk_mb");
    assert_eq(NodeCapacity_running_tasks(b), 4, "running_tasks");
    assert_eq(vec_len(NodeCapacity_accel_profiles(b)), 1, "accel_profiles");
    return 0;
}

