fn test_json_scheduled_task() {
    test_group("json_scheduled_task");
    var req = resource_req_new(f64_div(f64_from(1), f64_from(3)), 4096, REQ_GPU, 4, 1, 10000);
    var t = scheduled_task_new(str_from("nightly"), str_from("desc"), str_from("agent-x"), 7, req);
    ScheduledTask_set_node_preference(t, str_from("gpu-1"));
    ScheduledTask_set_status(t, TASK_SCHEDULED);
    ScheduledTask_set_scheduled_at(t, 1234567890);
    ScheduledTask_set_fail_reason(t, str_from("prior OOM"));
    var t2 = scheduled_task_from_json_str(scheduled_task_to_json_str(t));
    assert_eq(str_eq(ScheduledTask_task_id(t2), ScheduledTask_task_id(t)), 1, "st task_id");
    assert_eq(str_eq(ScheduledTask_name(t2), str_from("nightly")), 1, "st name");
    assert_eq(ScheduledTask_priority(t2), 7, "st priority");
    assert_eq(ScheduledTask_status(t2), TASK_SCHEDULED, "st status");
    assert_eq(ScheduledTask_scheduled_at(t2), 1234567890, "st scheduled_at");
    assert_eq(str_eq(ScheduledTask_node_preference(t2), str_from("gpu-1")), 1, "st node_pref");
    assert_eq(str_eq(ScheduledTask_fail_reason(t2), str_from("prior OOM")), 1, "st fail_reason");
    assert_eq(ScheduledTask_created_at(t2), ScheduledTask_created_at(t), "st created_at preserved");
    var r2 = ScheduledTask_resource_requirements(t2);
    assert_eq(ResourceReq_cpu_cores(r2) == ResourceReq_cpu_cores(req), 1, "st nested cpu bit-exact");
    assert_eq(ResourceReq_accel_min_chips(r2), 4, "st nested min_chips");
    return 0;
}

fn test_json_scheduled_task_null_fields() {
    test_group("json_st_nulls");
    var t = scheduled_task_new(str_from("t"), str_from("d"), str_from("a"), 3, resource_req_default());
    # fail_reason and node_preference default to 0 (None)
    var t2 = scheduled_task_from_json_str(scheduled_task_to_json_str(t));
    assert_eq(ScheduledTask_fail_reason(t2), 0, "st fail_reason null->0");
    assert_eq(ScheduledTask_node_preference(t2), 0, "st node_pref null->0");
    assert_eq(ScheduledTask_deadline(t2), 0, "st deadline 0");
    return 0;
}

fn test_json_node_capacity() {
    test_group("json_node_capacity");
    var node = node_capacity_add_accel(
      node_capacity_new(str_from("tpu-node"), f64_from(8), 16384, 102400, 0),
      profile_tpu(0, 8, TPU_V5P));
    node_capacity_reserve(node, resource_req_new(f64_from(2), 2048, REQ_NONE, 0, 0, 1024));
    var n2 = node_capacity_from_json_str(node_capacity_to_json_str(node));
    assert_eq(str_eq(NodeCapacity_node_id(n2), str_from("tpu-node")), 1, "nc node_id");
    assert_eq(NodeCapacity_total_cpu(n2) == NodeCapacity_total_cpu(node), 1, "nc total_cpu bit-exact");
    assert_eq(NodeCapacity_available_cpu(n2) == NodeCapacity_available_cpu(node), 1, "nc avail_cpu bit-exact");
    assert_eq(NodeCapacity_available_memory_mb(n2), NodeCapacity_available_memory_mb(node), "nc avail_mem");
    assert_eq(NodeCapacity_running_tasks(n2), 1, "nc running_tasks");
    assert_eq(vec_len(NodeCapacity_accel_profiles(n2)), 1, "nc 1 profile");
    # The M3 placement property must survive the round-trip.
    var tpu_req = resource_req_new(f64_from(1), 128, REQ_TPU, 4, 0, 0);
    assert_eq(node_capacity_can_fit(n2, tpu_req), 1, "rebuilt node fits REQ_TPU(4)");
    var tpu_big = resource_req_new(f64_from(1), 128, REQ_TPU, 16, 0, 0);
    assert_eq(node_capacity_can_fit(n2, tpu_big), 0, "rebuilt node rejects REQ_TPU(16)");
    return 0;
}

# ai-hwaccel schema v6 (2.3.28, pinned from samay 1.1.4): a profile records how
# much of its memory is system RAM, as "shared_memory_bytes". A node snapshot
# embeds profile_to_json verbatim, so the key must survive restore rather than
# be dropped: all of Metal's memory is shared, none of a discrete CUDA card's.
fn test_json_node_shared_memory() {
    test_group("json_node_shared_mem");
    var gib = 1073741824;
    var node = node_capacity_new(str_from("mac-1"), f64_from(12), 49152, 102400, 0);
    node_capacity_add_accel(node, profile_new(ACCEL_METAL, 0, 48 * gib));
    node_capacity_add_accel(node, profile_cuda(1, 24 * gib));
    var js = node_capacity_to_json_str(node);
    assert_eq(str_contains(js, str_from("\"shared_memory_bytes\":51539607552")), 1, "snapshot carries Metal shared part");
    var n2 = node_capacity_from_json_str(js);
    var profs = NodeCapacity_accel_profiles(n2);
    assert_eq(vec_len(profs), 2, "both profiles restored");
    assert_eq(profile_shared_mem(vec_get(profs, 0)), 48 * gib, "Metal shared part restored");
    assert_eq(profile_shared_mem(vec_get(profs, 1)), 0, "CUDA shares nothing");
    assert_eq(str_eq(node_capacity_to_json_str(n2), js), 1, "re-serialize byte-identical");
    # Metal's shared part is also what its type implies, so the asserts above
    # would pass if restore ignored the key. A GH200 is a CUDA card (type: no
    # sharing) whose 576 GiB includes 480 GiB of Grace RAM: only the key can
    # carry that through a snapshot.
    var gh = profile_cuda(0, 576 * gib);
    profile_set_shared_mem(gh, 480 * gib);
    var ghn = node_capacity_add_accel(node_capacity_new(str_from("gh-1"), f64_from(72), 491520, 102400, 0), gh);
    var ghjs = node_capacity_to_json_str(ghn);
    var gh2 = node_capacity_from_json_str(ghjs);
    assert_eq(profile_shared_mem(vec_get(NodeCapacity_accel_profiles(gh2), 0)), 480 * gib, "GH200 shared part restored from the key");
    assert_eq(str_eq(node_capacity_to_json_str(gh2), ghjs), 1, "GH200 re-serialize byte-identical");
    # The same Metal node as samay 1.1.3 (ai-hwaccel 2.3.23) wrote it: no key.
    # Restore derives the shared part from the type, so an old snapshot comes
    # back as the node a fresh one describes, down to the byte.
    var old = node_capacity_from_json_str(str_from("{\"node_id\":\"mac-1\",\"total_cpu\":12.0,\"available_cpu\":12.0,\"total_memory_mb\":49152,\"available_memory_mb\":49152,\"total_disk_mb\":102400,\"available_disk_mb\":102400,\"running_tasks\":0,\"accel_profiles\":[{\"accelerator\":\"Metal GPU\",\"accel_type_id\":3,\"device_id\":0,\"available\":true,\"memory_bytes\":51539607552,\"family\":\"GPU\"},{\"accelerator\":\"CUDA GPU\",\"accel_type_id\":1,\"device_id\":1,\"available\":true,\"memory_bytes\":25769803776,\"family\":\"GPU\"}]}"));
    assert_eq(profile_shared_mem(vec_get(NodeCapacity_accel_profiles(old), 0)), 48 * gib, "1.1.3 snapshot: shared part derived");
    assert_eq(str_eq(node_capacity_to_json_str(old), js), 1, "1.1.3 snapshot re-serializes as 1.1.4");
    return 0;
}

# 1 if a node with a `chips`-chip TPU can still place that work after a round trip.
fn tpu_places_after_round_trip(chips): i64 {
    var node = node_capacity_with_tpu(node_capacity_new(str_from("tpu"), f64_from(8), 4096, 8192, 0), chips);
    var back = node_capacity_from_json_str(node_capacity_to_json_str(node));
    return node_capacity_can_fit(back, resource_req_new(f64_from(1), 1, REQ_TPU, chips, 0, 0));
}

# ai-hwaccel checks a profile's ranges on restore. 2.5.5 capped tpu_chips at
# 1,024, which lost a real pod's profile, so a node stopped placing its own TPU
# work after a round trip (samay 1.2.1). 2.5.6 raised the bound to 16,384. A pod
# must round trip. Past the bound the profile is refused, and the node must
# survive with its other profiles. samay logs that loss, which an assert here
# cannot see.
fn test_json_node_profile_refused() {
    test_group("json_node_profile_refused");
    var gib = 1073741824;
    assert_eq(tpu_places_after_round_trip(4096), 1, "TPU v4 pod still places");
    assert_eq(tpu_places_after_round_trip(8960), 1, "TPU v5p pod still places");
    assert_eq(tpu_places_after_round_trip(16384), 1, "the bound itself still places");
    assert_eq(tpu_places_after_round_trip(16385), 0, "one chip past the bound does not");
    var over = node_capacity_new(str_from("tpu-over"), f64_from(8), 4096, 8192, 0);
    node_capacity_add_accel(over, profile_cuda(0, 24 * gib));
    node_capacity_with_tpu(over, 16385);
    var req = resource_req_new(f64_from(1), 1, REQ_TPU, 16385, 0, 0);
    assert_eq(node_capacity_can_fit(over, req), 1, "16385 chips fit before the round trip");
    var over2 = node_capacity_from_json_str(node_capacity_to_json_str(over));
    assert_eq(over2 != 0, 1, "node survives a refused profile");
    var profs = NodeCapacity_accel_profiles(over2);
    assert_eq(vec_len(profs), 1, "only the refused profile is lost");
    assert_eq(profile_accel_type(vec_get(profs, 0)), ACCEL_CUDA, "the CUDA profile stays");
    assert_eq(node_capacity_can_fit(over2, req), 0, "the refused profile no longer places");
    return 0;
}

# Through ai-hwaccel 2.5.4 a quote in a device name made the profile's text
# unparseable, so the snapshot omitted the accelerator. 2.5.5 escapes strings.
fn test_json_node_profile_quoted_name() {
    test_group("json_node_profile_quoted_name");
    var p = profile_cuda(0, 8589934592);
    profile_set_device_name(p, "Weird \"GPU\" \\ name");
    var node = node_capacity_add_accel(node_capacity_new(str_from("q"), f64_from(8), 4096, 8192, 0), p);
    var js = node_capacity_to_json_str(node);
    var n2 = node_capacity_from_json_str(js);
    var profs = NodeCapacity_accel_profiles(n2);
    assert_eq(vec_len(profs), 1, "quoted device name restored");
    assert_eq(streq(profile_device_name(vec_get(profs, 0)), "Weird \"GPU\" \\ name"), 1, "name fidelity");
    assert_eq(str_eq(node_capacity_to_json_str(n2), js), 1, "re-serialize byte-identical");
    return 0;
}

# bayan 1.11.1 refuses a duplicate object key and a leading-zero number, in any
# object of the document. Each restore answers 0, as for any malformed document.
fn test_json_refuses_duplicate_and_leading_zero() {
    test_group("json_refuses_invalid");
    assert_eq(task_scheduler_from_json_str(str_from("{\"tasks\":[],\"tasks\":[]}")), 0, "scheduler: duplicate key");
    assert_eq(cron_scheduler_from_json_str(str_from("{\"entries\":[],\"entries\":[]}")), 0, "cron: duplicate key");
    assert_eq(node_capacity_from_json_str(str_from("{\"node_id\":\"a\",\"node_id\":\"b\"}")), 0, "node: duplicate key");
    assert_eq(node_capacity_from_json_str(str_from("{\"node_id\":\"a\",\"total_cpu\":01}")), 0, "node: leading zero");
    assert_eq(task_scheduler_from_json_str(str_from("{\"nodes\":[{\"node_id\":\"a\",\"node_id\":\"b\"}]}")), 0, "nested duplicate key");
    return 0;
}

# ADR-0010: what the caller asked for and where the scheduler put a task are two
# fields. Through 1.2.x placing a task overwrote its request, so a requeue read the
# old assignment back as a request: the task stayed put and reported "preferred
# node" for a node nobody had asked for.

# 1 if optional Str `v` is the cstr `want`, or both are None.
fn _node_is(v, want) {
    if (want == 0) { return v == 0; }
    if (v == 0) { return 0; }
    return str_eq_cstr(v, want);
}

# Assert a task's request, assignment and the old one-field view of the two.
fn _assert_nodes(t, requested, assigned, view) {
    assert_eq(_node_is(ScheduledTask_requested_node(t), requested), 1, "requested_node");
    assert_eq(_node_is(ScheduledTask_assigned_node(t), assigned), 1, "assigned_node");
    assert_eq(_node_is(ScheduledTask_node_preference(t), view), 1, "node_preference view");
    return 0;
}

# A scheduler where n1 is full, and a task that asked for n1 and fell back to n2.
fn _fallback_scheduler(s, n1, task) {
    NodeCapacity_set_available_cpu(n1, f64_from(0));
    NodeCapacity_set_available_memory_mb(n1, 0);
    task_scheduler_register_node(s, n1);
    task_scheduler_register_node(s, make_node("n2", f64_from(4), 4096));
    ScheduledTask_set_node_preference(task, str_from("n1"));
    task_scheduler_submit_task(s, task);
    return vec_get(task_scheduler_schedule_pending(s), 0);
}

fn test_split_request_survives_fallback() {
    test_group("split_request_survives_fallback");
    var s = task_scheduler_new();
    var n1 = make_node("n1", f64_from(1), 256);
    var task = make_task("t1", 5);
    _assert_nodes(task, 0, 0, 0);
    var d = _fallback_scheduler(s, n1, task);
    assert_eq(str_eq_cstr(SchedulingDecision_reason(d), "best-fit selection"), 1, "fell back");
    _assert_nodes(task, "n1", "n2", "n2");
    # n1 frees up and the task is requeued: it goes where it asked to go.
    NodeCapacity_set_available_cpu(n1, f64_from(1));
    NodeCapacity_set_available_memory_mb(n1, 256);
    scheduled_task_transition(task, TASK_QUEUED);
    var d2 = vec_get(task_scheduler_schedule_pending(s), 0);
    assert_eq(str_eq_cstr(SchedulingDecision_assigned_node(d2), "n1"), 1, "requeue honours the request");
    assert_eq(str_eq_cstr(SchedulingDecision_reason(d2), "preferred node"), 1, "and says so");
    _assert_nodes(task, "n1", "n1", "n1");
    assert_eq(_cpu_milli(map_get(TaskScheduler_nodes(s), str_from("n2"))), 4000, "n2 released");
    return 0;
}

fn test_split_no_request_is_best_fit() {
    test_group("split_no_request_is_best_fit");
    var s = task_scheduler_new();
    var n1 = make_node("n1", f64_from(8), 8192);
    task_scheduler_register_node(s, n1);
    task_scheduler_register_node(s, make_node("n2", f64_from(8), 8192));
    var task = make_task("t1", 5);
    task_scheduler_submit_task(s, task);
    var d = vec_get(task_scheduler_schedule_pending(s), 0);
    assert_eq(str_eq_cstr(SchedulingDecision_assigned_node(d), "n1"), 1, "tie goes to n1");
    _assert_nodes(task, 0, "n1", "n1");
    # n1 gets busier while the task is out. Nobody asked for n1, so it does not stick.
    node_capacity_reserve(n1, make_req(f64_from(5), 1));
    scheduled_task_transition(task, TASK_QUEUED);
    var d2 = vec_get(task_scheduler_schedule_pending(s), 0);
    assert_eq(str_eq_cstr(SchedulingDecision_assigned_node(d2), "n2"), 1, "best fit again, not the old node");
    assert_eq(str_eq_cstr(SchedulingDecision_reason(d2), "best-fit selection"), 1, "no false preferred-node reason");
    _assert_nodes(task, 0, "n2", "n2");
    return 0;
}

# The setter asks for a node. On a placed task the view keeps naming the assignment
# until the next pass, and a finished task keeps saying where it ran.
fn test_split_retarget_and_history() {
    test_group("split_retarget_and_history");
    var s = task_scheduler_new();
    task_scheduler_register_node(s, make_node("n1", f64_from(8), 8192));
    task_scheduler_register_node(s, make_node("n2", f64_from(8), 8192));
    var task = make_task("t1", 5);
    ScheduledTask_set_node_preference(task, str_from("n1"));
    _assert_nodes(task, "n1", 0, "n1");
    var id = ScheduledTask_task_id(task);
    task_scheduler_submit_task(s, task);
    task_scheduler_schedule_pending(s);
    scheduled_task_transition(task, TASK_QUEUED);
    ScheduledTask_set_node_preference(task, str_from("n2"));
    _assert_nodes(task, "n2", "n1", "n1");
    var d = vec_get(task_scheduler_schedule_pending(s), 0);
    assert_eq(str_eq_cstr(SchedulingDecision_assigned_node(d), "n2"), 1, "the new request is honoured");
    assert_eq(str_eq_cstr(SchedulingDecision_reason(d), "preferred node"), 1, "preferred node");
    scheduled_task_transition(task, TASK_RUNNING);
    assert_eq(vec_len(task_scheduler_tasks_for_node(s, str_from("n2"))), 1, "listed on its node");
    assert_eq(vec_len(task_scheduler_tasks_for_node(s, str_from("n1"))), 0, "not on the old one");
    task_scheduler_complete_task(s, id, TASK_COMPLETED);
    assert_eq(ScheduledTask_reserved_on(task), 0, "reservation released");
    _assert_nodes(task, "n2", "n2", "n2");
    return 0;
}

# Readers before 1.3.0 read `node_preference` as the assigned node, so the key keeps
# that value and the split travels in two new keys.
fn test_split_json_round_trip() {
    test_group("split_json_round_trip");
    var s = task_scheduler_new();
    var task = make_task("t1", 5);
    _fallback_scheduler(s, make_node("n1", f64_from(1), 256), task);
    var js = scheduled_task_to_json_str(task);
    assert_eq(str_contains(js, str_from("\"node_preference\":\"n2\"")), 1, "key keeps the assignment");
    assert_eq(str_contains(js, str_from("\"requested_node\":\"n1\"")), 1, "request on its own key");
    assert_eq(str_contains(js, str_from("\"assigned_node\":\"n2\"")), 1, "assignment on its own key");
    var back = scheduled_task_from_json_str(js);
    _assert_nodes(back, "n1", "n2", "n2");
    assert_eq(str_eq(scheduled_task_to_json_str(back), js), 1, "re-serialize byte-identical");
    # An explicit null is an answer: the view must not stand in for the request.
    var fresh = make_task("t2", 5);
    ScheduledTask_set_assigned_node(fresh, str_from("n1"));
    var js2 = scheduled_task_to_json_str(fresh);
    assert_eq(str_contains(js2, str_from("\"requested_node\":null")), 1, "no request is written as null");
    _assert_nodes(scheduled_task_from_json_str(js2), 0, "n1", "n1");
    # A wrong-typed key reads as None, as every nullable Str field does.
    var bad = scheduled_task_from_json_str(str_from("{\"task_id\":\"x\",\"name\":\"n\",\"description\":\"d\",\"agent_id\":\"a\",\"resource_requirements\":{\"cpu_cores\":1.0,\"memory_mb\":1,\"accel_req\":0,\"accel_min_chips\":0,\"network\":0,\"disk_mb\":0},\"node_preference\":\"n1\",\"requested_node\":5,\"assigned_node\":[]}"));
    assert_eq(bad != 0, 1, "record survives");
    _assert_nodes(bad, 0, 0, 0);
    return 0;
}

# A restored scheduler's task with this name.
fn _task_named(s, name) {
    var all = map_values(TaskScheduler_tasks(s));
    var i = 0;
    while (i < vec_len(all)) {
        if (str_eq_cstr(ScheduledTask_name(vec_get(all, i)), name) == 1) { return vec_get(all, i); }
        i = i + 1;
    }
    return 0;
}

# tests/fixtures holds snapshots written by real releases, all from the same program:
# 3 nodes and a task for each placement history. A placed task's request is gone
# from these, so each reads back with its one recorded node as both fields.
fn _assert_fixture(path) {
    var cap = 65536;
    var buf = alloc(cap);
    var n = file_read_all(path, buf, cap);
    assert_eq(n > 0, 1, "fixture readable from the project root");
    var s = task_scheduler_from_json_str(str_new(buf, n));
    assert_eq(s != 0, 1, "fixture restored");
    assert_eq(map_size(TaskScheduler_tasks(s)), 8, "every task restored");
    # Never placed: the recorded node is the request, and it is not an assignment.
    _assert_nodes(_task_named(s, "queued-req"), "n1", 0, "n1");
    _assert_nodes(_task_named(s, "sched-req"), "n1", "n1", "n1");
    _assert_nodes(_task_named(s, "sched-fallback"), "n2", "n2", "n2");
    _assert_nodes(_task_named(s, "sched-bestfit"), "n3", "n3", "n3");
    _assert_nodes(_task_named(s, "running"), "n1", "n1", "n1");
    _assert_nodes(_task_named(s, "completed"), "n1", "n1", "n1");
    _assert_nodes(_task_named(s, "cancelled"), "n3", "n3", "n3");
    _assert_nodes(_task_named(s, "requeued-fallback"), "n2", "n2", "n2");
    assert_eq(_node_is(ScheduledTask_reserved_on(_task_named(s, "running")), "n1"), 1, "running holds n1");
    assert_eq(vec_len(task_scheduler_tasks_for_node(s, str_from("n1"))), 2, "n1 tasks");
    assert_eq(vec_len(task_scheduler_tasks_for_node(s, str_from("n2"))), 1, "n2 tasks");
    assert_eq(vec_len(task_scheduler_tasks_for_node(s, str_from("n3"))), 1, "n3 tasks");
    # The requeued task behaves as it did on the release that wrote it. queued-req
    # asks for more CPU than any node has, so it is the only one left.
    var ds = task_scheduler_schedule_pending(s);
    assert_eq(vec_len(ds), 1, "only the requeued task places");
    assert_eq(str_eq_cstr(SchedulingDecision_assigned_node(vec_get(ds, 0)), "n2"), 1, "requeued onto its old node");
    assert_eq(str_eq_cstr(SchedulingDecision_reason(vec_get(ds, 0)), "preferred node"), 1, "reason as before");
    return 0;
}

fn test_split_fixture_1_0_2() {
    test_group("split_fixture_1_0_2");
    return _assert_fixture("tests/fixtures/snapshot-1.0.2.json");
}

fn test_split_fixture_1_0_4() {
    test_group("split_fixture_1_0_4");
    return _assert_fixture("tests/fixtures/snapshot-1.0.4.json");
}

fn test_split_fixture_1_2_2() {
    test_group("split_fixture_1_2_2");
    return _assert_fixture("tests/fixtures/snapshot-1.2.2.json");
}

# The entry gate for replacing samay's insertion sorts (ADR-0011). vec_sort_by is not
# stable, so this proves the comparators leave it nothing to choose: on random inputs
# it must match the insertion sort it replaced, element for element. Priority and
# created_at tie constantly, so the task_id tie-break decides most of the order. The
# reference keeps the old comparators' logic and its own string compare, so it shares
# nothing with the code under test.

var _sort_rng = 88172645463325252;

# xorshift64, fixed seed: the same inputs on every run.
fn _sort_rand(n) {
    var x = _sort_rng;
    x = x ^ (x << 13);
    x = x ^ (x >> 7);
    x = x ^ (x << 17);
    _sort_rng = x;
    return (x >> 1) % n;
}

# Unsigned bytes, then length: written here so the gate does not rest on _samay_str_cmp.
fn _ref_str_lt(a, b) {
    var la = str_len(a);
    var lb = str_len(b);
    var i = 0;
    while (i < la) {
        if (i >= lb) { return 0; }
        var ca = load8(str_data(a) + i);
        var cb = load8(str_data(b) + i);
        if (ca < cb) { return 1; }
        if (ca > cb) { return 0; }
        i = i + 1;
    }
    if (la < lb) { return 1; }
    return 0;
}

fn _ref_task_before(a, b) {
    var pa = ScheduledTask_priority(a);
    var pb = ScheduledTask_priority(b);
    if (pa > pb) { return 1; }
    if (pa < pb) { return 0; }
    var ca = ScheduledTask_created_at(a);
    var cb = ScheduledTask_created_at(b);
    if (ca < cb) { return 1; }
    if (ca > cb) { return 0; }
    return _ref_str_lt(ScheduledTask_task_id(a), ScheduledTask_task_id(b));
}

fn _ref_id_before(a, b) { return _ref_str_lt(ScheduledTask_task_id(a), ScheduledTask_task_id(b)); }
fn _ref_node_before(a, b) { return _ref_str_lt(NodeCapacity_node_id(a), NodeCapacity_node_id(b)); }
fn _ref_entry_before(a, b) { return _ref_str_lt(CronEntry_name(a), CronEntry_name(b)); }

# A copy of `v` in the order the old insertion sorts gave it.
fn _ref_sorted(v, before) {
    var out = vec_new();
    var n = vec_len(v);
    var i = 0;
    while (i < n) {
        vec_push(out, vec_get(v, i));
        i = i + 1;
    }
    i = 1;
    while (i < n) {
        var key = vec_get(out, i);
        var j = i - 1;
        while (j >= 0) {
            var cur = vec_get(out, j);
            if (fncall2(before, key, cur) == 0) { break; }
            vec_set(out, j + 1, cur);
            j = j - 1;
        }
        vec_set(out, j + 1, key);
        i = i + 1;
    }
    return out;
}

fn _same_order(a, b) {
    if (vec_len(a) != vec_len(b)) { return 0; }
    var i = 0;
    while (i < vec_len(a)) {
        if (vec_get(a, i) != vec_get(b, i)) { return 0; }
        i = i + 1;
    }
    return 1;
}

# `n` distinct elements of `pool`, in random order (a partial Fisher-Yates shuffle).
fn _random_sample(pool, n) {
    var out = vec_new();
    var i = 0;
    while (i < n) {
        var j = i + _sort_rand(vec_len(pool) - i);
        var picked = vec_get(pool, j);
        vec_set(pool, j, vec_get(pool, i));
        vec_set(pool, i, picked);
        vec_push(out, picked);
        i = i + 1;
    }
    return out;
}

# Sort `inputs` random samples both ways. Returns how many came out different.
fn _sort_mismatches(pool, inputs, cmp, before) {
    var bad = 0;
    var i = 0;
    while (i < inputs) {
        var sample = _random_sample(pool, i % (vec_len(pool) + 1));
        var want = _ref_sorted(sample, before);
        vec_sort_by(sample, cmp);
        if (_same_order(sample, want) == 0) { bad = bad + 1; }
        i = i + 1;
    }
    return bad;
}

fn _numbered(prefix, i) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, prefix);
    str_builder_add_int(sb, i);
    return str_builder_build(sb);
}

fn _task_pool(n) {
    var pool = vec_new();
    var i = 0;
    while (i < n) {
        var t = make_task("t", 1 + _sort_rand(3));
        # A UUID has one length. These do not, so a prefix must sort first too.
        ScheduledTask_set_task_id(t, _numbered("id-", i));
        ScheduledTask_set_created_at(t, _sort_rand(4));
        vec_push(pool, t);
        i = i + 1;
    }
    return pool;
}

fn test_sort_matches_insertion() {
    test_group("sort_matches_insertion");
    var tasks = _task_pool(257);
    assert_eq(_sort_mismatches(tasks, 2000, &_task_cmp, &_ref_task_before), 0, "scheduling order, 2,000 inputs");
    assert_eq(_sort_mismatches(tasks, 500, &_task_id_cmp, &_ref_id_before), 0, "task_id order");
    var nodes = vec_new();
    var entries = vec_new();
    var i = 0;
    while (i < 97) {
        vec_push(nodes, node_capacity_new(_numbered("node-", i), f64_from(1), 1, 1, 0));
        var e_t, e_v = cron_expr_parse(str_from("0 3 * * *"));
        vec_push(entries, cron_entry_new(_numbered("entry-", i), result_unwrap(e_t, e_v), make_template(), 1, CRON_SKIP));
        i = i + 1;
    }
    assert_eq(_sort_mismatches(nodes, 500, &_node_id_cmp, &_ref_node_before), 0, "node_id order");
    assert_eq(_sort_mismatches(entries, 500, &_entry_name_cmp, &_ref_entry_before), 0, "cron entry order");
    return 0;
}

# The shapes that hurt a quicksort, past the size where the sort leaves insertion
# behind, through the public entry point.
fn test_sort_hostile_shapes() {
    test_group("sort_hostile_shapes");
    # Straight into the sort: through a scheduler the hashmap shuffles the input, and
    # this would never see the shape it names.
    var pending = vec_new();
    var i = 0;
    while (i < 2000) {
        var t = make_task("t", 5);
        ScheduledTask_set_task_id(t, _numbered("id-", i));
        ScheduledTask_set_created_at(t, 2000 - i);
        vec_push(pending, t);
        i = i + 1;
    }
    var by_ref = _ref_sorted(pending, &_ref_task_before);
    vec_sort_by(pending, &_task_cmp);
    assert_eq(_same_order(pending, by_ref), 1, "reverse created_at");
    assert_eq(ScheduledTask_created_at(vec_get(pending, 0)), 1, "oldest first");
    # All equal but the unique key: nothing but the tie-break separates them.
    var ties = _task_pool(2000);
    i = 0;
    while (i < 2000) {
        ScheduledTask_set_priority(vec_get(ties, i), 5);
        ScheduledTask_set_created_at(vec_get(ties, i), 7);
        i = i + 1;
    }
    var want = _ref_sorted(ties, &_ref_task_before);
    vec_sort_by(ties, &_task_cmp);
    assert_eq(_same_order(ties, want), 1, "every key tied but task_id");
    # Already sorted: vec_sort_by's scan returns without moving anything.
    vec_sort_by(ties, &_task_cmp);
    assert_eq(_same_order(ties, want), 1, "sorting a sorted vec changes nothing");
    return 0;
}

fn test_sort_str_cmp() {
    test_group("sort_str_cmp");
    assert_eq(_samay_str_cmp(str_from("a"), str_from("b")) < 0, 1, "a before b");
    assert_eq(_samay_str_cmp(str_from("b"), str_from("a")) > 0, 1, "b after a");
    assert_eq(_samay_str_cmp(str_from("ab"), str_from("abc")) < 0, 1, "a prefix first");
    assert_eq(_samay_str_cmp(str_from("abc"), str_from("ab")) > 0, 1, "longer after");
    assert_eq(_samay_str_cmp(str_from("abc"), str_from("abc")), 0, "equal");
    assert_eq(_samay_str_cmp(str_from(""), str_from("")), 0, "empty equal");
    # Bytes are unsigned: 0xC3 sorts after ASCII.
    assert_eq(_samay_str_cmp(str_from("\xC3"), str_from("z")) > 0, 1, "unsigned bytes");
    return 0;
}

# Every sort site, at a size where hash order cannot pass for sorted by luck. The
# determinism tests above use three or four elements, and with that few, removing a
# sort can still pass.
fn test_sort_every_site() {
    test_group("sort_every_site");
    var n = 64;
    var s = task_scheduler_new();
    var i = 0;
    while (i < n) {
        var t = make_task("t", 5);
        ScheduledTask_set_task_id(t, _numbered("id-", i));
        ScheduledTask_set_status(t, TASK_RUNNING);
        ScheduledTask_set_assigned_node(t, str_from("n"));
        task_scheduler_submit_task(s, t);
        task_scheduler_register_node(s, node_capacity_new(_numbered("node-", i), f64_from(1), 1, 1, 0));
        i = i + 1;
    }
    var on_node = task_scheduler_tasks_for_node(s, str_from("n"));
    assert_eq(vec_len(on_node), n, "every task listed");
    assert_eq(_same_order(on_node, _ref_sorted(on_node, &_ref_id_before)), 1, "tasks_for_node order");
    var snap = task_scheduler_to_jsonv(s);
    var tasks = bayan_json_v_obj_get_by_cstr(snap, "tasks");
    var nodes = bayan_json_v_obj_get_by_cstr(snap, "nodes");
    var sorted_t = _ref_sorted(on_node, &_ref_id_before);
    var sorted_n = _ref_sorted(map_values(TaskScheduler_nodes(s)), &_ref_node_before);
    var t_bad = 0;
    var n_bad = 0;
    i = 0;
    while (i < n) {
        var tid = bayan_json_v_str(bayan_json_v_obj_get_by_cstr(bayan_json_v_arr_get(tasks, i), "task_id"));
        if (str_eq(tid, ScheduledTask_task_id(vec_get(sorted_t, i))) != 1) { t_bad = t_bad + 1; }
        var nid = bayan_json_v_str(bayan_json_v_obj_get_by_cstr(bayan_json_v_arr_get(nodes, i), "node_id"));
        if (str_eq(nid, NodeCapacity_node_id(vec_get(sorted_n, i))) != 1) { n_bad = n_bad + 1; }
        i = i + 1;
    }
    assert_eq(t_bad, 0, "snapshot task order");
    assert_eq(n_bad, 0, "snapshot node order");
    var c = cron_scheduler_new();
    i = 0;
    while (i < n) {
        var tmpl = cron_task_template_new(_numbered("job-", i), str_from("d"), str_from("a"), 3, make_req(f64_from(1), 256));
        cron_scheduler_add(c, _numbered("entry-", i), str_from("* * * * *"), tmpl, 1, CRON_SKIP);
        i = i + 1;
    }
    var entries = cron_scheduler_list_entries(c);
    var fired = cron_scheduler_check_due_at(c, at_ns(2026, 7, 18, 12, 0));
    assert_eq(vec_len(fired), n, "every entry fired");
    var c_bad = 0;
    i = 0;
    while (i < n) {
        var base = CronTaskTemplate_name(CronEntry_task_template(vec_get(entries, i)));
        if (str_starts_with(ScheduledTask_name(vec_get(fired, i)), base) != 1) { c_bad = c_bad + 1; }
        i = i + 1;
    }
    assert_eq(c_bad, 0, "cron tasks fire in entry-name order");
    var jentries = bayan_json_v_obj_get_by_cstr(cron_scheduler_to_jsonv(c), "entries");
    var j_bad = 0;
    i = 0;
    while (i < n) {
        var jname = bayan_json_v_str(bayan_json_v_obj_get_by_cstr(bayan_json_v_arr_get(jentries, i), "name"));
        if (str_eq(jname, CronEntry_name(vec_get(entries, i))) != 1) { j_bad = j_bad + 1; }
        i = i + 1;
    }
    assert_eq(j_bad, 0, "snapshot entry order");
    return 0;
}

# Capacity is f64, and once a sum crosses a power of two the order of the adds changes
# the low bits. Map order changes with the hash seed, so releasing in map order made
# the same schedule leave different capacity from run to run. These amounts cross
# several. Each round has new task ids and so a new map order, so a release that
# ignored task_id order would have to match by luck in all of them.
fn _release_order_rounds(prune) {
    var bad = 0;
    var round = 0;
    while (round < 24) {
        var s = task_scheduler_new();
        var node = make_node("n1", f64_from(100), 8192);
        task_scheduler_register_node(s, node);
        var ts = vec_new();
        var i = 0;
        while (i < 16) {
            var req = make_req(f64_div(f64_from(37 + i), f64_from(7 + i % 3)), 1);
            var t = scheduled_task_new(str_from("t"), str_from("d"), str_from("a"), 5, req);
            ScheduledTask_set_task_id(t, _numbered(_numbered("r", round + 100 * prune), i));
            task_scheduler_submit_task(s, t);
            vec_push(ts, t);
            i = i + 1;
        }
        task_scheduler_schedule_pending(s);
        var held = vec_get(ts, 15);
        scheduled_task_transition(held, TASK_RUNNING);
        i = 0;
        while (i < 15) {
            var f = vec_get(ts, i);
            scheduled_task_transition(f, TASK_RUNNING);
            scheduled_task_transition(f, TASK_FAILED);
            i = i + 1;
        }
        # The answer: the same adds, in task_id order.
        var by_id = _ref_sorted(ts, &_ref_id_before);
        var want = NodeCapacity_available_cpu(node);
        i = 0;
        while (i < 16) {
            var r = vec_get(by_id, i);
            if (r != held) { want = f64_add(want, ResourceReq_cpu_cores(ScheduledTask_resource_requirements(r))); }
            i = i + 1;
        }
        if (prune == 1) {
            task_scheduler_prune_terminal(s, 9223372036854775807);
        } else {
            task_scheduler_schedule_pending(s);
        }
        if (NodeCapacity_available_cpu(node) != want) { bad = bad + 1; }
        round = round + 1;
    }
    return bad;
}

fn test_release_order_deterministic() {
    test_group("release_order_deterministic");
    assert_eq(_release_order_rounds(0), 0, "a scheduling pass releases in task_id order");
    assert_eq(_release_order_rounds(1), 0, "pruning releases in task_id order");
    return 0;
}

# 1 if a removal answers Err with this code.
fn _removal_refused(s, id, code) {
    var r_t, r_v = task_scheduler_remove_task(s, id);
    if (is_err_result(r_t) != 1) { return 0; }
    return r_v == code;
}

fn test_remove_task() {
    test_group("remove_task");
    var s = task_scheduler_new();
    var node = make_node("n1", f64_from(8), 8192);
    task_scheduler_register_node(s, node);
    var t = make_task("t1", 5);
    var id = ScheduledTask_task_id(t);
    assert_eq(_removal_refused(s, id, 1), 1, "unknown id is Err(1)");
    task_scheduler_submit_task(s, t);
    # Every status a task can still run from is refused, and nothing moves.
    assert_eq(_removal_refused(s, id, 2), 1, "QUEUED refused");
    task_scheduler_schedule_pending(s);
    assert_eq(_removal_refused(s, id, 2), 1, "SCHEDULED refused");
    scheduled_task_transition(t, TASK_RUNNING);
    assert_eq(_removal_refused(s, id, 2), 1, "RUNNING refused");
    assert_eq(_cpu_milli(node), 7000, "a refused removal releases nothing");
    assert_eq(map_size(TaskScheduler_tasks(s)), 1, "a refused removal keeps the task");
    scheduled_task_transition(t, TASK_PREEMPTED);
    assert_eq(_removal_refused(s, id, 2), 1, "PREEMPTED refused: it goes back to QUEUED");
    scheduled_task_transition(t, TASK_QUEUED);
    task_scheduler_schedule_pending(s);
    scheduled_task_transition(t, TASK_RUNNING);
    # Finished by hand, so it still holds the node until a pass or a removal.
    scheduled_task_transition(t, TASK_COMPLETED);
    assert_eq(_cpu_milli(node), 7000, "still held");
    var r_t, r_v = task_scheduler_remove_task(s, id);
    assert_eq(is_ok(r_t), 1, "a finished task is removed");
    assert_eq(_cpu_milli(node), 8000, "and returns what it held");
    assert_eq(NodeCapacity_running_tasks(node), 0, "and its running count");
    assert_eq(task_scheduler_get_task(s, id), 0, "gone from lookup");
    assert_eq(map_size(TaskScheduler_tasks(s)), 0, "gone from the map");
    assert_eq(vec_len(map_values(TaskScheduler_tasks(s))), 0, "gone from iteration");
    assert_eq(_removal_refused(s, id, 1), 1, "a second removal is Err(1)");
    return 0;
}

fn test_remove_task_finished_states() {
    test_group("remove_task_finished_states");
    var s = task_scheduler_new();
    var node = make_node("n1", f64_from(8), 8192);
    task_scheduler_register_node(s, node);
    var a = make_task("failed", 5);
    var b = make_task("cancelled", 5);
    var other = make_task("other", 5);
    var ia = ScheduledTask_task_id(a);
    var ib = ScheduledTask_task_id(b);
    task_scheduler_submit_task(s, a);
    task_scheduler_submit_task(s, b);
    task_scheduler_submit_task(s, other);
    task_scheduler_schedule_pending(s);
    scheduled_task_transition(a, TASK_RUNNING);
    task_scheduler_complete_task(s, ia, TASK_FAILED);
    task_scheduler_cancel_task(s, ib);
    assert_eq(_cpu_milli(node), 7000, "both released already, the third still holds");
    assert_eq(is_ok(task_scheduler_remove_task(s, ia)), 1, "FAILED removed");
    assert_eq(is_ok(task_scheduler_remove_task(s, ib)), 1, "CANCELLED removed");
    # Other work on the node is what makes this able to fail: on an idle node the
    # cap at total would hide a second release.
    assert_eq(_cpu_milli(node), 7000, "no double release");
    assert_eq(NodeCapacity_running_tasks(node), 1, "and the running count still counts the third");
    task_scheduler_cancel_task(s, ScheduledTask_task_id(other));
    assert_eq(NodeCapacity_running_tasks(node), 0, "running count not driven negative");
    return 0;
}

# Finish `t` with a known completed_at, through the scheduler.
fn _finish_at(s, t, at) {
    scheduled_task_transition(t, TASK_RUNNING);
    task_scheduler_complete_task(s, ScheduledTask_task_id(t), TASK_COMPLETED);
    ScheduledTask_set_completed_at(t, at);
    return 0;
}

fn test_prune_terminal() {
    test_group("prune_terminal");
    var s = task_scheduler_new();
    var node = make_node("n1", f64_from(8), 8192);
    task_scheduler_register_node(s, node);
    var old = make_task("old", 5);
    var edge = make_task("edge", 5);
    var fresh = make_task("fresh", 5);
    var live = make_task("live", 5);
    var byhand = make_task("byhand", 5);
    task_scheduler_submit_task(s, old);
    task_scheduler_submit_task(s, edge);
    task_scheduler_submit_task(s, fresh);
    task_scheduler_submit_task(s, live);
    task_scheduler_submit_task(s, byhand);
    task_scheduler_schedule_pending(s);
    _finish_at(s, old, 100);
    _finish_at(s, edge, 200);
    _finish_at(s, fresh, 300);
    scheduled_task_transition(live, TASK_RUNNING);
    # Finished by hand: no completed_at, and it still holds its node.
    scheduled_task_transition(byhand, TASK_RUNNING);
    scheduled_task_transition(byhand, TASK_COMPLETED);
    # A snapshot from before 1.4.3 can hold a finished task with no time on it.
    ScheduledTask_set_completed_at(byhand, 0);
    assert_eq(_cpu_milli(node), 6000, "live and byhand hold the node");
    assert_eq(task_scheduler_prune_terminal(s, 0), 0, "nothing is older than the epoch");
    assert_eq(task_scheduler_prune_terminal(s, 200), 2, "strictly before: old and byhand");
    assert_eq(task_scheduler_get_task(s, ScheduledTask_task_id(old)), 0, "old gone");
    assert_eq(task_scheduler_get_task(s, ScheduledTask_task_id(byhand)), 0, "byhand gone");
    assert_eq(task_scheduler_get_task(s, ScheduledTask_task_id(edge)) != 0, 1, "the boundary stays");
    assert_eq(_cpu_milli(node), 7000, "byhand's reservation came back");
    assert_eq(SchedulerStats_total_tasks(task_scheduler_stats(s)), 3, "stats count what is left");
    assert_eq(task_scheduler_prune_terminal(s, 1000), 2, "edge and fresh");
    assert_eq(map_size(TaskScheduler_tasks(s)), 1, "only the running task is left");
    assert_eq(task_scheduler_get_task(s, ScheduledTask_task_id(live)) != 0, 1, "an unfinished task is never pruned");
    assert_eq(task_scheduler_prune_terminal(s, 1000), 0, "nothing left to prune");
    assert_eq(_cpu_milli(node), 7000, "live still holds its node");
    assert_eq(str_contains(task_scheduler_to_json_str(s), str_from("\"name\":\"live\"")), 1, "the snapshot has live");
    assert_eq(str_contains(task_scheduler_to_json_str(s), str_from("\"name\":\"old\"")), 0, "and not what went");
    return 0;
}

# Pruning has to keep the table bounded, not only the count. The stdlib rebuilds it in
# place once tombstones pile up, so its capacity must follow the live tasks, not the
# tasks ever seen.
fn test_prune_churn() {
    test_group("prune_churn");
    var s = task_scheduler_new();
    task_scheduler_register_node(s, make_node("n1", f64_from(8), 8192));
    var round = 0;
    while (round < 2000) {
        var i = 0;
        while (i < 8) {
            var t = make_task("t", 5);
            task_scheduler_submit_task(s, t);
            task_scheduler_cancel_task(s, ScheduledTask_task_id(t));
            i = i + 1;
        }
        task_scheduler_prune_terminal(s, 9223372036854775807);
        round = round + 1;
    }
    assert_eq(map_size(TaskScheduler_tasks(s)), 0, "16,000 tasks seen, none left");
    assert_eq(map_cap(TaskScheduler_tasks(s)) <= 64, 1, "the table did not grow with them");
    return 0;
}

# Restore refuses a collection past the ceiling, so the writers must too, or samay
# writes what it cannot read back. A lowered ceiling stands in for 100,000 items.
fn test_snapshot_write_cap() {
    test_group("snapshot_write_cap");
    var ceiling = SAMAY_JSON_MAX_ITEMS;
    var s = task_scheduler_new();
    task_scheduler_register_node(s, make_node("n1", f64_from(8), 8192));
    var a = make_task("a", 5);
    var b = make_task("b", 5);
    var c = make_task("c", 5);
    task_scheduler_submit_task(s, a);
    task_scheduler_submit_task(s, b);
    SAMAY_JSON_MAX_ITEMS = 2;
    var at_cap = task_scheduler_to_json_str(s);
    assert_eq(at_cap != 0, 1, "at the ceiling, written");
    assert_eq(task_scheduler_from_json_str(at_cap) != 0, 1, "and what is written restores");
    task_scheduler_submit_task(s, c);
    assert_eq(task_scheduler_to_jsonv(s), 0, "tasks past the ceiling: refused, not truncated");
    assert_eq(task_scheduler_to_json_str(s), 0, "as a Str too");
    assert_eq(map_size(TaskScheduler_tasks(s)), 3, "refusing changes nothing");
    # The way out: finish something, prune it, write again.
    task_scheduler_cancel_task(s, ScheduledTask_task_id(c));
    assert_eq(task_scheduler_prune_terminal(s, 9223372036854775807), 1, "pruned");
    assert_eq(task_scheduler_to_json_str(s) != 0, 1, "and the snapshot writes again");
    # Nodes, and one node's profiles, inside a scheduler and on their own.
    task_scheduler_register_node(s, make_node("n2", f64_from(8), 8192));
    task_scheduler_register_node(s, make_node("n3", f64_from(8), 8192));
    assert_eq(task_scheduler_to_jsonv(s), 0, "nodes past the ceiling: refused");
    var heavy = make_node("heavy", f64_from(8), 8192);
    node_capacity_add_accel(heavy, profile_cuda(0, 0));
    node_capacity_add_accel(heavy, profile_cuda(1, 0));
    assert_eq(node_capacity_to_json_str(heavy) != 0, 1, "profiles at the ceiling, written");
    node_capacity_add_accel(heavy, profile_cuda(2, 0));
    assert_eq(node_capacity_to_jsonv(heavy), 0, "profiles past the ceiling: refused");
    assert_eq(node_capacity_to_json_str(heavy), 0, "as a Str too");
    var withheavy = task_scheduler_new();
    task_scheduler_register_node(withheavy, heavy);
    assert_eq(task_scheduler_to_json_str(withheavy), 0, "a refused node refuses its scheduler");
    # Cron entries.
    var cs = cron_scheduler_new();
    cron_scheduler_add(cs, str_from("e1"), str_from("0 1 * * *"), make_template(), 1, CRON_SKIP);
    cron_scheduler_add(cs, str_from("e2"), str_from("0 2 * * *"), make_template(), 1, CRON_SKIP);
    assert_eq(cron_scheduler_to_json_str(cs) != 0, 1, "entries at the ceiling, written");
    cron_scheduler_add(cs, str_from("e3"), str_from("0 3 * * *"), make_template(), 1, CRON_SKIP);
    assert_eq(cron_scheduler_to_jsonv(cs), 0, "entries past the ceiling: refused");
    assert_eq(cron_scheduler_to_json_str(cs), 0, "as a Str too");
    SAMAY_JSON_MAX_ITEMS = ceiling;
    assert_eq(cron_scheduler_to_json_str(cs) != 0, 1, "the real ceiling writes all three");
    return 0;
}

# Put a samay value node inside someone else's document, serialize the whole
# document, parse it back, and hand back the nested node.
fn _embed_rt(v) {
    var outer = bayan_json_v_obj_new();
    bayan_json_v_obj_set(outer, str_from("ok"), bayan_json_v_bool_new(1));
    bayan_json_v_obj_set(outer, str_from("item"), v);
    var text = bayan_json_v_build(outer);
    return bayan_json_v_obj_get_by_cstr(bayan_json_v_parse_buf(str_data(text), str_len(text)), "item");
}

# The *_to_jsonv / *_from_jsonv layer is how a consumer embeds samay objects in
# its own JSON. Until 1.1.5 no test called it directly: everything went through
# the *_json_str wrappers. Each container type goes into an outer document and
# back and must re-serialize byte-identically, and each decoder must reject a
# missing node and a node that is not an object.
fn test_json_jsonv_embed() {
    test_group("json_jsonv_embed");
    var notobj = bayan_json_v_int_new(7);

    var tj = training_job_template_new(str_from("m"), TM_DPO, str_from("d"), str_from("gpu-1"), 60, 5);
    var tj2 = training_job_template_from_jsonv(_embed_rt(training_job_template_to_jsonv(tj)));
    assert_eq(str_eq(training_job_template_to_json_str(tj2), training_job_template_to_json_str(tj)), 1, "training template round-trips");
    assert_eq(training_job_template_from_jsonv(0), 0, "training template: missing -> 0");
    assert_eq(training_job_template_from_jsonv(notobj), 0, "training template: non-object -> 0");

    var ct = make_template();
    var ct2 = cron_task_template_from_jsonv(_embed_rt(cron_task_template_to_jsonv(ct)));
    assert_eq(str_eq(cron_task_template_to_json_str(ct2), cron_task_template_to_json_str(ct)), 1, "cron task template round-trips");
    assert_eq(cron_task_template_from_jsonv(0), 0, "cron task template: missing -> 0");
    assert_eq(cron_task_template_from_jsonv(notobj), 0, "cron task template: non-object -> 0");

    var st = make_task("st", 7);
    ScheduledTask_set_node_preference(st, str_from("n1"));
    var st2 = scheduled_task_from_jsonv(_embed_rt(scheduled_task_to_jsonv(st)));
    assert_eq(str_eq(scheduled_task_to_json_str(st2), scheduled_task_to_json_str(st)), 1, "scheduled task round-trips");
    assert_eq(scheduled_task_from_jsonv(0), 0, "scheduled task: missing -> 0");
    assert_eq(scheduled_task_from_jsonv(notobj), 0, "scheduled task: non-object -> 0");

    var nc = node_capacity_add_accel(make_node("nc", f64_from(8), 4096), profile_tpu(0, 8, TPU_V5P));
    var nc2 = node_capacity_from_jsonv(_embed_rt(node_capacity_to_jsonv(nc)));
    assert_eq(str_eq(node_capacity_to_json_str(nc2), node_capacity_to_json_str(nc)), 1, "node capacity round-trips");
    assert_eq(node_capacity_from_jsonv(0), 0, "node capacity: missing -> 0");
    assert_eq(node_capacity_from_jsonv(notobj), 0, "node capacity: non-object -> 0");

    var _x_t, _x_v = cron_expr_parse(str_from("*/15 9-17 * * 1-5"));
    var ce = cron_entry_new(str_from("weekday"), result_unwrap(_x_t, _x_v), make_template(), 1, CRON_CATCHUP);
    var ce2 = cron_entry_from_jsonv(_embed_rt(cron_entry_to_jsonv(ce)));
    assert_eq(str_eq(cron_entry_to_json_str(ce2), cron_entry_to_json_str(ce)), 1, "cron entry round-trips");
    assert_eq(cron_entry_from_jsonv(0), 0, "cron entry: missing -> 0");
    assert_eq(cron_entry_from_jsonv(notobj), 0, "cron entry: non-object -> 0");

    var cs = mk_cron("0 2 * * *", CRON_SKIP);
    var cs2 = cron_scheduler_from_jsonv(_embed_rt(cron_scheduler_to_jsonv(cs)));
    assert_eq(str_eq(cron_scheduler_to_json_str(cs2), cron_scheduler_to_json_str(cs)), 1, "cron scheduler round-trips");
    assert_eq(cron_scheduler_from_jsonv(0), 0, "cron scheduler: missing -> 0");
    assert_eq(cron_scheduler_from_jsonv(notobj), 0, "cron scheduler: non-object -> 0");

    var s = task_scheduler_new();
    task_scheduler_register_node(s, make_node("n1", f64_from(4), 4096));
    task_scheduler_submit_task(s, make_task("t1", 5));
    task_scheduler_schedule_pending(s);
    var s2 = task_scheduler_from_jsonv(_embed_rt(task_scheduler_to_jsonv(s)));
    assert_eq(str_eq(task_scheduler_to_json_str(s2), task_scheduler_to_json_str(s)), 1, "task scheduler round-trips");
    assert_eq(task_scheduler_from_jsonv(0), 0, "task scheduler: missing -> 0");
    assert_eq(task_scheduler_from_jsonv(notobj), 0, "task scheduler: non-object -> 0");
    return 0;
}

fn test_json_cron_entry() {
    test_group("json_cron_entry");
    var req = make_req(f64_from(1), 128);
    var tmpl = cron_task_template_new(str_from("job"), str_from("recurring"), str_from("agent-1"), 5, req);
    var _expr_t, _expr_v = cron_expr_parse(str_from("0 2 * * *"));
    var expr = result_unwrap(_expr_t, _expr_v);
    var e = cron_entry_new(str_from("backup"), expr, tmpl, 1, CRON_SKIP);
    CronEntry_set_last_fired(e, 1700000000);
    var e2 = cron_entry_from_json_str(cron_entry_to_json_str(e));
    assert_eq(str_eq(CronEntry_name(e2), str_from("backup")), 1, "ce name");
    assert_eq(CronEntry_enabled(e2), 1, "ce enabled");
    assert_eq(CronEntry_missed_policy(e2), CRON_SKIP, "ce policy");
    assert_eq(CronEntry_last_fired(e2), 1700000000, "ce last_fired");
    # nested expr still matches the right instant (02:00 daily)
    var at_2am = _chrono_ymd_to_epoch_secs(2026, 3, 10, 2, 0, 0);
    assert_eq(cron_expr_matches(CronEntry_expr(e2), at_2am), 1, "ce nested expr matches 02:00");
    # nested template
    assert_eq(str_eq(CronTaskTemplate_name(CronEntry_task_template(e2)), str_from("job")), 1, "ce nested tmpl name");
    return 0;
}

fn test_json_cron_scheduler_deterministic() {
    test_group("json_cron_sched");
    var c = cron_scheduler_new();
    cron_scheduler_add(c, str_from("zebra"), str_from("0 1 * * *"), make_template(), 1, CRON_CATCHUP);
    cron_scheduler_add(c, str_from("alpha"), str_from("*/5 * * * *"), make_template(), 1, CRON_SKIP);
    cron_scheduler_add(c, str_from("mid"), str_from("0 12 * * *"), make_template(), 0, CRON_CATCHUP);
    var s1 = cron_scheduler_to_json_str(c);
    var s2 = cron_scheduler_to_json_str(c);
    assert_eq(str_eq(s1, s2), 1, "serializing twice gives the same bytes");
    # entries emitted in sorted key order: alpha, mid, zebra
    assert_eq(str_index_of_cstr(s1, "alpha") < str_index_of_cstr(s1, "mid"), 1, "alpha before mid");
    assert_eq(str_index_of_cstr(s1, "mid") < str_index_of_cstr(s1, "zebra"), 1, "mid before zebra");
    var c2 = cron_scheduler_from_json_str(s1);
    assert_eq(map_size(CronScheduler_entries(c2)), 3, "3 entries restored");
    assert_eq(str_eq(cron_scheduler_to_json_str(c2), s1), 1, "re-serialize matches");
    return 0;
}

fn test_json_task_scheduler_snapshot() {
    test_group("json_scheduler_snapshot");
    var s = task_scheduler_new();
    task_scheduler_register_node(s, node_capacity_add_accel(
        node_capacity_new(str_from("tpu-a"), f64_from(8), 16384, 102400, 0), profile_tpu(0, 4, TPU_V4)));
    task_scheduler_register_node(s, node_capacity_new(str_from("cpu-b"), f64_from(16), 32768, 204800, 0));
    task_scheduler_submit_task(s, make_task("t-alpha", 5));
    task_scheduler_submit_task(s, make_task("t-beta", 9));
    task_scheduler_schedule_pending(s);
    var snap1 = task_scheduler_to_json_str(s);
    var snap2 = task_scheduler_to_json_str(s);
    assert_eq(str_eq(snap1, snap2), 1, "writing a snapshot twice gives the same bytes");
    var s2 = task_scheduler_from_json_str(snap1);
    assert_eq(map_size(TaskScheduler_tasks(s2)), 2, "2 tasks restored");
    assert_eq(map_size(TaskScheduler_nodes(s2)), 2, "2 nodes restored");
    # restored scheduler re-serializes identically (full-fidelity snapshot)
    assert_eq(str_eq(task_scheduler_to_json_str(s2), snap1), 1, "snapshot round-trip identical");
    # stats over the restored scheduler match the original
    assert_eq(SchedulerStats_total_tasks(task_scheduler_stats(s2)),
      SchedulerStats_total_tasks(task_scheduler_stats(s)), "restored stats total match");
    return 0;
}

# --- M4 adversarial regression guards (from the container-codec verify pass) ---

# A Str with bytes: "  \  LF  TAB  c a f  0xC3 0xA9  (café) — exercises the
# common JSON escapes plus a multibyte UTF-8 char, built independent of source escaping.
fn _nasty_str() {
    var sb = str_builder_new();
    str_builder_add_byte(sb, 34);
    str_builder_add_byte(sb, 92);
    str_builder_add_byte(sb, 10);
    str_builder_add_byte(sb, 9);
    str_builder_add_byte(sb, 99);
    str_builder_add_byte(sb, 97);
    str_builder_add_byte(sb, 102);
    str_builder_add_byte(sb, 195);
    str_builder_add_byte(sb, 169);
    return str_builder_build(sb);
}

# GUARD 1 — string fidelity through the container DOM path (escape + UTF-8).
fn test_json_string_fidelity() {
    test_group("json_str_fidelity");
    var nasty = _nasty_str();
    var node = node_capacity_new(nasty, f64_from(1), 128, 256, 0);
    var njs = node_capacity_to_json_str(node);
    # emitted JSON must be valid (re-parseable as an object)
    assert_eq(bayan_json_v_is_obj(bayan_json_v_parse_buf(str_data(njs), str_len(njs))), 1, "node json valid");
    var n2 = node_capacity_from_json_str(njs);
    assert_eq(str_eq(NodeCapacity_node_id(n2), nasty), 1, "node_id byte-identical");
    var t = scheduled_task_new(str_from("t"), str_from("d"), str_from("a"), 5, resource_req_default());
    ScheduledTask_set_fail_reason(t, nasty);
    var t2 = scheduled_task_from_json_str(scheduled_task_to_json_str(t));
    assert_eq(str_eq(ScheduledTask_fail_reason(t2), nasty), 1, "fail_reason byte-identical");
    return 0;
}

# GUARD 2 — determinism independent of insertion order (not just repeated calls).
# Fixed task_id + pinned created_at, so the determinism check isolates ordering
# from clock-derived data (dt_now() would otherwise differ between the two builds).
fn _mk_task_id(id, prio) {
    var t = make_task(id, prio);
    ScheduledTask_set_task_id(t, str_from(id));
    ScheduledTask_set_created_at(t, 1000);
    return t;
}
fn test_json_determinism_reorder() {
    test_group("json_determinism");
    var a = task_scheduler_new();
    task_scheduler_submit_task(a, _mk_task_id("zebra", 5));
    task_scheduler_submit_task(a, _mk_task_id("alpha", 5));
    task_scheduler_submit_task(a, _mk_task_id("mid", 5));
    var b = task_scheduler_new();
    task_scheduler_submit_task(b, _mk_task_id("mid", 5));
    task_scheduler_submit_task(b, _mk_task_id("zebra", 5));
    task_scheduler_submit_task(b, _mk_task_id("alpha", 5));
    assert_eq(str_eq(task_scheduler_to_json_str(a), task_scheduler_to_json_str(b)), 1,
      "same tasks, different insert order -> identical JSON");
    return 0;
}

# GUARD 3 — empty / minimal collections serialize as [] and restore to size 0.
fn test_json_empty_collections() {
    test_group("json_empty");
    var s2 = task_scheduler_from_json_str(task_scheduler_to_json_str(task_scheduler_new()));
    assert_eq(map_size(TaskScheduler_tasks(s2)), 0, "empty tasks -> 0");
    assert_eq(map_size(TaskScheduler_nodes(s2)), 0, "empty nodes -> 0");
    var c2 = cron_scheduler_from_json_str(cron_scheduler_to_json_str(cron_scheduler_new()));
    assert_eq(map_size(CronScheduler_entries(c2)), 0, "empty entries -> 0");
    var cpu = node_capacity_new(str_from("cpu"), f64_from(4), 1024, 2048, 0);
    var cpu2 = node_capacity_from_json_str(node_capacity_to_json_str(cpu));
    assert_eq(vec_len(NodeCapacity_accel_profiles(cpu2)), 0, "zero profiles -> 0");
    return 0;
}

# GUARD 4 — malformed / partial input: non-object -> 0, record with no fields -> 0, no crash.
fn test_json_malformed_input() {
    test_group("json_malformed");
    assert_eq(scheduled_task_from_json_str(str_from("[1,2,3]")), 0, "array root -> 0");
    assert_eq(scheduled_task_from_json_str(str_from("42")), 0, "int root -> 0");
    assert_eq(node_capacity_from_json_str(str_from("null")), 0, "null root -> 0");
    assert_eq(task_scheduler_from_json_str(str_from("{")), 0, "unterminated -> 0");
    assert_eq(cron_entry_from_json_str(str_from("")), 0, "empty string -> 0");
    # record types with missing required fields -> rejected (fail-closed, ADR-0005)
    assert_eq(cron_task_template_from_json_str(str_from("{}")), 0, "record missing required -> 0");
    assert_eq(scheduled_task_from_json_str(str_from("{}")), 0, "task missing required -> 0");
    assert_eq(node_capacity_from_json_str(str_from("{}")), 0, "node missing node_id -> 0");
    # container types with no items -> valid empty container (no required scalar fields)
    var es = task_scheduler_from_json_str(str_from("{}"));
    assert_eq(es != 0, 1, "empty scheduler obj -> valid");
    assert_eq(map_size(TaskScheduler_tasks(es)), 0, "empty scheduler has 0 tasks");
    return 0;
}

# GUARD 5 — behavior parity + numeric boundaries after round-trip.
fn test_json_parity_boundaries() {
    test_group("json_parity_bounds");
    # f64 boundaries bit-exact through NodeCapacity.total_cpu
    var tiny = node_capacity_new(str_from("n"), f64_div(f64_from(1), f64_from(1000000000)), 1, 1, 0);
    var tiny2 = node_capacity_from_json_str(node_capacity_to_json_str(tiny));
    assert_eq(NodeCapacity_total_cpu(tiny2) == NodeCapacity_total_cpu(tiny), 1, "1e-9 cpu bit-exact");
    var zero = node_capacity_new(str_from("z"), f64_from(0), 1, 1, 0);
    var zero2 = node_capacity_from_json_str(node_capacity_to_json_str(zero));
    assert_eq(NodeCapacity_total_cpu(zero2) == f64_from(0), 1, "0.0 cpu bit-exact");
    # A double at a rounding near-tie. 1.621274542797433e-9 is the shortest repr
    # of 0x3E1BDA70DB50D19F, and through samay 1.1.3 (bayan 1.5.6) it restored
    # one ULP high, as ...D1A0; bayan 1.5.7's parser is correctly rounded. The
    # asserts above use f64 ==, a value compare; this one compares the bits.
    var hard = node_capacity_new(str_from("h"), f64_from(1), 1, 1, 0);
    NodeCapacity_set_total_cpu(hard, 0x3E1BDA70DB50D19F);
    NodeCapacity_set_available_cpu(hard, 0x3E1BDA70DB50D19F);
    var hard2 = node_capacity_from_json_str(node_capacity_to_json_str(hard));
    assert_eq(NodeCapacity_total_cpu(hard2), 0x3E1BDA70DB50D19F, "near-tie cpu bit-exact (bits)");
    # i64 boundary: near-max timestamp, no coercion
    var t = scheduled_task_new(str_from("t"), str_from("d"), str_from("a"), 5, resource_req_default());
    ScheduledTask_set_scheduled_at(t, 9223372036854775807);
    var t2 = scheduled_task_from_json_str(scheduled_task_to_json_str(t));
    assert_eq(ScheduledTask_scheduled_at(t2), 9223372036854775807, "i64-max timestamp exact");
    # chip-count-exact placement boundary through a restored node
    var node = node_capacity_add_accel(
      node_capacity_new(str_from("tpu"), f64_from(8), 4096, 8192, 0), profile_tpu(0, 8, TPU_V4));
    var node2 = node_capacity_from_json_str(node_capacity_to_json_str(node));
    assert_eq(node_capacity_can_fit(node2, resource_req_new(f64_from(1), 1, REQ_TPU, 8, 0, 0)), 1, "restored fits TPU(8)");
    assert_eq(node_capacity_can_fit(node2, resource_req_new(f64_from(1), 1, REQ_TPU, 9, 0, 0)), 0, "restored rejects TPU(9)");
    return 0;
}

# --- M5: determinism guarantees (tie-breaks independent of hashmap order) ---

fn _det_task(id, prio, created) {
    var t = make_task(id, prio);
    ScheduledTask_set_task_id(t, str_from(id));
    ScheduledTask_set_created_at(t, created);
    return t;
}

# Flagship: same 3 equal-priority/equal-created tasks + 2 equal nodes, inserted
# in opposite orders, must yield an identical decision sequence.
fn test_det_schedule_pending() {
    test_group("det_schedule");
    var a = task_scheduler_new();
    task_scheduler_register_node(a, make_node("node-a", f64_from(8), 8192));
    task_scheduler_register_node(a, make_node("node-b", f64_from(8), 8192));
    task_scheduler_submit_task(a, _det_task("task-1", 5, 100));
    task_scheduler_submit_task(a, _det_task("task-2", 5, 100));
    task_scheduler_submit_task(a, _det_task("task-3", 5, 100));
    var b = task_scheduler_new();
    task_scheduler_submit_task(b, _det_task("task-3", 5, 100));
    task_scheduler_submit_task(b, _det_task("task-2", 5, 100));
    task_scheduler_submit_task(b, _det_task("task-1", 5, 100));
    task_scheduler_register_node(b, make_node("node-b", f64_from(8), 8192));
    task_scheduler_register_node(b, make_node("node-a", f64_from(8), 8192));
    var da = task_scheduler_schedule_pending(a);
    var db = task_scheduler_schedule_pending(b);
    assert_eq(vec_len(da), vec_len(db), "same decision count");
    var i = 0;
    while (i < vec_len(da)) {
        assert_eq(str_eq(SchedulingDecision_task_id(vec_get(da, i)), SchedulingDecision_task_id(vec_get(db, i))), 1, "task order identical");
        assert_eq(str_eq(SchedulingDecision_assigned_node(vec_get(da, i)), SchedulingDecision_assigned_node(vec_get(db, i))), 1, "node choice identical");
        i = i + 1;
    }
    # pending order tie-break: lexicographically-first task_id goes first
    assert_eq(str_eq_cstr(SchedulingDecision_task_id(vec_get(da, 0)), "task-1"), 1, "task-1 first (task_id tie-break)");
    return 0;
}

# `n` nodes named `prefix`0, `prefix`1, ..., half full but for node `free`; -1 leaves them all
# idle. Enough that the table's order, which changes per process, cannot land on the answer.
fn _best_fit_among(prefix, n, free) {
    var s = task_scheduler_new();
    var i = 0;
    while (i < n) {
        var node = make_node(str_cstr(_numbered(prefix, i)), f64_from(8), 8192);
        if (free != 0 - 1 && i != free) { node_capacity_reserve(node, make_req(f64_from(4), 1)); }
        task_scheduler_register_node(s, node);
        i = i + 1;
    }
    return _best_fit_node(TaskScheduler_nodes(s), make_req(f64_from(1), 1));
}

# best-fit tie: one task, two equal-utilization nodes -> lowest node_id, both orders.
fn test_det_best_fit_tie() {
    test_group("det_best_fit");
    var a = task_scheduler_new();
    task_scheduler_register_node(a, make_node("node-a", f64_from(4), 4096));
    task_scheduler_register_node(a, make_node("node-b", f64_from(4), 4096));
    task_scheduler_submit_task(a, _det_task("t", 5, 100));
    var b = task_scheduler_new();
    task_scheduler_register_node(b, make_node("node-b", f64_from(4), 4096));
    task_scheduler_register_node(b, make_node("node-a", f64_from(4), 4096));
    task_scheduler_submit_task(b, _det_task("t", 5, 100));
    var na = SchedulingDecision_assigned_node(vec_get(task_scheduler_schedule_pending(a), 0));
    var nb = SchedulingDecision_assigned_node(vec_get(task_scheduler_schedule_pending(b), 0));
    assert_eq(str_eq_cstr(na, "node-a"), 1, "tie -> node-a (order 1)");
    assert_eq(str_eq_cstr(nb, "node-a"), 1, "tie -> node-a (order 2)");
    # Two nodes can pass with the tie-break gone, when the table happens to agree.
    assert_eq(str_eq(_best_fit_among("a-", 32, 0 - 1), str_from("a-0")), 1, "32 equal nodes -> smallest id");
    assert_eq(str_eq(_best_fit_among("b-", 32, 0 - 1), str_from("b-0")), 1, "and in another table order");
    # An id only breaks a tie: a busier node never takes over from an emptier one.
    assert_eq(str_eq(_best_fit_among("a-", 32, 9), str_from("a-9")), 1, "the emptiest beats every smaller id");
    return 0;
}

# tasks_for_node returns task_id order regardless of submission order.
fn test_det_tasks_for_node() {
    test_group("det_tasks_for_node");
    var s = task_scheduler_new();
    var t3 = _det_task("t3", 5, 100); ScheduledTask_set_status(t3, TASK_RUNNING); ScheduledTask_set_node_preference(t3, str_from("n"));
    var t1 = _det_task("t1", 5, 100); ScheduledTask_set_status(t1, TASK_RUNNING); ScheduledTask_set_node_preference(t1, str_from("n"));
    var t2 = _det_task("t2", 5, 100); ScheduledTask_set_status(t2, TASK_RUNNING); ScheduledTask_set_node_preference(t2, str_from("n"));
    task_scheduler_submit_task(s, t3);
    task_scheduler_submit_task(s, t1);
    task_scheduler_submit_task(s, t2);
    var v = task_scheduler_tasks_for_node(s, str_from("n"));
    assert_eq(vec_len(v), 3, "3 tasks for node n");
    assert_eq(str_eq_cstr(ScheduledTask_task_id(vec_get(v, 0)), "t1"), 1, "sorted t1");
    assert_eq(str_eq_cstr(ScheduledTask_task_id(vec_get(v, 1)), "t2"), 1, "sorted t2");
    assert_eq(str_eq_cstr(ScheduledTask_task_id(vec_get(v, 2)), "t3"), 1, "sorted t3");
    return 0;
}

# Fixed task_ids in opposite insertion orders. The hash is seeded per process, so
# whether these collide changes from run to run, and nothing here can rely on it.
# What makes this able to fail is comparing the whole sorted decision sequence.
fn test_det_schedule_colliding() {
    test_group("det_collide");
    var a = task_scheduler_new();
    task_scheduler_register_node(a, make_node("node-a", f64_from(16), 16384));
    task_scheduler_submit_task(a, _det_task("task-0", 5, 100));
    task_scheduler_submit_task(a, _det_task("task-15", 5, 100));
    task_scheduler_submit_task(a, _det_task("task-20", 5, 100));
    task_scheduler_submit_task(a, _det_task("task-33", 5, 100));
    var b = task_scheduler_new();
    task_scheduler_register_node(b, make_node("node-a", f64_from(16), 16384));
    task_scheduler_submit_task(b, _det_task("task-33", 5, 100));
    task_scheduler_submit_task(b, _det_task("task-20", 5, 100));
    task_scheduler_submit_task(b, _det_task("task-15", 5, 100));
    task_scheduler_submit_task(b, _det_task("task-0", 5, 100));
    # ⚠ THE OLD NON-VACUITY GUARD IS GONE, AND NEITHER DIRECTION CAN REPLACE IT.
    #
    # It asserted that the two insertion orders produce DIFFERENT raw `map_values`
    # order. cyrius 6.6.x added `lib/hashseed.cyr` — per-process seeded hashing, a
    # security fix closing a measured 934x hash-flooding DoS — so bucket index now
    # depends on a seed drawn fresh in every process.
    #
    # With linear probing, insertion order changes iteration order ONLY when two
    # keys land in the same bucket, and whether these four ids collide is a property
    # of the seed. So across runs the old assertion holds sometimes and fails
    # sometimes; asserting the OPPOSITE is flaky for exactly the same reason
    # (measured: 1 failure in 3 runs, then 1 in 12). A seed-dependent fact is not
    # assertable in either direction.
    #
    # ⭐ So non-vacuity moves to the FULL sorted sequence below, which is stronger
    # than the guard it replaces: raw map order is now random per process, so a
    # scheduler that failed to apply the `samay_str_lt` tie-break would emit that
    # random order and fail on almost every run. The test still cannot pass
    # vacuously — it just proves it by construction instead of by assertion.
    var ra = map_values(TaskScheduler_tasks(a));
    assert_eq(vec_len(ra), 4, "raw map holds all 4");
    # and scheduling decisions are byte-identical
    var da = task_scheduler_schedule_pending(a);
    var db = task_scheduler_schedule_pending(b);
    assert_eq(vec_len(da), 4, "4 decisions");
    var i = 0;
    while (i < 4) {
        assert_eq(str_eq(SchedulingDecision_task_id(vec_get(da, i)), SchedulingDecision_task_id(vec_get(db, i))), 1, "collide task order identical");
        i = i + 1;
    }
    # and pending order is task_id-sorted: task-0 < task-15 < task-20 < task-33
    # ALL FOUR positions — this is the non-vacuity guard now (see above).
    assert_eq(str_eq_cstr(SchedulingDecision_task_id(vec_get(da, 0)), "task-0"), 1, "sorted[0]=task-0");
    assert_eq(str_eq_cstr(SchedulingDecision_task_id(vec_get(da, 1)), "task-15"), 1, "sorted[1]=task-15");
    assert_eq(str_eq_cstr(SchedulingDecision_task_id(vec_get(da, 2)), "task-20"), 1, "sorted[2]=task-20");
    assert_eq(str_eq_cstr(SchedulingDecision_task_id(vec_get(da, 3)), "task-33"), 1, "sorted[3]=task-33");
    return 0;
}

# preempt tie-break: several equal-priority/equal-created RUNNING tasks with
# fixed ids, opposite orders -> the preempted victim is the lowest task_id.
fn test_det_preempt_tie() {
    test_group("det_preempt");
    # Three equal tasks filling one node, submitted in opposite orders.
    var a = task_scheduler_new();
    var b = task_scheduler_new();
    task_scheduler_register_node(a, make_node("n", f64_from(3), 8192));
    task_scheduler_register_node(b, make_node("n", f64_from(3), 8192));
    task_scheduler_submit_task(a, _det_task("task-0", 2, 100));
    task_scheduler_submit_task(a, _det_task("task-15", 2, 100));
    task_scheduler_submit_task(a, _det_task("task-20", 2, 100));
    task_scheduler_submit_task(b, _det_task("task-20", 2, 100));
    task_scheduler_submit_task(b, _det_task("task-15", 2, 100));
    task_scheduler_submit_task(b, _det_task("task-0", 2, 100));
    var decided = task_scheduler_schedule_pending(a);
    var decided2 = task_scheduler_schedule_pending(b);
    var k = 0;
    while (k < 3) {
        scheduled_task_transition(task_scheduler_get_task(a, SchedulingDecision_task_id(vec_get(decided, k))), TASK_RUNNING);
        scheduled_task_transition(task_scheduler_get_task(b, SchedulingDecision_task_id(vec_get(decided2, k))), TASK_RUNNING);
        k = k + 1;
    }
    var pa = task_scheduler_preempt_if_needed(a, make_task("hi", 10));
    var pb = task_scheduler_preempt_if_needed(b, make_task("hi", 10));
    assert_eq(pa != 0, 1, "preemption produced");
    assert_eq(str_eq_cstr(PreemptionAction_preempted_task_id(pa), "task-0"), 1, "victim = task-0 (order 1)");
    assert_eq(str_eq_cstr(PreemptionAction_preempted_task_id(pb), "task-0"), 1, "victim = task-0 (order 2)");
    return 0;
}

# cron list determinism under a map rehash (14 entries forces grow past cap 16).
fn test_det_cron_list_rehash() {
    test_group("det_cron_rehash");
    var fwd = cron_scheduler_new();
    var rev = cron_scheduler_new();
    var i = 0;
    while (i < 14) {
        var sb = str_builder_new(); str_builder_add_cstr(sb, "e"); str_builder_add_int(sb, i);
        cron_scheduler_add(fwd, str_builder_build(sb), str_from("* * * * *"), make_template(), 1, CRON_SKIP);
        var sb2 = str_builder_new(); str_builder_add_cstr(sb2, "e"); str_builder_add_int(sb2, 13 - i);
        cron_scheduler_add(rev, str_builder_build(sb2), str_from("* * * * *"), make_template(), 1, CRON_SKIP);
        i = i + 1;
    }
    var lf = cron_scheduler_list_entries(fwd);
    var lr = cron_scheduler_list_entries(rev);
    assert_eq(vec_len(lf), 14, "14 entries");
    var j = 0;
    while (j < 14) {
        assert_eq(str_eq(CronEntry_name(vec_get(lf, j)), CronEntry_name(vec_get(lr, j))), 1, "rehash list order identical");
        j = j + 1;
    }
    # spot-check sorted: e0 < e1 (byte order "e0".."e9","e1"? no — lexical: e0,e1,e10,e11,e12,e13,e2..e9)
    assert_eq(str_eq_cstr(CronEntry_name(vec_get(lf, 0)), "e0"), 1, "first is e0");
    return 0;
}

# cron list_entries emits name order regardless of insertion order.
fn test_det_cron_list() {
    test_group("det_cron_list");
    var c = cron_scheduler_new();
    cron_scheduler_add(c, str_from("zebra"), str_from("* * * * *"), make_template(), 1, CRON_SKIP);
    cron_scheduler_add(c, str_from("alpha"), str_from("* * * * *"), make_template(), 1, CRON_SKIP);
    cron_scheduler_add(c, str_from("mid"), str_from("* * * * *"), make_template(), 1, CRON_SKIP);
    var e = cron_scheduler_list_entries(c);
    assert_eq(str_eq_cstr(CronEntry_name(vec_get(e, 0)), "alpha"), 1, "list[0]=alpha");
    assert_eq(str_eq_cstr(CronEntry_name(vec_get(e, 1)), "mid"), 1, "list[1]=mid");
    assert_eq(str_eq_cstr(CronEntry_name(vec_get(e, 2)), "zebra"), 1, "list[2]=zebra");
    return 0;
}

# --- Security regression guards (restore-side validation, ADR-0005) ---

# A valid ScheduledTask snapshot, minus whichever required field the caller omits.
fn _task_json_full() {
    var t = scheduled_task_new(str_from("t"), str_from("n"), str_from("a"), 5,
      resource_req_new(f64_from(1), 256, REQ_NONE, 0, 0, 0));
    return scheduled_task_to_json_str(t);
}

# Missing required fields must reject (return 0), not produce a poisoned struct
# that SIGSEGVs on later use.
# --- v1.0.3: the "or the wrong type" half of ADR-0005's contract ---

fn test_sec_nested_wrong_type() {
    test_group("sec_nested_wrong_type");
    # Before v1.0.3 the nested leaves bridged through their #derive codec,
    # which cannot fail -- every one of these produced a NON-ZERO all-zero
    # ResourceReq (which fits any node) and the `req == 0` guard never fired.
    assert_eq(scheduled_task_from_json_str(str_from("{\"task_id\":\"t\",\"name\":\"n\",\"description\":\"d\",\"agent_id\":\"a\",\"priority\":5,\"resource_requirements\":\"nope\",\"status\":0}")), 0, "req as string -> rejected");
    assert_eq(scheduled_task_from_json_str(str_from("{\"task_id\":\"t\",\"name\":\"n\",\"description\":\"d\",\"agent_id\":\"a\",\"priority\":5,\"resource_requirements\":7,\"status\":0}")), 0, "req as int -> rejected");
    assert_eq(scheduled_task_from_json_str(str_from("{\"task_id\":\"t\",\"name\":\"n\",\"description\":\"d\",\"agent_id\":\"a\",\"priority\":5,\"resource_requirements\":[],\"status\":0}")), 0, "req as array -> rejected");
    assert_eq(scheduled_task_from_json_str(str_from("{\"task_id\":\"t\",\"name\":\"n\",\"description\":\"d\",\"agent_id\":\"a\",\"priority\":5,\"resource_requirements\":null,\"status\":0}")), 0, "req as null -> rejected");
    assert_eq(scheduled_task_from_json_str(str_from("{\"task_id\":\"t\",\"name\":\"n\",\"description\":\"d\",\"agent_id\":\"a\",\"priority\":5,\"resource_requirements\":{},\"status\":0}")), 0, "req as empty object -> rejected");
    # A well-formed one still restores.
    assert_eq(scheduled_task_from_json_str(str_from("{\"task_id\":\"t\",\"name\":\"n\",\"description\":\"d\",\"agent_id\":\"a\",\"priority\":5,\"resource_requirements\":{\"cpu_cores\":1.0,\"memory_mb\":256,\"accel_req\":0,\"accel_min_chips\":0,\"network\":0,\"disk_mb\":0},\"status\":0}")) != 0, 1, "well-formed req restores");
    return 0;
}

fn test_sec_resource_req_domain() {
    test_group("sec_rr_domain");
    # Negative requirements ran backwards through node_capacity_reserve,
    # which computes `available - required` and so ADDED capacity.
    var t = scheduled_task_from_json_str(str_from("{\"task_id\":\"t\",\"name\":\"n\",\"description\":\"d\",\"agent_id\":\"a\",\"priority\":5,\"resource_requirements\":{\"cpu_cores\":-4.0,\"memory_mb\":-1000,\"accel_req\":99,\"accel_min_chips\":0,\"network\":5,\"disk_mb\":-7},\"status\":0}"));
    assert_eq(t != 0, 1, "restored");
    var r = ScheduledTask_resource_requirements(t);
    assert_eq(f64_eq(ResourceReq_cpu_cores(r), f64_from(0)), 1, "negative cpu_cores clamped to 0");
    assert_eq(ResourceReq_memory_mb(r), 0, "negative memory_mb clamped to 0");
    assert_eq(ResourceReq_disk_mb(r), 0, "negative disk_mb clamped to 0");
    assert_eq(ResourceReq_accel_req(r), 99, "an unknown accel_req is kept, not guessed at");
    assert_eq(ResourceReq_network(r), 1, "truthy network normalised to 1");
    return 0;
}

fn test_sec_node_capacity_invariants() {
    test_group("sec_node_invariants");
    # available > total drove utilization hugely negative, and that node then
    # won every _best_fit_node argmin forever.
    var n = node_capacity_from_json_str(str_from("{\"node_id\":\"n\",\"total_cpu\":1.0,\"available_cpu\":1e18,\"total_memory_mb\":100,\"available_memory_mb\":999999,\"total_disk_mb\":10,\"available_disk_mb\":999}"));
    assert_eq(n != 0, 1, "restored");
    assert_eq(f64_eq(NodeCapacity_available_cpu(n), f64_from(1)), 1, "available_cpu clamped to total");
    assert_eq(NodeCapacity_available_memory_mb(n), 100, "available_memory clamped to total");
    assert_eq(NodeCapacity_available_disk_mb(n), 10, "available_disk clamped to total");
    # bayan maps an overflowing exponent to +Inf; a non-finite capacity makes
    # utilization NaN, which defeats the ADR-0004 tie-break.
    var inf = node_capacity_from_json_str(str_from("{\"node_id\":\"n\",\"total_cpu\":1e400,\"available_cpu\":1e400}"));
    assert_eq(inf != 0, 1, "restored");
    assert_eq(_f64_is_finite(NodeCapacity_total_cpu(inf)), 1, "non-finite total_cpu rejected");
    assert_eq(_f64_is_finite(node_capacity_utilization(inf)), 1, "utilization stays finite");
    # An empty node_id is a map key collision waiting to happen.
    assert_eq(node_capacity_from_json_str(str_from("{\"node_id\":\"\"}")), 0, "empty node_id rejected");
    return 0;
}

fn test_sec_identity_and_flags() {
    test_group("sec_identity_flags");
    assert_eq(scheduled_task_from_json_str(str_from("{\"task_id\":\"\",\"name\":\"n\",\"description\":\"d\",\"agent_id\":\"a\",\"priority\":5,\"resource_requirements\":{\"cpu_cores\":1.0,\"memory_mb\":256,\"accel_req\":0,\"accel_min_chips\":0,\"network\":0,\"disk_mb\":0},\"status\":0}")), 0, "empty task_id rejected");
    # `enabled` is compared with `== 1`, so a truthy non-1 value would leave
    # the entry dormant while reporting as enabled.
    var tmpl = "{\"name\":\"c\",\"description\":\"d\",\"agent_id\":\"a\",\"priority\":5,\"resource_requirements\":{\"cpu_cores\":1.0,\"memory_mb\":256,\"accel_req\":0,\"accel_min_chips\":0,\"network\":0,\"disk_mb\":0}}";
    # Day 1 of January: masks an expression can produce, which restore requires (1.5.1).
    var ce = "{\"minute_mask\":1,\"hour_mask\":1,\"dom_mask\":2,\"month_mask\":2,\"dow_mask\":1,\"dom_star\":7,\"dow_star\":0}";
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"name\":\"e\",\"expr\":");
    str_builder_add_cstr(sb, ce);
    str_builder_add_cstr(sb, ",\"task_template\":");
    str_builder_add_cstr(sb, tmpl);
    str_builder_add_cstr(sb, ",\"enabled\":99,\"missed_policy\":0,\"last_fired\":0}");
    var e = cron_entry_from_json_str(str_builder_build(sb));
    assert_eq(e != 0, 1, "entry restored");
    assert_eq(CronEntry_enabled(e), 1, "truthy enabled normalised to 1");
    assert_eq(CronExpr_dom_star(CronEntry_expr(e)), 1, "truthy dom_star normalised to 1");
    # A method samay does not know comes back as the constructor kept it. Through 1.4.4 it
    # read back as LoRA, so a job that asked for a GPU or a TPU asked for a GPU alone.
    var tj = training_job_template_from_json_str(str_from("{\"model_id\":\"m\",\"dataset\":\"d\",\"method\":424242}"));
    assert_eq(tj != 0, 1, "training restored");
    assert_eq(TrainingJobTemplate_method(tj), 424242, "an unknown method is kept");
    var job = training_job_to_scheduled_task(tj, str_from("a"));
    assert_eq(ResourceReq_accel_req(ScheduledTask_resource_requirements(job)), REQ_GPU_OR_TPU, "and still asks for either");
    return 0;
}

fn test_sec_reject_missing_required() {
    test_group("sec_reject_missing");
    # training: missing model_id
    assert_eq(training_job_template_from_json_str(str_from("{\"method\":0,\"dataset\":\"d\"}")), 0, "training no model_id -> 0");
    # scheduled task: missing task_id (map-key field)
    assert_eq(scheduled_task_from_json_str(str_from("{\"name\":\"n\",\"description\":\"d\",\"agent_id\":\"a\"}")), 0, "task no task_id -> 0");
    # node: missing node_id
    assert_eq(node_capacity_from_json_str(str_from("{\"total_cpu\":1.0}")), 0, "node no node_id -> 0");
    # task with missing nested resource_requirements
    assert_eq(scheduled_task_from_json_str(str_from("{\"task_id\":\"t\",\"name\":\"n\",\"description\":\"d\",\"agent_id\":\"a\"}")), 0, "task no req -> 0");
    return 0;
}

# A container with a malformed record drops that record and still serializes
# (the null-key map crash is gone).
fn test_sec_container_drops_bad() {
    test_group("sec_drop_bad");
    var s = task_scheduler_from_json_str(str_from("{\"tasks\":[{\"name\":\"orphan\"}]}"));
    assert_eq(s != 0, 1, "scheduler restored");
    assert_eq(map_size(TaskScheduler_tasks(s)), 0, "malformed task dropped");
    # re-serialization must not crash on a null key/Str
    var js = task_scheduler_to_json_str(s);
    assert_eq(str_len(js) > 0, 1, "re-serialized without crash");
    return 0;
}

# Out-of-range priority is clamped to 1..10 on restore (i64-overflow guard).
fn test_sec_clamp_priority() {
    test_group("sec_clamp_prio");
    var hi = scheduled_task_from_json_str(str_from("{\"task_id\":\"t\",\"name\":\"n\",\"description\":\"d\",\"agent_id\":\"a\",\"resource_requirements\":{\"cpu_cores\":1.0,\"memory_mb\":1,\"accel_req\":0,\"accel_min_chips\":0,\"network\":0,\"disk_mb\":0},\"priority\":9999999999}"));
    assert_eq(hi != 0, 1, "restored");
    assert_eq(ScheduledTask_priority(hi), 10, "priority clamped to 10");
    var lo = scheduled_task_from_json_str(str_from("{\"task_id\":\"t\",\"name\":\"n\",\"description\":\"d\",\"agent_id\":\"a\",\"resource_requirements\":{\"cpu_cores\":1.0,\"memory_mb\":1,\"accel_req\":0,\"accel_min_chips\":0,\"network\":0,\"disk_mb\":0},\"priority\":-5}"));
    assert_eq(ScheduledTask_priority(lo), 1, "priority clamped to 1");
    return 0;
}

# Negative unsigned-domain values are clamped to 0 on NodeCapacity restore.
fn test_sec_clamp_negative_resources() {
    test_group("sec_clamp_neg");
    var n = node_capacity_from_json_str(str_from("{\"node_id\":\"n\",\"total_cpu\":1.0,\"available_cpu\":1.0,\"total_memory_mb\":-1000,\"running_tasks\":-3}"));
    assert_eq(n != 0, 1, "restored");
    assert_eq(NodeCapacity_total_memory_mb(n), 0, "negative memory -> 0");
    assert_eq(NodeCapacity_running_tasks(n), 0, "negative running_tasks -> 0");
    return 0;
}

# ⛔ 1.1.3 — every constructor must OWN the Strs it retains.
#
# Through 1.1.2 they stored the caller's pointer. daimon passes `jget` results —
# views into an HTTP request buffer its server reuses — and on the live daimon
# binary a task submitted as "ORIGINAL_TASK_NAME" read back as another client's
# request bytes after one unrelated request. The shape below is the consumer's:
# build the input over a MUTABLE heap buffer, construct, overwrite every source
# byte as a reused buffer would, then assert the record still reads the original.
fn _own_mut(cstr, n) {
    var b = alloc(64);
    memcpy(b, cstr, n);
    return str_new(b, n);
}
fn _own_clobber(st) {
    memset(str_data(st), 88, str_len(st));   # 'X' over every source byte
    return 0;
}
fn _own_is(got, want) { return str_eq(got, str_from(want)); }

fn test_ownership_retained_strs() {
    test_group("own_retained_strs");

    # scheduled_task_new — the one daimon reaches live
    var tn = _own_mut("task-name", 9);
    var td = _own_mut("task-desc", 9);
    var ta = _own_mut("agent-one", 9);
    var t = scheduled_task_new(tn, td, ta, 5, resource_req_default());
    _own_clobber(tn); _own_clobber(td); _own_clobber(ta);
    assert_eq(_own_is(ScheduledTask_name(t), "task-name"), 1, "task name owned");
    assert_eq(_own_is(ScheduledTask_description(t), "task-desc"), 1, "task description owned");
    assert_eq(_own_is(ScheduledTask_agent_id(t), "agent-one"), 1, "task agent_id owned");

    # node_capacity_new — node_id is also the scheduler's MAP KEY for this node
    var nid = _own_mut("node-7", 6);
    var n = node_capacity_new(nid, f64_from(4), 1024, 2048, 0);
    _own_clobber(nid);
    assert_eq(_own_is(NodeCapacity_node_id(n), "node-7"), 1, "node_id owned");

    # scheduling_decision_new
    var dt = _own_mut("tid-1", 5);
    var dn = _own_mut("node-a", 6);
    var dr = _own_mut("best-fit", 8);
    var d = scheduling_decision_new(dt, dn, dr, f64_from(1));
    _own_clobber(dt); _own_clobber(dn); _own_clobber(dr);
    assert_eq(_own_is(SchedulingDecision_task_id(d), "tid-1"), 1, "decision task_id owned");
    assert_eq(_own_is(SchedulingDecision_assigned_node(d), "node-a"), 1, "decision node owned");
    assert_eq(_own_is(SchedulingDecision_reason(d), "best-fit"), 1, "decision reason owned");

    # preemption_action_new
    var pa = _own_mut("victim", 6);
    var pb = _own_mut("winner", 6);
    var pr = _own_mut("priority", 8);
    var pre = preemption_action_new(pa, pb, pr);
    _own_clobber(pa); _own_clobber(pb); _own_clobber(pr);
    assert_eq(_own_is(PreemptionAction_preempted_task_id(pre), "victim"), 1, "preempted id owned");
    assert_eq(_own_is(PreemptionAction_preempting_task_id(pre), "winner"), 1, "preempting id owned");
    assert_eq(_own_is(PreemptionAction_reason(pre), "priority"), 1, "preemption reason owned");

    # cron_task_template_new + cron_entry_new
    var cn = _own_mut("nightly", 7);
    var cd = _own_mut("rebuild", 7);
    var ca = _own_mut("builder", 7);
    var tmpl = cron_task_template_new(cn, cd, ca, 3, resource_req_default());
    _own_clobber(cn); _own_clobber(cd); _own_clobber(ca);
    assert_eq(_own_is(CronTaskTemplate_name(tmpl), "nightly"), 1, "cron template name owned");
    assert_eq(_own_is(CronTaskTemplate_description(tmpl), "rebuild"), 1, "cron template desc owned");
    assert_eq(_own_is(CronTaskTemplate_agent_id(tmpl), "builder"), 1, "cron template agent owned");
    var _ce_t, _ce_v = cron_expr_parse(str_from("0 3 * * *"));
    var en = _own_mut("entry-1", 7);
    var ent = cron_entry_new(en, result_unwrap(_ce_t, _ce_v), tmpl, 1, 0);
    _own_clobber(en);
    assert_eq(_own_is(CronEntry_name(ent), "entry-1"), 1, "cron entry name owned");

    # training_job_template_new
    var mm = _own_mut("llama-8b", 8);
    var md = _own_mut("corpus", 6);
    var tj = training_job_template_new(mm, TM_LORA, md, 0, 60, 0);
    _own_clobber(mm); _own_clobber(md);
    assert_eq(_own_is(TrainingJobTemplate_model_id(tj), "llama-8b"), 1, "training model_id owned");
    assert_eq(_own_is(TrainingJobTemplate_dataset(tj), "corpus"), 1, "training dataset owned");

    # 0 is the None sentinel for optional Str fields and must pass through
    # UNCLONED — not crash in str_len(0), and not panic as if it were an OOM.
    var tnone = training_job_template_new(str_from("m"), TM_LORA, str_from("d"), 0, 60, 0);
    assert_eq(TrainingJobTemplate_target_node(tnone), 0, "None (0) passes through, not cloned");
    # A field that is never None takes the empty Str instead (1.5.1): a null one was
    # kept, and crashed the first writer that met it.
    var none = preemption_action_new(str_from("a"), str_from("b"), 0);
    assert_eq(str_len(PreemptionAction_reason(none)), 0, "a null reason is the empty Str");
    return 0;
}

# --- v1.4.1: the burst budget holds entries, and never drops them ---

# n entries at watermark lf, each with its own template so a task names its entry.
fn _fleet_add(c, n, prefix, expr_str, policy, lf) {
    var i = 0;
    while (i < n) {
        var name = _numbered(prefix, i);
        var tmpl = cron_task_template_new(name, str_from("d"), str_from("a"), 3, make_req(f64_from(1), 128));
        var e_t, e_v = cron_expr_parse(str_from(expr_str));
        var e = cron_entry_new(name, result_unwrap(e_t, e_v), tmpl, 1, policy);
        CronEntry_set_last_fired(e, lf);
        cron_scheduler_add_entry(c, e);
        i = i + 1;
    }
    return 0;
}

fn _at_watermark(c, lf) {
    var v = cron_scheduler_list_entries(c);
    var n = 0;
    var i = 0;
    while (i < vec_len(v)) {
        if (CronEntry_last_fired(vec_get(v, i)) == lf) { n = n + 1; }
        i = i + 1;
    }
    return n;
}

# Tasks in `fired` that came from the entry called `name`.
fn _fired_by(fired, name) {
    var want = _cron_task_name(name);
    var n = 0;
    var i = 0;
    while (i < vec_len(fired)) {
        if (str_eq(ScheduledTask_name(vec_get(fired, i)), want) == 1) { n = n + 1; }
        i = i + 1;
    }
    return n;
}

# Tasks fired by checking at `now` until a check returns nothing.
fn _drain(c, now) {
    var total = 0;
    var got = vec_len(cron_scheduler_check_due_at(c, now));
    while (got > 0) {
        total = total + got;
        got = vec_len(cron_scheduler_check_due_at(c, now));
    }
    return total;
}

fn test_cron_budget_holds_then_drains() {
    test_group("cron_budget_drains");
    var now = at_ns(2026, 7, 18, 12, 0);
    var lf = now - 1000 * 60000000000;
    var c = cron_scheduler_new();
    _fleet_add(c, 12, "e-", "* * * * *", CRON_CATCHUP, lf);
    var one = cron_scheduler_check_due_at(c, now);
    assert_eq(vec_len(one), CRON_BURST_BUDGET, "a check stops at the budget");
    assert_eq(_at_watermark(c, lf), 2, "two entries held, watermark untouched");
    assert_eq(_at_watermark(c, now), 10, "the rest advanced");
    var two = cron_scheduler_check_due_at(c, now);
    assert_eq(vec_len(two), 2000, "the same instant again fires what was held");
    assert_eq(_at_watermark(c, now), 12, "every entry has now advanced");
    assert_eq(vec_len(cron_scheduler_check_due_at(c, now)), 0, "and nothing is left, so a drain loop ends");

    # What the budget changes is when, not how many.
    var saved = CRON_BURST_BUDGET;
    CRON_BURST_BUDGET = 1000000000;
    var whole = cron_scheduler_new();
    _fleet_add(whole, 12, "e-", "* * * * *", CRON_CATCHUP, lf);
    var all = vec_len(cron_scheduler_check_due_at(whole, now));
    CRON_BURST_BUDGET = saved;
    var d = cron_scheduler_new();
    _fleet_add(d, 12, "e-", "* * * * *", CRON_CATCHUP, lf);
    assert_eq(_drain(d, now), all, "a budgeted drain fires what one unbudgeted check would");
    return 0;
}

fn test_cron_budget_boundary() {
    test_group("cron_budget_boundary");
    var now = at_ns(2026, 7, 18, 12, 0);
    var lf = now - 1000 * 60000000000;
    var fits = cron_scheduler_new();
    _fleet_add(fits, 10, "e-", "* * * * *", CRON_CATCHUP, lf);
    assert_eq(vec_len(cron_scheduler_check_due_at(fits, now)), CRON_BURST_BUDGET, "landing exactly on the budget fits");
    assert_eq(_at_watermark(fits, now), 10, "so nothing is held");
    var over = cron_scheduler_new();
    _fleet_add(over, 11, "e-", "* * * * *", CRON_CATCHUP, lf);
    assert_eq(vec_len(cron_scheduler_check_due_at(over, now)), CRON_BURST_BUDGET, "one burst past it stays out");
    assert_eq(_at_watermark(over, lf), 1, "and is held");
    return 0;
}

fn test_cron_budget_single_fires_exempt() {
    test_group("cron_budget_exempt");
    # A single fire is what an entry does on an ordinary minute, so no schedule
    # on time can be delayed, however large it is.
    var saved = CRON_BURST_BUDGET;
    CRON_BURST_BUDGET = 10;
    var now = at_ns(2026, 7, 18, 12, 0);
    var c = cron_scheduler_new();
    _fleet_add(c, 3, "burst-", "* * * * *", CRON_CATCHUP, now - 10 * 60000000000);
    _fleet_add(c, 3, "skip-", "* * * * *", CRON_SKIP, now - 5 * 60000000000);
    _fleet_add(c, 2, "ontime-", "* * * * *", CRON_CATCHUP, now - 60000000000);
    _fleet_add(c, 1, "first-", "* * * * *", CRON_CATCHUP, 0);
    _fleet_add(c, 1, "off-", "* * * * *", CRON_CATCHUP, now - 5 * 60000000000);
    CronEntry_set_enabled(map_get(CronScheduler_entries(c), str_from("off-0")), 0);
    var fired = cron_scheduler_check_due_at(c, now);
    assert_eq(vec_len(fired), 10 + 3 + 2 + 1, "one burst and every single fire");
    assert_eq(_at_watermark(c, now - 10 * 60000000000), 2, "the other two bursts are held");
    assert_eq(_at_watermark(c, now), 8, "everything else advanced, the disabled entry too");

    # Nor do single fires spend the budget: older ones run first here, and two
    # bursts of 5 still fit in 10.
    var d = cron_scheduler_new();
    _fleet_add(d, 8, "skip-", "* * * * *", CRON_SKIP, now - 60 * 60000000000);
    _fleet_add(d, 2, "burst-", "* * * * *", CRON_CATCHUP, now - 5 * 60000000000);
    assert_eq(vec_len(cron_scheduler_check_due_at(d, now)), 8 + 5 + 5, "single fires leave the budget untouched");
    assert_eq(_at_watermark(d, now), 10, "so nothing is held");
    CRON_BURST_BUDGET = saved;
    return 0;
}

fn test_cron_budget_writeback_consumer() {
    test_group("cron_budget_writeback");
    # stiva rebuilds its scheduler on every `check`, runs CRON_SKIP only, and
    # stores now as every job's watermark whatever happened. That is safe only
    # because a SKIP entry is never held: a held one would lose its debt there.
    var saved = CRON_BURST_BUDGET;
    CRON_BURST_BUDGET = 2;
    var now = at_ns(2026, 7, 18, 12, 0);
    var c = cron_scheduler_new();
    _fleet_add(c, 50, "job-", "* * * * *", CRON_SKIP, now - 86400 * 1000000000);
    assert_eq(vec_len(cron_scheduler_check_due_at(c, now)), 50, "every overdue SKIP job fires, past any budget");
    assert_eq(_at_watermark(c, now), 50, "and none was held");
    CRON_BURST_BUDGET = saved;
    return 0;
}

fn test_cron_budget_first_burst_runs() {
    test_group("cron_budget_progress");
    # A budget below one burst must not freeze the entry forever.
    var saved = CRON_BURST_BUDGET;
    CRON_BURST_BUDGET = 5;
    var now = at_ns(2026, 7, 18, 12, 0);
    var c = cron_scheduler_new();
    _fleet_add(c, 3, "e-", "* * * * *", CRON_CATCHUP, now - 20 * 60000000000);
    assert_eq(vec_len(cron_scheduler_check_due_at(c, now)), 20, "one burst runs although it is past the budget");
    assert_eq(_drain(c, now), 40, "so every check moves the backlog on");
    CRON_BURST_BUDGET = saved;
    return 0;
}

fn test_cron_budget_no_starvation() {
    test_group("cron_budget_no_starvation");
    # Six entries, each owing a burst on every check, and room for two bursts.
    # In name order the first two would run on every check and the last four
    # never. Oldest first takes turns, and nothing owed is lost.
    var saved = CRON_BURST_BUDGET;
    CRON_BURST_BUDGET = 10;
    var base = at_ns(2026, 7, 18, 12, 0);
    var c = cron_scheduler_new();
    _fleet_add(c, 6, "e-", "* * * * *", CRON_CATCHUP, base);
    var counts = vec_new();
    var i = 0;
    while (i < 6) { vec_push(counts, 0); i = i + 1; }
    var pass = 1;
    while (pass <= 5) {
        var fired = cron_scheduler_check_due_at(c, base + pass * 5 * 60000000000);
        i = 0;
        while (i < 6) {
            vec_set(counts, i, vec_get(counts, i) + _fired_by(fired, _numbered("e-", i)));
            i = i + 1;
        }
        pass = pass + 1;
    }
    var silent = 0;
    var owed = 0;
    i = 0;
    while (i < 6) {
        if (vec_get(counts, i) == 0) { silent = silent + 1; }
        i = i + 1;
    }
    assert_eq(silent, 0, "every entry fired within five checks");
    # An entry's fires so far plus what it still owes is the whole time elapsed.
    var entries = cron_scheduler_list_entries(c);
    var end = base + 25 * 60000000000;
    i = 0;
    while (i < 6) {
        var lf = CronEntry_last_fired(vec_get(entries, i));
        owed = owed + vec_get(counts, i) + (end - lf) / 60000000000;
        i = i + 1;
    }
    assert_eq(owed, 6 * 25, "every minute is fired or still owed, none lost");
    CRON_BURST_BUDGET = saved;
    return 0;
}

fn test_cron_check_order() {
    test_group("cron_check_order");
    # Oldest watermark first; a tie falls back to the name.
    var now = at_ns(2026, 7, 18, 12, 0);
    var c = cron_scheduler_new();
    _fleet_add(c, 1, "z-old-", "* * * * *", CRON_SKIP, now - 600 * 60000000000);
    _fleet_add(c, 1, "m-new-", "* * * * *", CRON_SKIP, now - 60 * 60000000000);
    _fleet_add(c, 1, "a-new-", "* * * * *", CRON_SKIP, now - 60 * 60000000000);
    var f = cron_scheduler_check_due_at(c, now);
    assert_eq(vec_len(f), 3, "all three fire");
    assert_eq(str_starts_with(ScheduledTask_name(vec_get(f, 0)), str_from("z-old")), 1, "the oldest debt goes first, whatever its name");
    assert_eq(str_starts_with(ScheduledTask_name(vec_get(f, 1)), str_from("a-new")), 1, "then the tie, by name");
    assert_eq(str_starts_with(ScheduledTask_name(vec_get(f, 2)), str_from("m-new")), 1, "and the rest of the tie");
    return 0;
}

fn test_cron_budget_deterministic() {
    test_group("cron_budget_deterministic");
    # The same schedule at the same time holds the same entries, whatever order
    # it was built in, on the wire or not.
    var saved = CRON_BURST_BUDGET;
    CRON_BURST_BUDGET = 40;
    var now = at_ns(2026, 7, 18, 12, 0);
    var lf = now - 30 * 60000000000;
    var a = cron_scheduler_new();
    _fleet_add(a, 8, "e-", "* * * * *", CRON_CATCHUP, lf);
    var b = cron_scheduler_new();
    var i = 7;
    while (i >= 0) {
        var name = _numbered("e-", i);
        var tmpl = cron_task_template_new(name, str_from("d"), str_from("a"), 3, make_req(f64_from(1), 128));
        var e_t, e_v = cron_expr_parse(str_from("* * * * *"));
        var e = cron_entry_new(name, result_unwrap(e_t, e_v), tmpl, 1, CRON_CATCHUP);
        CronEntry_set_last_fired(e, lf);
        cron_scheduler_add_entry(b, e);
        i = i - 1;
    }
    var fa = cron_scheduler_check_due_at(a, now);
    var fb = cron_scheduler_check_due_at(b, now);
    assert_eq(vec_len(fa), 30, "one burst fits with the 40-task budget, and the next too small to join it");
    assert_eq(vec_len(fb), vec_len(fa), "same count");
    var bad = 0;
    i = 0;
    while (i < vec_len(fa)) {
        if (str_eq(ScheduledTask_name(vec_get(fa, i)), ScheduledTask_name(vec_get(fb, i))) != 1) { bad = bad + 1; }
        i = i + 1;
    }
    assert_eq(bad, 0, "same tasks in the same order");

    # A snapshot taken mid-drain carries the held work: it is only the watermarks.
    var snap = cron_scheduler_to_json_str(a);
    var back = cron_scheduler_from_json_str(snap);
    var total = vec_len(fa) + _drain(back, now);
    assert_eq(total, 8 * 30, "a restored scheduler finishes the drain, nothing lost or doubled");
    CRON_BURST_BUDGET = saved;
    return 0;
}

var _log_lines = 0;

fn _log_capture(ts, level, category, msg, msg_len, fields) {
    # Copied: sakshi's contract is that msg dies when the hook returns.
    var sb = str_builder_new();
    str_builder_add(sb, str_new(msg, msg_len));
    vec_push(_log_lines, str_builder_build(sb));
    return 0;
}

fn _logs_start() {
    _log_lines = vec_new();
    sakshi_set_emit_hook(&_log_capture);
    return 0;
}

fn _logs_stop() {
    sakshi_clear_emit_hook();
    return 0;
}

# Captured lines holding `text`.
fn _logged(text) {
    var want = str_from(text);
    var n = 0;
    var i = 0;
    while (i < vec_len(_log_lines)) {
        if (str_contains(vec_get(_log_lines, i), want) == 1) { n = n + 1; }
        i = i + 1;
    }
    return n;
}

fn test_cron_budget_logs() {
    test_group("cron_budget_logs");
    # Held is not dropped, but it must not be quiet either. And a held entry says
    # nothing of its own until it runs, so a long hold cannot repeat itself.
    var saved = CRON_BURST_BUDGET;
    CRON_BURST_BUDGET = 10;
    var now = at_ns(2026, 7, 18, 12, 0);
    var stale = now - CRON_SCAN_WINDOW_SECS * 2000000000;
    var c = cron_scheduler_new();
    _fleet_add(c, 3, "e-", "0 * * * *", CRON_CATCHUP, stale);
    _logs_start();
    var one = cron_scheduler_check_due_at(c, now);
    assert_eq(vec_len(one), CRON_CATCHUP_CAP, "the first burst ran");
    assert_eq(_logged("burst budget reached at 1000 task(s); 2 entry(ies) held"), 1, "the check says what it held");
    assert_eq(_logged("~366-day catch-up window"), 1, "only the entry that ran reports its clamp");
    assert_eq(_logged("catch-up capped"), 1, "and only that entry reports its cap");
    cron_scheduler_check_due_at(c, now);
    assert_eq(_logged("burst budget reached at 1000 task(s); 1 entry(ies) held"), 1, "a later check reports what is still held");
    cron_scheduler_check_due_at(c, now);
    assert_eq(_logged("burst budget reached"), 2, "and a check that held nothing says nothing");
    assert_eq(_logged("~366-day catch-up window"), 3, "each clamp is reported once, not once per check");
    _logs_stop();
    CRON_BURST_BUDGET = saved;
    return 0;
}

fn test_cron_logs_exact() {
    test_group("cron_logs_exact");
    # 1.1.0 made these say ">=" because the count stopped at 100,000. It no
    # longer stops, so an operator now reads the real figure.
    var now = at_ns(2026, 7, 18, 12, 0);
    var stale = now - CRON_SCAN_WINDOW_SECS * 2000000000;
    var full = CRON_SCAN_WINDOW_SECS / 60 + 1;
    var s = cron_scheduler_new();
    _fleet_add(s, 1, "s-", "* * * * *", CRON_SKIP, stale);
    var c = cron_scheduler_new();
    _fleet_add(c, 1, "c-", "* * * * *", CRON_CATCHUP, stale);
    _logs_start();
    cron_scheduler_check_due_at(s, now);
    cron_scheduler_check_due_at(c, now);
    _logs_stop();
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "skip policy dropped ");
    str_builder_add_int(sb, full - 1);
    assert_eq(_logged(str_cstr(str_builder_build(sb))), 1, "skip reports the exact drop");
    var sb2 = str_builder_new();
    str_builder_add_cstr(sb2, "fired 1000 of ");
    str_builder_add_int(sb2, full);
    assert_eq(_logged(str_cstr(str_builder_build(sb2))), 1, "the cap reports the exact total");
    assert_eq(_logged(">="), 0, "and neither hedges");
    return 0;
}

# --- v1.4.2: the write-side codec, and the corpus that proves the wire unchanged ---

# 64 random bits. _sort_rand gives 63 at most, so two are stitched together.
fn _wire_bits() {
    return (_sort_rand(1 << 32) << 32) ^ _sort_rand(1 << 32);
}

# The values most likely to print differently: fractions with no short decimal,
# both zeros, the ends of the f64 range, and everything non-finite.
fn _wire_floats() {
    var v = vec_new();
    vec_push(v, f64_div(f64_from(1), f64_from(3)));
    vec_push(v, f64_div(f64_from(1), f64_from(10)));
    vec_push(v, f64_div(f64_from(7), f64_from(9)));
    vec_push(v, f64_div(f64_from(2), f64_from(3)));
    vec_push(v, f64_from(0));
    vec_push(v, f64_from(1));
    vec_push(v, f64_from(5));
    vec_push(v, f64_from(1024));
    vec_push(v, 0x8000000000000000);        # -0.0
    vec_push(v, 0x7FF8000000000000);        # NaN
    vec_push(v, 0xFFF8000000000001);        # another NaN
    vec_push(v, 0x7FF0000000000000);        # +Inf
    vec_push(v, 0xFFF0000000000000);        # -Inf
    vec_push(v, 1);                         # smallest denormal
    vec_push(v, 0x000FFFFFFFFFFFFF);        # largest denormal
    vec_push(v, 0x0010000000000000);        # smallest normal
    vec_push(v, 0x7FEFFFFFFFFFFFFF);        # largest finite
    vec_push(v, 0x43C0000000000000);        # 2^61, past the 1e18 _f64_is_finite gate
    vec_push(v, 0x444B1AE4D6E2EF50);        # 1e21, where the printer goes to an exponent
    vec_push(v, 0x4480F0CF064DD592);        # 1e22
    vec_push(v, 0x3E7AD7F29ABCAF48);        # 1e-7
    vec_push(v, 0x3F1A36E2EB1C432D);        # 1e-4
    return v;
}

fn _wire_ints() {
    var v = vec_new();
    vec_push(v, 0);
    vec_push(v, 1);
    vec_push(v, 0 - 1);
    vec_push(v, 4096);
    vec_push(v, 1152921504606846975);       # 2^60 - 1, a full minute mask
    vec_push(v, 16777215);                  # 2^24 - 1, a full hour mask
    vec_push(v, 9223372036854775807);       # i64 max
    vec_push(v, 0 - 9223372036854775807);
    vec_push(v, 0 - 9223372036854775807 - 1);   # i64 min
    return v;
}

fn _pick(v) {
    return vec_get(v, _sort_rand(vec_len(v)));
}

# A float for the corpus: a listed value, a random bit pattern, or a realistic
# fraction of a CPU.
fn _wire_float(listed) {
    var r = _sort_rand(3);
    if (r == 0) { return _pick(listed); }
    if (r == 1) { return _wire_bits(); }
    return f64_div(f64_from(1 + _sort_rand(1000)), f64_from(1 + _sort_rand(1000)));
}

fn _wire_int(listed) {
    var r = _sort_rand(3);
    if (r == 0) { return _pick(listed); }
    if (r == 1) { return _wire_bits(); }
    return _sort_rand(1000000);
}

# Set field by field: resource_req_new now clamps, and a struct restored from an old
# build or written by hand can still hold anything.
fn _wire_req(floats, ints) {
    var r = resource_req_new(f64_from(0), 0, 0, 0, 0, 0);
    ResourceReq_set_cpu_cores(r, _wire_float(floats));
    ResourceReq_set_memory_mb(r, _wire_int(ints));
    ResourceReq_set_accel_req(r, _wire_int(ints));
    ResourceReq_set_accel_min_chips(r, _wire_int(ints));
    ResourceReq_set_network(r, _wire_int(ints));
    ResourceReq_set_disk_mb(r, _wire_int(ints));
    # Half of them ask for devices or a share, written raw as the derive writes them.
    if (_wire_int(ints) % 2 == 0) {
        ResourceReq_set_accel_devices(r, _wire_int(ints));
        ResourceReq_set_accel_share(r, _wire_int(ints));
    }
    return r;
}

fn _wire_expr(ints) {
    var p = alloc(56);
    CronExpr_set_minute_mask(p, _wire_int(ints));
    CronExpr_set_hour_mask(p, _wire_int(ints));
    CronExpr_set_dom_mask(p, _wire_int(ints));
    CronExpr_set_month_mask(p, _wire_int(ints));
    CronExpr_set_dow_mask(p, _wire_int(ints));
    CronExpr_set_dom_star(p, _wire_int(ints));
    CronExpr_set_dow_star(p, _wire_int(ints));
    return p;
}

# The bridge the write side used through 1.4.1, kept here as the reference:
# derive to text, parse the text, build the tree.
fn _bridge_bytes(text) {
    var v = _parse(text);
    if (v == 0) { return 0; }
    return bayan_json_v_build(v);
}

fn _req_derive_text(r) {
    var sb = str_builder_new();
    ResourceReq_to_json(r, sb);
    return str_builder_build(sb);
}

# The derive's text as a snapshot writes it: devices and share as placement reads them
# (1.5.1), and one whole device leaves out the two keys 1.5.0 added, so the bytes are
# 1.4.6's (ADR-0016).
fn _req_wire_text(r) {
    var w = resource_req_new(f64_from(0), 0, 0, 0, 0, 0);
    ResourceReq_set_cpu_cores(w, ResourceReq_cpu_cores(r));
    ResourceReq_set_memory_mb(w, ResourceReq_memory_mb(r));
    ResourceReq_set_accel_req(w, ResourceReq_accel_req(r));
    ResourceReq_set_accel_min_chips(w, ResourceReq_accel_min_chips(r));
    ResourceReq_set_network(w, ResourceReq_network(r));
    ResourceReq_set_disk_mb(w, ResourceReq_disk_mb(r));
    ResourceReq_set_accel_devices(w, _req_devices(r));
    ResourceReq_set_accel_share(w, _req_share(r));
    var text = _req_derive_text(w);
    var tail = str_from(",\"accel_devices\":1,\"accel_share\":1000}");
    if (str_ends_with(text, tail) == 0) { return text; }
    var sb = str_builder_new();
    str_builder_add(sb, str_sub(text, 0, str_len(text) - str_len(tail)));
    str_builder_add_cstr(sb, "}");
    return str_builder_build(sb);
}

fn _expr_derive_text(e) {
    var sb = str_builder_new();
    CronExpr_to_json(e, sb);
    return str_builder_build(sb);
}

fn test_wire_corpus_resource_req() {
    test_group("wire_corpus_resource_req");
    # The entry gate for 1.4.2, and it stays. The derive is public and stays too,
    # so samay has two writers of this shape. A field added to the struct reaches
    # the derive by itself and must reach _rr_node by hand; this is what notices.
    var floats = _wire_floats();
    var ints = _wire_ints();
    var bad_derive = 0;
    var bad_bridge = 0;
    var i = 0;
    # Every listed float once, so none is left to chance.
    while (i < vec_len(floats)) {
        var f = vec_get(floats, i);
        var r0 = resource_req_new(f64_from(0), 4096, 1, 2, 1, 1024);
        ResourceReq_set_cpu_cores(r0, f);
        var got0 = bayan_json_v_build(_rr_node(r0));
        var text0 = _req_wire_text(r0);
        if (str_eq(got0, text0) != 1) { bad_derive = bad_derive + 1; }
        if (str_eq(got0, _bridge_bytes(text0)) != 1) { bad_bridge = bad_bridge + 1; }
        i = i + 1;
    }
    i = 0;
    while (i < 2000) {
        var r = _wire_req(floats, ints);
        var got = bayan_json_v_build(_rr_node(r));
        var text = _req_wire_text(r);
        if (str_eq(got, text) != 1) { bad_derive = bad_derive + 1; }
        if (str_eq(got, _bridge_bytes(text)) != 1) { bad_bridge = bad_bridge + 1; }
        i = i + 1;
    }
    assert_eq(bad_derive, 0, "same bytes as the derive, on 2,022 requirements");
    assert_eq(bad_bridge, 0, "same bytes as the old bridge");
    return 0;
}

fn test_wire_corpus_cron_expr() {
    test_group("wire_corpus_cron_expr");
    var ints = _wire_ints();
    var bad_derive = 0;
    var bad_bridge = 0;
    var i = 0;
    while (i < 2000) {
        var e = _wire_expr(ints);
        var got = bayan_json_v_build(_ce_node(e));
        var text = _expr_derive_text(e);
        if (str_eq(got, text) != 1) { bad_derive = bad_derive + 1; }
        if (str_eq(got, _bridge_bytes(text)) != 1) { bad_bridge = bad_bridge + 1; }
        i = i + 1;
    }
    # Real expressions as well: the shapes a schedule actually holds.
    var v = _diff_exprs();
    i = 0;
    while (i < vec_len(v)) {
        var e2 = vec_get(v, i);
        var got2 = bayan_json_v_build(_ce_node(e2));
        var text2 = _expr_derive_text(e2);
        if (str_eq(got2, text2) != 1) { bad_derive = bad_derive + 1; }
        if (str_eq(got2, _bridge_bytes(text2)) != 1) { bad_bridge = bad_bridge + 1; }
        i = i + 1;
    }
    assert_eq(bad_derive, 0, "same bytes as the derive, on every expression");
    assert_eq(bad_bridge, 0, "same bytes as the old bridge");
    return 0;
}

fn test_wire_tree_types() {
    test_group("wire_tree_types");
    # *_to_jsonv hands out the tree itself, so its node types are surface too. A
    # finite float must stay a float and an integer an integer.
    var r = resource_req_new(f64_from(5), 4096, 1, 2, 1, 1024);
    var v = _rr_node(r);
    assert_eq(bayan_json_v_is_float(bayan_json_v_obj_get_by_cstr(v, "cpu_cores")), 1, "cpu_cores is a float");
    assert_eq(bayan_json_v_is_int(bayan_json_v_obj_get_by_cstr(v, "memory_mb")), 1, "memory_mb is an int");
    assert_eq(bayan_json_v_is_int(bayan_json_v_obj_get_by_cstr(v, "network")), 1, "network is an int");
    var _e_t, _e_v = cron_expr_parse(str_from("0 3 * * *"));
    var ev = _ce_node(result_unwrap(_e_t, _e_v));
    assert_eq(bayan_json_v_is_int(bayan_json_v_obj_get_by_cstr(ev, "minute_mask")), 1, "masks are ints");
    assert_eq(bayan_json_v_is_int(bayan_json_v_obj_get_by_cstr(ev, "dow_star")), 1, "flags are ints");

    # A non-finite requirement is the one case the node type differs: the bridge
    # parsed `null`, this holds the float. Read back, both give 0 cores.
    var nan = resource_req_new(f64_from(0), 1, 0, 0, 0, 0);
    ResourceReq_set_cpu_cores(nan, 0x7FF8000000000000);
    var o = bayan_json_v_obj_new();
    bayan_json_v_obj_set(o, str_from("req"), _rr_node(nan));
    var back = _rr_from(o, "req");
    assert_eq(f64_eq(ResourceReq_cpu_cores(back), f64_from(0)), 1, "a non-finite value still reads back as 0");
    return 0;
}

fn test_wire_nested_bytes() {
    test_group("wire_nested_bytes");
    # The two leaves embedded in the documents that actually reach disk. A fixed
    # document, so a change anywhere in the nesting shows as a byte change.
    var req = resource_req_new(f64_div(f64_from(1), f64_from(3)), 4096, REQ_GPU, 2, 1, 10240);
    var tmpl = cron_task_template_new(str_from("t"), str_from("d"), str_from("a"), 5, req);
    var _e_t, _e_v = cron_expr_parse(str_from("30 3 * * 1-5"));
    var e = cron_entry_new(str_from("n"), result_unwrap(_e_t, _e_v), tmpl, 1, CRON_SKIP);
    var want = str_builder_new();
    str_builder_add_cstr(want, "{\"name\":\"n\",\"expr\":");
    str_builder_add(want, _expr_derive_text(CronEntry_expr(e)));
    str_builder_add_cstr(want, ",\"task_template\":{\"name\":\"t\",\"description\":\"d\",\"agent_id\":\"a\",\"priority\":5,\"resource_requirements\":");
    str_builder_add(want, _req_wire_text(req));
    str_builder_add_cstr(want, "},\"enabled\":1,\"last_fired\":0,\"missed_policy\":1}");
    assert_eq(str_eq(cron_entry_to_json_str(e), str_builder_build(want)), 1, "cron entry bytes, nesting included");
    assert_eq(str_contains(cron_entry_to_json_str(e), str_from("\"cpu_cores\":0.3333333333333333,")), 1, "1/3 keeps every digit");
    return 0;
}

# --- v1.4.3: a pass costs the same however much the scheduler has ever held ---

# A scheduler with `finished` cancelled tasks in its table.
fn _history_sched(finished) {
    var s = task_scheduler_new();
    task_scheduler_register_node(s, node_capacity_new(str_from("n"), f64_from(8), 8192, 1024, 0));
    var i = 0;
    while (i < finished) {
        var t = make_task("t", 5);
        task_scheduler_submit_task(s, t);
        task_scheduler_cancel_task(s, ScheduledTask_task_id(t));
        i = i + 1;
    }
    return s;
}

fn _pass_bytes(s) {
    # The first pass may grow the scratch vec. That is once, so it is not counted.
    task_scheduler_schedule_pending(s);
    var before = alloc_used();
    var i = 0;
    while (i < 50) { task_scheduler_schedule_pending(s); i = i + 1; }
    return (alloc_used() - before) / 50;
}

fn test_pass_heap_flat() {
    test_group("pass_heap_flat");
    # alloc() never frees. Through 1.4.2 an idle schedule_pending copied every task
    # ever held, twice: 33 KB per pass at 1,000 finished tasks, 2.7 GB a day at one
    # pass a second, on a scheduler with nothing to do.
    var empty = _history_sched(0);
    var full = _history_sched(1000);
    var base = _pass_bytes(empty);
    assert_eq(_pass_bytes(full), base, "a pass costs the same at 1,000 finished tasks as at none");
    assert_eq(base < 200, 1, "and that cost is only the returned vec");

    # Tasks that cannot be placed stay pending, and each logs on every pass.
    var stuck = _history_sched(0);
    var i = 0;
    while (i < 100) {
        task_scheduler_submit_task(stuck, scheduled_task_new(str_from("t"), str_from("d"), str_from("a"), 5,
            make_req(f64_from(1000), 1)));
        i = i + 1;
    }
    assert_eq(_pass_bytes(stuck), base, "100 stuck tasks add nothing per pass");
    assert_eq(vec_len(task_scheduler_pending_tasks(stuck)), 100, "and they really are still pending");

    # The queries a consumer polls take no copy of the table either.
    var q = make_task("q", 9);
    var before = alloc_used();
    task_scheduler_preempt_if_needed(empty, q);
    task_scheduler_tasks_for_node(empty, str_from("n"));
    var at_none = alloc_used() - before;
    before = alloc_used();
    task_scheduler_preempt_if_needed(full, q);
    task_scheduler_tasks_for_node(full, str_from("n"));
    assert_eq(alloc_used() - before, at_none, "polling queries do not scale with history");
    return 0;
}

fn test_check_heap_flat() {
    test_group("check_heap_flat");
    var now = at_ns(2026, 7, 1, 0, 0);
    var small = cron_scheduler_new();
    _fleet_add(small, 1, "e-", "0 3 1 1 *", CRON_SKIP, now);
    var large = cron_scheduler_new();
    _fleet_add(large, 500, "e-", "0 3 1 1 *", CRON_SKIP, now);
    cron_scheduler_check_due_at(small, now + 60000000000);
    cron_scheduler_check_due_at(large, now + 60000000000);
    var before = alloc_used();
    var i = 2;
    while (i < 40) { cron_scheduler_check_due_at(small, now + i * 60000000000); i = i + 1; }
    var one = alloc_used() - before;
    before = alloc_used();
    i = 2;
    while (i < 40) { cron_scheduler_check_due_at(large, now + i * 60000000000); i = i + 1; }
    assert_eq(alloc_used() - before, one, "a quiet check costs the same at 500 entries as at one");
    return 0;
}

fn test_log_no_capacity() {
    test_group("log_no_capacity");
    # Built on the stack now, so its bounds are this test's business.
    _logs_start();
    _log_no_capacity(str_from("abc"));
    var sb = str_builder_new();
    var i = 0;
    while (i < 500) { str_builder_add_cstr(sb, "x"); i = i + 1; }
    _log_no_capacity(str_builder_build(sb));
    _log_no_capacity(str_from(""));
    _logs_stop();
    assert_eq(_logged("task 'abc': no node with sufficient capacity"), 1, "the line reads as it always did");
    assert_eq(_logged("task '': no node with sufficient capacity"), 1, "an empty id is fine");
    var longest = str_len(vec_get(_log_lines, 1));
    assert_eq(longest, 128 + 41, "a long id is cut at 128, not written past the buffer");
    assert_eq(_logged("': no node with sufficient capacity"), 3, "and the line still ends properly");
    return 0;
}

fn test_release_cannot_wrap() {
    test_group("release_cannot_wrap");
    # A restored reservation can be any size. available + held wrapped negative,
    # past the `> total` cap, and left a node with less than nothing. The fuzz
    # harness found this within seconds of first running.
    var huge = 9223372036854775807;
    var n = node_capacity_new(str_from("n"), f64_from(8), 8192, 1024, 0);
    node_capacity_reserve(n, resource_req_new(f64_from(1), 100, REQ_NONE, 0, 0, 100));
    node_capacity_release(n, resource_req_new(f64_from(0), huge, REQ_NONE, 0, 0, 0));
    assert_eq(NodeCapacity_available_memory_mb(n), 8192, "huge memory returns to total");
    assert_eq(NodeCapacity_available_disk_mb(n), 924, "and leaves disk alone");
    var m = node_capacity_new(str_from("m"), f64_from(8), 8192, 1024, 0);
    node_capacity_reserve(m, resource_req_new(f64_from(1), 100, REQ_NONE, 0, 0, 100));
    node_capacity_release(m, resource_req_new(f64_from(0), 0, REQ_NONE, 0, 0, huge));
    assert_eq(NodeCapacity_available_disk_mb(m), 1024, "huge disk returns to total");

    # Exactly the room left is the boundary of the cap.
    var e = node_capacity_new(str_from("e"), f64_from(8), 8192, 1024, 0);
    node_capacity_reserve(e, resource_req_new(f64_from(1), 100, REQ_NONE, 0, 0, 100));
    node_capacity_release(e, resource_req_new(f64_from(0), 99, REQ_NONE, 0, 0, 100));
    assert_eq(NodeCapacity_available_memory_mb(e), 8191, "an ordinary release just adds");
    assert_eq(NodeCapacity_available_disk_mb(e), 1024, "landing exactly on total stays there");
    return 0;
}

# --- v1.4.3: accelerators are held, not just found (ADR-0013) ---

fn _gpu_node(id, gpus) {
    var n = make_node(id, f64_from(64), 524288);
    var i = 0;
    while (i < gpus) {
        node_capacity_add_accel(n, profile_cuda(i, 17179869184));
        i = i + 1;
    }
    return n;
}

fn _accel_task(name, prio, kind, chips) {
    return scheduled_task_new(str_from(name), str_from("d"), str_from("a"), prio,
      resource_req_new(f64_from(1), 16, kind, chips, 0, 0));
}

fn _status_count(s, status) {
    var all = map_values(TaskScheduler_tasks(s));
    var n = 0;
    var i = 0;
    while (i < vec_len(all)) {
        if (ScheduledTask_status(vec_get(all, i)) == status) { n = n + 1; }
        i = i + 1;
    }
    return n;
}

# Run and finish a task.
fn _finish(s, t) {
    if (ScheduledTask_status(t) == TASK_SCHEDULED) { scheduled_task_transition(t, TASK_RUNNING); }
    return task_scheduler_complete_task(s, ScheduledTask_task_id(t), TASK_COMPLETED);
}

fn test_accel_device_is_held() {
    test_group("accel_device_held");
    # Through 1.4.2 one GPU went to four tasks at once: can_fit asked whether the
    # device existed, and nothing recorded that it was taken.
    var s = task_scheduler_new();
    task_scheduler_register_node(s, _gpu_node("g", 1));
    var a = _accel_task("a", 5, REQ_GPU, 0);
    task_scheduler_submit_task(s, a);
    var i = 0;
    while (i < 3) {
        task_scheduler_submit_task(s, _accel_task("b", 5, REQ_GPU, 0));
        i = i + 1;
    }
    assert_eq(vec_len(task_scheduler_schedule_pending(s)), 1, "one GPU takes one task");
    assert_eq(vec_len(task_scheduler_schedule_pending(s)), 0, "and a second pass adds none");
    _finish(s, vec_get(task_scheduler_tasks_for_node(s, str_from("g")), 0));
    assert_eq(vec_len(task_scheduler_schedule_pending(s)), 1, "the next waits for it");
    var two = task_scheduler_new();
    task_scheduler_register_node(two, _gpu_node("g", 2));
    i = 0;
    while (i < 3) {
        task_scheduler_submit_task(two, _accel_task("c", 5, REQ_GPU, 0));
        i = i + 1;
    }
    assert_eq(vec_len(task_scheduler_schedule_pending(two)), 2, "two GPUs take two");
    return 0;
}

fn test_accel_tpu_shares_chips() {
    test_group("accel_tpu_chips");
    var s = task_scheduler_new();
    var n = node_capacity_add_accel(make_node("t", f64_from(64), 524288), profile_tpu(0, 8, TPU_V5P));
    task_scheduler_register_node(s, n);
    var a = _accel_task("a", 5, REQ_TPU, 4);
    var b = _accel_task("b", 5, REQ_TPU, 4);
    var c = _accel_task("c", 5, REQ_TPU, 1);
    task_scheduler_submit_task(s, a);
    task_scheduler_submit_task(s, b);
    task_scheduler_submit_task(s, c);
    assert_eq(vec_len(task_scheduler_schedule_pending(s)), 2, "two 4-chip tasks share an 8-chip pod");
    assert_eq(_status_count(s, TASK_QUEUED), 1, "and even one more chip is not there");
    assert_eq(node_capacity_can_fit(n, resource_req_new(f64_from(1), 1, REQ_TPU, 8, 0, 0)), 0, "the pod is not free");
    var placed = task_scheduler_tasks_for_node(s, str_from("t"));
    _finish(s, vec_get(placed, 0));
    assert_eq(vec_len(task_scheduler_schedule_pending(s)), 1, "freed chips go to the waiting task");
    var pod = task_scheduler_new();
    task_scheduler_register_node(pod, node_capacity_add_accel(make_node("t", f64_from(64), 524288), profile_tpu(0, 4, TPU_V5P)));
    task_scheduler_submit_task(pod, _accel_task("over", 5, REQ_GPU_OR_TPU, 16));
    task_scheduler_submit_task(pod, _accel_task("more", 5, REQ_TPU, 1));
    # Neither REQ_GPU_OR_TPU nor REQ_ANY_ACCELERATOR checks chips, so this asks for more
    # than the pod has. It takes the pod, not some impossible amount of it.
    assert_eq(vec_len(task_scheduler_schedule_pending(pod)), 1, "an oversized request takes the whole pod");
    return 0;
}

fn test_accel_can_fit_means_free() {
    test_group("accel_can_fit_free");
    var n = _gpu_node("g", 1);
    var req = resource_req_new(f64_from(1), 16, REQ_GPU, 0, 0, 0);
    assert_eq(node_capacity_can_fit(n, req), 1, "free");
    node_capacity_reserve(n, req);
    assert_eq(node_capacity_can_fit(n, req), 0, "taken");
    node_capacity_release(n, req);
    assert_eq(node_capacity_can_fit(n, req), 1, "free again");
    # A consumer calling reserve for something this node has no device for holds nothing.
    var cpu = make_node("c", f64_from(8), 8192);
    node_capacity_reserve(cpu, req);
    node_capacity_release(cpu, req);
    assert_eq(NodeCapacity_running_tasks(cpu), 0, "no device, no hold, no crash");
    return 0;
}

fn _exact_release_case(gpu_first) {
    var n = make_node("m", f64_from(64), 524288);
    if (gpu_first == 1) { node_capacity_add_accel(n, profile_cuda(0, 17179869184)); }
    node_capacity_add_accel(n, profile_tpu(0, 8, TPU_V5P));
    if (gpu_first == 0) { node_capacity_add_accel(n, profile_cuda(0, 17179869184)); }
    # `any` lands on the TPU, the better rank. `gpu` can only be the GPU.
    var any = resource_req_new(f64_from(1), 1, REQ_ANY_ACCELERATOR, 1, 0, 0);
    var gpu = resource_req_new(f64_from(1), 1, REQ_GPU, 0, 0, 0);
    node_capacity_reserve(n, any);
    node_capacity_reserve(n, gpu);
    node_capacity_release(n, any);
    var wrong = 0;
    if (node_capacity_can_fit(n, resource_req_new(f64_from(1), 1, REQ_GPU, 0, 0, 0)) != 0) { wrong = wrong + 1; }
    if (node_capacity_can_fit(n, resource_req_new(f64_from(1), 1, REQ_TPU, 8, 0, 0)) != 1) { wrong = wrong + 1; }
    return wrong;
}

fn test_accel_release_is_exact() {
    test_group("accel_release_exact");
    # Releasing `any` must free what `any` took. Undoing the pick by requirement type
    # frees the GPU instead, which sells a device in use and strands a TPU chip forever.
    assert_eq(_exact_release_case(0), 0, "TPU listed first");
    assert_eq(_exact_release_case(1), 0, "GPU listed first");
    # A caller releasing with its own equal copy is still understood.
    var n = _gpu_node("g", 1);
    var req = resource_req_new(f64_from(1), 16, REQ_GPU, 0, 0, 0);
    node_capacity_reserve(n, req);
    node_capacity_release(n, resource_req_clone(req));
    assert_eq(node_capacity_can_fit(n, req), 1, "an equal requirement releases the hold");
    # Releasing what was never reserved takes nothing away.
    var m = _gpu_node("g", 2);
    node_capacity_reserve(m, req);
    node_capacity_release(m, resource_req_new(f64_from(0), 0, REQ_TPU, 2, 0, 0));
    assert_eq(_accel_used_at(m, 0) + _accel_used_at(m, 1), SAMAY_ACCEL_WHOLE, "nothing held under that requirement");
    return 0;
}

fn test_accel_restore_rebuilds_holds() {
    test_group("accel_restore");
    # Device use is not on the wire. The reservations are, and they are enough.
    var s = task_scheduler_new();
    task_scheduler_register_node(s, _gpu_node("g", 1));
    var a = _accel_task("a", 5, REQ_GPU, 0);
    task_scheduler_submit_task(s, a);
    task_scheduler_schedule_pending(s);
    var back = task_scheduler_from_json_str(task_scheduler_to_json_str(s));
    task_scheduler_submit_task(back, _accel_task("b", 5, REQ_GPU, 0));
    assert_eq(vec_len(task_scheduler_schedule_pending(back)), 0, "a restored GPU is still taken");
    _finish(back, task_scheduler_get_task(back, ScheduledTask_task_id(a)));
    assert_eq(vec_len(task_scheduler_schedule_pending(back)), 1, "and comes free the normal way");

    # 1.4.2 could write four tasks on one GPU. Losing track of three would offer the
    # device while they run, so they stay counted, and it frees when the last one goes.
    var over = task_scheduler_new();
    var node = _gpu_node("g", 1);
    task_scheduler_register_node(over, node);
    var one = _accel_task("one", 5, REQ_GPU, 0);
    var two = _accel_task("two", 5, REQ_GPU, 0);
    task_scheduler_submit_task(over, one);
    task_scheduler_submit_task(over, two);
    task_scheduler_schedule_pending(over);
    var req2 = ScheduledTask_resource_requirements(two);
    node_capacity_reserve(node, req2);
    scheduled_task_transition(two, TASK_SCHEDULED);
    ScheduledTask_set_reserved_on(two, str_from("g"));
    var r = task_scheduler_from_json_str(task_scheduler_to_json_str(over));
    var rn = map_get(TaskScheduler_nodes(r), str_from("g"));
    assert_eq(_accel_used_at(rn, 0), 2 * SAMAY_ACCEL_WHOLE, "both tasks counted past capacity");
    _finish(r, task_scheduler_get_task(r, ScheduledTask_task_id(one)));
    assert_eq(node_capacity_can_fit(rn, ScheduledTask_resource_requirements(two)), 0, "still taken by the other");
    _finish(r, task_scheduler_get_task(r, ScheduledTask_task_id(two)));
    assert_eq(_accel_used_at(rn, 0), 0, "free once both are gone");
    return 0;
}

fn test_accel_unknown_requirement() {
    test_group("accel_unknown_req");
    # Through 1.4.2 an unknown requirement restored as REQ_NONE, and accelerator work
    # went to a node with no accelerator. Unknown now means nothing satisfies it.
    var doc = str_from("{\"task_id\":\"t\",\"name\":\"n\",\"description\":\"d\",\"agent_id\":\"a\",\"priority\":5,\"resource_requirements\":{\"cpu_cores\":1.0,\"memory_mb\":1,\"accel_req\":99,\"accel_min_chips\":0,\"network\":0,\"disk_mb\":0},\"status\":0}");
    var t = scheduled_task_from_json_str(doc);
    var s = task_scheduler_new();
    task_scheduler_register_node(s, make_node("n", f64_from(8), 8192));
    task_scheduler_submit_task(s, t);
    assert_eq(vec_len(task_scheduler_schedule_pending(s)), 0, "not placed");
    assert_eq(ScheduledTask_status(t), TASK_QUEUED, "and not lost");
    assert_eq(str_contains(scheduled_task_to_json_str(t), str_from("\"accel_req\":99")), 1, "the value survives a rewrite");
    return 0;
}

# --- v1.4.3: preemption has to help ---

fn test_preempt_must_help() {
    test_group("preempt_must_help");
    # Room elsewhere: nothing needs stopping.
    var s = task_scheduler_new();
    task_scheduler_register_node(s, make_node("n", f64_from(1), 8192));
    task_scheduler_register_node(s, make_node("m", f64_from(1), 8192));
    var low = make_task("low", 2);
    task_scheduler_submit_task(s, low);
    task_scheduler_schedule_pending(s);
    scheduled_task_transition(low, TASK_RUNNING);
    assert_eq(task_scheduler_preempt_if_needed(s, make_task("hi", 10)), 0, "it fits, so no victim");

    # A task nothing could ever hold: stopping work would not place it.
    var full = _full_node_sched(2);
    assert_eq(task_scheduler_preempt_if_needed(full, scheduled_task_new(str_from("big"), str_from("d"), str_from("a"), 10, make_req(f64_from(999), 1))), 0, "too large for any node");
    assert_eq(task_scheduler_preempt_if_needed(full, _accel_task("gpu", 10, REQ_GPU, 0)), 0, "no such device anywhere");

    # Only a queued task is looking for a place.
    var done = make_task("hi", 10);
    scheduled_task_transition(done, TASK_CANCELLED);
    assert_eq(task_scheduler_preempt_if_needed(full, done), 0, "a finished task needs nothing");
    var going = make_task("hi", 10);
    scheduled_task_transition(going, TASK_SCHEDULED);
    assert_eq(task_scheduler_preempt_if_needed(full, going), 0, "nor one already placed");

    # One victim must be enough. Two 4-core tasks stand between this and 8 cores, and
    # stopping one would only requeue it onto the space it left, for ever.
    var pair = task_scheduler_new();
    task_scheduler_register_node(pair, make_node("n", f64_from(8), 8192));
    var i = 0;
    while (i < 2) {
        var four = scheduled_task_new(str_from("four"), str_from("d"), str_from("a"), 2, make_req(f64_from(4), 1));
        task_scheduler_submit_task(pair, four);
        i = i + 1;
    }
    task_scheduler_schedule_pending(pair);
    var all = map_values(TaskScheduler_tasks(pair));
    scheduled_task_transition(vec_get(all, 0), TASK_RUNNING);
    scheduled_task_transition(vec_get(all, 1), TASK_RUNNING);
    assert_eq(task_scheduler_preempt_if_needed(pair, scheduled_task_new(str_from("all"), str_from("d"), str_from("a"), 10, make_req(f64_from(8), 1))), 0, "one victim would not free 8 cores");
    return 0;
}

fn test_preempt_targets_the_holder() {
    test_group("preempt_targets_holder");
    # The GPU is held at priority 5. A priority-1 CPU job elsewhere is the lowest
    # priority running, and stopping it would free nothing this task needs.
    var s = task_scheduler_new();
    task_scheduler_register_node(s, _gpu_node("g", 1));
    task_scheduler_register_node(s, make_node("c", f64_from(4), 8192));
    var holder = _accel_task("holder", 5, REQ_GPU, 0);
    var cheap = scheduled_task_new(str_from("cheap"), str_from("d"), str_from("a"), 1, make_req(f64_from(4), 1));
    task_scheduler_submit_task(s, holder);
    task_scheduler_submit_task(s, cheap);
    task_scheduler_schedule_pending(s);
    scheduled_task_transition(holder, TASK_RUNNING);
    scheduled_task_transition(cheap, TASK_RUNNING);
    var urgent = _accel_task("urgent", 10, REQ_GPU, 0);
    task_scheduler_submit_task(s, urgent);
    var node = map_get(TaskScheduler_nodes(s), str_from("g"));
    var cpu_before = NodeCapacity_available_cpu(node);
    var act = task_scheduler_preempt_if_needed(s, urgent);
    assert_eq(act != 0, 1, "an action");
    assert_eq(str_eq(PreemptionAction_preempted_task_id(act), ScheduledTask_task_id(holder)), 1, "it stops whoever holds the device");
    assert_eq(NodeCapacity_available_cpu(node) == cpu_before, 1, "asking changes nothing");
    assert_eq(_accel_used_at(node, 0), SAMAY_ACCEL_WHOLE, "and the device is still held");

    # Obeying it places the task.
    scheduled_task_transition(holder, TASK_PREEMPTED);
    task_scheduler_schedule_pending(s);
    assert_eq(ScheduledTask_status(urgent), TASK_SCHEDULED, "the urgent task got the GPU");
    return 0;
}

fn test_preempt_each_axis() {
    test_group("preempt_each_axis");
    # A victim only counts if it frees enough of every axis the task needs.
    var n = node_capacity_new(str_from("n"), f64_from(8), 8192, 1024, 0);
    var held = resource_req_new(f64_from(2), 2048, REQ_NONE, 0, 0, 256);
    node_capacity_reserve(n, resource_req_new(f64_from(6), 6144, REQ_NONE, 0, 0, 768));
    node_capacity_reserve(n, held);
    assert_eq(_fits_without(n, held, resource_req_new(f64_from(2), 2048, REQ_NONE, 0, 0, 256)), 1, "exactly what it frees");
    assert_eq(_fits_without(n, held, resource_req_new(f64_from(3), 1, REQ_NONE, 0, 0, 0)), 0, "cpu short");
    assert_eq(_fits_without(n, held, resource_req_new(f64_from(1), 2049, REQ_NONE, 0, 0, 0)), 0, "memory short");
    assert_eq(_fits_without(n, held, resource_req_new(f64_from(1), 1, REQ_NONE, 0, 0, 257)), 0, "disk short");
    return 0;
}

# --- v1.4.3: other lifecycle repairs ---

fn test_register_node_keeps_reservations() {
    test_group("register_keeps_reservations");
    # Re-registering a node id came up empty, so the same capacity was sold again.
    # daimon's POST /v1/scheduler/nodes reaches this with no existence check.
    var s = task_scheduler_new();
    var first = node_capacity_add_accel(make_node("n", f64_from(8), 8192), profile_cuda(0, 17179869184));
    task_scheduler_register_node(s, first);
    var a = scheduled_task_new(str_from("a"), str_from("d"), str_from("a"), 5, resource_req_new(f64_from(4), 1024, REQ_GPU, 0, 0, 512));
    task_scheduler_submit_task(s, a);
    task_scheduler_schedule_pending(s);
    scheduled_task_transition(a, TASK_RUNNING);
    var again = node_capacity_add_accel(make_node("n", f64_from(8), 8192), profile_cuda(0, 17179869184));
    task_scheduler_register_node(s, again);
    assert_eq(_cpu_milli(again), 4000, "cpu still held");
    assert_eq(NodeCapacity_available_memory_mb(again), 7168, "memory still held");
    assert_eq(NodeCapacity_available_disk_mb(again), 9728, "disk still held");
    assert_eq(NodeCapacity_running_tasks(again), 1, "the task is still counted");
    assert_eq(_accel_used_at(again, 0), SAMAY_ACCEL_WHOLE, "and so is its device");
    task_scheduler_submit_task(s, _accel_task("b", 5, REQ_GPU, 0));
    assert_eq(vec_len(task_scheduler_schedule_pending(s)), 0, "the GPU is not sold again");
    _finish(s, a);
    assert_eq(_cpu_milli(again), 8000, "finishing returns it to the new node");

    # Every holder is carried over, not just the first.
    var many = task_scheduler_new();
    task_scheduler_register_node(many, make_node("n", f64_from(16), 8192));
    var k = 0;
    while (k < 5) {
        task_scheduler_submit_task(many, make_task("t", 5));
        k = k + 1;
    }
    task_scheduler_schedule_pending(many);
    var fresh = make_node("n", f64_from(16), 8192);
    task_scheduler_register_node(many, fresh);
    assert_eq(NodeCapacity_running_tasks(fresh), 5, "all five are counted");
    assert_eq(_cpu_milli(fresh), 11000, "and all five charged");

    # Registering the same object again changes nothing.
    var same = task_scheduler_new();
    var n = make_node("n", f64_from(8), 8192);
    task_scheduler_register_node(same, n);
    var t = make_task("t", 5);
    task_scheduler_submit_task(same, t);
    task_scheduler_schedule_pending(same);
    task_scheduler_register_node(same, n);
    assert_eq(_cpu_milli(n), 7000, "not counted twice");
    assert_eq(NodeCapacity_running_tasks(n), 1, "the same one task");

    # Another node's tasks are left out of it.
    var other = task_scheduler_new();
    task_scheduler_register_node(other, make_node("x", f64_from(8), 8192));
    task_scheduler_register_node(other, make_node("y", f64_from(8), 8192));
    var on_x = make_task("t", 5);
    ScheduledTask_set_node_preference(on_x, str_from("x"));
    task_scheduler_submit_task(other, on_x);
    task_scheduler_schedule_pending(other);
    var y2 = make_node("y", f64_from(8), 8192);
    task_scheduler_register_node(other, y2);
    assert_eq(NodeCapacity_running_tasks(y2), 0, "holds elsewhere stay elsewhere");
    return 0;
}

fn test_submit_refuses_duplicate() {
    test_group("submit_duplicate");
    var s = task_scheduler_new();
    var node = make_node("n", f64_from(8), 8192);
    task_scheduler_register_node(s, node);
    var t = make_task("t", 5);
    assert_eq(is_ok(task_scheduler_submit_task(s, t)), 1, "first submit");
    task_scheduler_schedule_pending(s);
    scheduled_task_transition(t, TASK_RUNNING);
    var copy = scheduled_task_from_json_str(scheduled_task_to_json_str(t));
    assert_eq(is_err_result(task_scheduler_submit_task(s, copy)), 1, "a replay is refused");
    assert_eq(task_scheduler_get_task(s, ScheduledTask_task_id(t)) == t, 1, "the original stays");
    _finish(s, t);
    assert_eq(_cpu_milli(node), 8000, "and nothing is orphaned");
    return 0;
}

fn test_requirement_domain() {
    test_group("requirement_domain");
    # Restore has always refused these. reserve subtracts, so a negative runs backwards.
    var r = resource_req_new(f64_from(0 - 4), 0 - 1, REQ_NONE, 0 - 2, 0, 0 - 3);
    assert_eq(f64_eq(ResourceReq_cpu_cores(r), f64_from(0)), 1, "negative cpu is 0");
    assert_eq(ResourceReq_memory_mb(r), 0, "negative memory is 0");
    assert_eq(ResourceReq_accel_min_chips(r), 0, "negative chips is 0");
    assert_eq(ResourceReq_disk_mb(r), 0, "negative disk is 0");
    assert_eq(f64_eq(ResourceReq_cpu_cores(resource_req_new(0x7FF8000000000000, 1, 0, 0, 0, 0)), f64_from(0)), 1, "NaN cpu is 0");
    # A huge requirement is legal: it just never fits.
    var inf = resource_req_new(0x7FF0000000000000, 1, 0, 0, 0, 0);
    assert_eq(node_capacity_can_fit(make_node("n", f64_from(8), 8192), inf), 0, "+Inf cores never fits");
    var ok = resource_req_new(f64_from(2), 256, REQ_TPU, 4, 1, 512);
    assert_eq(ResourceReq_memory_mb(ok), 256, "ordinary memory is untouched");
    assert_eq(ResourceReq_accel_min_chips(ok), 4, "ordinary chips are untouched");
    assert_eq(ResourceReq_disk_mb(ok), 512, "ordinary disk is untouched");
    assert_eq(f64_eq(ResourceReq_cpu_cores(ok), f64_from(2)), 1, "ordinary cpu is untouched");
    return 0;
}

fn test_task_owns_requirement() {
    test_group("task_owns_requirement");
    # One ResourceReq reused across tasks, and edited for the next one. Release has to
    # return what reserve took, not what the caller's struct says now.
    var s = task_scheduler_new();
    var node = make_node("n", f64_from(8), 8192);
    task_scheduler_register_node(s, node);
    var req = make_req(f64_from(2), 1024);
    var t = scheduled_task_new(str_from("t"), str_from("d"), str_from("a"), 5, req);
    task_scheduler_submit_task(s, t);
    task_scheduler_schedule_pending(s);
    scheduled_task_transition(t, TASK_RUNNING);
    ResourceReq_set_cpu_cores(req, f64_from(1));
    ResourceReq_set_memory_mb(req, 512);
    _finish(s, t);
    assert_eq(_cpu_milli(node), 8000, "cpu back in full");
    assert_eq(NodeCapacity_available_memory_mb(node), 8192, "memory back in full");
    return 0;
}

fn test_placement_owns_strs() {
    test_group("placement_owns_strs");
    # A requested node in a caller's reused buffer used to become reserved_on, the key
    # release looks up. Once the buffer changed, the capacity was gone for good.
    var s = task_scheduler_new();
    var node = make_node("n2", f64_from(8), 8192);
    task_scheduler_register_node(s, node);
    var buf = alloc(16);
    memcpy(buf, "n2", 2);
    var t = make_task("t", 5);
    ScheduledTask_set_node_preference(t, str_new(buf, 2));
    task_scheduler_submit_task(s, t);
    task_scheduler_schedule_pending(s);
    memcpy(buf, "x9", 2);
    assert_eq(str_eq(ScheduledTask_reserved_on(t), str_from("n2")), 1, "reserved_on still names the node");
    assert_eq(str_eq(ScheduledTask_requested_node(t), str_from("n2")), 1, "and the request is the task's own");
    _finish(s, t);
    assert_eq(_cpu_milli(node), 8000, "so the capacity comes back");

    var buf2 = alloc(16);
    memcpy(buf2, "g1", 2);
    var tmpl = training_job_template_new(str_from("m"), TM_LORA, str_from("d"), str_new(buf2, 2), 0, 0);
    memcpy(buf2, "x9", 2);
    assert_eq(str_eq(TrainingJobTemplate_target_node(tmpl), str_from("g1")), 1, "a template owns its target_node");
    assert_eq(TrainingJobTemplate_target_node(training_job_template_new(str_from("m"), TM_LORA, str_from("d"), 0, 0, 0)), 0, "and None stays None");
    return 0;
}

fn test_transition_records_times() {
    test_group("transition_times");
    var t = make_task("t", 5);
    scheduled_task_transition(t, TASK_SCHEDULED);
    assert_eq(ScheduledTask_started_at(t), 0, "placing is not starting");
    scheduled_task_transition(t, TASK_RUNNING);
    var first = ScheduledTask_started_at(t);
    assert_eq(first != 0, 1, "running stamps started_at");
    assert_eq(ScheduledTask_completed_at(t), 0, "and nothing else");
    scheduled_task_transition(t, TASK_PREEMPTED);
    assert_eq(ScheduledTask_completed_at(t), 0, "a preempted task has not finished");
    scheduled_task_transition(t, TASK_QUEUED);
    scheduled_task_transition(t, TASK_SCHEDULED);
    ScheduledTask_set_started_at(t, 5);
    scheduled_task_transition(t, TASK_RUNNING);
    assert_eq(ScheduledTask_started_at(t), 5, "a task keeps its first start");
    scheduled_task_transition(t, TASK_COMPLETED);
    assert_eq(ScheduledTask_completed_at(t) != 0, 1, "completed stamps completed_at");
    var f = make_task("f", 5);
    scheduled_task_transition(f, TASK_SCHEDULED);
    scheduled_task_transition(f, TASK_RUNNING);
    scheduled_task_transition(f, TASK_FAILED);
    assert_eq(ScheduledTask_completed_at(f) != 0, 1, "failed stamps completed_at");
    var c = make_task("c", 5);
    scheduled_task_transition(c, TASK_CANCELLED);
    assert_eq(ScheduledTask_completed_at(c) != 0, 1, "cancelled stamps completed_at");
    assert_eq(is_err_result(scheduled_task_transition(c, TASK_RUNNING)), 1, "a refused transition");
    assert_eq(ScheduledTask_started_at(c), 0, "stamps nothing");
    var s = task_scheduler_new();
    task_scheduler_register_node(s, make_node("n", f64_from(8), 8192));
    var p = make_task("p", 5);
    task_scheduler_submit_task(s, p);
    task_scheduler_schedule_pending(s);
    assert_eq(ScheduledTask_scheduled_at(p) != 0, 1, "placing stamps scheduled_at");
    return 0;
}

# A task in `status`, created at 1 s and running from `start` s to `end` s.
fn _stat_task(s, status, start, end) {
    var t = make_task("t", 5);
    ScheduledTask_set_status(t, status);
    ScheduledTask_set_created_at(t, 1000000000);
    ScheduledTask_set_started_at(t, start * 1000000000);
    ScheduledTask_set_completed_at(t, end * 1000000000);
    task_scheduler_submit_task(s, t);
    return t;
}

fn test_stats_every_status() {
    test_group("stats_every_status");
    # Worked by hand. Waits: 1 s, 3 s, 1 s, 2 s from four started tasks, 7 s in all, so
    # 1750 ms. Runs: only COMPLETED counts, 2 s and 4 s, so 3000 ms.
    var s = task_scheduler_new();
    _stat_task(s, TASK_QUEUED, 0, 0);
    _stat_task(s, TASK_SCHEDULED, 0, 0);
    _stat_task(s, TASK_PREEMPTED, 0, 0);
    _stat_task(s, TASK_RUNNING, 2, 0);
    _stat_task(s, TASK_COMPLETED, 4, 6);
    _stat_task(s, TASK_COMPLETED, 2, 6);
    _stat_task(s, TASK_FAILED, 3, 9);
    _stat_task(s, TASK_CANCELLED, 0, 9);
    var st = task_scheduler_stats(s);
    assert_eq(SchedulerStats_total_tasks(st), 8, "total");
    assert_eq(SchedulerStats_queued(st), 3, "queued holds queued, scheduled and preempted");
    assert_eq(SchedulerStats_running(st), 1, "running");
    assert_eq(SchedulerStats_completed(st), 3, "completed holds completed and cancelled");
    assert_eq(SchedulerStats_failed(st), 1, "failed");
    assert_eq(SchedulerStats_average_wait_time_ms(st), 1750, "average wait");
    assert_eq(SchedulerStats_average_run_time_ms(st), 3000, "average run");
    # Clock skew must not produce a negative time.
    var skew = task_scheduler_new();
    _stat_task(skew, TASK_COMPLETED, 9, 2);
    var t = _stat_task(skew, TASK_RUNNING, 3, 0);
    ScheduledTask_set_created_at(t, 9000000000);
    var sk = task_scheduler_stats(skew);
    assert_eq(SchedulerStats_average_run_time_ms(sk), 0, "a run ending before it began counts 0");
    assert_eq(SchedulerStats_average_wait_time_ms(sk), 4000, "a start before creation counts 0");
    return 0;
}

fn test_idle_node_is_full() {
    test_group("idle_node_is_full");
    # f64 sums round. Giving back 0.1 and 0.2 newest first ended a bit short of 1.0,
    # and that bit refused a whole-node task on an idle node for good (ADR-0007).
    var tenth = f64_div(f64_from(1), f64_from(10));
    var fifth = f64_div(f64_from(1), f64_from(5));
    var n = make_node("n", f64_from(1), 8192);
    var a = make_req(tenth, 1);
    var b = make_req(fifth, 1);
    node_capacity_reserve(n, a);
    node_capacity_reserve(n, b);
    node_capacity_release(n, b);
    assert_eq(NodeCapacity_running_tasks(n), 1, "one still on it");
    node_capacity_release(n, a);
    assert_eq(NodeCapacity_available_cpu(n) == NodeCapacity_total_cpu(n), 1, "idle is exactly full");

    # While something runs, the books are left as they are.
    var m = make_node("m", f64_from(8), 8192);
    var c = make_req(f64_from(3), 1);
    node_capacity_reserve(m, c);
    node_capacity_reserve(m, make_req(f64_from(1), 1));
    node_capacity_release(m, c);
    assert_eq(_cpu_milli(m), 7000, "not snapped while a task remains");

    # Requests that sum to the node must all fit, rounding or not.
    var three = f64_div(f64_from(3), f64_from(10));
    var f = make_node("f", f64_from(1), 8192);
    var i = 0;
    while (i < 3) {
        node_capacity_reserve(f, make_req(three, 1));
        i = i + 1;
    }
    assert_eq(node_capacity_can_fit(f, make_req(tenth, 1)), 1, "the last tenth fits");
    assert_eq(node_capacity_can_fit(f, make_req(fifth, 1)), 0, "a fifth does not");
    return 0;
}

fn test_disk_axis() {
    test_group("disk_axis");
    # Disk was in the README and in no test: can_fit could ignore it, and reserve and
    # release could skip it, with every assertion passing.
    var n = node_capacity_new(str_from("n"), f64_from(8), 8192, 1024, 0);
    var fits = resource_req_new(f64_from(1), 1, REQ_NONE, 0, 0, 1024);
    var over = resource_req_new(f64_from(1), 1, REQ_NONE, 0, 0, 1025);
    assert_eq(node_capacity_can_fit(n, fits), 1, "exactly the disk there is");
    assert_eq(node_capacity_can_fit(n, over), 0, "one more is refused");
    node_capacity_reserve(n, resource_req_new(f64_from(1), 1, REQ_NONE, 0, 0, 1000));
    assert_eq(NodeCapacity_available_disk_mb(n), 24, "reserve takes disk");
    assert_eq(node_capacity_can_fit(n, fits), 0, "and can_fit sees it");
    node_capacity_release(n, resource_req_new(f64_from(1), 1, REQ_NONE, 0, 0, 1000));
    assert_eq(NodeCapacity_available_disk_mb(n), 1024, "release returns it");
    var s = task_scheduler_new();
    var node = node_capacity_new(str_from("n"), f64_from(8), 8192, 1024, 0);
    task_scheduler_register_node(s, node);
    var t = scheduled_task_new(str_from("t"), str_from("d"), str_from("a"), 5, resource_req_new(f64_from(1), 1, REQ_NONE, 0, 0, 512));
    task_scheduler_submit_task(s, t);
    task_scheduler_schedule_pending(s);
    assert_eq(NodeCapacity_available_disk_mb(node), 512, "a placed task holds disk");
    _finish(s, t);
    assert_eq(NodeCapacity_available_disk_mb(node), 1024, "and gives it back");
    return 0;
}

fn test_schedule_logs_stuck_task() {
    test_group("schedule_logs_stuck");
    var s = task_scheduler_new();
    task_scheduler_register_node(s, make_node("n", f64_from(1), 8192));
    var t = scheduled_task_new(str_from("t"), str_from("d"), str_from("a"), 5, make_req(f64_from(9), 1));
    task_scheduler_submit_task(s, t);
    _logs_start();
    task_scheduler_schedule_pending(s);
    _logs_stop();
    assert_eq(_logged("no node with sufficient capacity"), 1, "an unplaceable task is logged");
    return 0;
}

# --- v1.4.3: every field survives, and every required field is required ---

fn test_json_every_task_field() {
    test_group("json_every_task_field");
    # A round trip that only compares writer with writer cannot see a key missing from
    # both sides. Each field has its own value here, and its own assertion.
    var t = scheduled_task_new(str_from("name"), str_from("desc"), str_from("agent"), 7,
      resource_req_new(f64_from(2), 256, REQ_GPU, 3, 1, 512));
    ScheduledTask_set_task_id(t, str_from("id-1"));
    ScheduledTask_set_status(t, TASK_RUNNING);
    ScheduledTask_set_fail_reason(t, str_from("why"));
    ScheduledTask_set_created_at(t, 11);
    ScheduledTask_set_scheduled_at(t, 22);
    ScheduledTask_set_started_at(t, 33);
    ScheduledTask_set_completed_at(t, 44);
    ScheduledTask_set_deadline(t, 55);
    ScheduledTask_set_requested_node(t, str_from("wanted"));
    ScheduledTask_set_assigned_node(t, str_from("given"));
    ScheduledTask_set_reserved_on(t, str_from("held"));
    var b = scheduled_task_from_json_str(scheduled_task_to_json_str(t));
    assert_eq(str_eq(ScheduledTask_task_id(b), str_from("id-1")), 1, "task_id");
    assert_eq(str_eq(ScheduledTask_name(b), str_from("name")), 1, "name");
    assert_eq(str_eq(ScheduledTask_description(b), str_from("desc")), 1, "description");
    assert_eq(str_eq(ScheduledTask_agent_id(b), str_from("agent")), 1, "agent_id");
    assert_eq(ScheduledTask_priority(b), 7, "priority");
    assert_eq(ScheduledTask_status(b), TASK_RUNNING, "status");
    assert_eq(str_eq(ScheduledTask_fail_reason(b), str_from("why")), 1, "fail_reason");
    assert_eq(ScheduledTask_created_at(b), 11, "created_at");
    assert_eq(ScheduledTask_scheduled_at(b), 22, "scheduled_at");
    assert_eq(ScheduledTask_started_at(b), 33, "started_at");
    assert_eq(ScheduledTask_completed_at(b), 44, "completed_at");
    assert_eq(ScheduledTask_deadline(b), 55, "deadline");
    assert_eq(str_eq(ScheduledTask_requested_node(b), str_from("wanted")), 1, "requested_node");
    assert_eq(str_eq(ScheduledTask_assigned_node(b), str_from("given")), 1, "assigned_node");
    assert_eq(str_eq(ScheduledTask_reserved_on(b), str_from("held")), 1, "reserved_on");
    var r = ScheduledTask_resource_requirements(b);
    assert_eq(f64_eq(ResourceReq_cpu_cores(r), f64_from(2)), 1, "cpu_cores");
    assert_eq(ResourceReq_memory_mb(r), 256, "memory_mb");
    assert_eq(ResourceReq_accel_req(r), REQ_GPU, "accel_req");
    assert_eq(ResourceReq_accel_min_chips(r), 3, "accel_min_chips");
    assert_eq(ResourceReq_network(r), 1, "network");
    assert_eq(ResourceReq_disk_mb(r), 512, "disk_mb");
    return 0;
}

fn test_json_every_node_field() {
    test_group("json_every_node_field");
