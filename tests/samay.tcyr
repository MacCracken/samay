# `doc` with `"key":value` removed, or with its value replaced by `value`. Assumes the
# value holds no comma or brace at depth 0 of the search, so keep these documents flat
# apart from the objects named here.
fn _doc_with(pairs, skip, wrong) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{");
    var first = 1;
    var i = 0;
    while (i < vec_len(pairs)) {
        var k = vec_get(pairs, i);
        var v = vec_get(pairs, i + 1);
        if (streq(k, skip) == 0) {
            if (first == 0) { str_builder_add_cstr(sb, ","); }
            first = 0;
            str_builder_add_cstr(sb, "\"");
            str_builder_add_cstr(sb, k);
            str_builder_add_cstr(sb, "\":");
            if (streq(k, wrong) == 1) { str_builder_add_cstr(sb, "123"); } else { str_builder_add_cstr(sb, v); }
        }
        i = i + 2;
    }
    str_builder_add_cstr(sb, "}");
    return str_builder_build(sb);
}

fn _rr_text() { return "{\"cpu_cores\":1.0,\"memory_mb\":1,\"accel_req\":0,\"accel_min_chips\":0,\"network\":0,\"disk_mb\":0}"; }
fn _expr_text() { return "{\"minute_mask\":1,\"hour_mask\":1,\"dom_mask\":2,\"month_mask\":2,\"dow_mask\":1,\"dom_star\":1,\"dow_star\":1}"; }

fn _pairs(a, b, c, d, e, f, g, h, i, j) {
    var v = vec_new();
    vec_push(v, a); vec_push(v, b);
    vec_push(v, c); vec_push(v, d);
    if (e != 0) { vec_push(v, e); vec_push(v, f); }
    if (g != 0) { vec_push(v, g); vec_push(v, h); }
    if (i != 0) { vec_push(v, i); vec_push(v, j); }
    return v;
}

# Count required keys whose absence or wrong type was NOT refused.
fn _required_escapes(reader, pairs, required) {
    var bad = 0;
    var i = 0;
    while (i < vec_len(required)) {
        var key = vec_get(required, i);
        if (fncall1(reader, _doc_with(pairs, key, "")) != 0) { bad = bad + 1; }
        if (fncall1(reader, _doc_with(pairs, "", key)) != 0) { bad = bad + 1; }
        i = i + 1;
    }
    return bad;
}

fn test_json_required_fields() {
    test_group("json_required_fields");
    # ADR-0005: a required field that is missing OR THE WRONG TYPE rejects the record.
    # Through 1.4.2 this was tried on one nested field.
    var tmpl_doc = _doc_with(_pairs("name", "\"t\"", "description", "\"d\"", "agent_id", "\"a\"", "priority", "5", "resource_requirements", _rr_text()), "", "");
    var task = _pairs("task_id", "\"t\"", "name", "\"n\"", "description", "\"d\"", "agent_id", "\"a\"", "resource_requirements", _rr_text());
    assert_eq(scheduled_task_from_json_str(_doc_with(task, "", "")) != 0, 1, "the task document is valid to begin with");
    var req = vec_new();
    vec_push(req, "task_id"); vec_push(req, "name"); vec_push(req, "description");
    vec_push(req, "agent_id"); vec_push(req, "resource_requirements");
    assert_eq(_required_escapes(&scheduled_task_from_json_str, task, req), 0, "every required task field");

    var tmpl = _pairs("name", "\"t\"", "description", "\"d\"", "agent_id", "\"a\"", "resource_requirements", _rr_text(), 0, 0);
    assert_eq(cron_task_template_from_json_str(_doc_with(tmpl, "", "")) != 0, 1, "the template document is valid");
    var treq = vec_new();
    vec_push(treq, "name"); vec_push(treq, "description"); vec_push(treq, "agent_id"); vec_push(treq, "resource_requirements");
    assert_eq(_required_escapes(&cron_task_template_from_json_str, tmpl, treq), 0, "every required template field");

    var entry = _pairs("name", "\"e\"", "expr", _expr_text(), "task_template", str_cstr(tmpl_doc), 0, 0, 0, 0);
    assert_eq(cron_entry_from_json_str(_doc_with(entry, "", "")) != 0, 1, "the entry document is valid");
    var ereq = vec_new();
    vec_push(ereq, "name"); vec_push(ereq, "expr"); vec_push(ereq, "task_template");
    assert_eq(_required_escapes(&cron_entry_from_json_str, entry, ereq), 0, "every required entry field");

    var job = _pairs("model_id", "\"m\"", "dataset", "\"d\"", 0, 0, 0, 0, 0, 0);
    assert_eq(training_job_template_from_json_str(_doc_with(job, "", "")) != 0, 1, "the training document is valid");
    var jreq = vec_new();
    vec_push(jreq, "model_id"); vec_push(jreq, "dataset");
    assert_eq(_required_escapes(&training_job_template_from_json_str, job, jreq), 0, "every required training field");

    var node = _pairs("node_id", "\"n\"", "total_cpu", "1.0", 0, 0, 0, 0, 0, 0);
    assert_eq(node_capacity_from_json_str(_doc_with(node, "", "")) != 0, 1, "the node document is valid");
    var nreq = vec_new();
    vec_push(nreq, "node_id");
    assert_eq(_required_escapes(&node_capacity_from_json_str, node, nreq), 0, "every required node field");

    assert_eq(cron_entry_from_json_str(_doc_with(_pairs("name", "\"\"", "expr", _expr_text(), "task_template", str_cstr(tmpl_doc), 0, 0, 0, 0), "", "")), 0, "an empty entry name is refused");
    return 0;
}

fn test_json_restore_limits() {
    test_group("json_restore_limits");
    # Each collection's ceiling, tried just under and just over.
    var saved = SAMAY_JSON_MAX_ITEMS;
    SAMAY_JSON_MAX_ITEMS = 2;
    assert_eq(task_scheduler_from_json_str(str_from("{\"tasks\":[1,2]}")) != 0, 1, "2 tasks is at the limit");
    assert_eq(task_scheduler_from_json_str(str_from("{\"tasks\":[1,2,3]}")), 0, "3 tasks is over it");
    assert_eq(task_scheduler_from_json_str(str_from("{\"nodes\":[1,2]}")) != 0, 1, "2 nodes is at the limit");
    assert_eq(task_scheduler_from_json_str(str_from("{\"nodes\":[1,2,3]}")), 0, "3 nodes is over it");
    assert_eq(cron_scheduler_from_json_str(str_from("{\"entries\":[1,2]}")) != 0, 1, "2 entries is at the limit");
    assert_eq(cron_scheduler_from_json_str(str_from("{\"entries\":[1,2,3]}")), 0, "3 entries is over it");
    assert_eq(node_capacity_from_json_str(str_from("{\"node_id\":\"n\",\"accel_profiles\":[1,2,3]}")), 0, "3 profiles is over it");
    SAMAY_JSON_MAX_ITEMS = saved;
    return 0;
}

# --- v1.4.3: cron entries, clocks and what the log says ---

fn test_cron_add_owns_name() {
    test_group("cron_add_owns_name");
    # The table was keyed on the caller's Str. Read names through one reused buffer, and
    # every key changed under the map.
    var c = cron_scheduler_new();
    var buf = alloc(16);
    memcpy(buf, "job1", 4);
    cron_scheduler_add(c, str_new(buf, 4), str_from("* * * * *"), make_template(), 1, CRON_SKIP);
    memcpy(buf, "job2", 4);
    cron_scheduler_add(c, str_new(buf, 4), str_from("* * * * *"), make_template(), 1, CRON_SKIP);
    assert_eq(map_size(CronScheduler_entries(c)), 2, "two entries");
    assert_eq(is_ok(cron_scheduler_remove_entry(c, str_from("job1"))), 1, "job1 can be removed");
    assert_eq(is_ok(cron_scheduler_remove_entry(c, str_from("job2"))), 1, "job2 can be removed");
    return 0;
}

fn test_cron_replace_keeps_its_place() {
    test_group("cron_replace_keeps_place");
    var c = mk_cron("* * * * *", CRON_CATCHUP);
    var at = at_ns(2026, 7, 18, 12, 0);
    assert_eq(vec_len(cron_scheduler_check_due_at(c, at)), 1, "fires");
    cron_scheduler_add(c, str_from("job"), str_from("* * * * *"), make_template(), 1, CRON_CATCHUP);
    assert_eq(vec_len(cron_scheduler_check_due_at(c, at + 10000000000)), 0, "not again in the same minute");

    # What it owed survives the edit.
    var h = mk_cron("0 * * * *", CRON_CATCHUP);
    cron_scheduler_check_due_at(h, at);
    cron_scheduler_add(h, str_from("job"), str_from("0 * * * *"), make_template(), 1, CRON_CATCHUP);
    assert_eq(vec_len(cron_scheduler_check_due_at(h, at_ns(2026, 7, 18, 15, 30))), 3, "13:00, 14:00 and 15:00 still fire");

    # A pre-built entry with its own watermark means it.
    var o = mk_cron("* * * * *", CRON_CATCHUP);
    cron_scheduler_check_due_at(o, at);
    var _e_t, _e_v = cron_expr_parse(str_from("* * * * *"));
    var e = cron_entry_new(str_from("job"), result_unwrap(_e_t, _e_v), make_template(), 1, CRON_CATCHUP);
    CronEntry_set_last_fired(e, at - 120000000000);
    cron_scheduler_add_entry(o, e);
    assert_eq(CronEntry_last_fired(e), at - 120000000000, "its own watermark stands");

    # Removing it is removing it: there is no history left to keep.
    var r = mk_cron("* * * * *", CRON_SKIP);
    cron_scheduler_check_due_at(r, at);
    cron_scheduler_remove_entry(r, str_from("job"));
    cron_scheduler_add(r, str_from("job"), str_from("0 0 1 1 *"), make_template(), 1, CRON_SKIP);
    assert_eq(CronEntry_last_fired(vec_get(cron_scheduler_list_entries(r), 0)), 0, "a re-added entry starts fresh");
    return 0;
}

fn test_cron_disabling_says_what_it_gave_up() {
    test_group("cron_disable_logged");
    # ADR-0006 lets a disabled entry drop what it owed. Not silently.
    var at = at_ns(2026, 7, 18, 12, 0);
    var c = mk_cron("0 * * * *", CRON_CATCHUP);
    cron_scheduler_check_due_at(c, at);
    var e = vec_get(cron_scheduler_list_entries(c), 0);
    CronEntry_set_enabled(e, 0);
    _logs_start();
    cron_scheduler_check_due_at(c, at_ns(2026, 7, 18, 18, 0));
    assert_eq(_logged("disabled, giving up 6 missed occurrence(s)"), 1, "the count is logged");
    cron_scheduler_check_due_at(c, at_ns(2026, 7, 18, 19, 0));
    cron_scheduler_check_due_at(c, at_ns(2026, 7, 18, 20, 0));
    assert_eq(_logged("disabled, giving up"), 1, "once, not on every check");
    CronEntry_set_enabled(e, 1);
    cron_scheduler_check_due_at(c, at_ns(2026, 7, 18, 20, 30));
    CronEntry_set_enabled(e, 0);
    cron_scheduler_check_due_at(c, at_ns(2026, 7, 18, 23, 0));
    assert_eq(_logged("disabled, giving up"), 2, "and once more for a second disable");
    _logs_stop();

    # Nothing owed, nothing to say.
    var q = mk_cron("0 0 1 1 *", CRON_CATCHUP);
    cron_scheduler_check_due_at(q, at);
    CronEntry_set_enabled(vec_get(cron_scheduler_list_entries(q), 0), 0);
    _logs_start();
    cron_scheduler_check_due_at(q, at_ns(2026, 7, 18, 18, 0));
    assert_eq(vec_len(_log_lines), 0, "a quiet disable stays quiet");
    _logs_stop();

    # An entry disabled from the start has no history to give up.
    var never = cron_scheduler_new();
    cron_scheduler_add(never, str_from("off"), str_from("* * * * *"), make_template(), 0, CRON_CATCHUP);
    _logs_start();
    cron_scheduler_check_due_at(never, at);
    assert_eq(vec_len(_log_lines), 0, "nothing to report");
    _logs_stop();
    return 0;
}

fn test_cron_clock_reset() {
    test_group("cron_clock_reset");
    var at = at_ns(2026, 7, 18, 12, 0);
    # One bad reading a month ahead used to stop this entry for a month.
    var c = mk_cron("0 * * * *", CRON_SKIP);
    cron_scheduler_check_due_at(c, at);
    cron_scheduler_check_due_at(c, at + 2592000000000000);
    assert_eq(vec_len(cron_scheduler_check_due_at(c, at_ns(2026, 7, 18, 13, 0))), 1, "a matching minute fires after the correction");
    assert_eq(vec_len(cron_scheduler_check_due_at(c, at_ns(2026, 7, 18, 14, 0))), 1, "and the schedule carries on");
    assert_eq(vec_len(cron_scheduler_check_due_at(c, at_ns(2026, 7, 18, 14, 0))), 0, "without firing twice");

    # A small step back waits, as it always has: nothing fires twice.
    var s = mk_cron("* * * * *", CRON_CATCHUP);
    cron_scheduler_check_due_at(s, at);
    var limit = CRON_CLOCK_RESET_SECS * 1000000000;
    assert_eq(vec_len(cron_scheduler_check_due_at(s, at - limit)), 0, "exactly the limit still waits");
    assert_eq(CronEntry_last_fired(vec_get(cron_scheduler_list_entries(s), 0)), at, "watermark held");
    _logs_start();
    assert_eq(vec_len(cron_scheduler_check_due_at(s, at - limit - 60000000000)), 1, "a minute past it starts again");
    assert_eq(_logged("watermark re-anchored"), 1, "and says so");
    _logs_stop();
    assert_eq(CronEntry_last_fired(vec_get(cron_scheduler_list_entries(s), 0)), at - limit - 60000000000, "anchored at now");
    return 0;
}

fn test_cron_logs_tell_the_truth() {
    test_group("cron_logs_truth");
    var at = at_ns(2026, 7, 18, 12, 0);
    # A daily entry fires one late occurrence and said nothing.
    var d = mk_cron("0 0 * * *", CRON_CATCHUP);
    cron_scheduler_check_due_at(d, at_ns(2026, 7, 17, 23, 0));
    _logs_start();
    cron_scheduler_check_due_at(d, at_ns(2026, 7, 18, 5, 0));
    assert_eq(_logged("catch-up policy fired 1 missed occurrence(s)"), 1, "one late fire is logged");
    _logs_stop();
    var ds = mk_cron("0 0 * * *", CRON_SKIP);
    cron_scheduler_check_due_at(ds, at_ns(2026, 7, 17, 23, 0));
    _logs_start();
    cron_scheduler_check_due_at(ds, at_ns(2026, 7, 18, 5, 0));
    assert_eq(_logged("skip policy fired 1 missed occurrence(s)"), 1, "under either policy");
    _logs_stop();

    # On time is not missed.
    var t = mk_cron("* * * * *", CRON_CATCHUP);
    cron_scheduler_check_due_at(t, at);
    _logs_start();
    cron_scheduler_check_due_at(t, at + 60000000000);
    assert_eq(vec_len(_log_lines), 0, "an on-time fire says nothing");
    cron_scheduler_check_due_at(t, at + 180000000000);
    assert_eq(_logged("catch-up policy fired 1 missed occurrence(s)"), 1, "12:03 was on time, so only 12:02 was missed");
    _logs_stop();

    # A count past the window covers the window, and says that.
    var stale = at - CRON_SCAN_WINDOW_SECS * 2000000000;
    var c = cron_scheduler_new();
    _fleet_add(c, 1, "c-", "* * * * *", CRON_CATCHUP, stale);
    var s = cron_scheduler_new();
    _fleet_add(s, 1, "s-", "* * * * *", CRON_SKIP, stale);
    _logs_start();
    cron_scheduler_check_due_at(c, at);
    cron_scheduler_check_due_at(s, at);
    _logs_stop();
    assert_eq(_logged("due occurrence(s) in the catch-up window"), 1, "the cap says what it counted");
    assert_eq(_logged("missed occurrence(s) in the catch-up window"), 1, "and so does skip");
    # Within the window it is the whole truth, so no qualifier.
    var w = mk_cron("* * * * *", CRON_SKIP);
    cron_scheduler_check_due_at(w, at);
    _logs_start();
    cron_scheduler_check_due_at(w, at + 300000000000);
    assert_eq(_logged("dropped 4 missed occurrence(s)"), 1, "exact");
    assert_eq(_logged("in the catch-up window"), 0, "unqualified");
    _logs_stop();

    # A schedule with no occurrences older than the window drops none, so nothing may
    # claim it did.
    var leap = cron_scheduler_new();
    _fleet_add(leap, 1, "l-", "0 0 29 2 *", CRON_SKIP, at - CRON_SCAN_WINDOW_SECS * 2000000000);
    _logs_start();
    cron_scheduler_check_due_at(leap, at);
    assert_eq(_logged("dropped"), 0, "the clamp line claims nothing");
    assert_eq(_logged("anything older is not counted"), 1, "it says what it knows");
    _logs_stop();

    # A long name cannot push the count off the end of the line.
    var sb = str_builder_new();
    var i = 0;
    while (i < 300) { str_builder_add_cstr(sb, "n"); i = i + 1; }
    var lng = cron_scheduler_new();
    var _e_t, _e_v = cron_expr_parse(str_from("* * * * *"));
    var e = cron_entry_new(str_builder_build(sb), result_unwrap(_e_t, _e_v), make_template(), 1, CRON_SKIP);
    CronEntry_set_last_fired(e, at);
    cron_scheduler_add_entry(lng, e);
    _logs_start();
    cron_scheduler_check_due_at(lng, at + 300000000000);
    assert_eq(str_len(vec_get(_log_lines, 0)) < 256, 1, "the line fits sakshi's buffer");
    assert_eq(_logged("dropped 4 missed"), 1, "with the count in it");
    _logs_stop();
    return 0;
}

fn test_cron_entry_edges() {
    test_group("cron_entry_edges");
    # Compared with `== 1`, so 2 would be dormant while reporting enabled, then fire
    # after a restore normalised it.
    var c = cron_scheduler_new();
    cron_scheduler_add(c, str_from("e"), str_from("* * * * *"), make_template(), 2, CRON_SKIP);
    assert_eq(vec_len(cron_scheduler_check_due_at(c, at_ns(2026, 7, 18, 12, 0))), 1, "truthy enabled fires");
    # 0 means never, so an epoch-zero clock must still leave a mark.
    var z = mk_cron("* * * * *", CRON_SKIP);
    assert_eq(vec_len(cron_scheduler_check_due_at(z, 0)), 1, "fires at the epoch");
    assert_eq(vec_len(cron_scheduler_check_due_at(z, 0)), 0, "but only once");
    return 0;
}

fn test_cron_parser_edges() {
    test_group("cron_parser_edges");
    var bad = vec_new();
    vec_push(bad, "*/0 * * * *");
    vec_push(bad, "0-5/0 * * * *");
    vec_push(bad, "1/0 * * * *");
    vec_push(bad, "* * * * *  x");
    vec_push(bad, "* * * *");
    vec_push(bad, "5-1 * * * *");
    vec_push(bad, "60 * * * *");
    vec_push(bad, "* 24 * * *");
    vec_push(bad, "* * 0 * *");
    vec_push(bad, "* * 32 * *");
    vec_push(bad, "* * * 0 *");
    vec_push(bad, "* * * 13 *");
    vec_push(bad, "* * * * 8");
    vec_push(bad, ", * * * *");
    vec_push(bad, "1, * * * *");
    vec_push(bad, "*/ * * * *");
    vec_push(bad, "- * * * *");
    vec_push(bad, "1- * * * *");
    vec_push(bad, "1000000000 * * * *");
    vec_push(bad, "@reboot");
    vec_push(bad, "@nope");
    vec_push(bad, "/5 * * * *");
    vec_push(bad, "-5 * * * *");
    vec_push(bad, "5- * * * *");
    vec_push(bad, "5/ * * * *");
    vec_push(bad, "1,,2 * * * *");
    # A name has to match on all three letters.
    vec_push(bad, "0 0 * JXN *");
    vec_push(bad, "0 0 * XAN *");
    vec_push(bad, "0 0 * JAX *");
    vec_push(bad, "0 0 * * MXN");
    vec_push(bad, "0 0 * * XON");
    vec_push(bad, "0 0 * * MOX");
    vec_push(bad, "");
    vec_push(bad, "   ");
    var accepted = 0;
    var i = 0;
    while (i < vec_len(bad)) {
        var _b_t, _b_v = cron_expr_parse(str_from(vec_get(bad, i)));
        if (is_ok(_b_t) == 1) { accepted = accepted + 1; }
        i = i + 1;
    }
    assert_eq(accepted, 0, "every malformed expression is refused at parse time");

    var _a_t, _a_v = cron_expr_parse(str_from("5/15 * * * *"));
    var a = result_unwrap(_a_t, _a_v);
    assert_eq(CronExpr_minute_mask(a), (1 << 5) | (1 << 20) | (1 << 35) | (1 << 50), "N/S runs from N to the end");

    # Names in lower case, with a and z the ends of the upcasing range.
    var _l_t, _l_v = cron_expr_parse(str_from("0 0 * jan sat"));
    var l = result_unwrap(_l_t, _l_v);
    assert_eq(CronExpr_month_mask(l), 1 << 1, "jan");
    assert_eq(CronExpr_dow_mask(l), 1 << 6, "sat");
    var _m_t, _m_v = cron_expr_parse(str_from("0 0 * * 5-7"));
    assert_eq(CronExpr_dow_mask(result_unwrap(_m_t, _m_v)), (1 << 5) | (1 << 6) | 1, "5-7 runs into Sunday");
    var _n_t, _n_v = cron_expr_parse(str_from("000000009 * * * *"));
    assert_eq(CronExpr_minute_mask(result_unwrap(_n_t, _n_v)), 1 << 9, "nine digits is the most a number may have");
    return 0;
}

fn test_cron_next_after_horizon() {
    test_group("cron_next_after_horizon");
    # A Feb 29 that is also the right weekday can be decades off. The old ten-year scan
    # answered -1, the same answer Feb 31 gets.
    var from = _chrono_ymd_to_epoch_secs(2061, 12, 31, 0, 0, 0);
    var _a_t, _a_v = cron_expr_parse(str_from("0 0 29 2 */7"));
    assert_eq(cron_expr_next_after(result_unwrap(_a_t, _a_v), from), _chrono_ymd_to_epoch_secs(2088, 2, 29, 0, 0, 0), "26 years on");
    var _n_t, _n_v = cron_expr_parse(str_from("0 0 31 2 *"));
    assert_eq(cron_expr_next_after(result_unwrap(_n_t, _n_v), from), 0 - 1, "-1 now means never");
    # Epoch 0 is the first match after any negative instant.
    var _e_t, _e_v = cron_expr_parse(str_from("* * * * *"));
    var every = result_unwrap(_e_t, _e_v);
    assert_eq(cron_expr_next_after(every, 0 - 30), 0, "0 follows -30");
    assert_eq(cron_expr_next_after(every, 0), 60, "strictly after");
    # Later the same day, past the first match of the day.
    var _h_t, _h_v = cron_expr_parse(str_from("15 3,15 * * *"));
    var at_noon = _chrono_ymd_to_epoch_secs(2026, 7, 18, 12, 0, 0);
    assert_eq(cron_expr_next_after(result_unwrap(_h_t, _h_v), at_noon), _chrono_ymd_to_epoch_secs(2026, 7, 18, 15, 15, 0), "same day");
    # Masks that select no time at all, which only a snapshot can hold, end at once.
    var empty = result_unwrap(_e_t, _e_v);
    CronExpr_set_hour_mask(empty, 0);
    assert_eq(cron_expr_next_after(empty, at_noon), 0 - 1, "no time of day means never");
    return 0;
}

# --- v1.4.3: restore checks the nodes against the tasks ---

fn _read_fixture(path) {
    var cap = 65536;
    var buf = alloc(cap);
    return str_new(buf, file_read_all(path, buf, cap));
}

fn _snap_node(cpu, mem, rt) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"node_id\":\"n\",\"total_cpu\":8.0,\"available_cpu\":");
    str_builder_add_cstr(sb, cpu);
    str_builder_add_cstr(sb, ",\"total_memory_mb\":8192,\"available_memory_mb\":");
    str_builder_add_int(sb, mem);
    str_builder_add_cstr(sb, ",\"total_disk_mb\":1000,\"available_disk_mb\":1000,\"running_tasks\":");
    str_builder_add_int(sb, rt);
    str_builder_add_cstr(sb, ",\"accel_profiles\":[]}");
    return str_builder_build(sb);
}

# A task of `cores` cores. `held` and `placed` name a node, or are 0 for null.
fn _snap_task(id, status, cores, held, placed) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"task_id\":\"");
    str_builder_add_cstr(sb, id);
    str_builder_add_cstr(sb, "\",\"name\":\"t\",\"description\":\"d\",\"agent_id\":\"a\",\"priority\":5,\"resource_requirements\":{\"cpu_cores\":");
    str_builder_add_int(sb, cores);
    str_builder_add_cstr(sb, ".0,\"memory_mb\":0,\"accel_req\":0,\"accel_min_chips\":0,\"network\":0,\"disk_mb\":0},\"status\":");
    str_builder_add_int(sb, status);
    str_builder_add_cstr(sb, ",\"created_at\":1,\"scheduled_at\":2,\"reserved_on\":");
    if (held == 0) {
        str_builder_add_cstr(sb, "null");
    } else {
        str_builder_add_cstr(sb, "\"");
        str_builder_add_cstr(sb, held);
        str_builder_add_cstr(sb, "\"");
    }
    str_builder_add_cstr(sb, ",\"requested_node\":null,\"assigned_node\":");
    if (placed == 0) {
        str_builder_add_cstr(sb, "null");
    } else {
        str_builder_add_cstr(sb, "\"");
        str_builder_add_cstr(sb, placed);
        str_builder_add_cstr(sb, "\"");
    }
    str_builder_add_cstr(sb, "}");
    return str_builder_build(sb);
}

fn _snap(tasks, node) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"tasks\":[");
    var i = 0;
    while (i < vec_len(tasks)) {
        if (i > 0) { str_builder_add_cstr(sb, ","); }
        str_builder_add(sb, vec_get(tasks, i));
        i = i + 1;
    }
    str_builder_add_cstr(sb, "],\"nodes\":[");
    str_builder_add(sb, node);
    str_builder_add_cstr(sb, "]}");
    return task_scheduler_from_json_str(str_builder_build(sb));
}

fn _v1(a) { var v = vec_new(); vec_push(v, a); return v; }
fn _v2(a, b) { var v = vec_new(); vec_push(v, a); vec_push(v, b); return v; }

fn test_restore_settles_capacity() {
    test_group("restore_settles_capacity");
    # Two tasks hold 4 cores each, and the node says it gave up 4.
    var dbl = _snap(_v2(_snap_task("a", TASK_RUNNING, 4, "n", "n"), _snap_task("b", TASK_RUNNING, 4, "n", "n")), _snap_node("4.0", 8192, 1));
    var n = map_get(TaskScheduler_nodes(dbl), str_from("n"));
    assert_eq(_cpu_milli(n), 0, "both are charged");
    assert_eq(NodeCapacity_running_tasks(n), 2, "both are counted");
    task_scheduler_submit_task(dbl, scheduled_task_new(str_from("c"), str_from("d"), str_from("a"), 5, make_req(f64_from(4), 0)));
    assert_eq(vec_len(task_scheduler_schedule_pending(dbl)), 0, "so a third is not sold the same cores");

    # The node gave up capacity nothing holds.
    _logs_start();
    var phantom = _snap(vec_new(), _snap_node("2.0", 100, 3));
    assert_eq(_logged("snapshot capacity disagrees with its tasks"), 1, "a rebuild says so");
    _logs_stop();
    var pn = map_get(TaskScheduler_nodes(phantom), str_from("n"));
    assert_eq(_cpu_milli(pn), 8000, "cpu comes back");
    assert_eq(NodeCapacity_available_memory_mb(pn), 8192, "memory comes back");
    assert_eq(NodeCapacity_running_tasks(pn), 0, "nothing is running");

    # Running, placed, and the reservation lost: it still occupies its node.
    var lost = _snap(_v1(_snap_task("a", TASK_RUNNING, 8, 0, "n")), _snap_node("8.0", 8192, 0));
    assert_eq(_cpu_milli(map_get(TaskScheduler_nodes(lost), str_from("n"))), 0, "its capacity is charged");
    # Every such task, wherever the table put it.
    var strays = vec_new();
    var st = 0;
    while (st < 32) {
        vec_push(strays, _snap_task(str_cstr(_numbered("t-", st)), TASK_RUNNING, 0, 0, "n"));
        st = st + 1;
    }
    var lost_all = _snap(strays, _snap_node("8.0", 8192, 0));
    assert_eq(NodeCapacity_running_tasks(map_get(TaskScheduler_nodes(lost_all), str_from("n"))), 32, "all of them are charged");

    # A finished task not yet reconciled is charged until the next pass, whatever the
    # node says, so it cannot credit back what was never taken.
    var stale = _snap(_v2(_snap_task("a", TASK_COMPLETED, 6, "n", "n"), _snap_task("b", TASK_RUNNING, 2, "n", "n")), _snap_node("6.0", 8192, 1));
    var sn = map_get(TaskScheduler_nodes(stale), str_from("n"));
    task_scheduler_schedule_pending(stale);
    assert_eq(_cpu_milli(sn), 6000, "only the running task holds anything after the pass");

    # A reservation on a node the snapshot lacks matches nothing, and does no harm.
    var ghost = _snap(_v1(_snap_task("a", TASK_RUNNING, 4, "gone", "gone")), _snap_node("8.0", 8192, 0));
    assert_eq(_cpu_milli(map_get(TaskScheduler_nodes(ghost), str_from("n"))), 8000, "the real node is untouched");
    _finish(ghost, task_scheduler_get_task(ghost, str_from("a")));

    # Holds on either side of a node, in id order, belong to no one else.
    var both = _snap(_v2(_snap_task("a", TASK_RUNNING, 1, "a-node", "a-node"), _snap_task("b", TASK_RUNNING, 1, "z-node", "z-node")), _snap_node("8.0", 8192, 0));
    assert_eq(_cpu_milli(map_get(TaskScheduler_nodes(both), str_from("n"))), 8000, "neighbours in sort order are not picked up");

    # Several in a row on a missing node must not skip past the real one that follows.
    var ghosts = vec_new();
    vec_push(ghosts, _snap_task("a", TASK_RUNNING, 1, "a-gone", "a-gone"));
    vec_push(ghosts, _snap_task("b", TASK_RUNNING, 1, "b-gone", "b-gone"));
    vec_push(ghosts, _snap_task("c", TASK_RUNNING, 1, "c-gone", "c-gone"));
    vec_push(ghosts, _snap_task("d", TASK_RUNNING, 1, "n", "n"));
    var g3 = _snap(ghosts, _snap_node("7.0", 8192, 1));
    assert_eq(_cpu_milli(map_get(TaskScheduler_nodes(g3), str_from("n"))), 7000, "the real hold is found");

    # Over-committed, it counts below zero (1.5.1, ADR-0007). Through 1.5.0 it stopped at
    # zero, so one task's release gave back 6 cores where 2 were free.
    var over = _snap(_v2(_snap_task("a", TASK_RUNNING, 6, "n", "n"), _snap_task("b", TASK_RUNNING, 6, "n", "n")), _snap_node("0.0", 8192, 2));
    var on = map_get(TaskScheduler_nodes(over), str_from("n"));
    assert_eq(_cpu_milli(on), 0 - 4000, "12 cores held on 8 leaves -4");
    task_scheduler_complete_task(over, str_from("a"), TASK_COMPLETED);
    assert_eq(_cpu_milli(on), 2000, "and one task's release leaves 2 free, not 6");
    return 0;
}

fn test_restore_keeps_a_good_snapshot_exact() {
    test_group("restore_keeps_good_exact");
    # f64 sums depend on order, and replay is not the order they ran in. A snapshot
    # that agrees with its tasks must come back to the bit.
    var s = task_scheduler_new();
    var node = make_node("n", f64_from(16), 8192);
    task_scheduler_register_node(s, node);
    var i = 0;
    while (i < 12) {
        var t = scheduled_task_new(str_from("t"), str_from("d"), str_from("a"), 5,
          make_req(f64_div(f64_from(1 + i), f64_from(7)), 1));
        task_scheduler_submit_task(s, t);
        i = i + 1;
    }
    task_scheduler_schedule_pending(s);
    var placed = task_scheduler_tasks_for_node(s, str_from("n"));
    # Out of placement order, so the sum left behind is one replay would not reach.
    _finish(s, vec_get(placed, 3));
    _finish(s, vec_get(placed, 9));
    _finish(s, vec_get(placed, 1));
    var js = task_scheduler_to_json_str(s);
    _logs_start();
    var back = task_scheduler_from_json_str(js);
    assert_eq(_logged("disagrees"), 0, "nothing to rebuild");
    _logs_stop();
    assert_eq(str_eq(task_scheduler_to_json_str(back), js), 1, "byte for byte");
    var bn = map_get(TaskScheduler_nodes(back), str_from("n"));
    assert_eq(NodeCapacity_available_cpu(bn) == NodeCapacity_available_cpu(node), 1, "to the bit");
    assert_eq(NodeCapacity_running_tasks(bn), 9, "and its count stands");
    # Whether those sums differ rests on where uuids sort, so plant one that does: within
    # rounding of what replay reaches, it keeps its own bits.
    var near = _snap(_v1(_snap_task("a", TASK_RUNNING, 1, "n", "n")), _snap_node("6.99999999999", 8192, 1));
    var nn = map_get(TaskScheduler_nodes(near), str_from("n"));
    assert_eq(f64_eq(NodeCapacity_available_cpu(nn), f64_from(7)), 0, "a sum within rounding is not replaced");
    assert_eq(f64_lt(f64_sub(f64_from(7), NodeCapacity_available_cpu(nn)), f64_div(f64_from(1), f64_from(1000000))), 1, "nor rebuilt");
    return 0;
}

fn test_restore_old_snapshot_drains_full() {
    test_group("restore_old_snapshot_drains");
    # 1.0.2 released only on cancel, so a real snapshot from it shows capacity held by
    # tasks long finished. Every node must come back when the work is done.
    var s = task_scheduler_from_json_str(_read_fixture("tests/fixtures/snapshot-1.0.2.json"));
    var round = 0;
    while (round < 3) {
        task_scheduler_schedule_pending(s);
        var all = map_values(TaskScheduler_tasks(s));
        var i = 0;
        while (i < vec_len(all)) {
            var t = vec_get(all, i);
            var st = ScheduledTask_status(t);
            if (st == TASK_QUEUED) { task_scheduler_cancel_task(s, ScheduledTask_task_id(t)); }
            if (st == TASK_PREEMPTED) { task_scheduler_cancel_task(s, ScheduledTask_task_id(t)); }
            if (st == TASK_SCHEDULED) { _finish(s, t); }
            if (st == TASK_RUNNING) { _finish(s, t); }
            i = i + 1;
        }
        round = round + 1;
    }
    var nodes = map_values(TaskScheduler_nodes(s));
    var short = 0;
    var i2 = 0;
    while (i2 < vec_len(nodes)) {
        var n = vec_get(nodes, i2);
        if (NodeCapacity_available_cpu(n) != NodeCapacity_total_cpu(n)) { short = short + 1; }
        if (NodeCapacity_available_memory_mb(n) != NodeCapacity_total_memory_mb(n)) { short = short + 1; }
        if (NodeCapacity_running_tasks(n) != 0) { short = short + 1; }
        i2 = i2 + 1;
    }
    assert_eq(vec_len(nodes), 3, "all three nodes");
    assert_eq(short, 0, "all back to full");
    return 0;
}

# Keys of `pairs` that accept this wrong value.
fn _accepted_wrong(reader, pairs, keys, value) {
    var bad = 0;
    var i = 0;
    while (i < vec_len(keys)) {
        var key = vec_get(keys, i);
        var v = vec_new();
        var found = 0;
        var k = 0;
        while (k < vec_len(pairs)) {
            vec_push(v, vec_get(pairs, k));
            if (streq(vec_get(pairs, k), key) == 1) {
                vec_push(v, value);
                found = 1;
            } else {
                vec_push(v, vec_get(pairs, k + 1));
            }
            k = k + 2;
        }
        if (found == 0) { vec_push(v, key); vec_push(v, value); }
        if (fncall1(reader, _doc_with(v, "", "")) != 0) { bad = bad + 1; }
        i = i + 1;
    }
    return bad;
}

fn _wrong_all(reader, pairs, keys) {
    var bad = _accepted_wrong(reader, pairs, keys, "\"x\"");
    bad = bad + _accepted_wrong(reader, pairs, keys, "null");
    bad = bad + _accepted_wrong(reader, pairs, keys, "[]");
    bad = bad + _accepted_wrong(reader, pairs, keys, "{}");
    return bad;
}

fn _keys(a, b, c, d, e, f, g) {
    var v = vec_new();
    vec_push(v, a);
    if (b != 0) { vec_push(v, b); }
    if (c != 0) { vec_push(v, c); }
    if (d != 0) { vec_push(v, d); }
    if (e != 0) { vec_push(v, e); }
    if (f != 0) { vec_push(v, f); }
    if (g != 0) { vec_push(v, g); }
    return v;
}

fn _task_wrapping(req_text) {
    return _doc_with(_pairs("task_id", "\"t\"", "name", "\"n\"", "description", "\"d\"", "agent_id", "\"a\"", "resource_requirements", req_text), "", "");
}

fn test_restore_refuses_wrong_types() {
    test_group("restore_wrong_types");
    # These readers answer 0 for a wrong type. "cpu_cores":"8" restored as no cores at
    # all, and "status":"running" as QUEUED, so a running task ran twice.
    var task = _pairs("task_id", "\"t\"", "name", "\"n\"", "description", "\"d\"", "agent_id", "\"a\"", "resource_requirements", _rr_text());
    assert_eq(_wrong_all(&scheduled_task_from_json_str, task,
        _keys("priority", "status", "created_at", "scheduled_at", "started_at", "completed_at", "deadline")), 0, "task numbers");

    var node = _pairs("node_id", "\"n\"", "total_cpu", "1.0", 0, 0, 0, 0, 0, 0);
    assert_eq(_wrong_all(&node_capacity_from_json_str, node,
        _keys("total_cpu", "available_cpu", "total_memory_mb", "available_memory_mb", "total_disk_mb", "available_disk_mb", "running_tasks")), 0, "node numbers");

    var tmpl = _pairs("name", "\"t\"", "description", "\"d\"", "agent_id", "\"a\"", "resource_requirements", _rr_text(), 0, 0);
    assert_eq(_wrong_all(&cron_task_template_from_json_str, tmpl, _keys("priority", 0, 0, 0, 0, 0, 0)), 0, "template numbers");

    var job = _pairs("model_id", "\"m\"", "dataset", "\"d\"", 0, 0, 0, 0, 0, 0);
    assert_eq(_wrong_all(&training_job_template_from_json_str, job, _keys("method", "max_duration_secs", "checkpoint_interval_secs", 0, 0, 0, 0)), 0, "training numbers");

    var doc = _doc_with(_pairs("name", "\"t\"", "description", "\"d\"", "agent_id", "\"a\"", "resource_requirements", _rr_text(), 0, 0), "", "");
    var entry = _pairs("name", "\"e\"", "expr", _expr_text(), "task_template", str_cstr(doc), 0, 0, 0, 0);
    assert_eq(_wrong_all(&cron_entry_from_json_str, entry, _keys("enabled", "last_fired", "missed_policy", 0, 0, 0, 0)), 0, "entry numbers");

    # Inside the requirement. Each reaches a task that would otherwise fit any node.
    var rr = _pairs("cpu_cores", "1.0", "memory_mb", "1", "accel_req", "0", "accel_min_chips", "0", "network", "0");
    # Every field is required since 1.5.1, disk_mb too.
    vec_push(rr, "disk_mb");
    vec_push(rr, "0");
    assert_eq(scheduled_task_from_json_str(_task_wrapping(str_cstr(_doc_with(rr, "", "")))) != 0, 1, "the requirement is valid to begin with");
    var keys = _keys("cpu_cores", "memory_mb", "accel_req", "accel_min_chips", "network", "disk_mb", 0);
    var i = 0;
    var wrong = 0;
    while (i < vec_len(keys)) {
        var v = vec_new();
        var k = 0;
        while (k < vec_len(rr)) {
            vec_push(v, vec_get(rr, k));
            if (streq(vec_get(rr, k), vec_get(keys, i)) == 1) { vec_push(v, "\"8\""); } else { vec_push(v, vec_get(rr, k + 1)); }
            k = k + 2;
        }
        if (scheduled_task_from_json_str(_task_wrapping(str_cstr(_doc_with(v, "", "")))) != 0) { wrong = wrong + 1; }
        i = i + 1;
    }
    assert_eq(wrong, 0, "every requirement field");

    # Inside the expression: a missing mask matches nothing, and such an entry would
    # sit enabled and never fire.
    var masks = _keys("minute_mask", "hour_mask", "dom_mask", "month_mask", "dow_mask", 0, 0);
    var full = _pairs("minute_mask", "1", "hour_mask", "1", "dom_mask", "2", "month_mask", "2", "dow_mask", "1");
    var missing = 0;
    var mistyped = 0;
    i = 0;
    while (i < vec_len(masks)) {
        var m = vec_get(masks, i);
        var e1 = _pairs("name", "\"e\"", "expr", str_cstr(_doc_with(full, m, "")), "task_template", str_cstr(doc), 0, 0, 0, 0);
        if (cron_entry_from_json_str(_doc_with(e1, "", "")) != 0) { missing = missing + 1; }
        var bad = vec_new();
        var k2 = 0;
        while (k2 < vec_len(full)) {
            vec_push(bad, vec_get(full, k2));
            if (streq(vec_get(full, k2), m) == 1) { vec_push(bad, "\"*/5\""); } else { vec_push(bad, vec_get(full, k2 + 1)); }
            k2 = k2 + 2;
        }
        var e2 = _pairs("name", "\"e\"", "expr", str_cstr(_doc_with(bad, "", "")), "task_template", str_cstr(doc), 0, 0, 0, 0);
        if (cron_entry_from_json_str(_doc_with(e2, "", "")) != 0) { mistyped = mistyped + 1; }
        i = i + 1;
    }
    assert_eq(missing, 0, "every mask is required");
    assert_eq(mistyped, 0, "and has to be a number");
    var star = _pairs("minute_mask", "1", "hour_mask", "1", "dom_mask", "2", "month_mask", "2", "dow_mask", "1");
    vec_push(star, "dom_star");
    vec_push(star, "\"x\"");
    assert_eq(cron_entry_from_json_str(_doc_with(_pairs("name", "\"e\"", "expr", str_cstr(_doc_with(star, "", "")), "task_template", str_cstr(doc), 0, 0, 0, 0), "", "")), 0, "a star flag is a flag");
    return 0;
}

fn test_restore_reads_json_booleans() {
    test_group("restore_booleans");
    # bayan_json_v_int answers 0 for a bool, so "enabled":true restored as off, and the
    # entry sat there silently.
    var doc = _doc_with(_pairs("name", "\"t\"", "description", "\"d\"", "agent_id", "\"a\"", "resource_requirements", _rr_text(), 0, 0), "", "");
    var on = _pairs("name", "\"e\"", "expr", _expr_text(), "task_template", str_cstr(doc), "enabled", "true", 0, 0);
    assert_eq(CronEntry_enabled(cron_entry_from_json_str(_doc_with(on, "", ""))), 1, "true is on");
    var off = _pairs("name", "\"e\"", "expr", _expr_text(), "task_template", str_cstr(doc), "enabled", "false", 0, 0);
    assert_eq(CronEntry_enabled(cron_entry_from_json_str(_doc_with(off, "", ""))), 0, "false is off");
    var net = _pairs("cpu_cores", "1.0", "memory_mb", "1", "accel_req", "0", "accel_min_chips", "0", "network", "true");
    vec_push(net, "disk_mb");
    vec_push(net, "0");
    var t = scheduled_task_from_json_str(_task_wrapping(str_cstr(_doc_with(net, "", ""))));
    assert_eq(ResourceReq_network(ScheduledTask_resource_requirements(t)), 1, "network true is 1");
    return 0;
}

fn test_restore_refuses_bad_containers() {
    test_group("restore_bad_containers");
    # A collection of the wrong type read as empty: a snapshot with its tasks keyed by id
    # restored as an empty scheduler and reported success.
    assert_eq(task_scheduler_from_json_str(str_from("{\"tasks\":{\"a\":1}}")), 0, "tasks as an object");
    assert_eq(task_scheduler_from_json_str(str_from("{\"tasks\":\"x\"}")), 0, "tasks as a string");
    assert_eq(task_scheduler_from_json_str(str_from("{\"tasks\":null}")), 0, "tasks as null");
    assert_eq(task_scheduler_from_json_str(str_from("{\"nodes\":{\"a\":1}}")), 0, "nodes as an object");
    assert_eq(cron_scheduler_from_json_str(str_from("{\"entries\":{\"a\":1}}")), 0, "entries as an object");
    assert_eq(node_capacity_from_json_str(str_from("{\"node_id\":\"n\",\"accel_profiles\":{\"a\":1}}")), 0, "profiles as an object");
    assert_eq(task_scheduler_from_json_str(str_from("{}")) != 0, 1, "absent is still fine");
    assert_eq(cron_scheduler_from_json_str(str_from("{}")) != 0, 1, "for cron too");

    # A node past the profile limit refuses its scheduler, as the write side does.
    var saved = SAMAY_JSON_MAX_ITEMS;
    SAMAY_JSON_MAX_ITEMS = 2;
    assert_eq(task_scheduler_from_json_str(str_from("{\"nodes\":[{\"node_id\":\"n\",\"accel_profiles\":[1,2,3]}]}")), 0, "too many profiles");
    SAMAY_JSON_MAX_ITEMS = saved;
    assert_eq(task_scheduler_from_json_str(str_from("{\"nodes\":[{\"node_id\":\"n\",\"accel_profiles\":{}}]}")), 0, "profiles of the wrong type");
    assert_eq(task_scheduler_from_json_str(0), 0, "a refused write fed straight back is not a crash");

    # Two records under one key cannot come from an honest writer, and keeping either
    # strands what the other held.
    _logs_start();
    var t = _snap_task("same", TASK_RUNNING, 1, "n", "n");
    assert_eq(_snap(_v2(t, t), _snap_node("7.0", 8192, 1)), 0, "two tasks, one id");
    assert_eq(_logged("snapshot refused: two tasks named 'same'"), 1, "and it says why");
    var n = str_cstr(_snap_node("8.0", 8192, 0));
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"nodes\":[");
    str_builder_add_cstr(sb, n);
    str_builder_add_cstr(sb, ",");
    str_builder_add_cstr(sb, n);
    str_builder_add_cstr(sb, "]}");
    assert_eq(task_scheduler_from_json_str(str_builder_build(sb)), 0, "two nodes, one id");
    assert_eq(_logged("snapshot refused: two nodes named 'n'"), 1, "named");
    var c = mk_cron("0 1 * * *", CRON_SKIP);
    var e = str_cstr(cron_entry_to_json_str(vec_get(cron_scheduler_list_entries(c), 0)));
    var sb2 = str_builder_new();
    str_builder_add_cstr(sb2, "{\"entries\":[");
    str_builder_add_cstr(sb2, e);
    str_builder_add_cstr(sb2, ",");
    str_builder_add_cstr(sb2, e);
    str_builder_add_cstr(sb2, "]}");
    assert_eq(cron_scheduler_from_json_str(str_builder_build(sb2)), 0, "two entries, one name");
    assert_eq(_logged("snapshot refused: two cron entries named 'job'"), 1, "named too");
    _logs_stop();
    return 0;
}

fn test_restore_says_what_it_dropped() {
    test_group("restore_says_dropped");
    _logs_start();
    assert_eq(task_scheduler_from_json_str(str_from("{\"tasks\":[1,2],\"nodes\":[3]}")) != 0, 1, "a bad record is dropped, not fatal");
    assert_eq(_logged("restore dropped 2 unreadable tasks"), 1, "but it is counted");
    assert_eq(_logged("restore dropped 1 unreadable nodes"), 1, "for nodes too");
    assert_eq(cron_scheduler_from_json_str(str_from("{\"entries\":[1]}")) != 0, 1, "and cron");
    assert_eq(_logged("restore dropped 1 unreadable cron entries"), 1, "the same");
    var n = vec_len(_log_lines);
    task_scheduler_from_json_str(str_from("{\"tasks\":[],\"nodes\":[]}"));
    assert_eq(vec_len(_log_lines), n, "nothing dropped, nothing said");
    _logs_stop();
    return 0;
}

fn test_restore_no_easier_to_place() {
    test_group("restore_no_easier");
    # A requirement past the finite gate read back as 0 cores: a task that could never
    # run became one that fits anywhere, by going through a snapshot.
    var big = resource_req_new(f64_from(2000000000000000000), 1, REQ_NONE, 0, 0, 0);
    var inf = resource_req_new(0x7FF0000000000000, 1, REQ_NONE, 0, 0, 0);
    var node = make_node("n", f64_from(8), 8192);
    var a = scheduled_task_new(str_from("a"), str_from("d"), str_from("a"), 5, big);
    var b = scheduled_task_new(str_from("b"), str_from("d"), str_from("a"), 5, inf);
    assert_eq(node_capacity_can_fit(node, ScheduledTask_resource_requirements(a)), 0, "too big before");
    assert_eq(node_capacity_can_fit(node, ScheduledTask_resource_requirements(b)), 0, "+Inf too");
    var a2 = scheduled_task_from_json_str(scheduled_task_to_json_str(a));
    var b2 = scheduled_task_from_json_str(scheduled_task_to_json_str(b));
    assert_eq(node_capacity_can_fit(node, ScheduledTask_resource_requirements(a2)), 0, "too big after");
    assert_eq(node_capacity_can_fit(node, ScheduledTask_resource_requirements(b2)), 0, "+Inf after");
    # A negative requirement in a snapshot still clamps, and 1e400 cannot become 0.
    var wire = scheduled_task_from_json_str(_task_wrapping(
        "{\"cpu_cores\":1e400,\"memory_mb\":1,\"accel_req\":0,\"accel_min_chips\":0,\"network\":0,\"disk_mb\":0}"));
    assert_eq(node_capacity_can_fit(node, ScheduledTask_resource_requirements(wire)), 0, "an overflowing number stays too big");
    return 0;
}

fn test_constructors_share_the_restore_domain() {
    test_group("constructors_restore_domain");
    # What a constructor accepts should survive a round trip unchanged.
    var low = cron_task_template_new(str_from("t"), str_from("d"), str_from("a"), 0, resource_req_default());
    var high = cron_task_template_new(str_from("t"), str_from("d"), str_from("a"), 99, resource_req_default());
    var mid = cron_task_template_new(str_from("t"), str_from("d"), str_from("a"), 7, resource_req_default());
    assert_eq(CronTaskTemplate_priority(low), 1, "template priority floors at 1");
    assert_eq(CronTaskTemplate_priority(high), 10, "and tops out at 10");
    assert_eq(CronTaskTemplate_priority(mid), 7, "and leaves the rest alone");
    var job = training_job_template_new(str_from("m"), TM_LORA, str_from("d"), 0, 0 - 5, 0 - 6);
    assert_eq(TrainingJobTemplate_max_duration_secs(job), 0, "a negative duration is none");
    assert_eq(TrainingJobTemplate_checkpoint_interval_secs(job), 0, "a negative interval is none");

    # v1.4.5: a node, an entry, a requirement and a training job come back byte for byte.
    # Through 1.4.4 a node past 1e18 cores restored with none, a negative amount wrote
    # negative and read 0, and the others read back as something else.
    var most = f64_from(1000000000000000000);
    var big = node_capacity_new(str_from("big"), f64_from(2000000000000000000), 1, 1, 0);
    assert_eq(f64_eq(NodeCapacity_total_cpu(big), most), 1, "cores stop at 1e18");
    assert_eq(f64_eq(NodeCapacity_available_cpu(big), most), 1, "free ones too");
    _same_node_back(big, "the 1e18 node comes back");
    var neg = node_capacity_new(str_from("neg"), f64_from(0 - 4), 0 - 5, 0 - 6, 0);
    assert_eq(f64_eq(NodeCapacity_total_cpu(neg), f64_from(0)), 1, "negative cores are none");
    assert_eq(NodeCapacity_total_memory_mb(neg), 0, "negative memory is none");
    assert_eq(NodeCapacity_available_memory_mb(neg), 0, "free memory too");
    assert_eq(NodeCapacity_total_disk_mb(neg), 0, "negative disk is none");
    assert_eq(NodeCapacity_available_disk_mb(neg), 0, "free disk too");
    _same_node_back(neg, "the negative node comes back");
    var nan = node_capacity_new(str_from("nan"), 0x7FF8000000000000, 8, 8, 0);
    assert_eq(f64_eq(NodeCapacity_total_cpu(nan), f64_from(0)), 1, "NaN cores are none");
    _same_node_back(nan, "the NaN node comes back");
    var _o_t, _o_v = cron_expr_parse(str_from("0 3 * * *"));
    var odd = cron_entry_new(str_from("e"), result_unwrap(_o_t, _o_v),
      cron_task_template_new(str_from("t"), str_from("d"), str_from("a"), 5, resource_req_default()), 1, 7);
    assert_eq(CronEntry_missed_policy(odd), CRON_CATCHUP, "an unknown policy is catch-up, as it acts");
    var ejs = cron_entry_to_json_str(odd);
    assert_eq(str_eq(cron_entry_to_json_str(cron_entry_from_json_str(ejs)), ejs), 1, "the entry comes back");
    var net = resource_req_new(f64_from(1), 1, REQ_NONE, 0, 5, 0);
    assert_eq(ResourceReq_network(net), 1, "network is a flag");
    var rsb = str_builder_new();
    ResourceReq_to_json(net, rsb);
    var rjs = str_builder_build(rsb);
    var rsb2 = str_builder_new();
    ResourceReq_to_json(resource_req_from_json_str(rjs), rsb2);
    assert_eq(str_eq(str_builder_build(rsb2), rjs), 1, "the requirement comes back");
    var job99 = training_job_template_new(str_from("m"), 99, str_from("d"), 0, 0, 0);
    var tjs = training_job_template_to_json_str(job99);
    assert_eq(str_eq(training_job_template_to_json_str(training_job_template_from_json_str(tjs)), tjs), 1, "the job comes back");

    # An empty node id is refused where restore would drop it.
    var s = task_scheduler_new();
    _logs_start();
    assert_eq(task_scheduler_register_node(s, make_node("", f64_from(8), 8192)), 1, "an empty id is refused");
    assert_eq(_logged("an empty id"), 1, "and says so");
    _logs_stop();
    assert_eq(vec_len(map_values(TaskScheduler_nodes(s))), 0, "nothing was registered");
    assert_eq(task_scheduler_register_node(s, make_node("n", f64_from(8), 8192)), 0, "a real id still is");
    return 0;
}

fn _same_node_back(node, what) {
    var js = node_capacity_to_json_str(node);
    assert_eq(str_eq(node_capacity_to_json_str(node_capacity_from_json_str(js)), js), 1, what);
    return 0;
}

fn test_restore_owns_its_strs() {
    test_group("restore_owns_strs");
    # A tree parsed on an arena is reset the moment restore returns, and the next request
    # reuses the memory. Everything a restored object keeps has to be its own.
    var src = scheduled_task_to_json_str(make_task("t", 5));
    var s = task_scheduler_new();
    task_scheduler_register_node(s, make_node("node-one", f64_from(8), 8192));
    var t = make_task("t", 5);
    ScheduledTask_set_fail_reason(t, str_from("reason"));
    ScheduledTask_set_node_preference(t, str_from("node-one"));
    task_scheduler_submit_task(s, t);
    task_scheduler_schedule_pending(s);
    var js = task_scheduler_to_json_str(s);
    var a = arena_allocator(4194304);
    var v = bayan_json_v_parse_buf_a(a, str_data(js), str_len(js));
    var back = task_scheduler_from_jsonv(v);
    reset_via(a);
    var i = 0;
    while (i < 4) {
        bayan_json_v_parse_buf_a(a, str_data(src), str_len(src));
        i = i + 1;
    }
    assert_eq(str_eq(task_scheduler_to_json_str(back), js), 1, "the arena's reuse changes nothing");
    assert_eq(map_get(TaskScheduler_nodes(back), str_from("node-one")) != 0, 1, "and the node id still finds its node");
    return 0;
}

# --- v1.4.3: what the second mutation run showed the tests above still missed ---

fn test_accel_holds_many() {
    test_group("accel_holds_many");
    # Removing one hold from the middle must leave the rest exactly right.
    var n = _gpu_node("g", 3);
    var a = resource_req_new(f64_from(1), 1, REQ_GPU, 0, 0, 0);
    var b = resource_req_new(f64_from(1), 1, REQ_GPU, 0, 0, 0);
    var c = resource_req_new(f64_from(1), 1, REQ_GPU, 0, 0, 0);
    node_capacity_reserve(n, a);
    node_capacity_reserve(n, b);
    node_capacity_reserve(n, c);
    var used_b = 0;
    var i = 0;
    while (i < 6) {
        if (vec_get(NodeCapacity_accel_holds(n), i) == b) { used_b = vec_get(NodeCapacity_accel_holds(n), i + 1); }
        i = i + 2;
    }
    node_capacity_release(n, b);
    assert_eq(vec_len(NodeCapacity_accel_holds(n)), 4, "one pair gone");
    assert_eq(_accel_used_at(n, used_b), 0, "the profile b held is free");
    assert_eq(_accel_hold_from(n, a, 1, 0) >= 0, 1, "a is still held");
    assert_eq(_accel_hold_from(n, c, 1, 0) >= 0, 1, "c is still held");
    assert_eq(vec_get(NodeCapacity_accel_holds(n), _accel_hold_from(n, a, 1, 0)), a, "by a itself");
    assert_eq(vec_get(NodeCapacity_accel_holds(n), _accel_hold_from(n, c, 1, 0)), c, "and c itself");
    # Each hold must still name its own profile. Summing across profiles would hide a
    # hold that moved and kept the wrong one.
    var used_a = vec_get(NodeCapacity_accel_holds(n), _accel_hold_from(n, a, 1, 0) + 1);
    var used_c = vec_get(NodeCapacity_accel_holds(n), _accel_hold_from(n, c, 1, 0) + 1);
    assert_eq(used_a != used_c, 1, "a and c are on different devices");
    assert_eq(_accel_used_at(n, used_a), SAMAY_ACCEL_WHOLE, "a's device is held");
    assert_eq(_accel_used_at(n, used_c), SAMAY_ACCEL_WHOLE, "c's device is held");
    node_capacity_release(n, c);
    assert_eq(_accel_used_at(n, used_c), 0, "releasing c frees c's device");
    assert_eq(_accel_used_at(n, used_a), SAMAY_ACCEL_WHOLE, "and not a's");
    node_capacity_release(n, a);
    assert_eq(_accel_used_at(n, 0) + _accel_used_at(n, 1) + _accel_used_at(n, 2), 0, "all free");
    assert_eq(vec_len(NodeCapacity_accel_holds(n)), 0, "no record left");
    # A release with nothing held for it changes nothing.
    var none = make_node("c", f64_from(8), 8192);
    assert_eq(_accel_drop(none, a), 0, "no hold, no harm");
    assert_eq(vec_len(NodeCapacity_accel_holds(none)), 0, "and no record");
    # CPU-only work takes no device, even on a node that has them.
    var g = _gpu_node("g", 1);
    node_capacity_reserve(g, make_req(f64_from(1), 1));
    assert_eq(_accel_used_at(g, 0), 0, "REQ_NONE holds nothing");
    assert_eq(vec_len(NodeCapacity_accel_holds(g)), 0, "and records nothing");
    return 0;
}

fn test_accel_pick_order() {
    test_group("accel_pick_order");
    # ai-hwaccel's own order: best rank, then most memory, then the first listed.
    var big = 34359738368;
    var small = 8589934592;
    var n = make_node("g", f64_from(64), 524288);
    node_capacity_add_accel(n, profile_cuda(0, small));
    node_capacity_add_accel(n, profile_cuda(1, big));
    node_capacity_add_accel(n, profile_cuda(2, small));
    var gpu = resource_req_new(f64_from(1), 1, REQ_GPU, 0, 0, 0);
    assert_eq(_accel_pick(n, gpu, 1), 1, "most memory first");
    var req = resource_req_new(f64_from(1), 1, REQ_GPU, 0, 0, 0);
    node_capacity_reserve(n, req);
    assert_eq(_accel_used_at(n, 1), SAMAY_ACCEL_WHOLE, "and that is the one taken");
    assert_eq(_accel_pick(n, gpu, 1), 0, "then the first of the equals");
    node_capacity_reserve(n, resource_req_new(f64_from(1), 1, REQ_GPU, 0, 0, 0));
    assert_eq(_accel_pick(n, gpu, 1), 2, "then the last free one");
    node_capacity_reserve(n, resource_req_new(f64_from(1), 1, REQ_GPU, 0, 0, 0));
    assert_eq(_accel_pick(n, gpu, 1), 0 - 1, "none free");
    assert_eq(_accel_pick(n, gpu, 0), 1, "among the full ones, the same order");
    # Rank beats memory, in either listing order.
    var m = make_node("m", f64_from(64), 524288);
    node_capacity_add_accel(m, profile_tpu(0, 8, TPU_V5P));
    node_capacity_add_accel(m, profile_cuda(0, big));
    var want = 0;
    if (profile_rank(vec_get(NodeCapacity_accel_profiles(m), 1)) > profile_rank(vec_get(NodeCapacity_accel_profiles(m), 0))) { want = 1; }
    var any = resource_req_new(f64_from(1), 1, REQ_ANY_ACCELERATOR, 1, 0, 0);
    assert_eq(_accel_pick(m, any, 1), want, "the better rank");
    var r = make_node("r", f64_from(64), 524288);
    node_capacity_add_accel(r, profile_cuda(0, big));
    node_capacity_add_accel(r, profile_tpu(0, 8, TPU_V5P));
    assert_eq(_accel_pick(r, any, 1), 1 - want, "whichever is listed first");
    # A chip count of 0 still takes a chip, and a pod of 0 chips offers none.
    var pod = make_node("p", f64_from(64), 524288);
    node_capacity_add_accel(pod, profile_tpu(0, 2, TPU_V5P));
    node_capacity_reserve(pod, resource_req_new(f64_from(1), 1, REQ_TPU, 0, 0, 0));
    assert_eq(_accel_used_at(pod, 0), 1, "no chip count means one chip");
    node_capacity_reserve(pod, resource_req_new(f64_from(1), 1, REQ_TPU, 1, 0, 0));
    assert_eq(_accel_used_at(pod, 0), 2, "and exactly the last one fits");
    assert_eq(_accel_pick(pod, resource_req_new(f64_from(1), 1, REQ_TPU, 1, 0, 0), 1), 0 - 1, "then the pod is full");
    assert_eq(vec_len(NodeCapacity_accel_profiles(node_capacity_with_tpu(make_node("t", f64_from(8), 8192), 0))), 0, "no chips, no profile");
    assert_eq(vec_len(NodeCapacity_accel_profiles(node_capacity_with_tpu(make_node("t", f64_from(8), 8192), 1))), 1, "one chip is a profile");
    return 0;
}

fn test_restore_replays_in_placement_order() {
    test_group("restore_placement_order");
    # A node with one TPU pod of 8 chips and one GPU. `first` took all 8 chips, then
    # `any`, which takes the best free device, was left the GPU. Replaying `any` first
    # would put it on the TPU, and a restored node would offer the GPU while it runs.
    var s = task_scheduler_new();
    task_scheduler_register_node(s, node_capacity_add_accel(node_capacity_add_accel(
          make_node("m", f64_from(64), 524288), profile_tpu(0, 8, TPU_V5P)), profile_cuda(0, 17179869184)));
    var first = _accel_task("first", 9, REQ_TPU, 8);
    var any = _accel_task("any", 5, REQ_ANY_ACCELERATOR, 1);
    ScheduledTask_set_task_id(first, str_from("z-sorts-last"));
    ScheduledTask_set_task_id(any, str_from("a-sorts-first"));
    task_scheduler_submit_task(s, first);
    task_scheduler_submit_task(s, any);
    task_scheduler_schedule_pending(s);
    ScheduledTask_set_scheduled_at(first, 100);
    ScheduledTask_set_scheduled_at(any, 200);
    var back = task_scheduler_from_json_str(task_scheduler_to_json_str(s));
    var n = map_get(TaskScheduler_nodes(back), str_from("m"));
    assert_eq(node_capacity_can_fit(n, resource_req_new(f64_from(1), 1, REQ_GPU, 0, 0, 0)), 0, "the GPU is still taken");
    assert_eq(node_capacity_can_fit(n, resource_req_new(f64_from(1), 1, REQ_TPU, 1, 0, 0)), 0, "and so is every chip");
    # Placed together, the id decides, so the same snapshot restores the same way.
    var a2 = _det_task("b", 5, 1);
    var b2 = _det_task("a", 5, 1);
    assert_eq(_placement_cmp(a2, b2) > 0, 1, "ids break a tie");
    ScheduledTask_set_scheduled_at(a2, 1);
    ScheduledTask_set_scheduled_at(b2, 2);
    assert_eq(_placement_cmp(a2, b2) < 0, 1, "earlier first, whatever the id");
    assert_eq(_placement_cmp(b2, a2) > 0, 1, "either way round");
    return 0;
}

# `n` running tasks of one priority filling a node, created at 100, 101, ...
fn _tied_running(n) {
    var s = task_scheduler_new();
    task_scheduler_register_node(s, make_node("n", f64_from(n), 8192));
    var i = 0;
    while (i < n) {
        task_scheduler_submit_task(s, _det_task(str_cstr(_numbered("t-", i)), 2, 100 + i));
        i = i + 1;
    }
    var placed = task_scheduler_schedule_pending(s);
    i = 0;
    while (i < n) {
        scheduled_task_transition(task_scheduler_get_task(s, SchedulingDecision_task_id(vec_get(placed, i))), TASK_RUNNING);
        i = i + 1;
    }
    return s;
}

fn test_preempt_tie_breaks() {
    test_group("preempt_tie_breaks");
    # Equal priority: the newest goes, then the smallest id. Enough tasks that the
    # table's order, which changes per process, cannot land on the answer by luck.
    var act = task_scheduler_preempt_if_needed(_tied_running(32), make_task("hi", 10));
    assert_eq(str_eq(PreemptionAction_preempted_task_id(act), str_from("t-31")), 1, "the newest of equals");

    var ids = _tied_running(32);
    var all = map_values(TaskScheduler_tasks(ids));
    var i = 0;
    while (i < vec_len(all)) {
        ScheduledTask_set_created_at(vec_get(all, i), 7);
        i = i + 1;
    }
    var a3 = task_scheduler_preempt_if_needed(ids, make_task("hi", 10));
    assert_eq(str_eq(PreemptionAction_preempted_task_id(a3), str_from("t-0")), 1, "then the smallest id");

    var s2 = _tied_running(32);
    ScheduledTask_set_priority(task_scheduler_get_task(s2, str_from("t-5")), 1);
    var a2 = task_scheduler_preempt_if_needed(s2, make_task("hi", 10));
    assert_eq(str_eq(PreemptionAction_preempted_task_id(a2), str_from("t-5")), 1, "the lowest priority comes first");

    # A running task with no reservation, or on a node that has gone, frees nothing.
    var s3 = task_scheduler_new();
    task_scheduler_register_node(s3, make_node("n", f64_from(1), 8192));
    var loose = make_task("loose", 1);
    ScheduledTask_set_status(loose, TASK_RUNNING);
    task_scheduler_submit_task(s3, loose);
    var held = make_task("held", 1);
    task_scheduler_submit_task(s3, held);
    task_scheduler_schedule_pending(s3);
    scheduled_task_transition(held, TASK_RUNNING);
    ScheduledTask_set_reserved_on(held, str_from("gone"));
    assert_eq(task_scheduler_preempt_if_needed(s3, make_task("hi", 10)), 0, "neither would help");
    return 0;
}

fn test_decision_carries_score() {
    test_group("decision_score");
    var s = task_scheduler_new();
    task_scheduler_register_node(s, make_node("n", f64_from(4), 4096));
    task_scheduler_submit_task(s, scheduled_task_new(str_from("a"), str_from("d"), str_from("a"), 9, make_req(f64_from(2), 2048)));
    task_scheduler_submit_task(s, scheduled_task_new(str_from("b"), str_from("d"), str_from("a"), 1, make_req(f64_from(1), 1)));
    var ds = task_scheduler_schedule_pending(s);
    assert_eq(f64_eq(SchedulingDecision_score(vec_get(ds, 0)), f64_from(1)), 1, "an empty node scores 1");
    var half = f64_div(f64_from(1), f64_from(2));
    assert_eq(f64_eq(SchedulingDecision_score(vec_get(ds, 1)), half), 1, "a half-used one scores 0.5");
    return 0;
}

fn test_task_starts_queued_and_dated() {
    test_group("task_starts_dated");
    var before = dt_now();
    var t = make_task("t", 5);
    assert_eq(ScheduledTask_status(t), TASK_QUEUED, "queued");
    assert_eq(ScheduledTask_created_at(t) >= before, 1, "created_at is now");
    assert_eq(ScheduledTask_priority(make_task("low", 0)), 1, "priority floors at 1");
    assert_eq(ScheduledTask_priority(make_task("low", 1)), 1, "1 stays");
    assert_eq(ScheduledTask_priority(make_task("high", 10)), 10, "10 stays");
    assert_eq(ScheduledTask_priority(make_task("high", 11)), 10, "priority tops out at 10");
    assert_eq(task_priority_from_numeric(1), PRIO_NORMAL, "1 is normal");
    assert_eq(task_priority_from_numeric(3), PRIO_NORMAL, "3 is normal");
    return 0;
}

fn test_node_utilization_edges() {
    test_group("node_utilization_edges");
    var zero = node_capacity_new(str_from("z"), f64_from(0), 0, 0, 0);
    assert_eq(f64_eq(node_capacity_utilization(zero), f64_from(0)), 1, "a node of nothing is not busy");
    var cpu = node_capacity_new(str_from("c"), f64_from(4), 0, 0, 0);
    NodeCapacity_set_available_cpu(cpu, f64_from(2));
    var mem = node_capacity_new(str_from("m"), f64_from(0), 4096, 0, 0);
    NodeCapacity_set_available_memory_mb(mem, 1024);
    assert_eq(f64_to(f64_mul(node_capacity_utilization(cpu), f64_from(1000))) > 0, 1, "cpu alone counts");
    assert_eq(f64_to(f64_mul(node_capacity_utilization(mem), f64_from(1000))) > 0, 1, "memory alone counts");
    return 0;
}

fn test_logs_that_had_no_test() {
    test_group("logs_untested");
    var at = at_ns(2026, 7, 18, 12, 0);
    var c = mk_cron("* * * * *", CRON_SKIP);
    cron_scheduler_check_due_at(c, at);
    _logs_start();
    cron_scheduler_check_due_at(c, at - 120000000000);
    assert_eq(_logged("clock moved backwards; watermark held"), 1, "a small step back is logged");
    _logs_stop();
    # Disabling a very stale entry gives up only what the window can count.
    var stale = at - CRON_SCAN_WINDOW_SECS * 2000000000;
    var d = cron_scheduler_new();
    _fleet_add(d, 1, "d-", "0 0 * * *", CRON_CATCHUP, stale);
    CronEntry_set_enabled(vec_get(cron_scheduler_list_entries(d), 0), 0);
    _logs_start();
    cron_scheduler_check_due_at(d, at);
    assert_eq(_logged("missed occurrence(s) in the catch-up window"), 1, "and says that is what it counted");
    _logs_stop();
    # A profile ai-hwaccel refuses on restore costs a node capacity, so it is logged.
    var pod = node_capacity_add_accel(make_node("t", f64_from(8), 8192), profile_tpu(0, 8, TPU_V5P));
    var doc = str_builder_new();
    str_builder_add(doc, node_capacity_to_json_str(pod));
    var js = str_builder_build(doc);
    var cut = str_index_of_cstr(js, "\"tpu_chips\":");
    assert_eq(cut > 0, 1, "the profile names its chips");
    var sb = str_builder_new();
    str_builder_add(sb, str_new(str_data(js), cut));
    str_builder_add_cstr(sb, "\"tpu_chips\":99999999");
    var rest = cut + 13;
    str_builder_add(sb, str_new(str_data(js) + rest, str_len(js) - rest));
    _logs_start();
    var back = node_capacity_from_json_str(str_builder_build(sb));
    assert_eq(vec_len(NodeCapacity_accel_profiles(back)), 0, "the profile is refused");
    assert_eq(_logged("accelerator profile refused on restore"), 1, "and that is logged");
    _logs_stop();
    return 0;
}

fn test_training_deadline_paths() {
    test_group("training_deadline_paths");
    var none = training_job_to_scheduled_task(training_job_template_new(str_from("m"), TM_LORA, str_from("d"), 0, 0, 0), str_from("a"));
    assert_eq(ScheduledTask_deadline(none), 0, "no duration, no deadline");
    _logs_start();
    var huge = training_job_to_scheduled_task(training_job_template_new(str_from("m"), TM_LORA, str_from("d"), 0, 9223372036854775807, 0), str_from("a"));
    assert_eq(_logged("deadline"), 1, "a duration past the clock's range is logged");
    _logs_stop();
    assert_eq(ScheduledTask_deadline(huge) > dt_now(), 1, "and the deadline stays in the future");
    return 0;
}

# --- v1.4.3: what the final mutation run still found ---

fn test_restore_settles_many_nodes() {
    test_group("restore_settles_many_nodes");
    # A merge of two sorted lists, so it has to be tried at a size luck cannot pass:
    # the map's order changes per process, and a few records can land sorted by chance.
    var n = 64;
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"tasks\":[");
    var i = 0;
    while (i < n) {
        if (i > 0) { str_builder_add_cstr(sb, ","); }
        # Three tasks on each node, in an order that sorts differently from the nodes.
        var node = _numbered("node-", n - 1 - i);
        str_builder_add(sb, _snap_task(str_cstr(_numbered("t-", i)), TASK_RUNNING, 1, str_cstr(node), str_cstr(node)));
        str_builder_add_cstr(sb, ",");
        str_builder_add(sb, _snap_task(str_cstr(_numbered("u-", i)), TASK_RUNNING, 2, str_cstr(node), str_cstr(node)));
        str_builder_add_cstr(sb, ",");
        str_builder_add(sb, _snap_task(str_cstr(_numbered("v-", i)), TASK_RUNNING, 1, str_cstr(node), str_cstr(node)));
        i = i + 1;
    }
    str_builder_add_cstr(sb, "],\"nodes\":[");
    i = 0;
    while (i < n) {
        if (i > 0) { str_builder_add_cstr(sb, ","); }
        # The node's own figures are wrong on purpose, on every axis.
        str_builder_add_cstr(sb, "{\"node_id\":\"");
        str_builder_add(sb, _numbered("node-", i));
        str_builder_add_cstr(sb, "\",\"total_cpu\":8.0,\"available_cpu\":1.0,\"total_memory_mb\":8192,\"available_memory_mb\":1,\"total_disk_mb\":1000,\"available_disk_mb\":1,\"running_tasks\":9,\"accel_profiles\":[]}");
        i = i + 1;
    }
    str_builder_add_cstr(sb, "]}");
    var s = task_scheduler_from_json_str(str_builder_build(sb));
    var wrong = 0;
    i = 0;
    while (i < n) {
        var node2 = map_get(TaskScheduler_nodes(s), _numbered("node-", i));
        if (_cpu_milli(node2) != 4000) { wrong = wrong + 1; }
        if (NodeCapacity_available_memory_mb(node2) != 8192) { wrong = wrong + 1; }
        if (NodeCapacity_available_disk_mb(node2) != 1000) { wrong = wrong + 1; }
        if (NodeCapacity_running_tasks(node2) != 3) { wrong = wrong + 1; }
        i = i + 1;
    }
    assert_eq(wrong, 0, "every node carries exactly its own three tasks, on every axis");
    return 0;
}

fn test_cron_window_boundary() {
    test_group("cron_window_boundary");
    # Exactly a window behind is inside it: nothing is out of reach, so no clamp.
    var now_s = _chrono_ymd_to_epoch_secs(2026, 8, 30, 12, 0, 0);
    var _e_t, _e_v = cron_expr_parse(str_from("0 3 * * *"));
    var daily = result_unwrap(_e_t, _e_v);
    var clamped = 7;
    _cron_count_due(daily, now_s - CRON_SCAN_WINDOW_SECS - 60, now_s, &clamped);
    assert_eq(clamped, 0, "the last minute inside the window is not clamped");
    _cron_count_due(daily, now_s - CRON_SCAN_WINDOW_SECS - 120, now_s, &clamped);
    assert_eq(clamped, 1, "the minute before it is");

    # Exactly the cap owes nothing past it, so it is not called capped.
    var at = at_ns(2026, 7, 18, 12, 0);
    var c = cron_scheduler_new();
    _fleet_add(c, 1, "e-", "* * * * *", CRON_CATCHUP, at - CRON_CATCHUP_CAP * 60000000000);
    _logs_start();
    assert_eq(vec_len(cron_scheduler_check_due_at(c, at)), CRON_CATCHUP_CAP, "all of them fire");
    assert_eq(_logged("catch-up capped"), 0, "nothing was capped");
    assert_eq(_logged("catch-up policy fired 999 missed occurrence(s)"), 1, "and the one on time is not called missed");
    _logs_stop();
    return 0;
}

fn test_f64_is_finite() {
    test_group("f64_is_finite");
    assert_eq(_f64_is_finite(0x7FF8000000000000), 0, "NaN");
    assert_eq(_f64_is_finite(0x7FF0000000000000), 0, "+Inf");
    assert_eq(_f64_is_finite(0xFFF0000000000000), 0, "-Inf");
    assert_eq(_f64_is_finite(f64_from(8)), 1, "a real number");
    assert_eq(_f64_is_finite(f64_from(0 - 8)), 1, "a negative one");
    # NaN utilization must lose, or the tie-break never runs.
    var s = task_scheduler_new();
    var bad = make_node("a-bad", f64_from(8), 8192);
    NodeCapacity_set_available_cpu(bad, 0x7FF8000000000000);
    task_scheduler_register_node(s, bad);
    task_scheduler_register_node(s, make_node("z-good", f64_from(8), 8192));
    var req = make_req(f64_from(1), 1);
    assert_eq(str_eq(_best_fit_node(TaskScheduler_nodes(s), req), str_from("z-good")), 1, "a NaN node never wins");
    return 0;
}

# --- v1.4.5: what a document may cost (ADR-0014) ---

# An empty snapshot of exactly `n` bytes, padded by a key samay does not read.
fn _padded_snapshot(n) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"tasks\":[],\"nodes\":[],\"x\":\"");
    var i = 30;
    while (i < n) {
        str_builder_add_cstr(sb, "a");
        i = i + 1;
    }
    str_builder_add_cstr(sb, "\"}");
    return str_builder_build(sb);
}

# `n` empty arrays under a key samay does not read. Each costs about 196 bytes of tree
# for its 3 bytes of text.
fn _nested_junk(n) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"tasks\":[],\"nodes\":[],\"junk\":[[]");
    var i = 1;
    while (i < n) {
        str_builder_add_cstr(sb, ",[]");
        i = i + 1;
    }
    str_builder_add_cstr(sb, "]}");
    return str_builder_build(sb);
}

fn _chars(c, n) {
    var sb = str_builder_new();
    var i = 0;
    while (i < n) {
        str_builder_add_cstr(sb, c);
        i = i + 1;
    }
    return str_builder_build(sb);
}

fn test_json_byte_limit() {
    test_group("json_byte_limit");
    var keep = SAMAY_JSON_MAX_BYTES;
    SAMAY_JSON_MAX_BYTES = 300;
    var at = _padded_snapshot(300);
    assert_eq(str_len(at), 300, "the padding is exact");
    assert_eq(task_scheduler_from_json_str(at) != 0, 1, "a document at the limit is read");
    _logs_start();
    assert_eq(task_scheduler_from_json_str(_padded_snapshot(301)), 0, "one byte past it is refused");
    assert_eq(_logged("301 bytes, past the limit of 300"), 1, "and says so");
    _logs_stop();
    assert_eq(scheduled_task_from_json_str(_padded_snapshot(301)), 0, "by every reader");
    assert_eq(resource_req_from_json_str(_padded_snapshot(301)), 0, "the leaves too");

    # A writer refuses what no reader would take, at the same byte.
    var t0 = cron_task_template_new(str_from("n"), str_from(""), str_from("a"), 5, make_req(f64_from(1), 1));
    var base = str_len(cron_task_template_to_json_str(t0));
    SAMAY_JSON_MAX_BYTES = base + 50;
    var fits = cron_task_template_new(str_from("n"), _chars("d", 50), str_from("a"), 5, make_req(f64_from(1), 1));
    var out = cron_task_template_to_json_str(fits);
    assert_eq(out != 0, 1, "text at the limit is written");
    assert_eq(str_len(out), base + 50, "all of it");
    assert_eq(cron_task_template_from_json_str(out) != 0, 1, "and reads back");
    var over = cron_task_template_new(str_from("n"), _chars("d", 51), str_from("a"), 5, make_req(f64_from(1), 1));
    _logs_start();
    assert_eq(cron_task_template_to_json_str(over), 0, "one byte more is refused");
    assert_eq(_logged("past the limit of"), 1, "and says so");
    _logs_stop();

    # Far past the limit the build itself stops, on its budget, before it finishes.
    SAMAY_JSON_MAX_BYTES = 100;
    var huge = cron_task_template_new(str_from("n"), _chars("d", 5000), str_from("a"), 5, make_req(f64_from(1), 1));
    _logs_start();
    assert_eq(cron_task_template_to_json_str(huge), 0, "a build past its budget is refused");
    assert_eq(_logged("its text runs past the limit of 100 bytes"), 1, "and says so");
    _logs_stop();

    # Every writer: none of these fits in 10 bytes.
    SAMAY_JSON_MAX_BYTES = 10;
    var tmpl = cron_task_template_new(str_from("t"), str_from("d"), str_from("a"), 5, resource_req_default());
    var _e_t, _e_v = cron_expr_parse(str_from("0 3 * * *"));
    var entry = cron_entry_new(str_from("e"), result_unwrap(_e_t, _e_v), tmpl, 1, CRON_SKIP);
    var cs = cron_scheduler_new();
    cron_scheduler_add_entry(cs, entry);
    assert_eq(task_scheduler_to_json_str(task_scheduler_new()), 0, "scheduler");
    assert_eq(cron_scheduler_to_json_str(cs), 0, "cron scheduler");
    assert_eq(scheduled_task_to_json_str(make_task("t", 5)), 0, "task");
    assert_eq(node_capacity_to_json_str(make_node("n", f64_from(8), 8192)), 0, "node");
    _logs_start();
    assert_eq(node_capacity_to_json_str(_gpu_node("g", 1)), 0, "node with a device");
    _logs_stop();
    assert_eq(_logged("node 'g': accelerator profile omitted"), 1, "its profile's text is past the limit too");
    assert_eq(cron_entry_to_json_str(entry), 0, "entry");
    assert_eq(cron_task_template_to_json_str(tmpl), 0, "template");
    assert_eq(training_job_template_to_json_str(training_job_template_new(str_from("m"), TM_LORA, str_from("d"), 0, 0, 0)), 0, "training job");
    SAMAY_JSON_MAX_BYTES = keep;
    assert_eq(task_scheduler_to_json_str(task_scheduler_new()) != 0, 1, "and back at the default, they write");
    return 0;
}

fn test_json_expansion_limit() {
    test_group("json_expansion_limit");
    # A few empty arrays fit the 4 KiB every document gets.
    assert_eq(task_scheduler_from_json_str(_nested_junk(10)) != 0, 1, "a little junk is read past");
    # 3 KB of them would take about 200 KB: refused before the tree is built.
    var junk = _nested_junk(1000);
    _logs_start();
    assert_eq(task_scheduler_from_json_str(junk), 0, "text that parses to 65 times its size is refused");
    assert_eq(_logged("takes more than 10 times that"), 1, "and says so");
    _logs_stop();
    assert_eq(scheduled_task_from_json_str(junk), 0, "by every reader");
    assert_eq(scheduler_stats_from_json_str(junk), 0, "the leaves too");

    # What samay writes stays well inside: a real snapshot takes about 6 times its size.
    var s = task_scheduler_new();
    task_scheduler_register_node(s, make_node("n", f64_from(64), 524288));
    var i = 0;
    while (i < 200) {
        task_scheduler_submit_task(s, make_task("t", 5));
        i = i + 1;
    }
    task_scheduler_schedule_pending(s);
    var js = task_scheduler_to_json_str(s);
    var keep = SAMAY_JSON_MAX_EXPANSION;
    SAMAY_JSON_MAX_EXPANSION = 5;
    assert_eq(task_scheduler_from_json_str(js), 0, "the limit is enforced: 5 times is too few");
    SAMAY_JSON_MAX_EXPANSION = 8;
    assert_eq(task_scheduler_from_json_str(js) != 0, 1, "8 is enough");
    # Close to the worst shape samay writes: one-letter names, short numbers. This document
    # measures 6.5 times its text; the worst measured, with zeroed numbers, 7.2.
    var c = cron_scheduler_new();
    var e = 0;
    while (e < 300) {
        var t = cron_task_template_new(str_from("r"), str_from("d"), str_from("a"), 1, resource_req_new(f64_from(0), 0, 0, 0, 0, 0));
        cron_scheduler_add(c, _numbered("", e), str_from("30 2 * * 1-5"), t, 1, CRON_SKIP);
        e = e + 1;
    }
    var cjs = cron_scheduler_to_json_str(c);
    var back = cron_scheduler_from_json_str(cjs);
    assert_eq(back != 0, 1, "the worst honest shape reads back within 8");
    assert_eq(vec_len(map_values(CronScheduler_entries(back))), 300, "all of it");
    SAMAY_JSON_MAX_EXPANSION = keep;
    return 0;
}

fn test_json_budget_allocator() {
    test_group("json_budget_allocator");
    # Counted as alloc() takes it, rounded up to 8 (1.5.1): 36 is 40.
    var al = _budget(104);
    assert_eq(alloc_via(al, 64) != 0, 1, "within the budget");
    assert_eq(alloc_via(al, 36) != 0, 1, "up to it exactly");
    assert_eq(_budget_refused(al), 0, "nothing refused yet");
    assert_eq(alloc_via(al, 8), 0, "one past it is refused");
    assert_eq(_budget_refused(al), 1, "and remembered");
    var tiny = _budget(16);
    alloc_via(tiny, 1);
    alloc_via(tiny, 1);
    assert_eq(_budget_refused(tiny), 0, "two single bytes take 16");
    assert_eq(alloc_via(tiny, 1), 0, "and a third does not fit");
    # Past ALLOC_MAX plain alloc() answers 0 too, and bayan_json_v_build exits on it.
    # Here it is a refusal: the writer answers 0 and the process lives.
    var big = _budget(ALLOC_MAX * 4);
    assert_eq(alloc_via(big, ALLOC_MAX + 1), 0, "past ALLOC_MAX is refused");
    assert_eq(_budget_refused(big), 1, "as a refusal, not out of memory");
    var st = allocator_state(al);
    assert_eq(_budget_realloc(st, 0, 0, 8), 0, "a realloc is refused, not copied");
    assert_eq(_budget_free(st, 0), 0, "free does nothing");
    assert_eq(_budget_reset(st), 0, "reset does nothing");
    assert_eq(_budget_refused(al), 1, "and leaves the refusal standing");
    return 0;
}

# --- v1.5.1: a restore's tree is let go ---

fn test_restore_tree_mapped() {
    test_group("restore_tree_mapped");
    # The mapped allocator hands out its mapping in order, 8-aligned, within the budget.
    var held = _MAPS_HELD;
    var al = _budget_mapped(4096);
    var st = allocator_state(al);
    var base = load64(st + 24);
    assert_eq(base != 0, 1, "a mapping");
    assert_eq(_MAPS_HELD, held + 1, "counted while it is held");
    assert_eq(load64(st + 32), 4096, "of the budget, rounded to a page");
    var p = alloc_via(al, 5);
    var q = alloc_via(al, 8);
    assert_eq(p, base, "the first block at its start");
    assert_eq(q, base + 8, "the next 8-aligned after it");
    store64(q, 77);
    assert_eq(load64(q), 77, "and it is writable");
    assert_eq(alloc_via(al, 4096), 0, "past the budget is refused");
    var there = cyr_mprotect(base, 4096, 3);
    _budget_unmap(al);
    var gone = cyr_mprotect(base, 4096, 3);
    assert_eq(there, 0, "its pages are there while mapped");
    assert_eq(gone < 0, 1, "and gone once it is unmapped");
    assert_eq(load64(st + 24), 0, "unmapped once");
    assert_eq(_budget_unmap(al), 0, "and a second unmap does nothing");
    assert_eq(_MAPS_HELD, held, "so it is counted back once");
    var odd = _budget_mapped(5000);
    assert_eq(load64(allocator_state(odd) + 32), 8192, "a budget past a page takes two");
    _budget_unmap(odd);

    # A restore on the heap path and on the mapped path build the same scheduler.
    var s = task_scheduler_new();
    task_scheduler_register_node(s, _gpu_node("g", 2));
    var i = 0;
    while (i < 200) {
        task_scheduler_submit_task(s, make_task("t", 1 + i % 10));
        i = i + 1;
    }
    task_scheduler_schedule_pending(s);
    var doc = task_scheduler_to_json_str(s);
    _RESTORE_MAPPED = 0;
    var before = alloc_used();
    var heap = task_scheduler_from_json_str(doc);
    var grew_heap = alloc_used() - before;
    _RESTORE_MAPPED = 1;
    before = alloc_used();
    var mapped = task_scheduler_from_json_str(doc);
    var grew_mapped = alloc_used() - before;
    assert_eq(str_eq(task_scheduler_to_json_str(heap), doc), 1, "the heap path writes back what it read");
    assert_eq(str_eq(task_scheduler_to_json_str(mapped), doc), 1, "and so does the mapped one, its tree gone");
    # The tree was about six times the document; what stays is the scheduler.
    assert_eq(grew_heap > 5 * str_len(doc), 1, "on the heap the tree stays");
    assert_eq(grew_mapped < 2 * str_len(doc), 1, "mapped, only what was restored stays");
    # Every reader goes the same way, and a refused parse gives its mapping back too.
    assert_eq(task_scheduler_from_json_str(str_from("[[[[")), 0, "malformed is refused");
    assert_eq(scheduled_task_from_json_str(str_from("{}")), 0, "a record without its fields is refused");
    assert_eq(task_scheduler_from_json_str(0), 0, "and no text at all is no scheduler");
    assert_eq(_MAPS_HELD, 0, "no restore keeps its mapping, read or refused");
    return 0;
}

fn test_leaf_decoders_check() {
    test_group("leaf_decoders_check");
    # Each reads what the derive writes.
    var d = scheduling_decision_new(str_from("task-abc"), str_from("node-1"), str_from("best-fit selection"),
      f64_div(f64_from(2), f64_from(3)));
    var sb = str_builder_new();
    SchedulingDecision_to_json(d, sb);
    var d2 = scheduling_decision_from_json_str(str_builder_build(sb));
    assert_eq(d2 != 0, 1, "decision read");
    assert_eq(str_eq(SchedulingDecision_task_id(d2), str_from("task-abc")), 1, "its task");
    assert_eq(str_eq(SchedulingDecision_assigned_node(d2), str_from("node-1")), 1, "its node");
    assert_eq(str_eq(SchedulingDecision_reason(d2), str_from("best-fit selection")), 1, "its reason");
    assert_eq(SchedulingDecision_score(d2) == SchedulingDecision_score(d), 1, "its score, to the bit");
    var a = preemption_action_new(str_from("victim"), str_from("aggressor"), str_from("why"));
    var ab = str_builder_new();
    PreemptionAction_to_json(a, ab);
    var a2 = preemption_action_from_json_str(str_builder_build(ab));
    assert_eq(a2 != 0, 1, "action read");
    assert_eq(str_eq(PreemptionAction_preempted_task_id(a2), str_from("victim")), 1, "its victim");
    assert_eq(str_eq(PreemptionAction_preempting_task_id(a2), str_from("aggressor")), 1, "its cause");
    assert_eq(str_eq(PreemptionAction_reason(a2), str_from("why")), 1, "its reason");
    var st = scheduler_stats_new();
    SchedulerStats_set_total_tasks(st, 9);
    SchedulerStats_set_queued(st, 1);
    SchedulerStats_set_running(st, 2);
    SchedulerStats_set_completed(st, 3);
    SchedulerStats_set_failed(st, 4);
    SchedulerStats_set_average_wait_time_ms(st, 5);
    SchedulerStats_set_average_run_time_ms(st, 6);
    var stb = str_builder_new();
    SchedulerStats_to_json(st, stb);
    var st2 = scheduler_stats_from_json_str(str_builder_build(stb));
    assert_eq(st2 != 0, 1, "stats read");
    assert_eq(SchedulerStats_total_tasks(st2) + SchedulerStats_queued(st2) * 10 + SchedulerStats_running(st2) * 100
      + SchedulerStats_completed(st2) * 1000 + SchedulerStats_failed(st2) * 10000
      + SchedulerStats_average_wait_time_ms(st2) * 100000 + SchedulerStats_average_run_time_ms(st2) * 1000000,
      6543219, "every count in its place");
    var r = resource_req_new(f64_from(3), 512, REQ_GPU, 2, 1, 64);
    var rb = str_builder_new();
    ResourceReq_to_json(r, rb);
    var r2 = resource_req_from_json_str(str_builder_build(rb));
    assert_eq(r2 != 0, 1, "requirement read");
    assert_eq(f64_eq(ResourceReq_cpu_cores(r2), f64_from(3)), 1, "its cores");
    assert_eq(ResourceReq_memory_mb(r2) + ResourceReq_accel_req(r2) * 10000 + ResourceReq_accel_min_chips(r2) * 100000
      + ResourceReq_network(r2) * 1000000 + ResourceReq_disk_mb(r2) * 10000000,
      512 + REQ_GPU * 10000 + 200000 + 1000000 + 640000000, "and the rest, each in its place");
    var _c_t, _c_v = cron_expr_parse(str_from("30 2 * * 1-5"));
    var ce = result_unwrap(_c_t, _c_v);
    var cb = str_builder_new();
    CronExpr_to_json(ce, cb);
    var ce2 = cron_expr_from_json_str(str_builder_build(cb));
    assert_eq(ce2 != 0, 1, "expression read");
    assert_eq(CronExpr_minute_mask(ce2) == CronExpr_minute_mask(ce) && CronExpr_dow_mask(ce2) == CronExpr_dow_mask(ce), 1, "its masks");

    # And refuse what they cannot read. The derive's own reader gives `{}` null Strs.
    var bad = vec_new();
    vec_push(bad, str_from("{}"));
    vec_push(bad, str_from("[]"));
    vec_push(bad, str_from("5"));
    vec_push(bad, str_from("null"));
    vec_push(bad, str_from("\"x\""));
    vec_push(bad, str_from("{"));
    vec_push(bad, 0);
    var i = 0;
    var took = 0;
    while (i < vec_len(bad)) {
        var doc = vec_get(bad, i);
        took = took + (scheduling_decision_from_json_str(doc) != 0) + (preemption_action_from_json_str(doc) != 0)
        + (scheduler_stats_from_json_str(doc) != 0) + (resource_req_from_json_str(doc) != 0)
        + (cron_expr_from_json_str(doc) != 0);
        i = i + 1;
    }
    assert_eq(took, 0, "nothing shapeless is read");
    assert_eq(scheduling_decision_from_json_str(str_from("{\"task_id\":5,\"assigned_node\":\"n\",\"reason\":\"r\",\"score\":1.0}")), 0, "a number for a Str");
    assert_eq(scheduling_decision_from_json_str(str_from("{\"task_id\":\"t\",\"assigned_node\":\"n\",\"reason\":\"r\"}")), 0, "a missing score");
    assert_eq(scheduling_decision_from_json_str(str_from("{\"task_id\":\"t\",\"assigned_node\":\"n\",\"reason\":\"r\",\"score\":\"1\"}")), 0, "a Str for a score");
    assert_eq(scheduling_decision_from_json_str(str_from("{\"task_id\":\"t\",\"reason\":\"r\",\"score\":1.0}")), 0, "a missing node");
    assert_eq(scheduling_decision_from_json_str(str_from("{\"task_id\":\"t\",\"assigned_node\":\"n\",\"score\":1.0}")), 0, "a missing reason");
    assert_eq(preemption_action_from_json_str(str_from("{\"preempted_task_id\":\"v\",\"reason\":\"r\"}")), 0, "a missing cause");
    assert_eq(preemption_action_from_json_str(str_from("{\"preempted_task_id\":\"v\",\"preempting_task_id\":\"p\"}")), 0, "an action without its reason");
    assert_eq(scheduler_stats_from_json_str(str_from("{\"total_tasks\":1,\"queued\":0,\"running\":0,\"completed\":0,\"failed\":0,\"average_wait_time_ms\":0}")), 0, "a missing count");
    assert_eq(scheduler_stats_from_json_str(str_from("{\"total_tasks\":1,\"queued\":0,\"running\":0,\"completed\":0,\"failed\":\"0\",\"average_wait_time_ms\":0,\"average_run_time_ms\":0}")), 0, "a Str for a count");
    assert_eq(resource_req_from_json_str(str_from("{\"memory_mb\":1}")), 0, "a requirement without cores");
    assert_eq(cron_expr_from_json_str(str_from("{\"minute_mask\":1}")), 0, "an expression without its masks");
    return 0;
}

# --- v1.4.6: what a pass already knows fits nowhere ---

var _kp = 0;

fn _known_node(s, id, cpu, mem, disk) {
    var n = node_capacity_new(str_from(id), cpu, mem, disk, 0);
    task_scheduler_register_node(s, n);
    return n;
}

# Queue a task asking for exactly `req`, after every task queued so far.
# scheduled_task_new clamps its copy, so the raw fields go back on afterwards.
fn _known_task(s, req, pref) {
    var t = scheduled_task_new(str_from("k"), str_from("d"), str_from("a"), 5, req);
    var own = ScheduledTask_resource_requirements(t);
    ResourceReq_set_cpu_cores(own, ResourceReq_cpu_cores(req));
    ResourceReq_set_memory_mb(own, ResourceReq_memory_mb(req));
    ResourceReq_set_accel_min_chips(own, ResourceReq_accel_min_chips(req));
    ResourceReq_set_disk_mb(own, ResourceReq_disk_mb(req));
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "k");
    str_builder_add_int(sb, 1000 + _kp);
    ScheduledTask_set_task_id(t, str_builder_build(sb));
    ScheduledTask_set_created_at(t, 1000 + _kp);
    _kp = _kp + 1;
    if (pref != 0) { ScheduledTask_set_requested_node(t, str_from(pref)); }
    task_scheduler_submit_task(s, t);
    return t;
}

fn _rqd(cpu, mem, disk) {
    return resource_req_new(cpu, mem, REQ_NONE, 0, 0, disk);
}

# 1 if the task was placed on `id`, or, with `id` 0, if it was placed nowhere.
fn _went(t, id) {
    var a = ScheduledTask_assigned_node(t);
    if (id == 0) { return a == 0; }
    if (a == 0) { return 0; }
    return str_eq(a, str_from(id));
}

fn test_known_shapes() {
    test_group("known_shapes");
    var x = resource_req_new(f64_from(4), 4096, REQ_TPU, 2, 0, 500);
    assert_eq(_same_shape(x, resource_req_clone(x)), 1, "a copy is the same shape");
    var y = resource_req_clone(x);
    ResourceReq_set_cpu_cores(y, f64_from(5));
    assert_eq(_same_shape(x, y), 0, "more cores is another shape");
    y = resource_req_clone(x);
    ResourceReq_set_memory_mb(y, 4095);
    assert_eq(_same_shape(x, y), 0, "less memory is another shape");
    y = resource_req_clone(x);
    ResourceReq_set_accel_req(y, REQ_GPU);
    assert_eq(_same_shape(x, y), 0, "another device is another shape");
    y = resource_req_clone(x);
    ResourceReq_set_accel_min_chips(y, 3);
    assert_eq(_same_shape(x, y), 0, "more chips is another shape");
    y = resource_req_clone(x);
    ResourceReq_set_disk_mb(y, 501);
    assert_eq(_same_shape(x, y), 0, "more disk is another shape");
    y = resource_req_clone(x);
    ResourceReq_set_network(y, 1);
    assert_eq(_same_shape(x, y), 1, "network is not something can_fit reads");
    var zero = _rqd(f64_from(0), 1, 0);
    var minus = _rqd(f64_from(0), 1, 0);
    ResourceReq_set_cpu_cores(minus, f64_sub(f64_from(0), f64_from(0)));
    assert_eq(_same_shape(zero, minus), 1, "0 and -0 cores are one shape");
    assert_eq(_shape_slot(zero), _shape_slot(minus), "and start in one place");
    var nan = _rqd(f64_from(0), 1, 0);
    ResourceReq_set_cpu_cores(nan, f64_div(f64_from(0), f64_from(0)));
    assert_eq(_same_shape(nan, nan), 0, "NaN cores are no shape at all");
    # Shapes spread across the slots, so a few in a queue rarely share a probe.
    var seen[1024];
    memset(&seen, 0, 1024);
    var spread = 0;
    var wild = 0;
    var i = 0;
    while (i < 1000) {
        var at = _shape_slot(_rqd(f64_from(1 + i % 7), 1024 + i, 100 * (i % 3)));
        if (at < 0) { wild = wild + 1; }
        elif (at > 1023) { wild = wild + 1; }
        elif (load8(&seen + at) == 0) {
            store8(&seen + at, 1);
            spread = spread + 1;
        }
        i = i + 1;
    }
    assert_eq(wild, 0, "every shape starts inside the record");
    assert_eq(spread > 550, 1, "a thousand shapes start in most of the slots");
    return 0;
}

fn test_known_record() {
    test_group("known_record");
    var s = task_scheduler_new();
    _known_node(s, "a", f64_from(8), 1024, 300);
    _known_node(s, "b", f64_from(2), 8192, 100);
    var known[8224];
    _known_reset(&known, TaskScheduler_nodes(s));
    assert_eq(f64_eq(load64(&known + _KNOWN_CPU), f64_from(8)), 1, "the most cores free on one node");
    assert_eq(load64(&known + _KNOWN_MEM), 8192, "the most memory");
    assert_eq(load64(&known + _KNOWN_DISK), 300, "the most disk");
    assert_eq(load64(&known + _KNOWN_COUNT), 0, "and nothing recorded");
    assert_eq(_known_unfit(&known, _rqd(f64_from(8), 8192, 300)), 0, "the most of each is not refused");
    assert_eq(_known_unfit(&known, _rqd(f64_div(f64_from(33), f64_from(4)), 1, 0)), 1, "more cores than any node is");
    assert_eq(_known_unfit(&known, _rqd(f64_from(1), 8193, 0)), 1, "so is more memory");
    assert_eq(_known_unfit(&known, _rqd(f64_from(1), 1, 301)), 1, "and more disk");
    var x = _rqd(f64_from(4), 4096, 0);
    assert_eq(_known_unfit(&known, x), 0, "a shape inside the limits is not known yet");
    _known_add(&known, x);
    assert_eq(load64(&known + _KNOWN_COUNT), 1, "recording counts it");
    assert_eq(_known_unfit(&known, x), 1, "then it is");
    assert_eq(_known_unfit(&known, _rqd(f64_from(4), 4096, 0)), 1, "and so is an equal one");
    assert_eq(_known_unfit(&known, _rqd(f64_from(4), 4095, 0)), 0, "a neighbour is not");
    _known_reset(&known, TaskScheduler_nodes(s));
    assert_eq(_known_unfit(&known, x), 0, "a reset forgets it");
    assert_eq(load64(&known + _KNOWN_COUNT), 0, "and the count");

    # A node with NaN cores free lets any number past can_fit, so the limit does too.
    var c = _known_node(s, "c", f64_from(1), 1, 1);
    NodeCapacity_set_available_cpu(c, f64_div(f64_from(0), f64_from(0)));
    _known_reset(&known, TaskScheduler_nodes(s));
    assert_eq(_known_unfit(&known, _rqd(f64_from(1000), 1, 0)), 0, "a NaN node lifts the cpu limit");
    assert_eq(_known_unfit(&known, _rqd(f64_from(1), 8193, 0)), 1, "and no other");
    _known_reset(&known, TaskScheduler_nodes(task_scheduler_new()));
    assert_eq(_known_unfit(&known, _rqd(f64_from(1000000), 1099511627776, 1099511627776)), 0,
      "no nodes measures no limit, and the walk finds nothing anyway");

    # The record fills to half, then stops: past that, shapes are walked as before.
    _known_reset(&known, TaskScheduler_nodes(s));
    var first = _rqd(f64_from(1), 1, 0);
    _known_add(&known, first);
    var last = 0;
    var i = 1;
    while (i < 600) {
        last = _rqd(f64_from(1), 1 + i, 0);
        _known_add(&known, last);
        i = i + 1;
    }
    assert_eq(load64(&known + _KNOWN_COUNT), 512, "the record keeps 512 shapes");
    assert_eq(_known_unfit(&known, first), 1, "the first is still known");
    assert_eq(_known_unfit(&known, last), 0, "the 600th was not kept");

    # Two shapes that start in the last slot: the second wraps to the first.
    var at_end = vec_new();
    var m = 1;
    while (vec_len(at_end) < 2) {
        var r = _rqd(f64_from(1), m, 0);
        if (_shape_slot(r) == 1023) { vec_push(at_end, r); }
        m = m + 1;
    }
    _known_reset(&known, TaskScheduler_nodes(s));
    _known_add(&known, vec_get(at_end, 0));
    _known_add(&known, vec_get(at_end, 1));
    assert_eq(load64(&known), vec_get(at_end, 1), "a full last slot wraps to slot 0");
    assert_eq(_known_unfit(&known, vec_get(at_end, 1)), 1, "and is found there");

    # Two shapes that start in the same even slot: the second goes in the next.
    var firsts[8192];
    memset(&firsts, 0, 8192);
    var one = 0;
    var two = 0;
    m = 1;
    while (two == 0) {
        var cand = _rqd(f64_from(1), m, 0);
        var at = _shape_slot(cand);
        if (at % 2 == 0) {
            if (at < 1022) {
                if (load64(&firsts + at * 8) == 0) { store64(&firsts + at * 8, cand); }
                else {
                    one = load64(&firsts + at * 8);
                    two = cand;
                }
            }
        }
        m = m + 1;
    }
    _known_reset(&known, TaskScheduler_nodes(s));
    _known_add(&known, one);
    assert_eq(_known_unfit(&known, two), 0, "a shape sharing a start is not taken for it");
    _known_add(&known, two);
    assert_eq(load64(&known + (_shape_slot(two) + 1) * 8), two, "it goes in the next slot");
    assert_eq(_known_unfit(&known, two), 1, "and is found there");
    assert_eq(_known_unfit(&known, one), 1, "and the first still is");

    # Every field moves a shape's start, so shapes differing in one rarely share a probe.
    var spread = 0;
    var k = 0;
    var last_at = 0 - 1;
    while (k < 7) {
        var at2 = _shape_slot(resource_req_new(f64_from(1), 1024, k, 0, 0, 0));
        if (at2 != last_at) { spread = spread + 1; }
        last_at = at2;
        k = k + 1;
    }
    assert_eq(spread, 7, "each accelerator starts somewhere else");
    spread = 0;
    last_at = 0 - 1;
    k = 0;
    while (k < 64) {
        var at3 = _shape_slot(resource_req_new(f64_from(1), 1024, REQ_TPU, k, 0, 0));
        if (at3 != last_at) { spread = spread + 1; }
        last_at = at3;
        k = k + 1;
    }
    assert_eq(spread, 64, "so does each chip count");
    spread = 0;
    last_at = 0 - 1;
    k = 0;
    while (k < 64) {
        var at4 = _shape_slot(_rqd(f64_from(1), 1024, k));
        if (at4 != last_at) { spread = spread + 1; }
        last_at = at4;
        k = k + 1;
    }
    assert_eq(spread, 64, "and each amount of disk");
    spread = 0;
    last_at = 0 - 1;
    k = 1;
    while (k <= 64) {
        var at5 = _shape_slot(resource_req_with_devices(resource_req_new(f64_from(1), 1024, REQ_GPU, 0, 0, 0), k));
        if (at5 != last_at) { spread = spread + 1; }
        last_at = at5;
        k = k + 1;
    }
    assert_eq(spread, 64, "and each device count");
    spread = 0;
    last_at = 0 - 1;
    k = 1;
    while (k <= 64) {
        var at6 = _shape_slot(resource_req_with_share(resource_req_new(f64_from(1), 1024, REQ_GPU, 0, 0, 0), k));
        if (at6 != last_at) { spread = spread + 1; }
        last_at = at6;
        k = k + 1;
    }
    assert_eq(spread, 64, "and each share");

    # The limits come from every node, wherever the table put it: each of 32 in turn
    # holds the most.
    var many = task_scheduler_new();
    var nodes = vec_new();
    k = 0;
    while (k < 32) {
        var sb = str_builder_new();
        str_builder_add_cstr(sb, "m");
        str_builder_add_int(sb, k);
        var nd = node_capacity_new(str_builder_build(sb), f64_from(1), 1, 1, 0);
        task_scheduler_register_node(many, nd);
        vec_push(nodes, nd);
        k = k + 1;
    }
    var missed = 0;
    k = 0;
    while (k < 32) {
        var big = vec_get(nodes, k);
        NodeCapacity_set_available_cpu(big, f64_from(100));
        NodeCapacity_set_available_memory_mb(big, 100);
        NodeCapacity_set_available_disk_mb(big, 100);
        _known_reset(&known, TaskScheduler_nodes(many));
        if (f64_eq(load64(&known + _KNOWN_CPU), f64_from(100)) == 0) { missed = missed + 1; }
        if (load64(&known + _KNOWN_MEM) != 100) { missed = missed + 1; }
        if (load64(&known + _KNOWN_DISK) != 100) { missed = missed + 1; }
        NodeCapacity_set_available_cpu(big, f64_from(1));
        NodeCapacity_set_available_memory_mb(big, 1);
        NodeCapacity_set_available_disk_mb(big, 1);
        k = k + 1;
    }
    assert_eq(missed, 0, "every node is measured");
    return 0;
}

fn test_reserve_grew() {
    test_group("reserve_grew");
    # Taking only some of what a node has is not growth, even with nothing of the rest.
    var n = node_capacity_new(str_from("g"), f64_from(8), 4096, 1000, 0);
    assert_eq(_reserve_grew(n, _rqd(f64_from(1), 0, 0)), 0, "cores alone");
    assert_eq(_reserve_grew(n, _rqd(f64_from(0), 1024, 0)), 0, "memory alone");
    assert_eq(_reserve_grew(n, _rqd(f64_from(0), 0, 100)), 0, "disk alone");
    var gpu = node_capacity_new(str_from("gpu"), f64_from(8), 4096, 0, 0);
    node_capacity_add_accel(gpu, profile_cuda(0, 17179869184));
    assert_eq(_reserve_grew(gpu, resource_req_new(f64_from(1), 0, REQ_GPU, 0, 0, 0)), 0, "a device");
    # Each way setters can give capacity back.
    var r = _rqd(f64_from(1), 0, 0);
    ResourceReq_set_memory_mb(r, 0 - 1);
    assert_eq(_reserve_grew(n, r), 1, "negative memory gives memory back");
    r = _rqd(f64_from(1), 0, 0);
    ResourceReq_set_disk_mb(r, 0 - 1);
    assert_eq(_reserve_grew(n, r), 1, "negative disk gives disk back");
    r = _rqd(f64_from(0), 0, 0);
    ResourceReq_set_cpu_cores(r, f64_from(0 - 1));
    assert_eq(_reserve_grew(n, r), 1, "negative cores give cores back");
    var low = node_capacity_new(str_from("low"), f64_from(8), 4096, 0, 0);
    NodeCapacity_set_available_cpu(low, f64_div(f64_from(0 - 1), f64_from(10000000000)));
    assert_eq(_reserve_grew(low, _rqd(f64_from(0), 0, 0)), 1, "a node below zero rounds up to it");
    var pod = node_capacity_new(str_from("pod"), f64_from(8), 4096, 0, 0);
    node_capacity_add_accel(pod, profile_tpu(0, 0 - 3, TPU_V4));
    assert_eq(_reserve_grew(pod, resource_req_new(f64_from(1), 0, REQ_GPU_OR_TPU, 2, 0, 0)), 1,
      "a pod with fewer than no chips gives devices back");
    # Devices in use are summed over every profile.
    var three = node_capacity_new(str_from("three"), f64_from(8), 4096, 0, 0);
    var k = 0;
    while (k < 3) {
        node_capacity_add_accel(three, profile_cuda(k, 17179869184));
        node_capacity_reserve(three, resource_req_new(f64_from(1), 0, REQ_GPU, 0, 0, 0));
        k = k + 1;
    }
    assert_eq(_accel_in_use(three), 3 * SAMAY_ACCEL_WHOLE, "three GPUs, three in use");
    return 0;
}

fn test_schedule_skips_soundly() {
    test_group("schedule_skips_soundly");
    # A shape inside every limit that fits nowhere, then one field less, which fits.
    var s = task_scheduler_new();
    _known_node(s, "a", f64_from(8), 1024, 10000);
    _known_node(s, "b", f64_from(1), 8192, 10000);
    var t1 = _known_task(s, _rqd(f64_from(4), 4096, 0), 0);
    var t2 = _known_task(s, _rqd(f64_from(4), 1024, 0), 0);
    var t3 = _known_task(s, _rqd(f64_div(f64_from(1), f64_from(2)), 4096, 0), 0);
    task_scheduler_schedule_pending(s);
    assert_eq(_went(t1, 0), 1, "the shape fits nowhere");
    assert_eq(_went(t2, "a"), 1, "less memory fits");
    assert_eq(_went(t3, "b"), 1, "fewer cores fits");

    s = task_scheduler_new();
    _known_node(s, "a", f64_from(8), 1024, 1000);
    _known_node(s, "b", f64_from(1), 8192, 9000);
    t1 = _known_task(s, _rqd(f64_from(4), 1024, 5000), 0);
    t2 = _known_task(s, _rqd(f64_from(4), 1024, 500), 0);
    task_scheduler_schedule_pending(s);
    assert_eq(_went(t1, 0) + _went(t2, "a"), 2, "less disk fits");

    s = task_scheduler_new();
    node_capacity_add_accel(_known_node(s, "a", f64_from(8), 8192, 0), profile_tpu(0, 4, TPU_V5P));
    node_capacity_add_accel(_known_node(s, "b", f64_from(8), 8192, 0), profile_cuda(0, 17179869184));
    t1 = _known_task(s, resource_req_new(f64_from(1), 1024, REQ_TPU, 8, 0, 0), 0);
    t2 = _known_task(s, resource_req_new(f64_from(1), 1024, REQ_TPU, 2, 0, 0), 0);
    t3 = _known_task(s, resource_req_new(f64_from(1), 1024, REQ_GAUDI, 0, 0, 0), 0);
    var t4 = _known_task(s, resource_req_new(f64_from(1), 1024, REQ_GPU, 0, 0, 0), 0);
    task_scheduler_schedule_pending(s);
    assert_eq(_went(t1, 0) + _went(t2, "a"), 2, "fewer chips fits");
    assert_eq(_went(t3, 0) + _went(t4, "b"), 2, "another device fits");

    # A placement that gives capacity back: setters can build one, constructors
    # cannot. What fit nowhere before it can fit after, through the record or a limit.
    var i = 0;
    while (i < 6) {
        s = task_scheduler_new();
        var g = _rqd(f64_from(1), 0, 0);
        var x = 0;
        if (i < 2) {
            _known_node(s, "a", f64_from(8), 1024, 0);
            if (i == 0) { _known_node(s, "b", f64_from(0), 8192, 0); }
            x = _rqd(f64_from(1), 2048, 0);
            ResourceReq_set_memory_mb(g, 0 - 4096);
        } elif (i < 4) {
            _known_node(s, "a", f64_from(1), 8192, 0);
            if (i == 2) { _known_node(s, "b", f64_from(8), 512, 0); }
            x = _rqd(f64_from(4), 1024, 0);
            ResourceReq_set_cpu_cores(g, f64_from(0 - 8));
        } else {
            _known_node(s, "a", f64_from(8), 8192, 1000);
            if (i == 4) { _known_node(s, "b", f64_from(8), 512, 9000); }
            x = _rqd(f64_from(1), 1024, 5000);
            ResourceReq_set_disk_mb(g, 0 - 9000);
        }
        t1 = _known_task(s, x, 0);
        t2 = _known_task(s, g, "a");
        t3 = _known_task(s, resource_req_clone(x), 0);
        task_scheduler_schedule_pending(s);
        assert_eq(_went(t1, 0) + _went(t2, "a"), 2, "nothing fits until capacity comes back");
        assert_eq(_went(t3, "a"), 1, "then the same shape does");
        i = i + 1;
    }

    # A pod with fewer than no chips: a GPU-or-TPU request for two takes -3 of it.
    s = task_scheduler_new();
    node_capacity_add_accel(_known_node(s, "a", f64_from(8), 8192, 0), profile_tpu(0, 0 - 3, TPU_V4));
    t1 = _known_task(s, resource_req_new(f64_from(1), 1024, REQ_GPU_OR_TPU, 0, 0, 0), 0);
    t2 = _known_task(s, resource_req_new(f64_from(1), 1024, REQ_GPU_OR_TPU, 2, 0, 0), 0);
    t3 = _known_task(s, resource_req_new(f64_from(1), 1024, REQ_GPU_OR_TPU, 2, 0, 0), 0);
    t4 = _known_task(s, resource_req_new(f64_from(1), 1024, REQ_GPU_OR_TPU, 0, 0, 0), 0);
    task_scheduler_schedule_pending(s);
    assert_eq(_went(t1, 0), 1, "no room on the pod");
    assert_eq(_went(t2, "a") + _went(t3, "a"), 2, "until two requests give devices back");
    assert_eq(_went(t4, "a"), 1, "then the same request fits");

    # A node a hair below zero cores: placing none on it rounds it up to zero.
    s = task_scheduler_new();
    var a = _known_node(s, "a", f64_from(8), 8192, 0);
    NodeCapacity_set_available_cpu(a, f64_div(f64_from(0 - 1), f64_from(10000000000)));
    var nano = f64_div(f64_from(1), f64_from(1000000000));
    t1 = _known_task(s, _rqd(nano, 0, 0), 0);
    t2 = _known_task(s, _rqd(f64_from(0), 0, 0), 0);
    t3 = _known_task(s, _rqd(nano, 0, 0), 0);
    task_scheduler_schedule_pending(s);
    assert_eq(_went(t1, 0) + _went(t2, "a"), 2, "a billionth of a core is short of it");
    assert_eq(_went(t3, "a"), 1, "until the node rounds up to zero");

    s = task_scheduler_new();
    a = _known_node(s, "a", f64_from(8), 1024, 0);
    NodeCapacity_set_available_cpu(a, f64_div(f64_from(0), f64_from(0)));
    t1 = _known_task(s, _rqd(f64_from(100), 512, 0), 0);
    _known_node(s, "b", f64_from(8), 1024, 700);
    t2 = _known_task(s, _rqd(f64_from(8), 1024, 700), 0);
    task_scheduler_schedule_pending(s);
    assert_eq(_went(t1, "a"), 1, "a NaN node takes any number of cores, as can_fit says");
    assert_eq(_went(t2, "b"), 1, "and a task asking for all of a node gets it");

    # More shapes than the record keeps, each twice: every one is still refused and
    # logged, and what fits after them is placed.
    s = task_scheduler_new();
    _known_node(s, "a", f64_from(8), 4096, 0);
    _known_node(s, "b", f64_from(1), 65536, 0);
    i = 0;
    while (i < 1200) {
        _known_task(s, _rqd(f64_from(2), 8192 + i % 600, 0), 0);
        i = i + 1;
    }
    t1 = _known_task(s, _rqd(f64_from(2), 4096, 0), 0);
    _logs_start();
    var ds = task_scheduler_schedule_pending(s);
    _logs_stop();
    assert_eq(vec_len(ds), 1, "1,200 refused");
    assert_eq(_logged("no node with sufficient capacity"), 1200, "each logged, as before");
    assert_eq(_went(t1, "a"), 1, "and the one that fits is placed");

    # The record is the pass's own: capacity back between passes is seen.
    s = task_scheduler_new();
    _known_node(s, "a", f64_from(4), 8192, 0);
    t1 = _known_task(s, _rqd(f64_from(4), 1024, 0), 0);
    t2 = _known_task(s, _rqd(f64_from(4), 1024, 0), 0);
    task_scheduler_schedule_pending(s);
    assert_eq(_went(t1, "a") + _went(t2, 0), 2, "one node, one task");
    task_scheduler_cancel_task(s, ScheduledTask_task_id(t1));
    task_scheduler_schedule_pending(s);
    assert_eq(_went(t2, "a"), 1, "the next pass tries the shape again");
    return 0;
}

# --- v1.5.0: several devices, or a share of one (ADR-0016) ---

fn _gpu_req(cpu) {
    return resource_req_new(f64_from(cpu), 1, REQ_GPU, 0, 0, 0);
}

fn _req_task(name, prio, req) {
    return scheduled_task_new(str_from(name), str_from("d"), str_from("a"), prio, req);
}

fn test_req_devices_and_share() {
    test_group("req_devices_and_share");
    var r = _gpu_req(1);
    assert_eq(ResourceReq_accel_devices(r), 1, "one device by default");
    assert_eq(ResourceReq_accel_share(r), SAMAY_ACCEL_WHOLE, "all of it");
    assert_eq(SAMAY_ACCEL_WHOLE, 1000, "counted in thousandths");
    assert_eq(resource_req_with_devices(r, 4), r, "chainable");
    assert_eq(ResourceReq_accel_devices(r), 4, "four devices");
    assert_eq(ResourceReq_accel_share(r), SAMAY_ACCEL_WHOLE, "each whole");
    assert_eq(resource_req_with_share(r, 250), r, "chainable too");
    assert_eq(ResourceReq_accel_share(r), 250, "a quarter");
    assert_eq(ResourceReq_accel_devices(r), 1, "of one device: the last call wins");
    resource_req_with_devices(r, 2);
    assert_eq(ResourceReq_accel_share(r), SAMAY_ACCEL_WHOLE, "and devices replace a share");
    resource_req_with_devices(r, 0);
    assert_eq(ResourceReq_accel_devices(r), 1, "fewer than one is one");
    resource_req_with_devices(r, 0 - 5);
    assert_eq(ResourceReq_accel_devices(r), 1, "so is a negative count");
    resource_req_with_share(r, 0);
    assert_eq(ResourceReq_accel_share(r), SAMAY_ACCEL_WHOLE, "a share of nothing is the whole device");
    resource_req_with_share(r, 0 - 1);
    assert_eq(ResourceReq_accel_share(r), SAMAY_ACCEL_WHOLE, "and of less than nothing");
    resource_req_with_share(r, 1001);
    assert_eq(ResourceReq_accel_share(r), SAMAY_ACCEL_WHOLE, "and of more than one");
    resource_req_with_share(r, 999);
    assert_eq(ResourceReq_accel_share(r), 999, "999 thousandths is a share");
    resource_req_with_share(r, 1);
    assert_eq(ResourceReq_accel_share(r), 1, "and so is one");
    # A copy carries both, as placement reads them.
    var c = resource_req_clone(resource_req_with_devices(_gpu_req(1), 3));
    assert_eq(ResourceReq_accel_devices(c), 3, "a copy keeps the count");
    c = resource_req_clone(resource_req_with_share(_gpu_req(1), 400));
    assert_eq(ResourceReq_accel_share(c), 400, "and the share");
    var raw = _gpu_req(1);
    ResourceReq_set_accel_devices(raw, 4);
    ResourceReq_set_accel_share(raw, 500);
    c = resource_req_clone(raw);
    assert_eq(ResourceReq_accel_devices(c), 1, "a share set beside a count is of one device");
    assert_eq(ResourceReq_accel_share(c), 500, "and keeps the share");
    # Zeros, as setters and the derive's decoder leave them, read as one whole device.
    ResourceReq_set_accel_devices(raw, 0);
    ResourceReq_set_accel_share(raw, 0);
    assert_eq(_req_devices(raw), 1, "no count is one device");
    assert_eq(_req_share(raw), SAMAY_ACCEL_WHOLE, "no share is all of it");
    ResourceReq_set_accel_share(raw, 2000);
    assert_eq(_req_share(raw), SAMAY_ACCEL_WHOLE, "a share past whole is whole");
    ResourceReq_set_accel_devices(raw, 3);
    ResourceReq_set_accel_share(raw, SAMAY_ACCEL_WHOLE);
    assert_eq(_req_devices(raw), 3, "a count of whole devices stands");
    var t = _req_task("t", 5, resource_req_with_devices(_gpu_req(1), 2));
    assert_eq(ResourceReq_accel_devices(ScheduledTask_resource_requirements(t)), 2, "a task keeps its count");
    return 0;
}

fn test_accel_shares() {
    test_group("accel_shares");
    var n = _gpu_node("g", 1);
    var a = resource_req_with_share(_gpu_req(1), 500);
    var b = resource_req_with_share(_gpu_req(1), 500);
    assert_eq(node_capacity_can_fit(n, a), 1, "half a GPU fits");
    node_capacity_reserve(n, a);
    assert_eq(_accel_used_at(n, 0), 500, "and takes half");
    assert_eq(node_capacity_can_fit(n, _gpu_req(1)), 0, "a whole GPU no longer fits");
    assert_eq(node_capacity_can_fit(n, b), 1, "the other half does");
    node_capacity_reserve(n, b);
    assert_eq(node_capacity_can_fit(n, resource_req_with_share(_gpu_req(1), 1)), 0, "then not a thousandth more");
    node_capacity_release(n, a);
    assert_eq(_accel_used_at(n, 0), 500, "a release gives back its own half");
    assert_eq(node_capacity_can_fit(n, _gpu_req(1)), 0, "so the device is still shared");
    node_capacity_release(n, b);
    assert_eq(node_capacity_can_fit(n, _gpu_req(1)), 1, "then whole again");
    node_capacity_reserve(n, resource_req_with_share(_gpu_req(1), 999));
    assert_eq(node_capacity_can_fit(n, resource_req_with_share(_gpu_req(1), 1)), 1, "999 and 1 make a device");
    assert_eq(node_capacity_can_fit(n, resource_req_with_share(_gpu_req(1), 2)), 0, "999 and 2 do not");

    # A share joins a device already shared, so a whole one stays whole.
    var two = _gpu_node("two", 2);
    node_capacity_reserve(two, resource_req_with_share(_gpu_req(1), 300));
    var first = 0;
    if (_accel_used_at(two, 1) > 0) { first = 1; }
    node_capacity_reserve(two, resource_req_with_share(_gpu_req(1), 300));
    assert_eq(_accel_used_at(two, first), 600, "the second share joins the first");
    assert_eq(_accel_used_at(two, 1 - first), 0, "the other device stays whole");
    assert_eq(node_capacity_can_fit(two, _gpu_req(1)), 1, "so a whole GPU still fits");
    # Untouched devices go by ai-hwaccel's ranking, but a shared one comes first.
    var mixed = make_node("mixed", f64_from(64), 524288);
    node_capacity_add_accel(mixed, profile_cuda(0, 8589934592));
    node_capacity_add_accel(mixed, profile_cuda(1, 34359738368));
    var whole = _gpu_req(1);
    node_capacity_reserve(mixed, whole);
    assert_eq(_accel_used_at(mixed, 1), SAMAY_ACCEL_WHOLE, "a whole GPU takes the bigger");
    node_capacity_reserve(mixed, resource_req_with_share(_gpu_req(1), 100));
    assert_eq(_accel_used_at(mixed, 0), 100, "a share takes what is left");
    node_capacity_release(mixed, whole);
    node_capacity_reserve(mixed, resource_req_with_share(_gpu_req(1), 100));
    assert_eq(_accel_used_at(mixed, 0), 200, "the next share joins it, not the bigger whole one");
    assert_eq(_accel_used_at(mixed, 1), 0, "which stays whole");
    var fresh = make_node("fresh", f64_from(64), 524288);
    node_capacity_add_accel(fresh, profile_cuda(0, 8589934592));
    node_capacity_add_accel(fresh, profile_cuda(1, 34359738368));
    node_capacity_reserve(fresh, resource_req_with_share(_gpu_req(1), 100));
    assert_eq(_accel_used_at(fresh, 1), 100, "among untouched ones, the bigger first");
    return 0;
}

fn test_accel_devices() {
    test_group("accel_devices");
    var n = _gpu_node("g", 4);
    var four = resource_req_with_devices(_gpu_req(1), 4);
    assert_eq(node_capacity_can_fit(n, four), 1, "four GPUs fit on four");
    assert_eq(node_capacity_can_fit(n, resource_req_with_devices(_gpu_req(1), 5)), 0, "five do not");
    node_capacity_reserve(n, four);
    assert_eq(vec_len(NodeCapacity_accel_holds(n)), 8, "one hold per device");
    var k = 0;
    var each = 0;
    while (k < 4) {
        if (_accel_used_at(n, k) == SAMAY_ACCEL_WHOLE) { each = each + 1; }
        k = k + 1;
    }
    assert_eq(each, 4, "four different devices, not one four times");
    assert_eq(node_capacity_can_fit(n, _gpu_req(1)), 0, "none left");
    node_capacity_release(n, four);
    assert_eq(_accel_in_use(n) + vec_len(NodeCapacity_accel_holds(n)), 0, "a release gives back all four");

    var three = _gpu_node("three", 3);
    node_capacity_reserve(three, resource_req_with_devices(_gpu_req(1), 2));
    assert_eq(node_capacity_can_fit(three, resource_req_with_devices(_gpu_req(1), 2)), 0, "two do not fit on one free");
    assert_eq(node_capacity_can_fit(three, _gpu_req(1)), 1, "one does");

    # Several devices take the best, by ai-hwaccel's ranking.
    var ranked = make_node("ranked", f64_from(64), 524288);
    node_capacity_add_accel(ranked, profile_cuda(0, 8589934592));
    node_capacity_add_accel(ranked, profile_cuda(1, 34359738368));
    node_capacity_add_accel(ranked, profile_cuda(2, 17179869184));
    node_capacity_reserve(ranked, resource_req_with_devices(_gpu_req(1), 2));
    assert_eq(_accel_used_at(ranked, 0), 0, "the smallest is left");
    assert_eq(_accel_used_at(ranked, 1) + _accel_used_at(ranked, 2), 2 * SAMAY_ACCEL_WHOLE, "the two biggest are taken");

    # A caller's equal copy gives back as many as the request took.
    var copied = _gpu_node("copy", 2);
    var pair = resource_req_with_devices(_gpu_req(1), 2);
    node_capacity_reserve(copied, pair);
    node_capacity_release(copied, resource_req_clone(pair));
    assert_eq(_accel_in_use(copied), 0, "an equal copy releases both");
    # It never takes another task's hold: with one of its own left, only that goes.
    var own = _gpu_node("own", 3);
    var other = resource_req_with_devices(_gpu_req(1), 2);
    node_capacity_reserve(own, other);
    var mine = _gpu_req(1);
    node_capacity_reserve(own, mine);
    node_capacity_release(own, mine);
    assert_eq(_accel_in_use(own), 2 * SAMAY_ACCEL_WHOLE, "a release of one leaves the other task's two");

    # A replayed hold with too few free counts the rest past capacity, elsewhere.
    var over = _gpu_node("over", 2);
    node_capacity_reserve(over, _gpu_req(1));
    var taken = 0;
    if (_accel_used_at(over, 1) > 0) { taken = 1; }
    var both = resource_req_with_devices(_gpu_req(1), 2);
    node_capacity_reserve(over, both);
    assert_eq(_accel_used_at(over, taken), 2 * SAMAY_ACCEL_WHOLE, "the full device is counted twice");
    assert_eq(_accel_used_at(over, 1 - taken), SAMAY_ACCEL_WHOLE, "and the free one once");
    node_capacity_release(over, both);
    assert_eq(_accel_in_use(over), SAMAY_ACCEL_WHOLE, "a release takes back exactly those two");

    # A pod is one device, and gives chips.
    var pods = make_node("pods", f64_from(64), 524288);
    node_capacity_add_accel(pods, profile_tpu(0, 8, TPU_V5P));
    var two_pods = resource_req_with_devices(resource_req_new(f64_from(1), 1, REQ_TPU, 4, 0, 0), 2);
    assert_eq(node_capacity_can_fit(pods, two_pods), 0, "one pod is not two devices");
    node_capacity_add_accel(pods, profile_tpu(1, 8, TPU_V5P));
    assert_eq(node_capacity_can_fit(pods, two_pods), 1, "two pods are");
    node_capacity_reserve(pods, two_pods);
    assert_eq(_accel_used_at(pods, 0) + _accel_used_at(pods, 1), 8, "four chips of each");
    var pod = make_node("pod", f64_from(64), 524288);
    node_capacity_add_accel(pod, profile_tpu(0, 8, TPU_V5P));
    node_capacity_reserve(pod, resource_req_with_share(resource_req_new(f64_from(1), 1, REQ_GPU_OR_TPU, 2, 0, 0), 500));
    assert_eq(_accel_used_at(pod, 0), 2, "a share does nothing on a pod: it takes chips");
    return 0;
}

fn test_accel_devices_place_and_preempt() {
    test_group("accel_devices_place_and_preempt");
    # A four-GPU task goes where four are free, even onto the busier node.
    var s = task_scheduler_new();
    task_scheduler_register_node(s, _gpu_node("a-two", 2));
    var b = _gpu_node("b-four", 4);
    node_capacity_reserve(b, make_req(f64_from(32), 1));
    task_scheduler_register_node(s, b);
    var t = _req_task("four", 5, resource_req_with_devices(_gpu_req(1), 4));
    task_scheduler_submit_task(s, t);
    task_scheduler_schedule_pending(s);
    assert_eq(_went(t, "b-four"), 1, "four GPUs go where there are four");

    # Two half-GPU tasks share one GPU, and a third waits.
    var h = task_scheduler_new();
    task_scheduler_register_node(h, _gpu_node("g", 1));
    var i = 0;
    while (i < 3) {
        task_scheduler_submit_task(h, _req_task("half", 5, resource_req_with_share(_gpu_req(1), 500)));
        i = i + 1;
    }
    assert_eq(vec_len(task_scheduler_schedule_pending(h)), 2, "two halves share a GPU");
    assert_eq(vec_len(task_scheduler_pending_tasks(h)), 1, "the third waits");

    # A running two-GPU task is a victim for a queued two-GPU task.
    var p = task_scheduler_new();
    task_scheduler_register_node(p, _gpu_node("g", 2));
    var low = _req_task("low", 1, resource_req_with_devices(_gpu_req(1), 2));
    task_scheduler_submit_task(p, low);
    task_scheduler_schedule_pending(p);
    scheduled_task_transition(low, TASK_RUNNING);
    var high = _req_task("high", 10, resource_req_with_devices(_gpu_req(1), 2));
    task_scheduler_submit_task(p, high);
    var act = task_scheduler_preempt_if_needed(p, high);
    assert_eq(act != 0, 1, "stopping it frees both");
    if (act != 0) {
        assert_eq(str_eq(PreemptionAction_preempted_task_id(act), ScheduledTask_task_id(low)), 1, "and it is named");
    }
    assert_eq(_accel_in_use(map_get(TaskScheduler_nodes(p), str_from("g"))), 2 * SAMAY_ACCEL_WHOLE, "asking changed nothing");

    # Two one-GPU tasks are not one victim.
    var q = task_scheduler_new();
    task_scheduler_register_node(q, _gpu_node("g", 2));
    i = 0;
    while (i < 2) {
        var one = _req_task("one", 1, _gpu_req(1));
        task_scheduler_submit_task(q, one);
        task_scheduler_schedule_pending(q);
        scheduled_task_transition(one, TASK_RUNNING);
        i = i + 1;
    }
    var big = _req_task("big", 10, resource_req_with_devices(_gpu_req(1), 2));
    task_scheduler_submit_task(q, big);
    assert_eq(task_scheduler_preempt_if_needed(q, big), 0, "one victim has to be enough");

    # A restore replays a multi-device hold and a share on as many devices.
    var r = task_scheduler_from_json_str(task_scheduler_to_json_str(s));
    assert_eq(_accel_in_use(map_get(TaskScheduler_nodes(r), str_from("b-four"))), 4 * SAMAY_ACCEL_WHOLE, "four held after a restore");
    var hr = task_scheduler_from_json_str(task_scheduler_to_json_str(h));
    assert_eq(_accel_in_use(map_get(TaskScheduler_nodes(hr), str_from("g"))), SAMAY_ACCEL_WHOLE, "two halves held after a restore");
    assert_eq(vec_len(task_scheduler_schedule_pending(hr)), 0, "and the third still waits");
    return 0;
}

fn test_accel_wire() {
    test_group("accel_wire");
    # One whole device writes what 1.4.6 wrote.
    var plain = _gpu_req(1);
    assert_eq(str_eq(bayan_json_v_build(_rr_node(plain)),
        str_from("{\"cpu_cores\":1.0,\"memory_mb\":1,\"accel_req\":1,\"accel_min_chips\":0,\"network\":0,\"disk_mb\":0}")), 1,
      "no new keys for one whole device");
    var four = resource_req_with_devices(_gpu_req(1), 4);
    assert_eq(str_contains(bayan_json_v_build(_rr_node(four)), str_from(",\"disk_mb\":0,\"accel_devices\":4,\"accel_share\":1000}")), 1,
      "a count writes both, after disk_mb");
    # Each field round trips on its own.
    var back = resource_req_from_json_str(bayan_json_v_build(_rr_node(four)));
    assert_eq(ResourceReq_accel_devices(back), 4, "accel_devices round trips");
    back = resource_req_from_json_str(bayan_json_v_build(_rr_node(resource_req_with_share(_gpu_req(1), 250))));
    assert_eq(ResourceReq_accel_share(back), 250, "accel_share round trips");
    assert_eq(ResourceReq_accel_devices(back), 1, "with one device");
    # The derive writes both always, and its text reads back too.
    back = resource_req_from_json_str(_req_derive_text(four));
    assert_eq(ResourceReq_accel_devices(back), 4, "the derive's text reads");
    # Text from before 1.5.0 reads as one whole device.
    back = resource_req_from_json_str(str_from("{\"cpu_cores\":1.0,\"memory_mb\":1,\"accel_req\":1,\"accel_min_chips\":0,\"network\":0,\"disk_mb\":0}"));
    assert_eq(ResourceReq_accel_devices(back) * 10000 + ResourceReq_accel_share(back), 11000, "old text is one whole device");
    # Restore settles them as the constructors do.
    var base = "{\"cpu_cores\":1.0,\"memory_mb\":1,\"accel_req\":1,\"accel_min_chips\":0,\"network\":0,\"disk_mb\":0,";
    var sb = str_builder_new();
    str_builder_add_cstr(sb, base);
    str_builder_add_cstr(sb, "\"accel_devices\":4,\"accel_share\":500}");
    back = resource_req_from_json_str(str_builder_build(sb));
    assert_eq(ResourceReq_accel_devices(back) * 10000 + ResourceReq_accel_share(back), 10500, "a share beside a count is of one device");
    sb = str_builder_new();
    str_builder_add_cstr(sb, base);
    str_builder_add_cstr(sb, "\"accel_devices\":0,\"accel_share\":0}");
    back = resource_req_from_json_str(str_builder_build(sb));
    assert_eq(ResourceReq_accel_devices(back) * 10000 + ResourceReq_accel_share(back), 11000, "zeros are one whole device");
    sb = str_builder_new();
    str_builder_add_cstr(sb, base);
    str_builder_add_cstr(sb, "\"accel_devices\":-3,\"accel_share\":5000}");
    back = resource_req_from_json_str(str_builder_build(sb));
    assert_eq(ResourceReq_accel_devices(back) * 10000 + ResourceReq_accel_share(back), 11000, "out of range settles");
    sb = str_builder_new();
    str_builder_add_cstr(sb, base);
    str_builder_add_cstr(sb, "\"accel_devices\":\"4\"}");
    assert_eq(resource_req_from_json_str(str_builder_build(sb)), 0, "a Str for a count is refused");
    sb = str_builder_new();
    str_builder_add_cstr(sb, base);
    str_builder_add_cstr(sb, "\"accel_share\":[500]}");
    assert_eq(resource_req_from_json_str(str_builder_build(sb)), 0, "an array for a share is refused");
    # Inside a task, through a whole snapshot.
    var s = task_scheduler_new();
    var t = _req_task("t", 5, resource_req_with_share(_gpu_req(1), 750));
    task_scheduler_submit_task(s, t);
    var r = task_scheduler_from_json_str(task_scheduler_to_json_str(s));
    var rt = task_scheduler_get_task(r, ScheduledTask_task_id(t));
    assert_eq(ResourceReq_accel_share(ScheduledTask_resource_requirements(rt)), 750, "a task's share survives a snapshot");
    assert_eq(str_eq(task_scheduler_to_json_str(r), task_scheduler_to_json_str(s)), 1, "and writes back byte for byte");
    return 0;
}

# --- v1.5.0: CPU work goes to accelerator nodes last (ADR-0017) ---

fn test_cpu_work_avoids_accel_nodes() {
    test_group("cpu_work_avoids_accel_nodes");
    # Both idle: the GPU node's id sorts first, and through 1.4.6 that decided it.
    var s = task_scheduler_new();
    task_scheduler_register_node(s, _gpu_node("a-gpu", 1));
    task_scheduler_register_node(s, make_node("b-cpu", f64_from(64), 524288));
    var t = make_task("t", 5);
    task_scheduler_submit_task(s, t);
    task_scheduler_schedule_pending(s);
    assert_eq(_went(t, "b-cpu"), 1, "a tie goes to the CPU node");
    # The GPU node emptier: still the CPU node.
    var e = task_scheduler_new();
    task_scheduler_register_node(e, _gpu_node("a-gpu", 1));
    var busy = make_node("b-cpu", f64_from(64), 524288);
    node_capacity_reserve(busy, make_req(f64_from(48), 1));
    task_scheduler_register_node(e, busy);
    t = make_task("t", 5);
    task_scheduler_submit_task(e, t);
    task_scheduler_schedule_pending(e);
    assert_eq(_went(t, "b-cpu"), 1, "a busier CPU node beats an idle GPU node");
    # No CPU node fits: the GPU node takes it rather than leave it waiting.
    var f = task_scheduler_new();
    task_scheduler_register_node(f, _gpu_node("a-gpu", 1));
    task_scheduler_register_node(f, make_node("b-cpu", f64_from(1), 1024));
    t = _req_task("big", 5, make_req(f64_from(8), 4096));
    task_scheduler_submit_task(f, t);
    task_scheduler_schedule_pending(f);
    assert_eq(_went(t, "a-gpu"), 1, "an accelerator node when nothing else fits");
    # Accelerator work and a requested node are as before.
    var g = task_scheduler_new();
    task_scheduler_register_node(g, _gpu_node("b-gpu", 1));
    task_scheduler_register_node(g, make_node("a-cpu", f64_from(64), 524288));
    var gt = _accel_task("gpu", 5, REQ_GPU, 0);
    task_scheduler_submit_task(g, gt);
    var asked = make_task("asked", 5);
    ScheduledTask_set_requested_node(asked, str_from("b-gpu"));
    task_scheduler_submit_task(g, asked);
    task_scheduler_schedule_pending(g);
    assert_eq(_went(gt, "b-gpu"), 1, "GPU work goes to the GPU");
    assert_eq(_went(asked, "b-gpu"), 1, "and a task that asks for a node gets it");
    # A CPU profile is not an accelerator.
    var c = task_scheduler_new();
    task_scheduler_register_node(c, node_capacity_add_accel(make_node("a-cpu-profile", f64_from(64), 524288), profile_cpu(1073741824)));
    task_scheduler_register_node(c, make_node("b-plain", f64_from(64), 524288));
    t = make_task("t", 5);
    task_scheduler_submit_task(c, t);
    task_scheduler_schedule_pending(c);
    assert_eq(_went(t, "a-cpu-profile"), 1, "a node with only a CPU profile ranks as a CPU node");
    # Among 32 of each, every CPU task lands on a CPU node until they are full.
    var m = task_scheduler_new();
    var i = 0;
    while (i < 32) {
        var sb = str_builder_new();
        str_builder_add_cstr(sb, "gpu-");
        str_builder_add_int(sb, i);
        task_scheduler_register_node(m, node_capacity_add_accel(node_capacity_new(str_builder_build(sb), f64_from(4), 8192, 1024, 0),
            profile_cuda(0, 17179869184)));
        var sc = str_builder_new();
        str_builder_add_cstr(sc, "cpu-");
        str_builder_add_int(sc, i);
        task_scheduler_register_node(m, node_capacity_new(str_builder_build(sc), f64_from(4), 8192, 1024, 0));
        i = i + 1;
    }
    i = 0;
    var tasks = vec_new();
    while (i < 64) {
        var w = _req_task("w", 5, make_req(f64_from(2), 1024));
        task_scheduler_submit_task(m, w);
        vec_push(tasks, w);
        i = i + 1;
    }
    var on_cpu = 0;
    task_scheduler_schedule_pending(m);
    i = 0;
    while (i < 64) {
        var a = ScheduledTask_assigned_node(vec_get(tasks, i));
        if (a != 0) {
            if (str_starts_with(a, str_from("cpu-")) == 1) { on_cpu = on_cpu + 1; }
        }
        i = i + 1;
    }
    assert_eq(on_cpu, 64, "64 two-core tasks fill 32 four-core CPU nodes first");
    return 0;
}

fn _hold_profile(n, req) {
    var holds = NodeCapacity_accel_holds(n);
    var i = 0;
    while (i < vec_len(holds)) {
        if (vec_get(holds, i) == req) { return vec_get(holds, i + 1); }
        i = i + 2;
    }
    return 0 - 1;
}

fn test_accel_hold_edges() {
    test_group("accel_hold_edges");
    # A replayed two-GPU hold on a node whose four GPUs are all taken: two more, on
    # two different devices, the first two by rank.
    var full = _gpu_node("full", 4);
    var k = 0;
    while (k < 4) {
        node_capacity_reserve(full, _gpu_req(1));
        k = k + 1;
    }
    node_capacity_reserve(full, resource_req_with_devices(_gpu_req(1), 2));
    assert_eq(_accel_in_use(full), 6 * SAMAY_ACCEL_WHOLE, "two more past capacity, no more and no fewer");
    assert_eq(_accel_used_at(full, 0), 2 * SAMAY_ACCEL_WHOLE, "the first by rank");
    assert_eq(_accel_used_at(full, 1), 2 * SAMAY_ACCEL_WHOLE, "and the next, not the first again");
    assert_eq(_accel_used_at(full, 2) + _accel_used_at(full, 3), 2 * SAMAY_ACCEL_WHOLE, "the rest as they were");

    # Too few free, and the full one ranks last: the free ones are still taken.
    var last = make_node("last", f64_from(64), 524288);
    node_capacity_add_accel(last, profile_cuda(0, 8589934592));
    node_capacity_add_accel(last, profile_cuda(1, 34359738368));
    node_capacity_add_accel(last, profile_cuda(2, 17179869184));
    var r1 = _gpu_req(1);
    var r2 = _gpu_req(1);
    node_capacity_reserve(last, r1);
    node_capacity_reserve(last, r2);
    node_capacity_reserve(last, _gpu_req(1));
    node_capacity_release(last, r1);
    node_capacity_release(last, r2);
    node_capacity_reserve(last, resource_req_with_devices(_gpu_req(1), 3));
    assert_eq(_accel_used_at(last, 0), 2 * SAMAY_ACCEL_WHOLE, "the smallest, full, is counted again");
    assert_eq(_accel_used_at(last, 1) + _accel_used_at(last, 2), 2 * SAMAY_ACCEL_WHOLE, "and both free ones taken");

    # A whole request goes by rank even when a pod is partly taken: packing is for shares.
    var pods = make_node("pods", f64_from(64), 524288);
    node_capacity_add_accel(pods, profile_tpu(0, 8, TPU_V5P));
    node_capacity_add_accel(pods, profile_tpu(1, 16, TPU_V5P));
    var all16 = resource_req_new(f64_from(1), 1, REQ_TPU, 16, 0, 0);
    node_capacity_reserve(pods, all16);
    node_capacity_reserve(pods, resource_req_new(f64_from(1), 1, REQ_TPU, 4, 0, 0));
    node_capacity_release(pods, all16);
    node_capacity_reserve(pods, resource_req_new(f64_from(1), 1, REQ_TPU, 2, 0, 0));
    assert_eq(_accel_used_at(pods, 1), 2, "the bigger pod, untouched");
    assert_eq(_accel_used_at(pods, 0), 4, "not the one partly taken");

    # Shares, with the shared device listed after an untouched bigger one.
    var after = make_node("after", f64_from(64), 524288);
    node_capacity_add_accel(after, profile_cuda(0, 34359738368));
    node_capacity_add_accel(after, profile_cuda(1, 8589934592));
    var whole = _gpu_req(1);
    node_capacity_reserve(after, whole);
    node_capacity_reserve(after, resource_req_with_share(_gpu_req(1), 100));
    node_capacity_release(after, whole);
    node_capacity_reserve(after, resource_req_with_share(_gpu_req(1), 100));
    assert_eq(_accel_used_at(after, 1), 200, "a share joins the shared device listed later");
    assert_eq(_accel_used_at(after, 0), 0, "and leaves the bigger one whole");
    var first = make_node("first", f64_from(64), 524288);
    node_capacity_add_accel(first, profile_cuda(0, 34359738368));
    node_capacity_add_accel(first, profile_cuda(1, 8589934592));
    node_capacity_reserve(first, resource_req_with_share(_gpu_req(1), 100));
    assert_eq(_accel_used_at(first, 0), 100, "untouched devices: the bigger, listed first");

    # A caller's equal copy releases one request's worth, never another task's.
    var eq = _gpu_node("eq", 2);
    node_capacity_reserve(eq, _gpu_req(1));
    var a = _gpu_req(1);
    node_capacity_reserve(eq, a);
    node_capacity_release(eq, resource_req_clone(a));
    assert_eq(_accel_in_use(eq), SAMAY_ACCEL_WHOLE, "one equal hold released, not both");
    # Each field of the request decides which holds are equal.
    var sh = _gpu_node("sh", 2);
    node_capacity_reserve(sh, _gpu_req(1));
    var half = resource_req_with_share(_gpu_req(1), 500);
    node_capacity_reserve(sh, half);
    node_capacity_release(sh, resource_req_clone(half));
    assert_eq(_accel_in_use(sh), SAMAY_ACCEL_WHOLE, "a share's copy does not release a whole device");
    var dv = _gpu_node("dv", 3);
    node_capacity_reserve(dv, resource_req_with_devices(_gpu_req(1), 2));
    var one = _gpu_req(1);
    node_capacity_reserve(dv, one);
    var where = _hold_profile(dv, one);
    node_capacity_release(dv, resource_req_clone(one));
    assert_eq(_accel_used_at(dv, where), 0, "a one-device copy releases that device, not one of two");
    var ch = make_node("ch", f64_from(64), 524288);
    node_capacity_add_accel(ch, profile_tpu(0, 8, TPU_V5P));
    node_capacity_reserve(ch, resource_req_new(f64_from(1), 1, REQ_TPU, 4, 0, 0));
    var two = resource_req_new(f64_from(1), 1, REQ_TPU, 2, 0, 0);
    node_capacity_reserve(ch, two);
    node_capacity_release(ch, resource_req_clone(two));
    assert_eq(_accel_used_at(ch, 0), 4, "a two-chip copy releases two chips, not four");

    # A share key of 0 is no share, so the device count beside it stands.
    var t = resource_req_from_json_str(str_from(
        "{\"cpu_cores\":1.0,\"memory_mb\":1,\"accel_req\":1,\"accel_min_chips\":0,\"network\":0,\"disk_mb\":0,\"accel_devices\":4,\"accel_share\":0}"));
    assert_eq(ResourceReq_accel_devices(t), 4, "a share of 0 beside four devices keeps four");

    # A node whose accelerator is not its first profile still has one.
    var s = task_scheduler_new();
    var mixed = make_node("a-mixed", f64_from(64), 524288);
    node_capacity_add_accel(mixed, profile_cpu(1073741824));
    node_capacity_add_accel(mixed, profile_cuda(0, 17179869184));
    task_scheduler_register_node(s, mixed);
    task_scheduler_register_node(s, make_node("b-plain", f64_from(64), 524288));
    var cpu = make_task("cpu", 5);
    task_scheduler_submit_task(s, cpu);
    task_scheduler_schedule_pending(s);
    assert_eq(_went(cpu, "b-plain"), 1, "a GPU listed second still marks an accelerator node");
    return 0;
}

fn test_known_shapes_count_devices() {
    test_group("known_shapes_count_devices");
    var x = resource_req_with_devices(_gpu_req(1), 2);
    assert_eq(_same_shape(x, resource_req_with_devices(_gpu_req(1), 3)), 0, "another count is another shape");
    assert_eq(_same_shape(resource_req_with_share(_gpu_req(1), 500), resource_req_with_share(_gpu_req(1), 400)), 0,
      "another share is another shape");
    # Two GPUs fit nowhere, and one GPU is placed after them in the same pass.
    var s = task_scheduler_new();
    task_scheduler_register_node(s, _gpu_node("a", 1));
    var t1 = _req_task("t1", 9, resource_req_with_devices(_gpu_req(1), 2));
    var t2 = _req_task("t2", 8, _gpu_req(1));
    var t3 = _req_task("t3", 7, resource_req_with_share(_gpu_req(1), 300));
    task_scheduler_submit_task(s, t1);
    task_scheduler_submit_task(s, t2);
    task_scheduler_submit_task(s, t3);
    task_scheduler_schedule_pending(s);
    assert_eq(_went(t1, 0) + _went(t2, "a") + _went(t3, 0), 3, "a count's neighbour without it is placed");
    var u = task_scheduler_new();
    task_scheduler_register_node(u, _gpu_node("a", 1));
    var h1 = _req_task("h1", 9, resource_req_with_share(_gpu_req(1), 700));
    var h2 = _req_task("h2", 8, resource_req_with_share(_gpu_req(1), 400));
    var h3 = _req_task("h3", 7, resource_req_with_share(_gpu_req(1), 300));
    task_scheduler_submit_task(u, h1);
    task_scheduler_submit_task(u, h2);
    task_scheduler_submit_task(u, h3);
    task_scheduler_schedule_pending(u);
    assert_eq(_went(h1, "a") + _went(h2, 0) + _went(h3, "a"), 3, "a smaller share is placed after a refused one");
    return 0;
}

# --- v1.5.1: the P(-1) audit ---

# A node record with every axis given, for restores that disagree on one at a time.
fn _snap_node_axes(cpu, mem, disk, rt) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"node_id\":\"n\",\"total_cpu\":8.0,\"available_cpu\":");
    str_builder_add_cstr(sb, cpu);
    str_builder_add_cstr(sb, ",\"total_memory_mb\":8192,\"available_memory_mb\":");
    str_builder_add_int(sb, mem);
    str_builder_add_cstr(sb, ",\"total_disk_mb\":1000,\"available_disk_mb\":");
    str_builder_add_int(sb, disk);
    str_builder_add_cstr(sb, ",\"running_tasks\":");
    str_builder_add_int(sb, rt);
    str_builder_add_cstr(sb, ",\"accel_profiles\":[]}");
    return str_builder_build(sb);
}

# A task on "n" asking for `cores`, `mem` and `disk`, in `status`, holding n or not.
fn _snap_task_axes(id, status, cores, mem, disk, held) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"task_id\":\"");
    str_builder_add_cstr(sb, id);
    str_builder_add_cstr(sb, "\",\"name\":\"t\",\"description\":\"d\",\"agent_id\":\"a\",\"priority\":5,\"resource_requirements\":{\"cpu_cores\":");
    str_builder_add_int(sb, cores);
    str_builder_add_cstr(sb, ".0,\"memory_mb\":");
    str_builder_add_int(sb, mem);
    str_builder_add_cstr(sb, ",\"accel_req\":0,\"accel_min_chips\":0,\"network\":0,\"disk_mb\":");
    str_builder_add_int(sb, disk);
    str_builder_add_cstr(sb, "},\"status\":");
    str_builder_add_int(sb, status);
    str_builder_add_cstr(sb, ",\"created_at\":1,\"scheduled_at\":2,\"reserved_on\":");
    if (held == 1) { str_builder_add_cstr(sb, "\"n\""); } else { str_builder_add_cstr(sb, "null"); }
    str_builder_add_cstr(sb, ",\"assigned_node\":\"n\"}");
    return str_builder_build(sb);
}

fn _one(a) { var v = vec_new(); vec_push(v, a); return v; }

fn test_audit_restore_axes() {
    test_group("audit_restore_axes");
    # Each axis disagreeing alone is rebuilt from the tasks, and said so.
    _logs_start();
    var rt = _snap(_one(_snap_task_axes("a", TASK_RUNNING, 4, 0, 0, 1)), _snap_node_axes("4.0", 8192, 1000, 0));
    _logs_stop();
    var n = map_get(TaskScheduler_nodes(rt), str_from("n"));
    assert_eq(NodeCapacity_running_tasks(n), 1, "a wrong running count alone is rebuilt");
    assert_eq(_logged("snapshot capacity disagrees"), 1, "and logged");
    _logs_start();
    var mem = _snap(_one(_snap_task_axes("a", TASK_RUNNING, 0, 1024, 0, 1)), _snap_node_axes("8.0", 8192, 1000, 1));
    _logs_stop();
    assert_eq(NodeCapacity_available_memory_mb(map_get(TaskScheduler_nodes(mem), str_from("n"))), 7168, "wrong memory alone is rebuilt");
    assert_eq(_logged("snapshot capacity disagrees"), 1, "and logged");
    _logs_start();
    var disk = _snap(_one(_snap_task_axes("a", TASK_RUNNING, 0, 0, 100, 1)), _snap_node_axes("8.0", 8192, 1000, 1));
    _logs_stop();
    assert_eq(NodeCapacity_available_disk_mb(map_get(TaskScheduler_nodes(disk), str_from("n"))), 900, "wrong disk alone is rebuilt");
    assert_eq(_logged("snapshot capacity disagrees"), 1, "and logged");
    _logs_start();
    var hi = _snap(_one(_snap_task_axes("a", TASK_RUNNING, 4, 0, 0, 1)), _snap_node_axes("8.0", 8192, 1000, 1));
    _logs_stop();
    var hn = map_get(TaskScheduler_nodes(hi), str_from("n"));
    assert_eq(_cpu_milli(hn), 4000, "cores claimed free that a task holds are taken back");
    assert_eq(_logged("snapshot capacity disagrees"), 1, "and logged");
    task_scheduler_submit_task(hi, scheduled_task_new(str_from("c"), str_from("d"), str_from("a"), 5, make_req(f64_from(8), 0)));
    assert_eq(vec_len(task_scheduler_schedule_pending(hi)), 0, "so eight cores are not sold");
    _logs_start();
    var off = _snap(_one(_snap_task_axes("a", TASK_RUNNING, 4, 0, 0, 1)), _snap_node_axes("3.9999", 8192, 1000, 1));
    _logs_stop();
    assert_eq(_cpu_milli(map_get(TaskScheduler_nodes(off), str_from("n"))), 4000, "a ten-thousandth of a core off is rebuilt");
    assert_eq(_logged("snapshot capacity disagrees"), 1, "and logged");
    _logs_start();
    var near = _snap(_one(_snap_task_axes("a", TASK_RUNNING, 4, 0, 0, 1)), _snap_node_axes("3.9999999999", 8192, 1000, 1));
    _logs_stop();
    assert_eq(_logged("snapshot capacity disagrees"), 0, "a rounding error is not a disagreement");
    assert_eq(f64_eq(NodeCapacity_available_cpu(map_get(TaskScheduler_nodes(near), str_from("n"))), f64_from(4)), 0,
      "and keeps the bits it came with");
    # A placed task that lost its reservation still occupies its node, SCHEDULED as RUNNING.
    var sch = _snap(_one(_snap_task_axes("a", TASK_SCHEDULED, 4, 0, 0, 0)), _snap_node_axes("8.0", 8192, 1000, 0));
    var sn = map_get(TaskScheduler_nodes(sch), str_from("n"));
    assert_eq(_cpu_milli(sn) + NodeCapacity_running_tasks(sn), 4001, "a SCHEDULED task gets its reservation back");
    return 0;
}

fn test_audit_lifecycle_pins() {
    test_group("audit_lifecycle_pins");
    # A refused completion keeps what the task holds.
    var s = task_scheduler_new();
    task_scheduler_register_node(s, make_node("n", f64_from(4), 8192));
    var t1 = scheduled_task_new(str_from("a"), str_from("d"), str_from("a"), 5, make_req(f64_from(4), 1));
    task_scheduler_submit_task(s, t1);
    task_scheduler_schedule_pending(s);
    var r_t, r_v = task_scheduler_complete_task(s, ScheduledTask_task_id(t1), TASK_COMPLETED);
    assert_eq(is_err_result(r_t), 1, "a SCHEDULED task cannot complete");
    task_scheduler_submit_task(s, scheduled_task_new(str_from("b"), str_from("d"), str_from("a"), 5, make_req(f64_from(4), 1)));
    assert_eq(vec_len(task_scheduler_schedule_pending(s)), 0, "and the refusal gave nothing back");

    # Only a RUNNING task is a victim, and only of a higher class.
    var p = task_scheduler_new();
    task_scheduler_register_node(p, make_node("n", f64_from(4), 8192));
    var low = scheduled_task_new(str_from("low"), str_from("d"), str_from("a"), 1, make_req(f64_from(4), 1));
    task_scheduler_submit_task(p, low);
    task_scheduler_schedule_pending(p);
    var high = scheduled_task_new(str_from("high"), str_from("d"), str_from("a"), 10, make_req(f64_from(4), 1));
    task_scheduler_submit_task(p, high);
    assert_eq(task_scheduler_preempt_if_needed(p, high), 0, "a SCHEDULED holder is not a victim");
    scheduled_task_transition(low, TASK_RUNNING);
    assert_eq(task_scheduler_preempt_if_needed(p, high) != 0, 1, "a RUNNING one is");
    scheduled_task_transition(low, TASK_COMPLETED);
    assert_eq(task_scheduler_preempt_if_needed(p, high), 0, "and one finished by its transition is not, nor needed");
    var c = task_scheduler_new();
    task_scheduler_register_node(c, make_node("n", f64_from(4), 8192));
    var four = scheduled_task_new(str_from("p4"), str_from("d"), str_from("a"), 4, make_req(f64_from(4), 1));
    task_scheduler_submit_task(c, four);
    task_scheduler_schedule_pending(c);
    scheduled_task_transition(four, TASK_RUNNING);
    var six = scheduled_task_new(str_from("p6"), str_from("d"), str_from("a"), 6, make_req(f64_from(4), 1));
    task_scheduler_submit_task(c, six);
    assert_eq(task_scheduler_preempt_if_needed(c, six), 0, "priority 6 does not stop 4: one class");

    # A PREEMPTED task waits for its owner to queue it again, and a pass leaves it.
    var q = task_scheduler_new();
    task_scheduler_register_node(q, make_node("n", f64_from(8), 8192));
    var pre = scheduled_task_new(str_from("pre"), str_from("d"), str_from("a"), 5, make_req(f64_from(1), 1));
    task_scheduler_submit_task(q, pre);
    task_scheduler_schedule_pending(q);
    scheduled_task_transition(pre, TASK_RUNNING);
    scheduled_task_transition(pre, TASK_PREEMPTED);
    assert_eq(vec_len(task_scheduler_pending_tasks(q)), 0, "a PREEMPTED task is not pending");
    assert_eq(vec_len(task_scheduler_schedule_pending(q)), 0, "and a pass places nothing");

    # Restore keeps a PREEMPTED status and clamps one it cannot know.
    var keep = _snap(_one(_snap_task_axes("a", TASK_PREEMPTED, 1, 0, 0, 0)), _snap_node_axes("8.0", 8192, 1000, 0));
    assert_eq(ScheduledTask_status(task_scheduler_get_task(keep, str_from("a"))), TASK_PREEMPTED, "PREEMPTED restores as PREEMPTED");
    var neg = _snap(_one(_snap_task_axes("a", 0 - 1, 1, 0, 0, 0)), _snap_node_axes("8.0", 8192, 1000, 0));
    assert_eq(ScheduledTask_status(task_scheduler_get_task(neg, str_from("a"))), TASK_QUEUED, "a status below the range is QUEUED");
    var big = _snap(_one(_snap_task_axes("a", 99, 1, 0, 0, 0)), _snap_node_axes("8.0", 8192, 1000, 0));
    assert_eq(ScheduledTask_status(task_scheduler_get_task(big, str_from("a"))), TASK_QUEUED, "and one above it");

    # Registering answers 0 for the same node again, and for a reconnect.
    var g = task_scheduler_new();
    var node = make_node("g", f64_from(8), 8192);
    assert_eq(task_scheduler_register_node(g, node), 0, "a new node");
    assert_eq(task_scheduler_register_node(g, node), 0, "the same node again");
    assert_eq(task_scheduler_register_node(g, make_node("g", f64_from(8), 8192)), 0, "a reconnect");

    # A training job's target is a request: it is placed there, and the reason says so.
    var tr = task_scheduler_new();
    task_scheduler_register_node(tr, _gpu_node("a-gpu", 1));
    task_scheduler_register_node(tr, _gpu_node("z-gpu", 1));
    var job = training_job_template_new(str_from("m"), TM_LORA, str_from("data"), str_from("z-gpu"), 60, 0);
    var jt = training_job_to_scheduled_task(job, str_from("agent"));
    assert_eq(str_eq(ScheduledTask_requested_node(jt), str_from("z-gpu")), 1, "the target is requested");
    assert_eq(ScheduledTask_assigned_node(jt), 0, "not assigned");
    var jr = ScheduledTask_resource_requirements(jt);
    assert_eq(f64_eq(ResourceReq_cpu_cores(jr), f64_from(2)), 1, "two cores");
    assert_eq(ResourceReq_disk_mb(jr), 10000, "10,000 MB of disk");
    assert_eq(str_eq(ScheduledTask_description(jt), str_from("Training job: lora on m")), 1, "its description");
    task_scheduler_submit_task(tr, jt);
    var ds = task_scheduler_schedule_pending(tr);
    assert_eq(_went(jt, "z-gpu"), 1, "placed on its target");
    assert_eq(str_eq(SchedulingDecision_reason(vec_get(ds, 0)), str_from("preferred node")), 1, "as the preferred node");

    # A negative watermark restores as never, so the first check fires one minute.
    var cs = cron_scheduler_from_json_str(str_from(
        "{\"entries\":[{\"name\":\"e\",\"expr\":{\"minute_mask\":1152921504606846975,\"hour_mask\":16777215,\"dom_mask\":4294967294,\"month_mask\":8190,\"dow_mask\":127,\"dom_star\":1,\"dow_star\":1},\"task_template\":{\"name\":\"t\",\"description\":\"d\",\"agent_id\":\"a\",\"priority\":5,\"resource_requirements\":{\"cpu_cores\":1.0,\"memory_mb\":1,\"accel_req\":0,\"accel_min_chips\":0,\"network\":0,\"disk_mb\":0}},\"enabled\":1,\"last_fired\":-1,\"missed_policy\":1}]}"));
    assert_eq(CronEntry_last_fired(vec_get(cron_scheduler_list_entries(cs), 0)), 0, "a negative watermark is never");
    assert_eq(vec_len(cron_scheduler_check_due_at(cs, 1798804800000000000)), 1, "so the first check fires one minute");
    return 0;
}

fn test_audit_pins() {
    test_group("audit_pins");
    # A caller's copy releases only an equal hold, the requirement type included.
    var n = _gpu_node("g", 1);
    node_capacity_reserve(n, _gpu_req(1));
    node_capacity_release(n, resource_req_new(f64_from(1), 1, REQ_ANY_ACCELERATOR, 0, 0, 0));
    assert_eq(node_capacity_can_fit(n, _gpu_req(1)), 0, "an any-accelerator copy does not free a GPU hold");
    # The documented numbers.
    assert_eq(SAMAY_JSON_MAX_BYTES, 134217728, "128 MiB");
    assert_eq(SAMAY_JSON_MAX_ITEMS, 100000, "100,000 items");
    assert_eq(SAMAY_JSON_MAX_EXPANSION, 10, "ten times the text");
    assert_eq(CRON_CLOCK_RESET_SECS, 10800, "three hours");
    assert_eq(CRON_CATCHUP_CAP, 1000, "1,000 fires per entry");
    assert_eq(CRON_BURST_BUDGET, 10000, "10,000 per check");
    assert_eq(SAMAY_MAX_NODE_DEVICES, 1024, "1,024 devices a node");
    # A copy settles a share a setter zeroed, so its task writes 1.4.6's bytes.
    var z = _gpu_req(1);
    ResourceReq_set_accel_share(z, 0);
    var t = scheduled_task_new(str_from("t"), str_from("d"), str_from("a"), 5, z);
    assert_eq(ResourceReq_accel_share(ScheduledTask_resource_requirements(t)), SAMAY_ACCEL_WHOLE, "a zeroed share copies as whole");
    assert_eq(str_contains(scheduled_task_to_json_str(t), str_from("accel_share")), 0, "and writes no share");
    # The parser: nine digits at most, and a tab before a shortcut.
    var a_t, a_v = cron_expr_parse(str_from("0000000005 * * * *"));
    assert_eq(is_err_result(a_t), 1, "ten digits are refused");
    var b_t, b_v = cron_expr_parse(str_from("\t@daily"));
    assert_eq(is_err_result(b_t), 0, "a tab before @daily is trimmed");
    # Log lines say what they refused, with the number.
    var i = 0;
    var saved = SAMAY_JSON_MAX_ITEMS;
    SAMAY_JSON_MAX_ITEMS = 1;
    var two = task_scheduler_new();
    task_scheduler_submit_task(two, make_task("a", 5));
    task_scheduler_submit_task(two, make_task("b", 5));
    _logs_start();
    task_scheduler_to_json_str(two);
    _logs_stop();
    SAMAY_JSON_MAX_ITEMS = saved;
    assert_eq(_logged("snapshot refused: 2 tasks, past the restore limit of 1"), 1, "the item limit names the collection and its count");
    # 1,000 empty arrays in 3,001 bytes, with no budget past the first 4 KiB.
    var arrays = str_builder_new();
    str_builder_add_cstr(arrays, "[");
    i = 0;
    while (i < 1000) {
        if (i > 0) { str_builder_add_cstr(arrays, ","); }
        str_builder_add_cstr(arrays, "[]");
        i = i + 1;
    }
    str_builder_add_cstr(arrays, "]");
    var saved_x = SAMAY_JSON_MAX_EXPANSION;
    SAMAY_JSON_MAX_EXPANSION = 0;
    _logs_start();
    task_scheduler_from_json_str(str_builder_build(arrays));
    _logs_stop();
    SAMAY_JSON_MAX_EXPANSION = saved_x;
    assert_eq(_logged("parsing its 3001 bytes takes more than 0 times that"), 1, "a refused parse says how long its text was");
    var long = str_builder_new();
    i = 0;
    while (i < 70) {
        str_builder_add_cstr(long, "x");
        i = i + 1;
    }
    var c = cron_scheduler_new();
    var tmpl = cron_task_template_new(str_from("t"), str_from("d"), str_from("a"), 5, resource_req_default());
    cron_scheduler_add(c, str_builder_build(long), str_from("* * * * *"), tmpl, 1, CRON_CATCHUP);
    cron_scheduler_check_due_at(c, 1798804800000000000);
    _logs_start();
    cron_scheduler_check_due_at(c, 1798805100000000000);
    _logs_stop();
    var cut = str_builder_new();
    str_builder_add_cstr(cut, "cron '");
    i = 0;
    while (i < 64) {
        str_builder_add_cstr(cut, "x");
        i = i + 1;
    }
    str_builder_add_cstr(cut, "': ");
    assert_eq(_logged(str_cstr(str_builder_build(cut))), 1, "a cron name is cut at exactly 64");
    var hs = task_scheduler_new();
    task_scheduler_register_node(hs, make_node("n", f64_from(4), 8192));
    var lo = scheduled_task_new(str_from("lo"), str_from("d"), str_from("a"), 1, make_req(f64_from(4), 1));
    task_scheduler_submit_task(hs, lo);
    task_scheduler_schedule_pending(hs);
    scheduled_task_transition(lo, TASK_RUNNING);
    var hi = scheduled_task_new(str_from("hi"), str_from("d"), str_from("a"), 10, make_req(f64_from(4), 1));
    task_scheduler_submit_task(hs, hi);
    var act = task_scheduler_preempt_if_needed(hs, hi);
    assert_eq(str_eq(PreemptionAction_reason(act), str_from("priority 10 preempts priority 1 task")), 1, "the reason names both priorities in order");
    return 0;
}

# `s` with the first `from` replaced by `to`, both C strings.
fn _replace_once(s, from, to) {
    var at = str_index_of_cstr(s, from);
    if (at < 0) { return s; }
    var sb = str_builder_new();
    str_builder_add(sb, str_sub(s, 0, at));
    str_builder_add_cstr(sb, to);
    var past = at + strlen(from);
    str_builder_add(sb, str_sub(s, past, str_len(s) - past));
    return str_builder_build(sb);
}

var NOON = 1798804800000000000;
var MIN_NS = 60000000000;

fn _cron_with(name, expr, policy) {
    var c = cron_scheduler_new();
    var tmpl = cron_task_template_new(str_from("t"), str_from("d"), str_from("a"), 5, resource_req_default());
    cron_scheduler_add(c, str_from(name), str_from(expr), tmpl, 1, policy);
    return c;
}

fn _entry_of(c, name) { return map_get(CronScheduler_entries(c), str_from(name)); }

fn test_audit_cron_clock() {
    test_group("audit_cron_clock");
    # One reading far behind, then the right time: what had fired does not fire again.
    var c = _cron_with("hourly", "0 * * * *", CRON_CATCHUP);
    cron_scheduler_check_due_at(c, NOON);
    cron_scheduler_check_due_at(c, 946684800000000000);
    assert_eq(CronEntry_reset_from(_entry_of(c, "hourly")), NOON, "a reset keeps how far it had got");
    _logs_start();
    var back = vec_len(cron_scheduler_check_due_at(c, NOON + 5 * MIN_NS));
    _logs_stop();
    assert_eq(back, 0, "back past it, nothing fires twice");
    assert_eq(_logged("catch-up"), 0, "and nothing is called missed");
    assert_eq(CronEntry_reset_from(_entry_of(c, "hourly")), 0, "and the reset is over");
    assert_eq(vec_len(cron_scheduler_check_due_at(c, NOON + 60 * MIN_NS)), 1, "the next hour fires once");
    # The same through a snapshot taken between the two readings.
    var s = _cron_with("hourly", "0 * * * *", CRON_CATCHUP);
    cron_scheduler_check_due_at(s, NOON);
    cron_scheduler_check_due_at(s, 946684800000000000);
    var text = cron_scheduler_to_json_str(s);
    assert_eq(str_contains(text, str_from("\"reset_from\":1798804800000000000")), 1, "a reset is written");
    var r = cron_scheduler_from_json_str(text);
    assert_eq(str_eq(cron_scheduler_to_json_str(r), text), 1, "and reads back as written");
    assert_eq(vec_len(cron_scheduler_check_due_at(r, NOON + 5 * MIN_NS)), 0, "and still fires nothing twice");
    assert_eq(str_contains(cron_scheduler_to_json_str(_cron_with("e", "* * * * *", CRON_SKIP)), str_from("reset_from")), 0,
      "an entry with no reset writes no key");
    # A real step back keeps time as it passes again, until it is back past the mark.
    var real = _cron_with("minutely", "* * * * *", CRON_CATCHUP);
    cron_scheduler_check_due_at(real, NOON);
    cron_scheduler_check_due_at(real, NOON - 240 * MIN_NS);
    assert_eq(vec_len(cron_scheduler_check_due_at(real, NOON - 239 * MIN_NS)), 1, "a real step back fires as time passes");
    # A small step back waits, and says so once, not on every check.
    var w = _cron_with("a", "* * * * *", CRON_CATCHUP);
    cron_scheduler_add(w, str_from("b"), str_from("* * * * *"),
      cron_task_template_new(str_from("t"), str_from("d"), str_from("a"), 5, resource_req_default()), 1, CRON_CATCHUP);
    cron_scheduler_check_due_at(w, NOON);
    _logs_start();
    var used = alloc_used();
    var k = 0;
    while (k < 50) {
        cron_scheduler_check_due_at(w, NOON - 60 * MIN_NS + k * 1000000000);
        k = k + 1;
    }
    var per = (alloc_used() - used) / 50;
    _logs_stop();
    assert_eq(_logged("watermark held"), 2, "once per entry, not once per check");
    assert_eq(per < 400, 1, "and a held check costs about what a quiet one does");
    assert_eq(vec_len(cron_scheduler_check_due_at(w, NOON + MIN_NS)), 2, "then each fires its next minute");
    _logs_start();
    cron_scheduler_check_due_at(w, NOON);
    _logs_stop();
    assert_eq(_logged("watermark held"), 2, "a later step back is said again");
    # The top of i64 has no next minute, and the day before it still does.
    var _e_t, _e_v = cron_expr_parse(str_from("* * * * *"));
    var every = result_unwrap(_e_t, _e_v);
    assert_eq(cron_expr_next_after(every, 9223372036854775807), 0 - 1, "no minute after the top");
    var near = 9223372036854689407 - 86400 * 2;
    assert_eq(cron_expr_next_after(every, near) > near, 1, "two days below the top, the next minute");
    var _y_t, _y_v = cron_expr_parse(str_from("0 0 1 1 *"));
    var yearly = result_unwrap(_y_t, _y_v);
    var far = 9223372036820215807;
    var nx = cron_expr_next_after(yearly, far);
    assert_eq(nx == 0 - 1 || nx > far, 1, "never a value at or before the instant");
    return 0;
}

fn test_audit_cron_edits() {
    test_group("audit_cron_edits");
    var tmpl = cron_task_template_new(str_from("t"), str_from("d"), str_from("a"), 5, resource_req_default());
    # A changed schedule starts fresh, and says what the old one gives up.
    var c = _cron_with("job", "0 * * * *", CRON_CATCHUP);
    cron_scheduler_check_due_at(c, NOON);
    _logs_start();
    cron_scheduler_add(c, str_from("job"), str_from("* * * * *"), tmpl, 1, CRON_CATCHUP);
    _logs_stop();
    assert_eq(_logged("schedule changed; what the old one owed since its last check is given up"), 1, "a changed schedule says so");
    assert_eq(CronEntry_last_fired(_entry_of(c, "job")), 0, "and starts fresh");
    assert_eq(vec_len(cron_scheduler_check_due_at(c, NOON + 210 * MIN_NS)), 1, "so it fires the current minute, not 210");
    # The same schedule keeps its place, and its reset.
    var same = _cron_with("job", "0 * * * *", CRON_CATCHUP);
    cron_scheduler_check_due_at(same, NOON);
    _logs_start();
    cron_scheduler_add(same, str_from("job"), str_from("0 * * * *"), tmpl, 1, CRON_CATCHUP);
    _logs_stop();
    assert_eq(_logged("schedule changed"), 0, "the same schedule says nothing");
    assert_eq(CronEntry_last_fired(_entry_of(same, "job")), NOON, "and keeps its watermark");
    # A disabled entry says what it gave up once, through a snapshot and a replace.
    var d = _cron_with("h", "0 * * * *", CRON_CATCHUP);
    cron_scheduler_check_due_at(d, NOON);
    CronEntry_set_enabled(_entry_of(d, "h"), 0);
    cron_scheduler_check_due_at(d, NOON + MIN_NS);
    var dtext = cron_scheduler_to_json_str(d);
    assert_eq(str_contains(dtext, str_from("\"disabled_seen\":1")), 1, "a disabled entry that has spoken writes so");
    var dr = cron_scheduler_from_json_str(dtext);
    _logs_start();
    cron_scheduler_check_due_at(dr, NOON + 24 * 60 * MIN_NS);
    _logs_stop();
    assert_eq(_logged("giving up"), 0, "and does not speak again after a restore");
    _logs_start();
    cron_scheduler_add(d, str_from("h"), str_from("0 * * * *"), tmpl, 0, CRON_CATCHUP);
    cron_scheduler_check_due_at(d, NOON + 24 * 60 * MIN_NS);
    _logs_stop();
    assert_eq(_logged("giving up"), 0, "nor after a replace while disabled");
    assert_eq(str_contains(cron_scheduler_to_json_str(_cron_with("e", "* * * * *", CRON_SKIP)), str_from("disabled_seen")), 0,
      "an enabled entry writes no key");
    # Only 0 is disabled, before a restore and after.
    var two = _cron_with("job", "* * * * *", CRON_SKIP);
    cron_scheduler_check_due_at(two, NOON);
    CronEntry_set_enabled(_entry_of(two, "job"), 2);
    assert_eq(vec_len(cron_scheduler_check_due_at(two, NOON + MIN_NS)), 1, "enabled set to 2 fires");
    var tr = cron_scheduler_from_json_str(cron_scheduler_to_json_str(two));
    assert_eq(vec_len(cron_scheduler_check_due_at(tr, NOON + 2 * MIN_NS)), 1, "and still fires after a restore");
    # A name's newline cannot start a log line of its own.
    var nl = _cron_with("x\n[0] [ERROR] forged", "* * * * *", CRON_CATCHUP);
    cron_scheduler_check_due_at(nl, NOON);
    _logs_start();
    cron_scheduler_check_due_at(nl, NOON + 3 * MIN_NS);
    _logs_stop();
    assert_eq(_logged("cron 'x?[0] [ERROR] forged': catch-up"), 1, "a newline in a name is shown as ?");
    return 0;
}

fn _expr_doc(minute, hour, dom, month, dow, stars) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"minute_mask\":");
    str_builder_add_int(sb, minute);
    str_builder_add_cstr(sb, ",\"hour_mask\":");
    str_builder_add_int(sb, hour);
    str_builder_add_cstr(sb, ",\"dom_mask\":");
    str_builder_add_int(sb, dom);
    str_builder_add_cstr(sb, ",\"month_mask\":");
    str_builder_add_int(sb, month);
    str_builder_add_cstr(sb, ",\"dow_mask\":");
    str_builder_add_int(sb, dow);
    if (stars == 1) { str_builder_add_cstr(sb, ",\"dom_star\":0,\"dow_star\":1"); }
    str_builder_add_cstr(sb, "}");
    return str_builder_build(sb);
}

fn test_audit_cron_masks() {
    test_group("audit_cron_masks");
    var good = cron_expr_from_json_str(_expr_doc(1, 1, 2, 8190, 127, 1));
    assert_eq(good != 0, 1, "an expression the parser makes reads");
    assert_eq(cron_expr_from_json_str(_expr_doc(0, 1, 2, 8190, 127, 1)), 0, "an empty minute mask is refused");
    assert_eq(cron_expr_from_json_str(_expr_doc(1 << 60, 1, 2, 8190, 127, 1)), 0, "minute 60 alone is refused");
    assert_eq(cron_expr_from_json_str(_expr_doc(1, 1 << 24, 2, 8190, 127, 1)), 0, "hour 24 alone is refused");
    assert_eq(cron_expr_from_json_str(_expr_doc(1, 1, 1, 8190, 127, 1)), 0, "day 0 alone is refused");
    assert_eq(cron_expr_from_json_str(_expr_doc(1, 1, 2, 1, 127, 1)), 0, "month 0 alone is refused");
    assert_eq(cron_expr_from_json_str(_expr_doc(1, 1, 2, 1 << 13, 127, 1)), 0, "month 13 alone is refused");
    assert_eq(cron_expr_from_json_str(_expr_doc(1, 1, 2, 8190, 128, 1)), 0, "Sunday as 7 alone is refused");
    assert_eq(cron_expr_from_json_str(_expr_doc(1, 1, 2, 8190, 129, 1)), 0, "a stray bit beside a good one is refused");
    # Without its star flags, a whole field reads as a star: 0 0 1 * * stays monthly.
    var old = cron_expr_from_json_str(_expr_doc(1, 1, 2, 8190, 127, 0));
    assert_eq(CronExpr_dow_star(old), 1, "a whole week is a star");
    assert_eq(CronExpr_dom_star(old), 0, "and day 1 is not");
    var whole = cron_expr_from_json_str(_expr_doc(1, 1, 4294967294, 8190, 2, 0));
    assert_eq(CronExpr_dom_star(whole), 1, "a whole month of days is a star");
    assert_eq(CronExpr_dow_star(whole), 0, "and Monday alone is not");
    var fired = 0;
    var t = 1798761600;
    var k = 0;
    while (k < 30 * 1440) {
        fired = fired + cron_expr_matches(old, t + k * 60);
        k = k + 1;
    }
    assert_eq(fired, 1, "so it matches once in thirty days");
    return 0;
}

fn _profile_text() {
    var sb = str_builder_new();
    profile_to_json(sb, profile_cuda(0, 17179869184));
    return str_builder_build(sb);
}

fn _node_doc(profiles) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"node_id\":\"g\",\"total_cpu\":8.0,\"available_cpu\":8.0,\"total_memory_mb\":8192,\"available_memory_mb\":8192,\"total_disk_mb\":0,\"available_disk_mb\":0,\"running_tasks\":0,\"accel_profiles\":[");
    str_builder_add_cstr(sb, profiles);
    str_builder_add_cstr(sb, "]}");
    return str_builder_build(sb);
}

fn test_audit_restore_records() {
    test_group("audit_restore_records");
    # A profile samay could not have written is refused, and said so; a real one reads.
    _logs_start();
    var bare = node_capacity_from_json_str(_node_doc("{}"));
    _logs_stop();
    assert_eq(vec_len(NodeCapacity_accel_profiles(bare)), 0, "a profile with no type, device or memory is refused");
    assert_eq(_logged("node 'g': accelerator profile refused on restore (no type, device or memory)"), 1, "and logged, with the node");
    assert_eq(vec_len(NodeCapacity_accel_profiles(node_capacity_from_json_str(_node_doc(str_cstr(_profile_text()))))), 1,
      "a profile ai-hwaccel wrote reads");
    # Each of the three missing, or not a number, refuses it too; so does a profile that
    # is not an object.
    var pt = _profile_text();
    var shapes = vec_new();
    vec_push(shapes, _replace_once(pt, "\"device_id\"", "\"device\""));
    vec_push(shapes, _replace_once(pt, "\"memory_bytes\"", "\"memory\""));
    vec_push(shapes, _replace_once(pt, "\"device_id\":0", "\"device_id\":\"0\""));
    vec_push(shapes, str_from("5"));
    var refused = 0;
    var si = 0;
    _logs_start();
    while (si < vec_len(shapes)) {
        var one = node_capacity_from_json_str(_node_doc(str_cstr(vec_get(shapes, si))));
        if (vec_len(NodeCapacity_accel_profiles(one)) == 0) { refused = refused + 1; }
        si = si + 1;
    }
    _logs_stop();
    assert_eq(refused, 4, "each shape samay could not have written is refused");
    assert_eq(_logged("node 'g': accelerator profile refused on restore (no type, device or memory)"), 4, "each as unshaped");
    # A shaped profile ai-hwaccel refuses is said to be out of range instead.
    _logs_start();
    var neg = node_capacity_from_json_str(_node_doc(str_cstr(_replace_once(pt, "\"device_id\":0", "\"device_id\":-1"))));
    _logs_stop();
    assert_eq(vec_len(NodeCapacity_accel_profiles(neg)), 0, "a device id below zero is refused");
    assert_eq(_logged("node 'g': accelerator profile refused on restore (out of range)"), 1, "by ai-hwaccel, and said so");
    # Cores below any real over-commitment stop at -1e18.
    var deep = node_capacity_from_json_str(_replace_once(_node_doc(""), "\"available_cpu\":8.0", "\"available_cpu\":-1e300"));
    assert_eq(f64_eq(NodeCapacity_available_cpu(deep), f64_sub(f64_from(0), f64_from(1000000000000000000))), 1,
      "available cores far below zero stop at -1e18");
    # A score no writer can carry is refused.
    assert_eq(scheduling_decision_from_json_str(str_from("{\"task_id\":\"x\",\"assigned_node\":\"y\",\"reason\":\"z\",\"score\":1e400}")), 0,
      "an infinite score is refused");
    # A requirement needs every field.
    var fields = _keys("cpu_cores", "memory_mb", "accel_req", "accel_min_chips", "network", "disk_mb", 0);
    var kept = 0;
    var i = 0;
    while (i < vec_len(fields)) {
        var sb = str_builder_new();
        str_builder_add_cstr(sb, "{");
        var first = 1;
        var j = 0;
        while (j < vec_len(fields)) {
            if (j != i) {
                if (first == 0) { str_builder_add_cstr(sb, ","); }
                first = 0;
                str_builder_add_cstr(sb, "\"");
                str_builder_add_cstr(sb, vec_get(fields, j));
                str_builder_add_cstr(sb, "\":0");
            }
            j = j + 1;
        }
        str_builder_add_cstr(sb, "}");
        if (resource_req_from_json_str(str_builder_build(sb)) != 0) { kept = kept + 1; }
        i = i + 1;
    }
    assert_eq(kept, 0, "a requirement missing any one field is refused");
    # Null Strs where a value is required become empty, and write.
    var nt = scheduled_task_new(0, 0, 0, 5, make_req(f64_from(1), 1));
    assert_eq(str_len(ScheduledTask_name(nt)) + str_len(ScheduledTask_description(nt)) + str_len(ScheduledTask_agent_id(nt)), 0,
      "a task's null Strs are empty");
    var ns = task_scheduler_new();
    task_scheduler_submit_task(ns, nt);
    assert_eq(task_scheduler_to_json_str(ns) != 0, 1, "and the snapshot writes");
    assert_eq(task_scheduler_register_node(ns, node_capacity_new(0, f64_from(8), 8192, 0, 0)), 1, "a node with a null id is refused");
    var bad = make_node("b", f64_from(8), 8192);
    NodeCapacity_set_node_id(bad, 0);
    assert_eq(task_scheduler_register_node(ns, bad), 1, "even one nulled after building");
    return 0;
}

# The device a node's holds put on `i`, for comparing restored and live.
fn _used(n, i) { return _accel_used_at(n, i); }

fn test_audit_held_devices() {
    test_group("audit_held_devices");
    # x takes the GPU, f any accelerator (the Gaudi), x finishes, y takes the GPU. Replay
    # in placement order put f on the GPU and y on top of it.
    var s = task_scheduler_new();
    var node = make_node("n", f64_from(64), 524288);
    node_capacity_add_accel(node, profile_cuda(0, 17179869184));
    node_capacity_add_accel(node, profile_gaudi(0, 2));
    task_scheduler_register_node(s, node);
    var x = _req_task("x", 9, _gpu_req(1));
    task_scheduler_submit_task(s, x);
    task_scheduler_schedule_pending(s);
    var f = _req_task("f", 9, resource_req_new(f64_from(1), 1, REQ_ANY_ACCELERATOR, 0, 0, 0));
    task_scheduler_submit_task(s, f);
    task_scheduler_schedule_pending(s);
    scheduled_task_transition(x, TASK_RUNNING);
    task_scheduler_complete_task(s, ScheduledTask_task_id(x), TASK_COMPLETED);
    var y = _req_task("y", 9, _gpu_req(1));
    task_scheduler_submit_task(s, y);
    task_scheduler_schedule_pending(s);
    assert_eq(_used(node, 0) * 10 + _used(node, 1) / 1000, 10001, "live: the GPU and the Gaudi, one each");
    var text = task_scheduler_to_json_str(s);
    assert_eq(str_contains(text, str_from("\"held_profiles\":[1]")), 1, "the Gaudi's holder records it");
    var r = task_scheduler_from_json_str(text);
    var rn = map_get(TaskScheduler_nodes(r), str_from("n"));
    assert_eq(_used(rn, 0) * 10 + _used(rn, 1) / 1000, 10001, "restored: the same, not the GPU twice");
    assert_eq(str_eq(task_scheduler_to_json_str(r), text), 1, "and writes back byte for byte");
    var z = _req_task("z", 9, resource_req_new(f64_from(1), 1, REQ_GAUDI, 0, 0, 0));
    task_scheduler_submit_task(r, z);
    assert_eq(vec_len(task_scheduler_schedule_pending(r)), 0, "so the busy Gaudi is not offered");
    # The same node registered again keeps each task on its device.
    var again = make_node("n", f64_from(64), 524288);
    node_capacity_add_accel(again, profile_cuda(0, 17179869184));
    node_capacity_add_accel(again, profile_gaudi(0, 2));
    task_scheduler_register_node(s, again);
    assert_eq(_used(again, 0) * 10 + _used(again, 1) / 1000, 10001, "re-registered: the same");
    # A record that does not fit the node is chosen again, and said so.
    var moved = _replace_once(text, "\"held_profiles\":[1]", "\"held_profiles\":[7]");
    _logs_start();
    var m = task_scheduler_from_json_str(moved);
    _logs_stop();
    assert_eq(m != 0, 1, "a record past the node's profiles still restores");
    assert_eq(_logged("recorded devices do not fit it; chosen again"), 1, "and says the devices were chosen again");
    # A record of the wrong type refuses its task.
    var wrong = _replace_once(text, "\"held_profiles\":[1]", "\"held_profiles\":\"1\"");
    var w = task_scheduler_from_json_str(wrong);
    assert_eq(task_scheduler_get_task(w, ScheduledTask_task_id(f)), 0, "a recorded list that is not a list refuses the task");
    var neg = _replace_once(text, "\"held_profiles\":[1]", "\"held_profiles\":[1.5]");
    assert_eq(task_scheduler_get_task(task_scheduler_from_json_str(neg), ScheduledTask_task_id(f)), 0, "and so does one of fractions");
    # Without a record, as 1.5.0 wrote, the devices are chosen as they were.
    var plain = _replace_once(text, ",\"held_profiles\":[1]", "");
    assert_eq(task_scheduler_from_json_str(plain) != 0, 1, "a snapshot without records restores");
    assert_eq(str_contains(task_scheduler_to_json_str(task_scheduler_new()), str_from("held_profiles")), 0, "and none is written without devices");
    return 0;
}

fn test_audit_over_commit() {
    test_group("audit_over_commit");
    # A node re-registered smaller than its tasks hold counts below zero.
    var s = task_scheduler_new();
    task_scheduler_register_node(s, make_node("n", f64_from(16), 16384));
    var a = scheduled_task_new(str_from("a"), str_from("d"), str_from("a"), 5, make_req(f64_from(6), 6000));
    var b = scheduled_task_new(str_from("b"), str_from("d"), str_from("a"), 5, make_req(f64_from(6), 6000));
    task_scheduler_submit_task(s, a);
    task_scheduler_submit_task(s, b);
    task_scheduler_schedule_pending(s);
    var small = make_node("n", f64_from(8), 8192);
    task_scheduler_register_node(s, small);
    assert_eq(_cpu_milli(small), 0 - 4000, "12 cores on 8 leaves -4");
    assert_eq(NodeCapacity_available_memory_mb(small), 0 - 3808, "and 12,000 MB on 8,192 leaves -3,808");
    scheduled_task_transition(a, TASK_RUNNING);
    task_scheduler_complete_task(s, ScheduledTask_task_id(a), TASK_COMPLETED);
    assert_eq(_cpu_milli(small), 2000, "one task's release leaves 2 cores, not 6");
    assert_eq(NodeCapacity_available_memory_mb(small), 2192, "and 2,192 MB, not 6,000");
    task_scheduler_submit_task(s, scheduled_task_new(str_from("c"), str_from("d"), str_from("a"), 5, make_req(f64_from(6), 6000)));
    assert_eq(vec_len(task_scheduler_schedule_pending(s)), 0, "so a third task is not sold what b uses");
    # And it writes and reads back below zero, without calling that a disagreement.
    task_scheduler_register_node(s, make_node("n", f64_from(4), 4096));
    var text = task_scheduler_to_json_str(s);
    _logs_start();
    var r = task_scheduler_from_json_str(text);
    _logs_stop();
    assert_eq(NodeCapacity_available_memory_mb(map_get(TaskScheduler_nodes(r), str_from("n"))), 0 - 1904, "restored below zero");
    assert_eq(_logged("disagrees"), 0, "as written, so nothing disagrees");
    # Huge holds stop at a floor rather than wrap.
    assert_eq(_capacity_taken(0, 9223372036854775807), _CAPACITY_FLOOR, "taking the most there is stops at the floor");
    assert_eq(_capacity_taken(_CAPACITY_FLOOR, 9223372036854775807), _CAPACITY_FLOOR, "and stays there");
    assert_eq(_capacity_taken(9223372036854775807, 1), 9223372036854775806, "a huge node takes as usual");
    assert_eq(_capacity_returned(0 - 100, 300, 1000), 200, "below zero, a release adds");
    assert_eq(_capacity_returned(0 - 100, 3000, 1000), 1000, "up to the total");
    return 0;
}

fn test_audit_orphans_and_ceiling() {
    test_group("audit_orphans_and_ceiling");
    # Tasks restored without their node charge it when it registers.
    var s = task_scheduler_new();
    var g = _gpu_node("g", 1);
    task_scheduler_register_node(s, g);
    var t = _req_task("t", 5, make_req(f64_from(6), 6000));
    ResourceReq_set_accel_req(ScheduledTask_resource_requirements(t), REQ_GPU);
    task_scheduler_submit_task(s, t);
    task_scheduler_schedule_pending(s);
    scheduled_task_transition(t, TASK_RUNNING);
    var only = task_scheduler_new();
    task_scheduler_submit_task(only, t);
    var r = task_scheduler_from_json_str(task_scheduler_to_json_str(only));
    assert_eq(TaskScheduler_orphans(r), 1, "a task held a node the snapshot lacks");
    var late = _gpu_node("g", 1);
    task_scheduler_register_node(r, late);
    assert_eq(NodeCapacity_running_tasks(late) * 10000 + _used(late, 0), 11000, "registering it charges the task and its GPU");
    assert_eq(TaskScheduler_orphans(r), 0, "and nothing is left over");
    task_scheduler_submit_task(r, _req_task("u", 5, _gpu_req(1)));
    assert_eq(vec_len(task_scheduler_schedule_pending(r)), 0, "so its GPU is not sold");
    var other = make_node("other", f64_from(8), 8192);
    task_scheduler_register_node(r, other);
    assert_eq(NodeCapacity_running_tasks(other), 0, "and a node no task holds is charged nothing");
    # Past the device ceiling a profile is not added, and a snapshot is refused.
    var saved = SAMAY_MAX_NODE_DEVICES;
    SAMAY_MAX_NODE_DEVICES = 2;
    _logs_start();
    var n = _gpu_node("n", 3);
    _logs_stop();
    assert_eq(vec_len(NodeCapacity_accel_profiles(n)), 2, "the third profile is not added");
    assert_eq(_logged("node 'n': accelerator profile not added, past 2"), 1, "and that is logged, with the node");
    var three = str_builder_new();
    str_builder_add_cstr(three, "{\"nodes\":[");
    str_builder_add(three, _node_doc(str_cstr(_profile_text())));
    str_builder_add_cstr(three, "]}");
    var one = task_scheduler_from_json_str(str_builder_build(three));
    assert_eq(one != 0, 1, "a node within it restores");
    var pt = str_cstr(_profile_text());
    var list = str_builder_new();
    str_builder_add_cstr(list, pt);
    str_builder_add_cstr(list, ",");
    str_builder_add_cstr(list, pt);
    str_builder_add_cstr(list, ",");
    str_builder_add_cstr(list, pt);
    var over = str_builder_new();
    str_builder_add_cstr(over, "{\"nodes\":[");
    str_builder_add(over, _node_doc(str_cstr(str_builder_build(list))));
    str_builder_add_cstr(over, "]}");
    _logs_start();
    var refused = task_scheduler_from_json_str(str_builder_build(over));
    _logs_stop();
    SAMAY_MAX_NODE_DEVICES = saved;
    assert_eq(refused, 0, "a node past it refuses its scheduler");
    assert_eq(_logged("node 'g' refused: more accelerator profiles than 2"), 1, "and says which and why");
    # The rank order of a node's profiles, sorted once: biggest memory first, then index.
    var mixed = make_node("m", f64_from(8), 8192);
    node_capacity_add_accel(mixed, profile_cuda(0, 8589934592));
    node_capacity_add_accel(mixed, profile_cuda(1, 34359738368));
    node_capacity_add_accel(mixed, profile_cuda(2, 17179869184));
    node_capacity_add_accel(mixed, profile_cuda(3, 34359738368));
    var order = _accel_order(mixed);
    assert_eq(vec_get(order, 0) * 1000 + vec_get(order, 1) * 100 + vec_get(order, 2) * 10 + vec_get(order, 3), 1320,
      "32 GB first, lower index on a tie, then 16, then 8");
    node_capacity_add_accel(mixed, profile_cuda(4, 68719476736));
    assert_eq(vec_get(_accel_order(mixed), 0), 4, "and sorted again when a profile is added");
    return 0;
}

# The rank order written out plainly, to check the heap sort against: the better rank,
# then more memory, then the lower index.
fn _rank_first(profs, a, b) {
    var pa = vec_get(profs, a);
    var pb = vec_get(profs, b);
    if (profile_rank(pa) != profile_rank(pb)) { return profile_rank(pa) > profile_rank(pb); }
    if (profile_memory_bytes(pa) != profile_memory_bytes(pb)) { return profile_memory_bytes(pa) > profile_memory_bytes(pb); }
    return a < b;
}

fn _rank_expected(node) {
    var profs = NodeCapacity_accel_profiles(node);
    var out = vec_new();
    var i = 0;
    while (i < vec_len(profs)) {
        vec_push(out, i);
        var j = i;
        while (j > 0) {
            if (_rank_first(profs, vec_get(out, j - 1), i) == 1) { break; }
            vec_set(out, j, vec_get(out, j - 1));
            j = j - 1;
        }
        vec_set(out, j, i);
        i = i + 1;
    }
    return out;
}

# Entries [from, from + k) of `v`, lowest first.
fn _slice_sorted(v, from, k) {
    var out = vec_new();
    var i = 0;
    while (i < k) {
        var at = vec_get(v, from + i);
        vec_push(out, at);
        var j = i;
        while (j > 0) {
            if (vec_get(out, j - 1) < at) { break; }
            vec_set(out, j, vec_get(out, j - 1));
            j = j - 1;
        }
        vec_set(out, j, at);
        i = i + 1;
    }
    return out;
}

fn _same_vec(a, b) {
    if (vec_len(a) != vec_len(b)) { return 0; }
    var i = 0;
    while (i < vec_len(a)) {
        if (vec_get(a, i) != vec_get(b, i)) { return 0; }
        i = i + 1;
    }
    return 1;
}

fn _held_by(node, req) {
    var list = vec_new();
    _accel_held_list(node, req, list);
    return list;
}

fn _devices_req(n) { return resource_req_with_devices(_gpu_req(1), n); }

fn test_device_rank_oracle() {
    test_group("device_rank_oracle");
    # Nodes of 1 to 40 GPUs of two ranks and three sizes, many of them equal: the sort,
    # and what whole-device requests take by it, against the order written out plainly.
    var seed = 12345;
    var order_wrong = 0;
    var holds_wrong = 0;
    var n = 1;
    while (n <= 40) {
        var node = make_node("r", f64_from(1024), 1048576);
        var i = 0;
        while (i < n) {
            seed = (seed * 1103515245 + 12345) & 2147483647;
            var mem = 8589934592 << ((seed >> 8) % 3);
            if ((seed >> 4) % 2 == 0) {
                node_capacity_add_accel(node, profile_cuda(i, mem));
            } else {
                node_capacity_add_accel(node, profile_rocm(i, mem));
            }
            i = i + 1;
        }
        var want = _rank_expected(node);
        if (_same_vec(_accel_order(node), want) == 0) { order_wrong = order_wrong + 1; }
        # The best k, then the rest, then, with none free, the best full ones again.
        var k = n / 2 + 1;
        var first = _devices_req(k);
        node_capacity_reserve(node, first);
        if (_same_vec(_held_by(node, first), _slice_sorted(want, 0, k)) == 0) { holds_wrong = holds_wrong + 1; }
        if (n > k) {
            var rest = _devices_req(n - k);
            node_capacity_reserve(node, rest);
            if (_same_vec(_held_by(node, rest), _slice_sorted(want, k, n - k)) == 0) { holds_wrong = holds_wrong + 1; }
        }
        var over = 3;
        if (n < 3) { over = n; }
        var past = _devices_req(over);
        node_capacity_reserve(node, past);
        if (_same_vec(_held_by(node, past), _slice_sorted(want, 0, over)) == 0) { holds_wrong = holds_wrong + 1; }
        n = n + 1;
    }
    assert_eq(order_wrong, 0, "every node's profiles sort in rank order");
    assert_eq(holds_wrong, 0, "and requests take the best first, full ones first when none is free");
    # A share with no device free is counted on the best full one, the first included.
    var g = _gpu_node("g", 1);
    node_capacity_reserve(g, _gpu_req(1));
    var half = resource_req_with_share(_gpu_req(1), 500);
    node_capacity_reserve(g, half);
    assert_eq(_used(g, 0), 1500, "a share past a full device is counted on it");
    assert_eq(vec_len(_held_by(g, half)), 1, "and held");
    return 0;
}

# Profile indices as decimal digits, each plus one, so [] is 0 and [2,3] is 34.
fn _digits(v) {
    var code = 0;
    var i = 0;
    while (i < vec_len(v)) {
        code = code * 10 + vec_get(v, i) + 1;
        i = i + 1;
    }
    return code;
}

fn _list3(a, b, c, k) {
    var v = vec_new();
    if (k > 0) { vec_push(v, a); }
    if (k > 1) { vec_push(v, b); }
    if (k > 2) { vec_push(v, c); }
    return v;
}

# What a record taken on four free GPUs answers, times 1000, plus the devices held.
fn _listed_on_four(devices, list) {
    var node = _gpu_node("n", 4);
    var req = _devices_req(devices);
    var used = _reserve_listed(node, req, list);
    return used * 1000 + _digits(_held_by(node, req));
}

fn test_device_records_checked() {
    test_group("device_records_checked");
    # A record that fits is taken as it stands; one that does not is chosen again.
    assert_eq(_listed_on_four(2, _list3(2, 3, 0, 2)), 1034, "a record that fits is taken");
    assert_eq(_listed_on_four(2, vec_new()), 12, "an empty record is no record: the best two");
    assert_eq(_listed_on_four(2, _list3(0, 1, 2, 3)), 12, "more devices than the request takes");
    assert_eq(_listed_on_four(2, _list3(0 - 1, 2, 0, 2)), 12, "an index below zero");
    assert_eq(_listed_on_four(2, _list3(2, 4, 0, 2)), 12, "an index past the node's profiles");
    assert_eq(_listed_on_four(3, _list3(0, 3, 3, 3)), 123, "the same device twice");
    var mixed = make_node("m", f64_from(64), 524288);
    node_capacity_add_accel(mixed, profile_cuda(0, 17179869184));
    node_capacity_add_accel(mixed, profile_gaudi(0, 2));
    var gpu = _gpu_req(1);
    assert_eq(_reserve_listed(mixed, gpu, _one(1)), 0, "a device that does not serve the request");
    assert_eq(_digits(_held_by(mixed, gpu)), 1, "so the GPU is chosen");
    var cpu = make_req(f64_from(1), 1);
    assert_eq(_reserve_listed(mixed, cpu, _one(0)), 1, "a request for no device has nothing to choose");
    assert_eq(vec_len(_held_by(mixed, cpu)), 0, "and holds nothing");
    # A restore that takes every record as written says nothing about devices.
    var s = task_scheduler_new();
    task_scheduler_register_node(s, _gpu_node("n", 2));
    task_scheduler_submit_task(s, _req_task("t", 5, _gpu_req(1)));
    task_scheduler_schedule_pending(s);
    var text = task_scheduler_to_json_str(s);
    _logs_start();
    task_scheduler_from_json_str(text);
    _logs_stop();
    assert_eq(_logged("chosen again"), 0, "a record that fits is not chosen again");
    _logs_start();
    task_scheduler_from_json_str(_replace_once(text, "\"held_profiles\":[0]", "\"held_profiles\":[5]"));
    _logs_stop();
    assert_eq(_logged("node 'n': a task's recorded devices do not fit it"), 1, "one that does not names its node");
    _logs_start();
    task_scheduler_from_json_str(_replace_once(text, "\"running_tasks\":1", "\"running_tasks\":0"));
    _logs_stop();
    assert_eq(_logged("node 'n': snapshot capacity disagrees with its tasks"), 1, "and so does a rebuilt node");
    # At the device ceiling exactly, a node and a record of every device both restore.
    var saved = SAMAY_MAX_NODE_DEVICES;
    SAMAY_MAX_NODE_DEVICES = 2;
    var two = task_scheduler_new();
    task_scheduler_register_node(two, _gpu_node("n", 2));
    var both = _req_task("both", 5, _devices_req(2));
    task_scheduler_submit_task(two, both);
    task_scheduler_schedule_pending(two);
    var ttext = task_scheduler_to_json_str(two);
    assert_eq(str_contains(ttext, str_from("\"held_profiles\":[0,1]")), 1, "a task records both devices");
    var back = task_scheduler_from_json_str(ttext);
    assert_eq(back != 0, 1, "a node of exactly the ceiling restores");
    assert_eq(task_scheduler_get_task(back, ScheduledTask_task_id(both)) != 0, 1, "and so does a record that long");
    var pt = str_cstr(_profile_text());
    var three = str_builder_new();
    str_builder_add_cstr(three, pt);
    str_builder_add_cstr(three, ",");
    str_builder_add_cstr(three, pt);
    str_builder_add_cstr(three, ",");
    str_builder_add_cstr(three, pt);
    assert_eq(node_capacity_from_json_str(_node_doc(str_cstr(str_builder_build(three)))), 0, "a node past it is refused alone too");
    SAMAY_MAX_NODE_DEVICES = saved;
    return 0;
}

fn test_restore_counts_orphans() {
    test_group("restore_counts_orphans");
    # One task on each of a, b and c, and a snapshot that has only b: two are orphans,
    # wherever the missing nodes sort.
    var s = task_scheduler_new();
    var b = make_node("b", f64_from(1), 8192);
    task_scheduler_register_node(s, make_node("a", f64_from(1), 8192));
    task_scheduler_register_node(s, b);
    task_scheduler_register_node(s, make_node("c", f64_from(1), 8192));
    var only = task_scheduler_new();
    task_scheduler_register_node(only, b);
    var i = 0;
    while (i < 3) {
        var t = _req_task(str_cstr(_numbered("t", i)), 5, make_req(f64_from(1), 1));
        task_scheduler_submit_task(s, t);
        task_scheduler_submit_task(only, t);
        i = i + 1;
    }
    assert_eq(vec_len(task_scheduler_schedule_pending(s)), 3, "one task on each node");
    var r = task_scheduler_from_json_str(task_scheduler_to_json_str(only));
    assert_eq(TaskScheduler_orphans(r), 2, "the tasks on a and c are orphans, the one on b is not");
    var whole = task_scheduler_from_json_str(task_scheduler_to_json_str(s));
    assert_eq(TaskScheduler_orphans(whole), 0, "with every node there, none is");
    return 0;
}

fn test_preempt_counts_finished() {
    test_group("preempt_counts_finished");
    # A task finished through its transition still holds its node until a pass, and a
    # running task beside it is no victim for what that room can take.
    var s = task_scheduler_new();
    task_scheduler_register_node(s, make_node("n", f64_from(8), 8192));
    var low = scheduled_task_new(str_from("low"), str_from("d"), str_from("a"), 1, make_req(f64_from(4), 1));
    var done = scheduled_task_new(str_from("done"), str_from("d"), str_from("a"), 1, make_req(f64_from(4), 1));
    task_scheduler_submit_task(s, low);
    task_scheduler_submit_task(s, done);
    task_scheduler_schedule_pending(s);
    scheduled_task_transition(low, TASK_RUNNING);
    scheduled_task_transition(done, TASK_RUNNING);
    scheduled_task_transition(done, TASK_COMPLETED);
    var high = scheduled_task_new(str_from("high"), str_from("d"), str_from("a"), 10, make_req(f64_from(4), 1));
    task_scheduler_submit_task(s, high);
    assert_eq(task_scheduler_preempt_if_needed(s, high), 0, "the finished task's room is enough");
    assert_eq(ScheduledTask_status(low), TASK_RUNNING, "so the running one keeps going");
    return 0;
}

fn test_cron_replace_and_reset() {
    test_group("cron_replace_and_reset");
    var tmpl = cron_task_template_new(str_from("t"), str_from("d"), str_from("a"), 5, resource_req_default());
    # A schedule changed in any one field starts fresh: hour, day, month, weekday, and
    # a day or weekday written out in full rather than as a star.
    var from = vec_new();
    var to = vec_new();
    vec_push(from, "0 1 * * *");
    vec_push(to, "0 2 * * *");
    vec_push(from, "0 0 1 * *");
    vec_push(to, "0 0 2 * *");
    vec_push(from, "0 0 * 1 *");
    vec_push(to, "0 0 * 2 *");
    vec_push(from, "0 0 * * 1");
    vec_push(to, "0 0 * * 2");
    vec_push(from, "0 0 * * 1");
    vec_push(to, "0 0 1-31 * 1");
    vec_push(from, "0 0 1 * *");
    vec_push(to, "0 0 1 * 0-6");
    var fresh = 0;
    var i = 0;
    while (i < vec_len(from)) {
        var c = _cron_with("job", vec_get(from, i), CRON_CATCHUP);
        cron_scheduler_check_due_at(c, NOON);
        cron_scheduler_add(c, str_from("job"), str_from(vec_get(to, i)), tmpl, 1, CRON_CATCHUP);
        if (CronEntry_last_fired(_entry_of(c, "job")) == 0) { fresh = fresh + 1; }
        i = i + 1;
    }
    assert_eq(fresh, 6, "each changed field starts fresh");
    # The same schedule replaced during a reset keeps the reset.
    var r = _cron_with("job", "0 * * * *", CRON_CATCHUP);
    cron_scheduler_check_due_at(r, NOON);
    cron_scheduler_check_due_at(r, 946684800000000000);
    cron_scheduler_add(r, str_from("job"), str_from("0 * * * *"), tmpl, 1, CRON_CATCHUP);
    assert_eq(CronEntry_reset_from(_entry_of(r, "job")), NOON, "a replace keeps how far it had got");
    assert_eq(vec_len(cron_scheduler_check_due_at(r, NOON + 5 * MIN_NS)), 0, "so nothing fires twice");
    # Back at exactly the mark, nothing fires twice either.
    var at = _cron_with("job", "0 * * * *", CRON_CATCHUP);
    cron_scheduler_check_due_at(at, NOON);
    cron_scheduler_check_due_at(at, 946684800000000000);
    assert_eq(vec_len(cron_scheduler_check_due_at(at, NOON)), 0, "the very instant it had got to fires nothing");
    # An entry held by the burst budget as its reset ends keeps the mark, not the reset.
    var h = _cron_with("a", "* * * * *", CRON_CATCHUP);
    cron_scheduler_add(h, str_from("b"), str_from("* * * * *"), tmpl, 1, CRON_CATCHUP);
    cron_scheduler_check_due_at(h, NOON);
    cron_scheduler_check_due_at(h, 946684800000000000);
    var keep = CRON_BURST_BUDGET;
    CRON_BURST_BUDGET = 4;
    assert_eq(vec_len(cron_scheduler_check_due_at(h, NOON + 3 * MIN_NS)), 3, "one entry's three minutes fit the budget");
    CRON_BURST_BUDGET = keep;
    assert_eq(vec_len(cron_scheduler_check_due_at(h, NOON + 3 * MIN_NS)), 3, "the held one fires its three, not the reset");
    return 0;
}

fn test_log_lines_name() {
    test_group("log_lines_name");
    # A stuck task's id: control bytes are shown as '?', a space as itself.
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "a b");
    str_builder_putc(sb, 10);
    str_builder_putc(sb, 1);
    str_builder_putc(sb, 99);
    str_builder_putc(sb, 127);
    _logs_start();
    _log_no_capacity(str_builder_build(sb));
    _logs_stop();
    assert_eq(_logged("task 'a b??c?': no node with sufficient capacity"), 1, "every control byte, and only those");
    # An empty id is refused, and said so, both ways it can be empty.
    var s = task_scheduler_new();
    var none = make_node("z", f64_from(1), 1);
    NodeCapacity_set_node_id(none, 0);
    _logs_start();
    assert_eq(task_scheduler_register_node(s, make_node("", f64_from(1), 1)), 1, "an empty id is refused");
    assert_eq(task_scheduler_register_node(s, none), 1, "and so is none");
    _logs_stop();
    assert_eq(_logged("node refused: an empty id"), 2, "each said so");
    # A clamped training deadline names its model.
    _logs_start();
    training_job_to_scheduled_task(training_job_template_new(str_from("m"), TM_LORA, str_from("d"), 0, 9223372036854775807, 0),
      str_from("agent"));
    _logs_stop();
    assert_eq(_logged("training 'm': max_duration_secs"), 1, "a clamp names the model");
    # A profile whose text parses past its budget is left out of the node's snapshot.
    var g = make_node("g", f64_from(8), 8192);
    var p = profile_cuda(0, 17179869184);
    profile_set_device_name(p, str_cstr(_chars("x", 5000)));
    node_capacity_add_accel(g, p);
    var keep = SAMAY_JSON_MAX_EXPANSION;
    SAMAY_JSON_MAX_EXPANSION = 0;
    _logs_start();
    var text = node_capacity_to_json_str(g);
    _logs_stop();
    SAMAY_JSON_MAX_EXPANSION = keep;
    assert_eq(text != 0, 1, "the node is written");
    assert_eq(_logged("takes more than 0 times that"), 1, "without the profile, and the parse says why");
    assert_eq(_logged("node 'g': accelerator profile omitted"), 1, "and the node says what it lost");
    return 0;
}

