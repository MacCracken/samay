# --- scheduler: cancel ---

# --- v1.0.3: node-capacity reservation lifecycle (ADR-0007) ---

fn _cpu_milli(node) { return f64_to(f64_mul(NodeCapacity_available_cpu(node), f64_from(1000))); }

fn _sched_one(s, node_cpu, node_mem) {
    task_scheduler_register_node(s, make_node("n1", f64_from(node_cpu), node_mem));
    return 0;
}

fn test_complete_releases() {
    test_group("complete_releases");
    # The headline v1.0.2 defect: capacity was returned only on cancel, so an
    # ordinary completion retired the node's share forever.
    var s = task_scheduler_new();
    var node = make_node("n1", f64_from(8), 8192);
    task_scheduler_register_node(s, node);
    var _id_t, _id_v = task_scheduler_submit_task(s, make_task("t1", 5));
    var id = result_unwrap(_id_t, _id_v);
    task_scheduler_schedule_pending(s);
    var t = task_scheduler_get_task(s, id);
    scheduled_task_transition(t, TASK_RUNNING);
    assert_eq(is_ok(task_scheduler_complete_task(s, id, TASK_COMPLETED)), 1, "complete ok");
    assert_eq(_cpu_milli(node), 8000, "cpu fully returned on completion");
    assert_eq(NodeCapacity_available_memory_mb(node), 8192, "memory fully returned");
    assert_eq(NodeCapacity_running_tasks(node), 0, "running_tasks back to zero");
    return 0;
}

fn test_fail_releases() {
    test_group("fail_releases");
    var s = task_scheduler_new();
    var node = make_node("n1", f64_from(8), 8192);
    task_scheduler_register_node(s, node);
    var _id_t, _id_v = task_scheduler_submit_task(s, make_task("t1", 5));
    var id = result_unwrap(_id_t, _id_v);
    task_scheduler_schedule_pending(s);
    scheduled_task_transition(task_scheduler_get_task(s, id), TASK_RUNNING);
    assert_eq(is_ok(task_scheduler_complete_task(s, id, TASK_FAILED)), 1, "fail ok");
    assert_eq(_cpu_milli(node), 8000, "cpu returned on failure");
    assert_eq(NodeCapacity_running_tasks(node), 0, "running_tasks back to zero");
    # A non-terminal final status is rejected outright.
    var _id2_t, _id2_v = task_scheduler_submit_task(s, make_task("t2", 5));
    var id2 = result_unwrap(_id2_t, _id2_v);
    assert_eq(is_err_result(task_scheduler_complete_task(s, id2, TASK_RUNNING)), 1, "non-terminal rejected");
    return 0;
}

fn test_transition_reconciled() {
    test_group("transition_reconciled");
    # scheduled_task_transition is public, so a consumer can drive a task
    # terminal without any scheduler call. Reconciliation must still recover
    # the capacity on the next scheduling pass.
    var s = task_scheduler_new();
    var node = make_node("n1", f64_from(8), 8192);
    task_scheduler_register_node(s, node);
    var _id_t, _id_v = task_scheduler_submit_task(s, make_task("t1", 5));
    var id = result_unwrap(_id_t, _id_v);
    task_scheduler_schedule_pending(s);
    var t = task_scheduler_get_task(s, id);
    scheduled_task_transition(t, TASK_RUNNING);
    scheduled_task_transition(t, TASK_COMPLETED);
    assert_eq(_cpu_milli(node), 7000, "still held immediately after a raw transition");
    task_scheduler_schedule_pending(s);
    assert_eq(_cpu_milli(node), 8000, "reconciled on the next scheduling pass");
    assert_eq(NodeCapacity_running_tasks(node), 0, "running_tasks reconciled too");
    return 0;
}

fn test_requeue_releases() {
    test_group("requeue_releases");
    # SCHEDULED -> QUEUED previously left the reservation held AND took a
    # second one on re-placement, double-charging the node.
    var s = task_scheduler_new();
    var node = make_node("n1", f64_from(8), 8192);
    task_scheduler_register_node(s, node);
    var _id_t, _id_v = task_scheduler_submit_task(s, make_task("t1", 5));
    var id = result_unwrap(_id_t, _id_v);
    task_scheduler_schedule_pending(s);
    assert_eq(_cpu_milli(node), 7000, "one reservation after first placement");
    scheduled_task_transition(task_scheduler_get_task(s, id), TASK_QUEUED);
    task_scheduler_schedule_pending(s);
    assert_eq(_cpu_milli(node), 7000, "still exactly one reservation after requeue");
    assert_eq(NodeCapacity_running_tasks(node), 1, "running_tasks not double-counted");
    return 0;
}

fn test_capacity_conservation() {
    test_group("capacity_conservation");
    # The invariant that would have caught the v1.0.2 defect: once no task is
    # SCHEDULED or RUNNING, every node must be back to full capacity.
    var s = task_scheduler_new();
    var n1 = make_node("n1", f64_from(8), 8192);
    var n2 = make_node("n2", f64_from(8), 8192);
    task_scheduler_register_node(s, n1);
    task_scheduler_register_node(s, n2);
    var ids = vec_new();
    var i = 0;
    while (i < 8) {
        var _pt, _pv = task_scheduler_submit_task(s, make_task("t", 5));
        vec_push(ids, result_unwrap(_pt, _pv));
        i = i + 1;
    }
    task_scheduler_schedule_pending(s);
    # Drive a mixed set of exits: complete, fail, cancel, requeue-then-cancel.
    var k = 0;
    while (k < 8) {
        var id = vec_get(ids, k);
        var t = task_scheduler_get_task(s, id);
        if (k % 4 == 0) {
            scheduled_task_transition(t, TASK_RUNNING);
            task_scheduler_complete_task(s, id, TASK_COMPLETED);
        }
        if (k % 4 == 1) {
            scheduled_task_transition(t, TASK_RUNNING);
            task_scheduler_complete_task(s, id, TASK_FAILED);
        }
        if (k % 4 == 2) { task_scheduler_cancel_task(s, id); }
        if (k % 4 == 3) {
            scheduled_task_transition(t, TASK_QUEUED);
            scheduled_task_transition(t, TASK_CANCELLED);
        }
        k = k + 1;
    }
    task_scheduler_schedule_pending(s);
    assert_eq(_cpu_milli(n1), 8000, "n1 fully restored");
    assert_eq(NodeCapacity_available_memory_mb(n1), 8192, "n1 memory fully restored");
    assert_eq(NodeCapacity_running_tasks(n1), 0, "n1 running_tasks zero");
    assert_eq(_cpu_milli(n2), 8000, "n2 fully restored");
    assert_eq(NodeCapacity_available_memory_mb(n2), 8192, "n2 memory fully restored");
    assert_eq(NodeCapacity_running_tasks(n2), 0, "n2 running_tasks zero");
    return 0;
}

fn test_reserved_on_roundtrip() {
    test_group("reserved_on_roundtrip");
    var s = task_scheduler_new();
    task_scheduler_register_node(s, make_node("n1", f64_from(8), 8192));
    var _id_t, _id_v = task_scheduler_submit_task(s, make_task("t1", 5));
    var id = result_unwrap(_id_t, _id_v);
    task_scheduler_schedule_pending(s);
    var t = task_scheduler_get_task(s, id);
    assert_eq(str_eq(ScheduledTask_reserved_on(t), str_from("n1")), 1, "reservation recorded");
    var back = scheduled_task_from_json_str(scheduled_task_to_json_str(t));
    assert_eq(str_eq(ScheduledTask_reserved_on(back), str_from("n1")), 1, "reserved_on survives the wire");

    # Back-compat: a pre-1.0.3 snapshot carries no `reserved_on`. A SCHEDULED
    # task did hold one, on the node schedule_pending wrote into
    # node_preference; a terminal task did not.
    var legacy = "{\"task_id\":\"x\",\"name\":\"n\",\"description\":\"d\",\"agent_id\":\"a\",\"priority\":5,\"resource_requirements\":{\"cpu_cores\":1.0,\"memory_mb\":256,\"accel_req\":0,\"accel_min_chips\":0,\"network\":0,\"disk_mb\":0},\"status\":1,\"fail_reason\":null,\"created_at\":0,\"scheduled_at\":0,\"started_at\":0,\"completed_at\":0,\"deadline\":0,\"node_preference\":\"n9\"}";
    var old = scheduled_task_from_json_str(str_from(legacy));
    assert_eq(str_eq(ScheduledTask_reserved_on(old), str_from("n9")), 1, "legacy SCHEDULED task holds its node");

    var legacy_done = "{\"task_id\":\"y\",\"name\":\"n\",\"description\":\"d\",\"agent_id\":\"a\",\"priority\":5,\"resource_requirements\":{\"cpu_cores\":1.0,\"memory_mb\":256,\"accel_req\":0,\"accel_min_chips\":0,\"network\":0,\"disk_mb\":0},\"status\":3,\"fail_reason\":null,\"created_at\":0,\"scheduled_at\":0,\"started_at\":0,\"completed_at\":0,\"deadline\":0,\"node_preference\":\"n9\"}";
    var old_done = scheduled_task_from_json_str(str_from(legacy_done));
    assert_eq(ScheduledTask_reserved_on(old_done), 0, "legacy COMPLETED task holds nothing");
    return 0;
}

# --- v1.0.4: concurrency contract (ADR-0008) ---

# --- v1.1.1: no constructor returns a struct with a null field (ADR-0009) ---

fn test_no_null_fields_from_constructors() {
    test_group("constructor_null_fields");
    # The OOM *branch* of the 28 guards is not unit-testable -- lib/assert.cyr's
    # fail_after_n_allocs intercepts alloc_via only, not bare alloc(), and
    # threading an allocator through the constructors would be a signature
    # change. What IS testable is the invariant those guards protect: a
    # constructor never hands back a struct with a null field.
    #
    # This checks the path with no OOM. It could not have caught the v1.1.1 bug, which
    # needs an allocation to fail: only CI's alloc gate guards that. node_capacity_new stored
    # vec_new()'s result unchecked; on OOM that is 0, the gpu_available branch
    # is skipped for a CPU node, and the struct is returned looking healthy --
    # can_fit then answered 1 and schedule_pending PLACED A TASK on it.
    var n = node_capacity_new(str_from("t"), f64_from(1), 1, 1, 0);
    assert_eq(NodeCapacity_accel_profiles(n) != 0, 1, "accel_profiles non-null");
    assert_eq(vec_len(NodeCapacity_accel_profiles(n)), 0, "accel_profiles empty, not null");
    assert_eq(NodeCapacity_node_id(n) != 0, 1, "node_id non-null");

    var t = scheduled_task_new(str_from("n"), str_from("d"), str_from("a"), 5, resource_req_default());
    assert_eq(ScheduledTask_task_id(t) != 0, 1, "task_id non-null");
    assert_eq(str_len(ScheduledTask_task_id(t)), 36, "task_id fully rendered");
    assert_eq(ScheduledTask_resource_requirements(t) != 0, 1, "req non-null");

    var s = task_scheduler_new();
    assert_eq(TaskScheduler_tasks(s) != 0, 1, "tasks map non-null");
    assert_eq(TaskScheduler_nodes(s) != 0, 1, "nodes map non-null");

    var c = cron_scheduler_new();
    assert_eq(CronScheduler_entries(c) != 0, 1, "entries map non-null");
    assert_eq(cron_scheduler_check_due_at(c, at_ns(2026, 8, 30, 12, 0)) != 0, 1, "check_due_at returns a vec, not 0");

    var _e_t, _e_v = cron_expr_parse(str_from("0 3 * * *"));
    var e = result_unwrap(_e_t, _e_v);
    assert_eq(e != 0, 1, "parsed CronExpr non-null");
    var tj = training_job_template_new(str_from("m"), TM_LORA, str_from("d"), 0, 60, 0);
    assert_eq(tj != 0, 1, "training template non-null");
    var task = training_job_to_scheduled_task(tj, str_from("agent"));
    assert_eq(ScheduledTask_name(task) != 0, 1, "generated task name non-null");
    assert_eq(ScheduledTask_description(task) != 0, 1, "generated description non-null");
    return 0;
}

