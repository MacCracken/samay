# The direct port of the oracle's CronScheduler::add_entry, which every Rust
# cron test went through. Until 1.1.5 this suite reached entries only through
# cron_scheduler_add, so this path, and its empty-name guard, never ran.
fn test_cron_add_entry_prebuilt() {
    test_group("cron_add_entry");
    var c = cron_scheduler_new();
    var _x_t, _x_v = cron_expr_parse(str_from("0 2 * * *"));
    var expr = result_unwrap(_x_t, _x_v);
    var e = cron_entry_new(str_from("backup"), expr, make_template(), 1, CRON_SKIP);
    assert_eq(is_ok(cron_scheduler_add_entry(c, e)), 1, "add ok");
    var l = cron_scheduler_list_entries(c);
    assert_eq(vec_len(l), 1, "1 entry");
    assert_eq(vec_get(l, 0), e, "the entry registered is the one passed");
    assert_eq(vec_len(cron_scheduler_check_due_at(c, at_ns(2026, 7, 18, 2, 0))), 1, "and it fires on schedule");
    # oracle: test_cron_add_empty_name_rejected
    var blank = cron_entry_new(str_from(""), expr, make_template(), 1, CRON_SKIP);
    assert_eq(is_err_result(cron_scheduler_add_entry(c, blank)), 1, "empty name rejected");
    assert_eq(vec_len(cron_scheduler_list_entries(c)), 1, "and not registered");
    return 0;
}

# The oracle's check_due() read the wall clock, and every Rust cron test called
# it. This suite drives check_due_at (an injected clock), so until 1.1.5 the
# wall-clock entry point never ran; `cyrius coverage` counted it only because
# its name is a prefix of check_due_at.
fn test_cron_check_due_wallclock() {
    test_group("cron_check_due");
    var c = mk_cron("* * * * *", CRON_SKIP);
    var before = dt_now();
    var f = cron_scheduler_check_due(c);
    var after = dt_now();
    assert_eq(vec_len(f), 1, "first check fires: every minute matches");
    assert_eq(str_eq_cstr(ScheduledTask_name(vec_get(f, 0)), "cron-job (cron)"), 1, "task name");
    var lf = CronEntry_last_fired(vec_get(cron_scheduler_list_entries(c), 0));
    assert_eq(lf >= before, 1, "watermark is the wall clock (not before the call)");
    assert_eq(lf <= after, 1, "watermark is the wall clock (not after the call)");
    # oracle: test_cron_check_due_respects_interval. Just fired, so nothing is
    # due again within the minute. If the minute rolled over between the calls,
    # the new minute is due and one task may fire; never more.
    var f2 = cron_scheduler_check_due(c);
    var after2 = dt_now();
    var rolled = 0;
    if (after2 / 60000000000 > lf / 60000000000) { rolled = 1; }
    assert_eq(vec_len(f2) <= rolled, 1, "no re-fire within the minute");
    # oracle: test_cron_check_due_disabled_skipped
    var d = cron_scheduler_new();
    cron_scheduler_add(d, str_from("off"), str_from("* * * * *"), make_template(), 0, CRON_SKIP);
    assert_eq(vec_len(cron_scheduler_check_due(d)), 0, "disabled entry does not fire");
    return 0;
}
fn test_cron_disabled() {
    test_group("cron_disabled");
    var c = cron_scheduler_new();
    cron_scheduler_add(c, str_from("d"), str_from("* * * * *"), make_template(), 0, CRON_CATCHUP);
    assert_eq(vec_len(cron_scheduler_check_due_at(c, at_ns(2026, 7, 18, 12, 0))), 0, "disabled skipped");
    return 0;
}
fn test_cron_first_eval_match() {
    test_group("cron_first_match");
    var c = mk_cron("* * * * *", CRON_SKIP);
    var f = cron_scheduler_check_due_at(c, at_ns(2026, 7, 18, 12, 0));
    assert_eq(vec_len(f), 1, "fires once at match");
    assert_eq(str_eq_cstr(ScheduledTask_name(vec_get(f, 0)), "cron-job (cron)"), 1, "task name");
    return 0;
}
fn test_cron_first_eval_nomatch() {
    test_group("cron_first_nomatch");
    var c = mk_cron("30 3 * * *", CRON_SKIP);
    assert_eq(vec_len(cron_scheduler_check_due_at(c, at_ns(2026, 7, 18, 3, 0))), 0, "no fire at 3:00");
    assert_eq(vec_len(cron_scheduler_check_due_at(c, at_ns(2026, 7, 18, 3, 30))), 1, "fire at 3:30");
    assert_eq(vec_len(cron_scheduler_check_due_at(c, at_ns(2026, 7, 18, 3, 45))), 0, "no fire at 3:45");
    return 0;
}

# Public since 0.3.0; no test called it until 1.1.5.
fn test_cron_next_after() {
    test_group("cron_next_after");
    var _a_t, _a_v = cron_expr_parse(str_from("30 3 * * *"));
    var daily = result_unwrap(_a_t, _a_v);
    var at_0300 = _chrono_ymd_to_epoch_secs(2026, 7, 18, 3, 0, 0);
    var at_0330 = _chrono_ymd_to_epoch_secs(2026, 7, 18, 3, 30, 0);
    var next_day = _chrono_ymd_to_epoch_secs(2026, 7, 19, 3, 30, 0);
    assert_eq(cron_expr_next_after(daily, at_0300), at_0330, "later the same day");
    assert_eq(cron_expr_next_after(daily, at_0330 - 1), at_0330, "a mid-minute instant rounds up to the next minute");
    assert_eq(cron_expr_next_after(daily, at_0330), next_day, "strictly after: a match is not its own successor");
    var _b_t, _b_v = cron_expr_parse(str_from("0 0 29 2 *"));
    var leap = result_unwrap(_b_t, _b_v);
    var mar_2026 = _chrono_ymd_to_epoch_secs(2026, 3, 1, 0, 0, 0);
    assert_eq(cron_expr_next_after(leap, mar_2026), _chrono_ymd_to_epoch_secs(2028, 2, 29, 0, 0, 0), "Feb 29 waits for the next leap year");
    # Valid field by field, so it parses; it just never occurs.
    var _c_t, _c_v = cron_expr_parse(str_from("0 0 31 2 *"));
    assert_eq(is_ok(_c_t), 1, "Feb 31 parses");
    var never = result_unwrap(_c_t, _c_v);
    assert_eq(cron_expr_next_after(never, mar_2026), 0 - 1, "and has no next occurrence: -1");
    return 0;
}
# --- v1.4.1: the due count is exact ---

fn test_cron_count_exact() {
    test_group("cron_count_exact");
    # Through 1.4.0 _cron_count_due stopped at 100,000 matches, so a per-minute
    # expression reported 100,000 of its 527,041 and the logs had to say ">=".
    # Stepping by day made the stop pointless. The window includes both ends.
    var now_s = _chrono_ymd_to_epoch_secs(2026, 8, 30, 12, 0, 0);
    var old_s = now_s - CRON_SCAN_WINDOW_SECS * 5;
    var clamped = 0;

    var _every_t, _every_v = cron_expr_parse(str_from("* * * * *"));
    var every = result_unwrap(_every_t, _every_v);
    var n = _cron_count_due(every, old_s, now_s, &clamped);
    assert_eq(n, CRON_SCAN_WINDOW_SECS / 60 + 1, "per-minute count over the whole window");
    assert_eq(clamped, 1, "and the pre-window clamp is reported");

    var _daily_t, _daily_v = cron_expr_parse(str_from("0 3 * * *"));
    var daily = result_unwrap(_daily_t, _daily_v);
    var clamped2 = 0;
    var n2 = _cron_count_due(daily, old_s, now_s, &clamped2);
    assert_eq(n2, 366, "exact count over the 366-day window");
    assert_eq(clamped2, 1, "same clamp for a daily expression");

    # A short, recent window is exact and unclamped.
    var clamped3 = 0;
    var n3 = _cron_count_due(daily, now_s - 86400 * 3, now_s, &clamped3);
    assert_eq(clamped3, 0, "short window not clamped");
    assert_eq(n3, 3, "three daily occurrences in three days");
    return 0;
}

fn test_task_status_name() {
    test_group("task_status_name");
    # Public API with zero in-tree callers (and none in kavach or daimon).
    # Mirrors samay_training_method_name, which IS used -- so this is kept, not
    # deleted: removing an exported symbol is a major-version action. Pinned
    # here so it cannot rot unnoticed.
    assert_eq(streq(task_status_name(TASK_QUEUED), "queued"), 1, "queued");
    assert_eq(streq(task_status_name(TASK_SCHEDULED), "scheduled"), 1, "scheduled");
    assert_eq(streq(task_status_name(TASK_RUNNING), "running"), 1, "running");
    assert_eq(streq(task_status_name(TASK_COMPLETED), "completed"), 1, "completed");
    assert_eq(streq(task_status_name(TASK_FAILED), "failed"), 1, "failed");
    assert_eq(streq(task_status_name(TASK_CANCELLED), "cancelled"), 1, "cancelled");
    assert_eq(streq(task_status_name(TASK_PREEMPTED), "preempted"), 1, "preempted");
    return 0;
}

fn test_cron_clock_regression() {
    test_group("cron_clock_regression");
    # A backward clock step must hold the watermark, not rewind it. Before
    # v1.0.3 last_fired was stored unconditionally, so stepping back and
    # forward again re-fired the whole intervening interval.
    var c = mk_cron("* * * * *", CRON_CATCHUP);
    cron_scheduler_check_due_at(c, at_ns(2026, 7, 18, 10, 0));
    var a = cron_scheduler_check_due_at(c, at_ns(2026, 7, 18, 10, 5));
    assert_eq(vec_len(a), 5, "forward step fires the 5 missed minutes");
    var b = cron_scheduler_check_due_at(c, at_ns(2026, 7, 18, 10, 2));
    assert_eq(vec_len(b), 0, "backward step fires nothing");
    var d = cron_scheduler_check_due_at(c, at_ns(2026, 7, 18, 10, 5));
    assert_eq(vec_len(d), 0, "returning to the old instant does not re-fire");
    var e = cron_scheduler_check_due_at(c, at_ns(2026, 7, 18, 10, 7));
    assert_eq(vec_len(e), 2, "progress past the watermark fires only the new minutes");
    return 0;
}

fn test_cron_disabled_no_debt() {
    test_group("cron_disabled_no_debt");
    # A disabled entry tracks the clock instead of freezing its watermark, so
    # re-enabling does not fire a burst for the disabled interval (ADR-0007).
    # Before v1.0.3 a 30-day disable of `0 * * * *` fired 720 tasks, silently.
    var c = mk_cron("0 * * * *", CRON_CATCHUP);
    cron_scheduler_check_due_at(c, at_ns(2026, 7, 1, 0, 0));
    var entry = vec_get(cron_scheduler_list_entries(c), 0);
    CronEntry_set_enabled(entry, 0);
    var off = cron_scheduler_check_due_at(c, at_ns(2026, 7, 15, 0, 0));
    assert_eq(vec_len(off), 0, "disabled entry fires nothing");
    CronEntry_set_enabled(entry, 1);
    var back = cron_scheduler_check_due_at(c, at_ns(2026, 7, 15, 0, 30));
    assert_eq(vec_len(back), 0, "re-enable does not replay the disabled interval");
    var next = cron_scheduler_check_due_at(c, at_ns(2026, 7, 15, 1, 30));
    assert_eq(vec_len(next), 1, "normal firing resumes after re-enable");
    return 0;
}

fn test_cron_catchup() {
    test_group("cron_catchup");
    var c = mk_cron("* * * * *", CRON_CATCHUP);
    cron_scheduler_check_due_at(c, at_ns(2026, 7, 18, 12, 0));
    var f = cron_scheduler_check_due_at(c, at_ns(2026, 7, 18, 12, 5));
    assert_eq(vec_len(f), 5, "catch-up fires 5 missed");
    return 0;
}
fn test_cron_skip() {
    test_group("cron_skip");
    var c = mk_cron("* * * * *", CRON_SKIP);
    cron_scheduler_check_due_at(c, at_ns(2026, 7, 18, 12, 0));
    var f = cron_scheduler_check_due_at(c, at_ns(2026, 7, 18, 12, 5));
    assert_eq(vec_len(f), 1, "skip fires once");
    return 0;
}
fn test_cron_step_expr() {
    test_group("cron_step");
    var c = mk_cron("*/15 * * * *", CRON_CATCHUP);
    cron_scheduler_check_due_at(c, at_ns(2026, 7, 18, 12, 0));
    var f = cron_scheduler_check_due_at(c, at_ns(2026, 7, 18, 13, 0));
    assert_eq(vec_len(f), 4, "every-15 fires 4 in an hour");
    return 0;
}

# --- cron: regression tests for review findings ---

fn test_cron_star_list() {
    test_group("cron_star_list");
    # "15,*" in DOM begins with '1' -> NOT a star; neither DOM nor DOW is star
    # -> OR rule; DOM covers all days -> fires every day, not only Mondays.
    var _e_t, _e_v = cron_expr_parse(str_from("0 0 15,* * 1"));
    var e = result_unwrap(_e_t, _e_v);
    assert_eq(cron_expr_matches(e, at_ns(2026, 7, 21, 0, 0) / 1000000000), 1, "fires on a Tuesday");
    return 0;
}
fn test_cron_step_star_dom() {
    test_group("cron_step_star");
    # Vixie (cron.c): when EITHER field starts with `*` the two masks are
    # AND-ed. `*/2` sets the star flag but its mask is NOT all-ones -- over
    # DOM 1-31 it is the ODD days -- so `0 0 */2 * 1` means "odd-numbered
    # Mondays", not "every Monday". The starred field's mask still applies.
    var _e_t, _e_v = cron_expr_parse(str_from("0 0 */2 * 1"));
    var e = result_unwrap(_e_t, _e_v);
    assert_eq(cron_expr_matches(e, at_ns(2026, 7, 13, 0, 0) / 1000000000), 1, "odd-numbered Monday fires");
    assert_eq(cron_expr_matches(e, at_ns(2026, 7, 27, 0, 0) / 1000000000), 1, "odd-numbered Monday fires (2)");
    assert_eq(cron_expr_matches(e, at_ns(2026, 7, 20, 0, 0) / 1000000000), 0, "even-numbered Monday no fire");
    assert_eq(cron_expr_matches(e, at_ns(2026, 7, 6, 0, 0) / 1000000000), 0, "even-numbered Monday no fire (2)");
    assert_eq(cron_expr_matches(e, at_ns(2026, 7, 21, 0, 0) / 1000000000), 0, "Tuesday no fire");

    # `*/2` in DOM against a bare `*` DOW: AND with an all-ones DOW mask,
    # so the DOM step governs -- odd days only, every weekday.
    var _e2_t, _e2_v = cron_expr_parse(str_from("0 0 */2 * *"));
    var e2 = result_unwrap(_e2_t, _e2_v);
    assert_eq(cron_expr_matches(e2, at_ns(2026, 7, 1, 0, 0) / 1000000000), 1, "odd day fires");
    assert_eq(cron_expr_matches(e2, at_ns(2026, 7, 3, 0, 0) / 1000000000), 1, "odd day fires (2)");
    assert_eq(cron_expr_matches(e2, at_ns(2026, 7, 2, 0, 0) / 1000000000), 0, "even day no fire");
    assert_eq(cron_expr_matches(e2, at_ns(2026, 7, 8, 0, 0) / 1000000000), 0, "even day no fire (2)");

    # `*/2` in DOW: Sun(0), Tue(2), Thu(4), Sat(6) only.
    var _e3_t, _e3_v = cron_expr_parse(str_from("0 0 * * */2"));
    var e3 = result_unwrap(_e3_t, _e3_v);
    assert_eq(cron_expr_matches(e3, at_ns(2026, 7, 5, 0, 0) / 1000000000), 1, "Sunday fires");
    assert_eq(cron_expr_matches(e3, at_ns(2026, 7, 7, 0, 0) / 1000000000), 1, "Tuesday fires");
    assert_eq(cron_expr_matches(e3, at_ns(2026, 7, 6, 0, 0) / 1000000000), 0, "Monday no fire");
    assert_eq(cron_expr_matches(e3, at_ns(2026, 7, 8, 0, 0) / 1000000000), 0, "Wednesday no fire");

    # Regression guard: a bare `*` mask IS all-ones, so AND-ing it is the
    # identity -- these shapes must be untouched by the combination rule.
    var _e4_t, _e4_v = cron_expr_parse(str_from("0 0 15 * *"));
    var e4 = result_unwrap(_e4_t, _e4_v);
    assert_eq(cron_expr_matches(e4, at_ns(2026, 7, 15, 0, 0) / 1000000000), 1, "bare-star DOW: day 15 fires");
    assert_eq(cron_expr_matches(e4, at_ns(2026, 7, 16, 0, 0) / 1000000000), 0, "bare-star DOW: day 16 no fire");
    var _e5_t, _e5_v = cron_expr_parse(str_from("0 0 * * 1"));
    var e5 = result_unwrap(_e5_t, _e5_v);
    assert_eq(cron_expr_matches(e5, at_ns(2026, 7, 20, 0, 0) / 1000000000), 1, "bare-star DOM: Monday fires");
    assert_eq(cron_expr_matches(e5, at_ns(2026, 7, 21, 0, 0) / 1000000000), 0, "bare-star DOM: Tuesday no fire");
    # Neither starred -> OR rule: day 15 OR Monday.
    var _e6_t, _e6_v = cron_expr_parse(str_from("0 0 15 * 1"));
    var e6 = result_unwrap(_e6_t, _e6_v);
    assert_eq(cron_expr_matches(e6, at_ns(2026, 7, 15, 0, 0) / 1000000000), 1, "OR rule: day 15 (Wed) fires");
    assert_eq(cron_expr_matches(e6, at_ns(2026, 7, 20, 0, 0) / 1000000000), 1, "OR rule: Monday (day 20) fires");
    assert_eq(cron_expr_matches(e6, at_ns(2026, 7, 16, 0, 0) / 1000000000), 0, "OR rule: neither no fire");
    return 0;
}
# Reference matcher: the Vixie semantics written the slow, obvious way (full
# calendar decomposition up front, no prefilter, no early exits). Kept here
# deliberately so the optimised cron_expr_matches in src/cronexpr.cyr has an
# independent oracle to be differentially checked against -- v1.0.3 reordered
# that function to keep epoch_to_date off the miss path, and the guarantee it
# must hold is "behaviour-identical", which only a differential can show.
#
# Day of week from the calendar date (Sakamoto), not from _cron_dow.
fn _ref_dow(y, m, d) {
    var t = "\x00\x03\x02\x05\x00\x03\x05\x01\x04\x06\x02\x04";
    if (m < 3) { y = y - 1; }
    return (y + y / 4 - y / 100 + y / 400 + load8(t + m - 1) + d) % 7;
}

fn _ref_matches(expr, epoch_secs) {
    if (epoch_secs < 0) { return 0; }
    var dt = epoch_to_date(epoch_secs);
    var minute = load64(dt + 32);
    var hour = load64(dt + 24);
    var day = load64(dt + 16);
    var month = load64(dt + 8);
    var dow = _ref_dow(load64(dt), month, day);
    if ((CronExpr_minute_mask(expr) & (1 << minute)) == 0) { return 0; }
    if ((CronExpr_hour_mask(expr) & (1 << hour)) == 0) { return 0; }
    if ((CronExpr_month_mask(expr) & (1 << month)) == 0) { return 0; }
    var dom_ok = 0;
    if ((CronExpr_dom_mask(expr) & (1 << day)) != 0) { dom_ok = 1; }
    var dow_ok = 0;
    if ((CronExpr_dow_mask(expr) & (1 << dow)) != 0) { dow_ok = 1; }
    var either = 0;
    if (CronExpr_dom_star(expr) == 1) { either = 1; }
    if (CronExpr_dow_star(expr) == 1) { either = 1; }
    if (either == 1) {
        if (dom_ok == 1) { if (dow_ok == 1) { return 1; } }
        return 0;
    }
    if (dom_ok == 1) { return 1; }
    return dow_ok;
}

fn _diff_add(v, e) {
    var _dt, _dv = cron_expr_parse(str_from(e));
    vec_push(v, result_unwrap(_dt, _dv));
    return 0;
}

fn _diff_exprs() {
    var v = vec_new();
    _diff_add(v, "* * * * *");    _diff_add(v, "@hourly");      _diff_add(v, "@daily");
    _diff_add(v, "@weekly");      _diff_add(v, "@monthly");     _diff_add(v, "@yearly");
    _diff_add(v, "0 0 */2 * *");  _diff_add(v, "0 0 * * */2");  _diff_add(v, "0 0 */2 * 1");
    _diff_add(v, "0 0 15 * *");   _diff_add(v, "0 0 * * 1");    _diff_add(v, "0 0 15 * 1");
    _diff_add(v, "0 0 15,* * 1"); _diff_add(v, "0 12 29 2 *");  _diff_add(v, "0 0 30 2 *");
    _diff_add(v, "5 0-6/2 * JAN-MAR MON-WED");                  _diff_add(v, "*/7 */3 */5 */2 */2");
    _diff_add(v, "0 0 * * 7");    _diff_add(v, "30 3 * * 1-5"); _diff_add(v, "*/15 3,15 * * 1-5");
    return v;
}

fn test_cron_matcher_differential() {
    test_group("cron_matcher_differential");
    var v = _diff_exprs();
    var ne = vec_len(v);

    # Minute-by-minute sweep, plus boundary instants (epoch 0, negatives, leap
    # day, century non-leap, year end). Counts hits too: a differential that
    # only ever compares 0 == 0 proves nothing.
    var mism = 0;
    var hits = 0;
    var base = _chrono_ymd_to_epoch_secs(2024, 1, 1, 0, 0, 0);
    var step = 0;
    while (step < 3000) {
        var t = base + step * 60;
        var i = 0;
        while (i < ne) {
            var e = vec_get(v, i);
            var b = _ref_matches(e, t);
            if (cron_expr_matches(e, t) != b) { mism = mism + 1; }
            if (b == 1) { hits = hits + 1; }
            i = i + 1;
        }
        step = step + 1;
    }
    var probes = vec_new();
    vec_push(probes, 0); vec_push(probes, 0 - 1); vec_push(probes, 0 - 86400);
    vec_push(probes, 59); vec_push(probes, 60); vec_push(probes, 86399);
    vec_push(probes, _chrono_ymd_to_epoch_secs(2024, 2, 29, 12, 0, 0));
    vec_push(probes, _chrono_ymd_to_epoch_secs(2100, 2, 28, 0, 0, 0));
    vec_push(probes, _chrono_ymd_to_epoch_secs(2000, 2, 29, 0, 0, 0));
    vec_push(probes, _chrono_ymd_to_epoch_secs(2050, 12, 31, 23, 59, 0));
    var pi = 0;
    while (pi < vec_len(probes)) {
        var t2 = vec_get(probes, pi);
        var j = 0;
        while (j < ne) {
            var e2 = vec_get(v, j);
            if (cron_expr_matches(e2, t2) != _ref_matches(e2, t2)) { mism = mism + 1; }
            j = j + 1;
        }
        pi = pi + 1;
    }
    assert_eq(mism, 0, "optimised matcher agrees with reference on every pair");
    assert_eq(hits > 1000, 1, "differential actually exercised the match path");

    return 0;
}

# --- v1.4.1: cron evaluation allocates nothing, and the day-stepped count ---

fn test_cron_month_day_calendar() {
    test_group("cron_month_day");
    # Every day for over four centuries against chrono's year walk, which covers
    # each leap rule: the 4-year, the 100-year and the 400-year.
    var bad = 0;
    var days = 0;
    while (days < 160000) {
        var dt = epoch_to_date(days * 86400);
        var md = _cron_month_day(days);
        if (md / 32 != load64(dt + 8)) { bad = bad + 1; }
        if (md % 32 != load64(dt + 16)) { bad = bad + 1; }
        days = days + 1;
    }
    assert_eq(bad, 0, "agrees with epoch_to_date on every day");
    assert_eq(_cron_month_day(0), 1 * 32 + 1, "1970-01-01");
    var leap = _chrono_ymd_to_epoch_secs(2024, 2, 29, 0, 0, 0) / 86400;
    assert_eq(_cron_month_day(leap), 2 * 32 + 29, "2024-02-29");
    assert_eq(_cron_month_day(leap + 1), 3 * 32 + 1, "2024-03-01");
    var century = _chrono_ymd_to_epoch_secs(2100, 2, 28, 0, 0, 0) / 86400;
    assert_eq(_cron_month_day(century + 1), 3 * 32 + 1, "2100 has no Feb 29");
    return 0;
}

fn test_cron_eval_no_alloc() {
    test_group("cron_eval_no_alloc");
    # epoch_to_date allocates 48 bytes with no free, and it was on the hit path
    # until 1.4.1: one stale `* * * * *` entry cost 4.8 MB. A check runs this for
    # every entry, so the ceiling is exactly nothing.
    var _em_t, _em_v = cron_expr_parse(str_from("0 0 1 1 *"));
    var em = result_unwrap(_em_t, _em_v);
    var _ev_t, _ev_v = cron_expr_parse(str_from("* * * * *"));
    var ev = result_unwrap(_ev_t, _ev_v);
    var t0 = _chrono_ymd_to_epoch_secs(2026, 7, 18, 3, 15, 0);
    var before = alloc_used();
    var k = 0;
    var hits = 0;
    while (k < 20000) {
        cron_expr_matches(em, t0 + k * 60);
        hits = hits + cron_expr_matches(ev, t0 + k * 60);
        k = k + 1;
    }
    assert_eq(alloc_used() - before, 0, "neither a hit nor a miss allocates");
    assert_eq(hits, 20000, "the hit path really ran");
    var clamped = 0;
    before = alloc_used();
    var n = _cron_count_due(ev, 1, t0, &clamped);
    assert_eq(alloc_used() - before, 0, "a full-window count allocates nothing");
    assert_eq(n, CRON_SCAN_WINDOW_SECS / 60 + 1, "and it was a full window");
    return 0;
}

# The slow, obvious count: every minute of the range _cron_count_due covers.
fn _ref_count_due(expr, lf_secs, now_secs) {
    var t = (lf_secs / 60) * 60 + 60;
    var end = (now_secs / 60) * 60;
    if (t < end - CRON_SCAN_WINDOW_SECS) { t = end - CRON_SCAN_WINDOW_SECS; }
    var n = 0;
    while (t <= end) {
        n = n + cron_expr_matches(expr, t);
        t = t + 60;
    }
    return n;
}

# Sometimes an instant on the far side of the day-stepped path's boundaries.
fn _day_edge(t) {
    var r = _sort_rand(5);
    if (r == 0) { return t - t % 86400 - 60; }
    if (r == 1) { return t - t % 86400; }
    if (r == 2) { return t - t % 86400 + 86340; }
    if (r == 3) { return t - t % 86400 + 86399; }
    return t;
}

fn test_cron_count_differential() {
    test_group("cron_count_differential");
    var v = _diff_exprs();
    var base = _chrono_ymd_to_epoch_secs(2023, 11, 1, 0, 0, 0);
    var spans = vec_new();
    vec_push(spans, 5400);          # within a day or across one boundary
    vec_push(spans, 86400 * 3);     # two partial days and maybe a whole one
    vec_push(spans, 86400 * 40);    # across month ends
    var bad = 0;
    var hits = 0;
    var i = 0;
    while (i < 3000) {
        var e = vec_get(v, _sort_rand(vec_len(v)));
        var lf = _day_edge(base + _sort_rand(86400 * 900));
        var span = vec_get(spans, i % 3);
        # A few run past the window, which spans a leap day from 2023.
        if (i % 100 == 0) { span = 86400 * 500; }
        var now = _day_edge(lf + _sort_rand(span));
        if (now < lf) { now = lf; }
        var clamped = 0;
        var n = _cron_count_due(e, lf, now, &clamped);
        if (n != _ref_count_due(e, lf, now)) { bad = bad + 1; }
        hits = hits + n;
        i = i + 1;
    }
    assert_eq(bad, 0, "day-stepped count matches a minute-by-minute walk");
    assert_eq(hits > 100000, 1, "the differential saw real matches");

    # Masks are not range-checked on restore. cron_expr_matches can never test
    # minute 60 or hour 24, so a whole day must not count them either.
    var _x_t, _x_v = cron_expr_parse(str_from("0 3 * * *"));
    var x = result_unwrap(_x_t, _x_v);
    CronExpr_set_minute_mask(x, CronExpr_minute_mask(x) | (1 << 60) | (1 << 63));
    CronExpr_set_hour_mask(x, CronExpr_hour_mask(x) | (1 << 24) | (1 << 40));
    var c2 = 0;
    var from = _chrono_ymd_to_epoch_secs(2026, 1, 1, 0, 0, 0);
    assert_eq(_cron_count_due(x, from, from + 86400 * 10, &c2), _ref_count_due(x, from, from + 86400 * 10), "stray mask bits count for nothing");
    return 0;
}

# --- v1.0.3: parser features that had zero assertions before the sweep ---

fn _m(expr_str, y, mo, d, h, mi) {
    var _e_t, _e_v = cron_expr_parse(str_from(expr_str));
    var e = result_unwrap(_e_t, _e_v);
    return cron_expr_matches(e, at_ns(y, mo, d, h, mi) / 1000000000);
}

fn test_cron_shortcut_semantics() {
    test_group("cron_shortcut_semantics");
    # Every @shortcut expansion was previously unasserted: swapping the
    # @monthly and @weekly literals in src/cronexpr.cyr left the whole suite
    # green. These pin the actual expansion, not merely that it parses.
    assert_eq(_m("@yearly", 2026, 1, 1, 0, 0), 1, "@yearly fires Jan 1 00:00");
    assert_eq(_m("@yearly", 2026, 2, 1, 0, 0), 0, "@yearly not Feb 1");
    assert_eq(_m("@yearly", 2026, 1, 1, 1, 0), 0, "@yearly not 01:00");
    assert_eq(_m("@annually", 2026, 1, 1, 0, 0), 1, "@annually aliases @yearly");
    assert_eq(_m("@monthly", 2026, 7, 1, 0, 0), 1, "@monthly fires on the 1st");
    assert_eq(_m("@monthly", 2026, 7, 2, 0, 0), 0, "@monthly not the 2nd");
    # 2026-07-05 is a Sunday.
    assert_eq(_m("@weekly", 2026, 7, 5, 0, 0), 1, "@weekly fires Sunday");
    assert_eq(_m("@weekly", 2026, 7, 6, 0, 0), 0, "@weekly not Monday");
    assert_eq(_m("@daily", 2026, 7, 6, 0, 0), 1, "@daily fires at midnight");
    assert_eq(_m("@daily", 2026, 7, 6, 0, 1), 0, "@daily not 00:01");
    assert_eq(_m("@midnight", 2026, 7, 6, 0, 0), 1, "@midnight aliases @daily");
    assert_eq(_m("@hourly", 2026, 7, 6, 13, 0), 1, "@hourly fires on the hour");
    assert_eq(_m("@hourly", 2026, 7, 6, 13, 1), 0, "@hourly not past the hour");
    assert_eq(is_err_result(cron_expr_parse(str_from("@bogus"))), 1, "unknown shortcut rejected");
    assert_eq(is_err_result(cron_expr_parse(str_from("@reboot"))), 1, "@reboot unsupported");
    # v1.0.3: surrounding whitespace is tolerated, matching the 5-field path.
    assert_eq(is_ok(cron_expr_parse(str_from("@daily "))), 1, "trailing space accepted");
    assert_eq(is_ok(cron_expr_parse(str_from(" @daily"))), 1, "leading space accepted");
    assert_eq(_m("  @daily  ", 2026, 7, 6, 0, 0), 1, "padded shortcut still expands correctly");
    return 0;
}

fn test_cron_name_parsing() {
    test_group("cron_name_parsing");
    # Month and day NAMES had zero assertions in the suite.
    assert_eq(_m("0 0 15 JUL *", 2026, 7, 15, 0, 0), 1, "JUL month name matches");
    assert_eq(_m("0 0 15 JUL *", 2026, 8, 15, 0, 0), 0, "JUL excludes August");
    assert_eq(_m("0 0 * * MON", 2026, 7, 6, 0, 0), 1, "MON day name matches");
    assert_eq(_m("0 0 * * MON", 2026, 7, 7, 0, 0), 0, "MON excludes Tuesday");
    assert_eq(_m("0 0 * JAN-MAR *", 2026, 2, 10, 0, 0), 1, "JAN-MAR range matches Feb");
    assert_eq(_m("0 0 * JAN-MAR *", 2026, 7, 10, 0, 0), 0, "JAN-MAR excludes July");
    assert_eq(_m("0 0 * * MON-WED", 2026, 7, 8, 0, 0), 1, "MON-WED matches Wednesday");
    assert_eq(_m("0 0 * * MON-WED", 2026, 7, 9, 0, 0), 0, "MON-WED excludes Thursday");
    # day-of-week 7 folds to Sunday (0).
    assert_eq(_m("0 0 * * 7", 2026, 7, 5, 0, 0), 1, "DOW 7 folds to Sunday");
    assert_eq(_m("0 0 * * 7", 2026, 7, 6, 0, 0), 0, "DOW 7 excludes Monday");
    # step forms over an explicit range
    assert_eq(_m("0 0-6/2 * * *", 2026, 7, 6, 4, 0), 1, "N-M/S step matches");
    assert_eq(_m("0 0-6/2 * * *", 2026, 7, 6, 5, 0), 0, "N-M/S step excludes odd hour");
    return 0;
}

fn test_training_deadline_clamp() {
    test_group("training_deadline_clamp");
    # dur_seconds multiplies by 1e9; an absurd max_duration_secs used to wrap
    # i64 and land the deadline in the PAST while still passing `max > 0`.
    var job = training_job_template_new(str_from("m"), TM_LORA, str_from("d"), 0,
      9223372036854775807, 0);
    var t = training_job_to_scheduled_task(job, str_from("agent"));
    assert_eq(ScheduledTask_deadline(t) > dt_now(), 1, "clamped deadline is still in the future");
    # An ordinary duration is untouched.
    var job2 = training_job_template_new(str_from("m"), TM_LORA, str_from("d"), 0, 3600, 0);
    var t2 = training_job_to_scheduled_task(job2, str_from("agent"));
    assert_eq(ScheduledTask_deadline(t2) > dt_now(), 1, "normal deadline in the future");
    return 0;
}

