# samay benchmarks — hot-path microbenchmarks.
# Stdlib + project modules auto-included via cyrius.cyml / lib.cyr.

include "src/lib.cyr"

fn main(): i64 {
    alloc_init();

    var req = resource_req_new(f64_from(2), 4096, REQ_NONE, 0, 0, 0);
    var node = node_capacity_new(str_from("n1"), f64_from(8), 8192, 10240, 0);

    # Str args are built once, outside every timed loop: str_from allocates a
    # 16-byte header, so building them inline would fold that cost into the
    # figure each bench claims to report.
    var t_name = str_from("t");
    var t_desc = str_from("d");
    var t_agent = str_from("a");

    # can_fit: pure, no allocation — the inner loop of best_fit_node.
    var b1 = bench_new("node_can_fit");
    bench_batch_start(b1);
    var i = 0;
    while (i < 1000000) { node_capacity_can_fit(node, req); i = i + 1; }
    bench_batch_stop(b1, 1000000);
    bench_report(b1);

    # priority classification: pure.
    var b2 = bench_new("priority_from_numeric");
    bench_batch_start(b2);
    i = 0;
    while (i < 1000000) { task_priority_from_numeric(7); i = i + 1; }
    bench_batch_stop(b2, 1000000);
    bench_report(b2);

    # samay_uuid_v4: getrandom + hex format (allocating).
    var b3 = bench_new("samay_uuid_v4");
    bench_batch_start(b3);
    i = 0;
    while (i < 100000) { samay_uuid_v4(); i = i + 1; }
    bench_batch_stop(b3, 100000);
    bench_report(b3);

    # scheduled_task_new: alloc + uuid + dt_now.
    var b4 = bench_new("scheduled_task_new");
    bench_batch_start(b4);
    i = 0;
    while (i < 50000) { scheduled_task_new(t_name, t_desc, t_agent, 5, req); i = i + 1; }
    bench_batch_stop(b4, 50000);
    bench_report(b4);

    # cron_expr_matches: the check_due inner loop (epoch_to_date + bitmask tests).
    var _expr_t, _expr_v = cron_expr_parse(str_from("*/15 3,15 * * 1-5"));
    var expr = result_unwrap(_expr_t, _expr_v);
    var ct = _chrono_ymd_to_epoch_secs(2026, 7, 18, 3, 15, 0);
    var b5 = bench_new("cron_expr_matches");
    bench_batch_start(b5);
    i = 0;
    while (i < 100000) { cron_expr_matches(expr, ct); i = i + 1; }
    bench_batch_stop(b5, 100000);
    bench_report(b5);

    # pending_tasks at 2,000 queued tasks: the scan and sort every schedule_pending
    # runs. Last, so the rows above keep their code layout.
    var sched = task_scheduler_new();
    i = 0;
    while (i < 2000) {
        task_scheduler_submit_task(sched, scheduled_task_new(t_name, t_desc, t_agent, 1 + i % 10, req));
        i = i + 1;
    }
    var b6 = bench_new("pending_tasks_2000");
    bench_batch_start(b6);
    i = 0;
    while (i < 100) { task_scheduler_pending_tasks(sched); i = i + 1; }
    bench_batch_stop(b6, 100);
    bench_report(b6);

    # _cron_count_due over the whole catch-up window: what one stale entry adds
    # to a check. Last, for the same reason.
    var _every_t, _every_v = cron_expr_parse(str_from("* * * * *"));
    var every = result_unwrap(_every_t, _every_v);
    var clamped = 0;
    var b7 = bench_new("cron_count_window");
    bench_batch_start(b7);
    i = 0;
    while (i < 1000) { _cron_count_due(every, 1, ct, &clamped); i = i + 1; }
    bench_batch_stop(b7, 1000);
    bench_report(b7);

    # The two documents that carry a nested leaf. Last, for the same reason.
    var task = scheduled_task_new(t_name, t_desc, t_agent, 5, req);
    var b8 = bench_new("scheduled_task_to_jsonv");
    bench_batch_start(b8);
    i = 0;
    while (i < 20000) { scheduled_task_to_jsonv(task); i = i + 1; }
    bench_batch_stop(b8, 20000);
    bench_report(b8);

    var entry = cron_entry_new(t_name, expr, cron_task_template_new(t_name, t_desc, t_agent, 5, req), 1, CRON_SKIP);
    var b9 = bench_new("cron_entry_to_jsonv");
    bench_batch_start(b9);
    i = 0;
    while (i < 20000) { cron_entry_to_jsonv(entry); i = i + 1; }
    bench_batch_stop(b9, 20000);
    bench_report(b9);

    # Accelerator placement. Every row above that touches can_fit uses REQ_NONE,
    # which returns before reaching a profile. Last, for the same reason.
    var gpu_node = node_capacity_new(t_name, f64_from(64), 524288, 1048576, 0);
    i = 0;
    while (i < 4) {
        node_capacity_add_accel(gpu_node, profile_cuda(i, 17179869184));
        i = i + 1;
    }
    var gpu_req = resource_req_new(f64_from(2), 4096, REQ_GPU, 1, 0, 1024);
    var b10 = bench_new("node_can_fit_gpu");
    bench_batch_start(b10);
    i = 0;
    while (i < 1000000) { node_capacity_can_fit(gpu_node, gpu_req); i = i + 1; }
    bench_batch_stop(b10, 1000000);
    bench_report(b10);

    # _best_fit_node across 100 TPU nodes: what placing one task costs.
    var fleet = map_new_str();
    i = 0;
    while (i < 100) {
        var sb = str_builder_new();
        str_builder_add_cstr(sb, "tpu-");
        str_builder_add_int(sb, i);
        var id = str_builder_build(sb);
        map_set(fleet, id, node_capacity_add_accel(node_capacity_new(id, f64_from(32), 65536, 1048576, 0), profile_tpu(0, 8, TPU_V5P)));
        i = i + 1;
    }
    var tpu_req = resource_req_new(f64_from(2), 4096, REQ_TPU, 4, 0, 1024);
    var b11 = bench_new("best_fit_tpu_100_nodes");
    bench_batch_start(b11);
    i = 0;
    while (i < 20000) { _best_fit_node(fleet, tpu_req); i = i + 1; }
    bench_batch_stop(b11, 20000);
    bench_report(b11);

    # A whole pass, two ways. Each stuck task logs a line, so the log goes to a hook
    # that drops it: the rows time samay's work, not a terminal's. Last, for the same
    # reason as above.
    sakshi_set_emit_hook(&_bench_drop_log);

    # 2,000 tasks no node fits against 2,000 nodes. Nothing is placed, so every
    # pass is the same pass.
    var stuck = task_scheduler_new();
    i = 0;
    while (i < 2000) {
        task_scheduler_register_node(stuck, node_capacity_new(_bench_id("n-", i), f64_from(8), 16384, 102400, 0));
        task_scheduler_submit_task(stuck, scheduled_task_new(t_name, t_desc, t_agent, 1 + i % 10,
            resource_req_new(f64_from(16), 4096, REQ_NONE, 0, 0, 0)));
        i = i + 1;
    }
    var b12 = bench_new("schedule_pending_stuck_2000");
    bench_batch_start(b12);
    i = 0;
    while (i < 10) { task_scheduler_schedule_pending(stuck); i = i + 1; }
    bench_batch_stop(b12, 10);
    bench_report(b12);

    # 500 tasks placed on 500 nodes: what the skip costs a pass where everything
    # fits. A pass places them, so each round builds its own scheduler, untimed.
    var b13 = bench_new("schedule_pending_place_500");
    var round = 0;
    while (round < 10) {
        var fresh = task_scheduler_new();
        i = 0;
        while (i < 500) {
            task_scheduler_register_node(fresh, node_capacity_new(_bench_id("p-", i), f64_from(8), 16384, 102400, 0));
            task_scheduler_submit_task(fresh, scheduled_task_new(t_name, t_desc, t_agent, 1 + i % 10,
                resource_req_new(f64_from(1 + i % 4), 1024 * (1 + i % 8), REQ_NONE, 0, 0, 0)));
            i = i + 1;
        }
        bench_start(b13);
        task_scheduler_schedule_pending(fresh);
        bench_stop(b13);
        round = round + 1;
    }
    bench_report(b13);
    sakshi_clear_emit_hook();

    return 0;
}

fn _bench_drop_log(ts, level, category, msg, msg_len, fields): i64 {
    return 0;
}

fn _bench_id(prefix, i): i64 {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, prefix);
    str_builder_add_int(sb, i);
    return str_builder_build(sb);
}

var r = main();
syscall(60, r);
