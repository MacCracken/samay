# samay benchmarks — hot-path microbenchmarks.
# Stdlib + project modules auto-included via cyrius.cyml / lib.cyr.

include "src/lib.cyr"

fn main(): i64 {
    alloc_init();

    var req = resource_req_new(f64_from(2), 4096, REQ_NONE, 0, 0, 0);
    var node = node_capacity_new(str_from("n1"), f64_from(8), 8192, 10240, 0);

    # Str args are built once, outside every timed loop: str_from allocates a
    # 16-byte header, so building them inline would fold that cost into the
    # figure each bench claims to report.
    var t_name = str_from("t");
    var t_desc = str_from("d");
    var t_agent = str_from("a");

    # can_fit: pure, no allocation — the inner loop of best_fit_node.
    var b1 = bench_new("node_can_fit");
    bench_batch_start(b1);
    var i = 0;
    while (i < 1000000) { node_capacity_can_fit(node, req); i = i + 1; }
    bench_batch_stop(b1, 1000000);
    bench_report(b1);

    # priority classification: pure.
    var b2 = bench_new("priority_from_numeric");
    bench_batch_start(b2);
    i = 0;
    while (i < 1000000) { task_priority_from_numeric(7); i = i + 1; }
    bench_batch_stop(b2, 1000000);
    bench_report(b2);

    # samay_uuid_v4: getrandom + hex format (allocating).
    var b3 = bench_new("samay_uuid_v4");
    bench_batch_start(b3);
    i = 0;
    while (i < 100000) { samay_uuid_v4(); i = i + 1; }
    bench_batch_stop(b3, 100000);
    bench_report(b3);

    # scheduled_task_new: alloc + uuid + dt_now.
    var b4 = bench_new("scheduled_task_new");
    bench_batch_start(b4);
    i = 0;
    while (i < 50000) { scheduled_task_new(t_name, t_desc, t_agent, 5, req); i = i + 1; }
    bench_batch_stop(b4, 50000);
    bench_report(b4);

    # cron_expr_matches: the check_due inner loop (epoch_to_date + bitmask tests).
    var _expr_t, _expr_v = cron_expr_parse(str_from("*/15 3,15 * * 1-5"));
    var expr = result_unwrap(_expr_t, _expr_v);
    var ct = _chrono_ymd_to_epoch_secs(2026, 7, 18, 3, 15, 0);
    var b5 = bench_new("cron_expr_matches");
    bench_batch_start(b5);
    i = 0;
    while (i < 100000) { cron_expr_matches(expr, ct); i = i + 1; }
    bench_batch_stop(b5, 100000);
    bench_report(b5);

    # pending_tasks at 2,000 queued tasks: the scan and sort every schedule_pending
    # runs. Last, so the rows above keep their code layout.
    var sched = task_scheduler_new();
    i = 0;
    while (i < 2000) {
        task_scheduler_submit_task(sched, scheduled_task_new(t_name, t_desc, t_agent, 1 + i % 10, req));
        i = i + 1;
    }
    var b6 = bench_new("pending_tasks_2000");
    bench_batch_start(b6);
    i = 0;
    while (i < 100) { task_scheduler_pending_tasks(sched); i = i + 1; }
    bench_batch_stop(b6, 100);
    bench_report(b6);

    # _cron_count_due over the whole catch-up window: what one stale entry adds
    # to a check. Last, for the same reason.
    var _every_t, _every_v = cron_expr_parse(str_from("* * * * *"));
    var every = result_unwrap(_every_t, _every_v);
    var clamped = 0;
    var b7 = bench_new("cron_count_window");
    bench_batch_start(b7);
    i = 0;
    while (i < 1000) { _cron_count_due(every, 1, ct, &clamped); i = i + 1; }
    bench_batch_stop(b7, 1000);
    bench_report(b7);

    # The two documents that carry a nested leaf. Last, for the same reason.
    var task = scheduled_task_new(t_name, t_desc, t_agent, 5, req);
    var b8 = bench_new("scheduled_task_to_jsonv");
    bench_batch_start(b8);
    i = 0;
    while (i < 20000) { scheduled_task_to_jsonv(task); i = i + 1; }
    bench_batch_stop(b8, 20000);
    bench_report(b8);

    var entry = cron_entry_new(t_name, expr, cron_task_template_new(t_name, t_desc, t_agent, 5, req), 1, CRON_SKIP);
    var b9 = bench_new("cron_entry_to_jsonv");
    bench_batch_start(b9);
    i = 0;
    while (i < 20000) { cron_entry_to_jsonv(entry); i = i + 1; }
    bench_batch_stop(b9, 20000);
    bench_report(b9);

    return 0;
}

var r = main();
syscall(60, r);
